<Window x:Class="TransPoli.DriverPhoneWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="TransPoli • Celular" Width="450" Height="900" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
 ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" WindowStartupLocation="CenterScreen">
 <Window.Resources>
  <Style x:Key="PhoneApp" TargetType="Button">
   <Setter Property="Margin" Value="5"/><Setter Property="Background" Value="#10161D"/><Setter Property="Foreground" Value="#F7F8FA"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="1"/><Setter Property="FontSize" Value="10"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="4"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Shell" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="22" Padding="6"><Grid><Border Width="58" Height="58" CornerRadius="15" Background="#1A242E" HorizontalAlignment="Center" VerticalAlignment="Top"/><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="2,0,2,5" TextElement.FontWeight="SemiBold"/></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shell" Property="Background" Value="#121A22"/><Setter TargetName="Shell" Property="BorderBrush" Value="#27313B"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Shell" Property="Background" Value="#202A34"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="AndroidNav" TargetType="Button"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#AEB7C1"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontSize" Value="15"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="NavPill" Width="54" Height="30" CornerRadius="15" Background="{TemplateBinding Background}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="NavPill" Property="Background" Value="#18212A"/><Setter Property="Foreground" Value="#F7F8FA"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="NavPill" Property="Background" Value="#2A2515"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="PhoneCard" TargetType="Border"><Setter Property="Background" Value="#E610151B"/><Setter Property="BorderBrush" Value="#27313B"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="16"/><Setter Property="Padding" Value="13"/></Style>
 </Window.Resources>
 <Border Margin="10" CornerRadius="58" Background="#020304" BorderBrush="#4A5561" BorderThickness="2" Padding="9"><Border CornerRadius="48" Background="#080B0F" BorderBrush="#171E25" BorderThickness="1"><Grid>
    <Grid.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#10161D" Offset="0"/><GradientStop Color="#070A0E" Offset=".52"/><GradientStop Color="#0B0D0F" Offset="1"/></LinearGradientBrush></Grid.Background>
    <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/><RowDefinition Height="66"/></Grid.RowDefinitions>
    <Grid Margin="20,0"><TextBlock x:Name="ClockText" Text="12:00" Foreground="#F7F8FA" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/><Border Width="104" Height="29" CornerRadius="15" Background="#000000" HorizontalAlignment="Center" VerticalAlignment="Center"><Grid><Ellipse Width="6" Height="6" Fill="#07111A" HorizontalAlignment="Right" Margin="0,0,20,0"/><Ellipse Width="2" Height="2" Fill="#173B59" HorizontalAlignment="Right" Margin="0,0,22,2"/></Grid></Border><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Viewbox Width="18" Height="14" Margin="0,0,8,0"><Canvas Width="20" Height="16"><Path Stroke="#F7F8FA" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M2,5 C7,1 13,1 18,5"/><Path Stroke="#F7F8FA" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M5,9 C8,6.5 12,6.5 15,9"/><Ellipse Width="3" Height="3" Fill="#F7F8FA" Canvas.Left="8.5" Canvas.Top="12"/></Canvas></Viewbox><Border Width="21" Height="10" CornerRadius="3" BorderBrush="#D5DBE2" BorderThickness="1" VerticalAlignment="Center"><Border Width="15" Height="6" CornerRadius="1" Background="#D5DBE2" HorizontalAlignment="Left" Margin="1"/></Border></StackPanel></Grid>
    <Grid Grid.Row="1" Margin="22,5,22,8">
     <Grid.RowDefinitions><RowDefinition Height="112"/><RowDefinition Height="142"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Border CornerRadius="24" Background="#B80A1016" BorderBrush="#202A33" BorderThickness="1" Padding="14,12" Margin="0,0,0,8" ClipToBounds="True"><StackPanel>
      <Grid><StackPanel><TextBlock Text="TRANSPOLI" Foreground="#FFE08A" FontSize="17" FontWeight="Bold"/><TextBlock Text="CENTRAL DO MOTORISTA" Foreground="#929BA7" FontSize="9" FontWeight="SemiBold" Margin="0,2,0,0"/><TextBlock x:Name="PhoneGreetingText" Text="Boa viagem!" Foreground="#F7F8FA" FontSize="20" FontWeight="SemiBold" Margin="0,8,0,0"/></StackPanel><Border Width="48" Height="48" CornerRadius="15" Background="#0A0D10" BorderBrush="#D6A52A" BorderThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Top"><Grid><Path Fill="#FFE08A" Data="M8,6 L24,2 L40,6 L40,28 L24,42 L8,28 Z M14,12 L34,12 L34,17 L27,17 L27,32 L21,36 L21,17 L14,17 Z"/><TextBlock Text="TP" Foreground="#07090C" FontSize="7" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,7,0,0"/></Grid></Border></Grid>
      <Border Style="{StaticResource PhoneCard}" Margin="0,12,0,0" Padding="10,7"><Grid><TextBlock x:Name="PhoneConnectionText" Text="●  AGUARDANDO ETS2" Foreground="#929BA7" FontSize="9" FontWeight="Bold"/><TextBlock Text="F9  FECHAR" Foreground="#697480" FontSize="8" FontWeight="SemiBold" HorizontalAlignment="Right"/></Grid></Border>
     </StackPanel></Border>
     <Border Grid.Row="1" Style="{StaticResource PhoneCard}" BorderBrush="#80631B" CornerRadius="24" Padding="15" Margin="0,4,0,4">
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="5"/></Grid.RowDefinitions>
       <Grid><StackPanel Orientation="Horizontal"><TextBlock Text="▣" Foreground="#FFE08A" FontSize="14" Margin="0,0,8,0"/><Ellipse x:Name="PhoneTripDot" Width="7" Height="7" Fill="#FFE08A" Margin="0,0,7,0" VerticalAlignment="Center"/><TextBlock x:Name="PhoneTripText" Text="SEM VIAGEM ATIVA" Foreground="#FFE08A" FontSize="9" FontWeight="Bold"/></StackPanel><TextBlock x:Name="PhoneSpeedText" Text="0 km/h" Foreground="#F7F8FA" FontSize="17" FontWeight="Bold" HorizontalAlignment="Right"/></Grid>
       <TextBlock x:Name="PhoneRouteText" Grid.Row="1" Text="Aguardando telemetria" Foreground="#F7F8FA" FontSize="13" FontWeight="SemiBold" Margin="0,8,0,0" TextTrimming="CharacterEllipsis"/>
       <Grid Grid.Row="2" Margin="0,8,0,7"><TextBlock x:Name="PhoneCargoText" Text="Carga: —" Foreground="#929BA7" FontSize="9" TextTrimming="CharacterEllipsis" Width="175" HorizontalAlignment="Left"/><TextBlock x:Name="PhoneProgressText" Text="—" Foreground="#C8D0D9" FontSize="9" FontWeight="SemiBold" HorizontalAlignment="Right"/></Grid>
       <Border Grid.Row="3" Background="#202830" CornerRadius="3"><Border x:Name="PhoneProgressBar" Background="#D6A52A" CornerRadius="3" HorizontalAlignment="Left" Width="0"/></Border>
      </Grid>
     </Border>
     <Grid Grid.Row="2" Margin="0,4,0,0"><Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid><TextBlock Text="APLICATIVOS" Foreground="#697480" FontSize="9" FontWeight="Bold" VerticalAlignment="Center"/><TextBlock Text="TRANSPOLI OS" Foreground="#414B55" FontSize="8" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid><UniformGrid x:Name="AppGrid" Grid.Row="1" Columns="3" Rows="3">
      <Button x:Name="MessagesButton" Style="{StaticResource PhoneApp}" Content="💬  Mensagens&#x0a;Comunicados" Click="App_Click" Tag="Mensagens"/><Button Style="{StaticResource PhoneApp}" Content="🏦  Banco&#x0a;Saldo e movimentos" Click="App_Click" Tag="Banco"/><Button Style="{StaticResource PhoneApp}" Content="📄  Documentos&#x0a;Notas e carimbo" Click="App_Click" Tag="Documentos"/><Button Style="{StaticResource PhoneApp}" Content="🚚  Viagens&#x0a;Carga e histórico" Click="App_Click" Tag="Viagens"/><Button Style="{StaticResource PhoneApp}" Content="🏆  Ranking&#x0a;Sua posição" Click="App_Click" Tag="Ranking"/><Button x:Name="AlertsButton" Style="{StaticResource PhoneApp}" Content="🔔  Alertas&#x0a;Eventos ativos" Click="App_Click" Tag="Alertas"/><Button Style="{StaticResource PhoneApp}" Content="👤  Meu Perfil&#x0a;Motorista" Click="App_Click" Tag="Perfil"/><Button Style="{StaticResource PhoneApp}" Content="🚛  Garagem&#x0a;Seu caminhão" Click="App_Click" Tag="Garagem"/><Button Style="{StaticResource PhoneApp}" Content="⚙  Ajustes&#x0a;Preferências" Click="App_Click" Tag="Ajustes"/>
     </UniformGrid></Grid>
     <Border x:Name="AppPanel" Grid.RowSpan="3" Background="#FF080C11" BorderBrush="#303B46" BorderThickness="1" CornerRadius="28" Padding="15" Visibility="Collapsed" ClipToBounds="True">
      <Grid><Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid><Button Content="‹" Width="36" Height="36" HorizontalAlignment="Left" Click="Back_Click" Background="#141A20" Foreground="#FFE08A" BorderBrush="#27313B" BorderThickness="1" FontSize="22"/><TextBlock x:Name="AppTitle" Foreground="#F7F8FA" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/><TextBlock Text="TRANSPOLI" Foreground="#6C7580" FontSize="8" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid><ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="AppContent"/></ScrollViewer></Grid>
     </Border>
    </Grid>
    <Grid Grid.Row="2">
     <Border Width="128" Height="5" CornerRadius="3" Background="#F0F2F4" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Grid>
   </Grid></Border></Border>
</Window>