<Window x:Class="TransPoli.DriverPhoneWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="TransPoli • Celular" Width="420" Height="820" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
 ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" WindowStartupLocation="CenterScreen">
 <Window.Resources>
  <Style x:Key="PhoneApp" TargetType="Button">
   <Setter Property="Margin" Value="5"/><Setter Property="Background" Value="#10161D"/><Setter Property="Foreground" Value="#F7F8FA"/><Setter Property="BorderBrush" Value="#27313B"/><Setter Property="BorderThickness" Value="1"/><Setter Property="FontSize" Value="11"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="4"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Shell" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="17"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.FontWeight="SemiBold"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shell" Property="Background" Value="#18212A"/><Setter TargetName="Shell" Property="BorderBrush" Value="#6C5620"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Shell" Property="Background" Value="#202A34"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="PhoneCard" TargetType="Border"><Setter Property="Background" Value="#E610151B"/><Setter Property="BorderBrush" Value="#27313B"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="16"/><Setter Property="Padding" Value="13"/></Style>
 </Window.Resources>
 <Border Margin="12" CornerRadius="50" Background="#020304" BorderBrush="#4A5561" BorderThickness="2" Padding="7" ClipToBounds="True">
  <Border CornerRadius="42" Background="#080B0F" BorderBrush="#171E25" BorderThickness="1" ClipToBounds="True">
   <Grid>
    <Grid.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#10161D" Offset="0"/><GradientStop Color="#070A0E" Offset=".52"/><GradientStop Color="#0B0D0F" Offset="1"/></LinearGradientBrush></Grid.Background>
    <Grid.RowDefinitions><RowDefinition Height="43"/><RowDefinition Height="*"/><RowDefinition Height="47"/></Grid.RowDefinitions>
    <Grid Margin="20,0"><TextBlock x:Name="ClockText" Text="12:00" Foreground="#F7F8FA" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/><Border Width="92" Height="25" CornerRadius="13" Background="#010203" HorizontalAlignment="Center" VerticalAlignment="Center"><Ellipse Width="6" Height="6" Fill="#17202A" HorizontalAlignment="Right" Margin="0,0,18,0"/></Border><TextBlock Text="▂▄▆█  100%" Foreground="#D5DBE2" FontSize="9" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
    <Grid Grid.Row="1" Margin="22,7,22,10">
     <Grid.RowDefinitions><RowDefinition Height="120"/><RowDefinition Height="122"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <StackPanel>
      <Grid><StackPanel><TextBlock Text="TRANSPOLI" Foreground="#FFE08A" FontSize="12" FontWeight="Bold"/><TextBlock Text="Central do motorista" Foreground="#F7F8FA" FontSize="24" FontWeight="SemiBold" Margin="0,4,0,0"/><TextBlock Text="Seu ecossistema operacional" Foreground="#929BA7" FontSize="10" Margin="0,2,0,0"/></StackPanel><Border Width="38" Height="38" CornerRadius="12" Background="#18170F" BorderBrush="#6C5620" BorderThickness="1" HorizontalAlignment="Right" VerticalAlignment="Top"><TextBlock Text="TP" Foreground="#FFE08A" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></Grid>
      <Border Style="{StaticResource PhoneCard}" Margin="0,12,0,0" Padding="10,7"><Grid><TextBlock x:Name="PhoneConnectionText" Text="●  AGUARDANDO ETS2" Foreground="#929BA7" FontSize="9" FontWeight="Bold"/><TextBlock Text="F9  FECHAR" Foreground="#697480" FontSize="8" FontWeight="SemiBold" HorizontalAlignment="Right"/></Grid></Border>
     </StackPanel>
     <Border Grid.Row="1" Style="{StaticResource PhoneCard}" BorderBrush="#4A3D1B" Padding="14">
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="5"/></Grid.RowDefinitions>
       <Grid><StackPanel Orientation="Horizontal"><Ellipse x:Name="PhoneTripDot" Width="7" Height="7" Fill="#FFE08A" Margin="0,0,7,0" VerticalAlignment="Center"/><TextBlock x:Name="PhoneTripText" Text="SEM VIAGEM ATIVA" Foreground="#FFE08A" FontSize="9" FontWeight="Bold"/></StackPanel><TextBlock x:Name="PhoneSpeedText" Text="0 km/h" Foreground="#F7F8FA" FontSize="17" FontWeight="Bold" HorizontalAlignment="Right"/></Grid>
       <TextBlock x:Name="PhoneRouteText" Grid.Row="1" Text="Aguardando telemetria" Foreground="#F7F8FA" FontSize="13" FontWeight="SemiBold" Margin="0,8,0,0" TextTrimming="CharacterEllipsis"/>
       <Grid Grid.Row="2" Margin="0,8,0,7"><TextBlock x:Name="PhoneCargoText" Text="Carga: —" Foreground="#929BA7" FontSize="9" TextTrimming="CharacterEllipsis" Width="175" HorizontalAlignment="Left"/><TextBlock x:Name="PhoneProgressText" Text="—" Foreground="#C8D0D9" FontSize="9" FontWeight="SemiBold" HorizontalAlignment="Right"/></Grid>
       <Border Grid.Row="3" Background="#202830" CornerRadius="3"><Border x:Name="PhoneProgressBar" Background="#D6A52A" CornerRadius="3" HorizontalAlignment="Left" Width="0"/></Border>
      </Grid>
     </Border>
     <Grid Grid.Row="2"><Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="APLICATIVOS" Foreground="#697480" FontSize="9" FontWeight="Bold" VerticalAlignment="Center"/><UniformGrid x:Name="AppGrid" Grid.Row="1" Columns="3" Rows="3">
      <Button x:Name="MessagesButton" Style="{StaticResource PhoneApp}" Content="●  MENSAGENS&#x0a;Central" Click="App_Click" Tag="Mensagens"/><Button Style="{StaticResource PhoneApp}" Content="▰  BANCO&#x0a;Financeiro" Click="App_Click" Tag="Banco"/><Button Style="{StaticResource PhoneApp}" Content="▤  DOCUMENTOS&#x0a;Notas" Click="App_Click" Tag="Documentos"/><Button Style="{StaticResource PhoneApp}" Content="➜  VIAGENS&#x0a;Operação" Click="App_Click" Tag="Viagens"/><Button Style="{StaticResource PhoneApp}" Content="◆  RANKING&#x0a;Desempenho" Click="App_Click" Tag="Ranking"/><Button x:Name="AlertsButton" Style="{StaticResource PhoneApp}" Content="●  ALERTAS&#x0a;Operação" Click="App_Click" Tag="Alertas"/><Button Style="{StaticResource PhoneApp}" Content="◉  PERFIL&#x0a;Motorista" Click="App_Click" Tag="Perfil"/><Button Style="{StaticResource PhoneApp}" Content="▣  GARAGEM&#x0a;Veículo" Click="App_Click" Tag="Garagem"/><Button Style="{StaticResource PhoneApp}" Content="⚙  AJUSTES&#x0a;Sistema" Click="App_Click" Tag="Ajustes"/>
     </UniformGrid></Grid>
     <Border x:Name="AppPanel" Grid.RowSpan="3" Background="#FA0A0E13" BorderBrush="#303B46" BorderThickness="1" CornerRadius="24" Padding="16" Visibility="Collapsed">
      <Grid><Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid><Button Content="‹" Width="38" Height="34" HorizontalAlignment="Left" Click="Back_Click" Background="#141A20" Foreground="#FFE08A" BorderBrush="#27313B" BorderThickness="1" FontSize="22"/><TextBlock x:Name="AppTitle" Foreground="#F7F8FA" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/><TextBlock Text="TRANSPOLI" Foreground="#6C7580" FontSize="8" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid><ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="AppContent"/></ScrollViewer></Grid>
     </Border>
    </Grid>
    <Grid Grid.Row="2" Margin="22,0">
 <Border Height="38" CornerRadius="19" Background="#E611171D" BorderBrush="#27313B" BorderThickness="1" VerticalAlignment="Center">
  <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
   <Button Grid.Column="0" Content="⌂" Tag="Home" Click="Dock_Click" Background="Transparent" Foreground="#FFE08A" BorderThickness="0" FontSize="17" Cursor="Hand"/>
   <Button Grid.Column="1" Content="➜" Tag="Viagens" Click="Dock_Click" Background="Transparent" Foreground="#C8D0D9" BorderThickness="0" FontSize="15" Cursor="Hand"/>
   <Button Grid.Column="2" Content="▰" Tag="Banco" Click="Dock_Click" Background="Transparent" Foreground="#C8D0D9" BorderThickness="0" FontSize="15" Cursor="Hand"/>
   <Button Grid.Column="3" Content="◉" Tag="Perfil" Click="Dock_Click" Background="Transparent" Foreground="#C8D0D9" BorderThickness="0" FontSize="15" Cursor="Hand"/>
  </Grid>
 </Border>
</Grid>
   </Grid>
  </Border>
 </Border>
</Window>