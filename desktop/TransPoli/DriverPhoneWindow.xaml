<Window x:Class="TransPoli.DriverPhoneWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="TransPoli • Celular" Width="390" Height="760" WindowStyle="None" AllowsTransparency="True"
 Background="Transparent" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" WindowStartupLocation="CenterScreen">
 <Border Margin="12" CornerRadius="42" Background="#05070A" BorderBrush="#3A4652" BorderThickness="2" Padding="9">
  <Border CornerRadius="34" Background="#090D12" BorderBrush="#171E25" BorderThickness="1">
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/><RowDefinition Height="54"/></Grid.RowDefinitions>
    <Grid Grid.Row="0" Margin="18,0">
     <TextBlock x:Name="ClockText" Text="12:00" Foreground="#F7F8FA" FontWeight="SemiBold" VerticalAlignment="Center"/>
     <Border Width="94" Height="25" CornerRadius="13" Background="#020304" HorizontalAlignment="Center" VerticalAlignment="Center"/>
     <TextBlock Text="▂▄▆█  100%" Foreground="#C8D0D9" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"/>
    </Grid>
    <Grid Grid.Row="1" Margin="22,10,22,14">
     <Grid.RowDefinitions><RowDefinition Height="150"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <StackPanel>
      <TextBlock Text="TRANSPOLI" Foreground="#FFE08A" FontSize="13" FontWeight="Bold"/>
      <TextBlock Text="Olá, motorista." Foreground="#F7F8FA" FontSize="27" FontWeight="SemiBold" Margin="0,7,0,0"/>
      <TextBlock Text="Seu celular operacional" Foreground="#929BA7" FontSize="12" Margin="0,3,0,0"/>
      <Border Background="#10161D" BorderBrush="#27313B" BorderThickness="1" CornerRadius="15" Padding="13" Margin="0,16,0,0">
       <Grid><TextBlock Text="●  TRANSPOLI CONECTADO" Foreground="#4EE59B" FontSize="11" FontWeight="Bold"/>
       <TextBlock Text="F9 fecha o celular" Foreground="#929BA7" FontSize="10" HorizontalAlignment="Right"/></Grid>
      </Border>
     </StackPanel>
     <UniformGrid Grid.Row="1" Columns="3" Rows="3" Margin="0,16,0,0">
      <Button Style="{StaticResource PhoneApp}" Content="💬&#x0a;Mensagens" Click="App_Click" Tag="Mensagens"/>
      <Button Style="{StaticResource PhoneApp}" Content="💳&#x0a;Banco" Click="App_Click" Tag="Banco"/>
      <Button Style="{StaticResource PhoneApp}" Content="📄&#x0a;Documentos" Click="App_Click" Tag="Documentos"/>
      <Button Style="{StaticResource PhoneApp}" Content="🚚&#x0a;Viagens" Click="App_Click" Tag="Viagens"/>
      <Button Style="{StaticResource PhoneApp}" Content="🏆&#x0a;Ranking" Click="App_Click" Tag="Ranking"/>
      <Button Style="{StaticResource PhoneApp}" Content="🔔&#x0a;Alertas" Click="App_Click" Tag="Alertas"/>
      <Button Style="{StaticResource PhoneApp}" Content="👤&#x0a;Perfil" Click="App_Click" Tag="Perfil"/>
      <Button Style="{StaticResource PhoneApp}" Content="🛠&#x0a;Garagem" Click="App_Click" Tag="Garagem"/>
      <Button Style="{StaticResource PhoneApp}" Content="⚙&#x0a;Ajustes" Click="App_Click" Tag="Ajustes"/>
     </UniformGrid>
    <Border x:Name="AppPanel" Grid.Row="1" Margin="22,10,22,14" Background="#0D1319" BorderBrush="#27313B" BorderThickness="1" CornerRadius="22" Padding="18" Visibility="Collapsed"><Grid><Grid.RowDefinitions><RowDefinition Height="46"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid><Button Content="‹" Width="38" Height="34" HorizontalAlignment="Left" Click="Back_Click" Background="#141A20" Foreground="#FFE08A" BorderThickness="0"/><TextBlock x:Name="AppTitle" Text="APP" Foreground="#F7F8FA" FontSize="17" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid><StackPanel Grid.Row="1" VerticalAlignment="Center"><TextBlock x:Name="AppStatus" Text="" Foreground="#FFE08A" FontSize="15" FontWeight="SemiBold" TextAlignment="Center"/><TextBlock x:Name="AppDescription" Text="" Foreground="#929BA7" FontSize="12" TextWrapping="Wrap" TextAlignment="Center" Margin="10,12,10,0"/></StackPanel></Grid></Border>
    </Grid>
    <Grid Grid.Row="2"><Border Width="112" Height="5" CornerRadius="3" Background="#AEB6C0" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
   </Grid>
  </Border>
 </Border>
 <Window.Resources>
  <Style x:Key="PhoneApp" TargetType="Button">
   <Setter Property="Margin" Value="6"/><Setter Property="Background" Value="#10161D"/><Setter Property="Foreground" Value="#F7F8FA"/>
   <Setter Property="BorderBrush" Value="#27313B"/><Setter Property="BorderThickness" Value="1"/><Setter Property="FontSize" Value="12"/>
   <Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="4"/>
  </Style>
 </Window.Resources>
</Window>