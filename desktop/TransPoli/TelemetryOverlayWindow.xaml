<Window x:Class="TransPoli.TelemetryOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="1880" Height="86"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
        ShowActivated="False">
    <Border x:Name="HudShell" Margin="6" CornerRadius="16" Background="#F807090C" BorderBrush="#D6A52A" BorderThickness="1.2">
        <Grid x:Name="HudRoot" Margin="18,5,18,5">
            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="0"/></Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="500"/>
            </Grid.ColumnDefinitions>

            <StackPanel x:Name="IdentityPanel" Grid.Column="0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="30" Height="30" CornerRadius="8" Background="#FFD8A92E" BorderBrush="#FFE19A" BorderThickness="1" Margin="0,0,7,0">
                        <TextBlock Text="TP" Foreground="#081016" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="TRANSPOLI" Foreground="#D6A52A" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock x:Name="StateText" Text="  •  EM VIAGEM" Foreground="#54D99B" FontSize="11" FontWeight="Bold" Margin="12,1,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock Text="KM " Foreground="#8E9AA8" FontSize="11" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TripKmText" Text="0.0" Foreground="#F5F7FA" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Text="  •  ODO " Foreground="#8E9AA8" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="OdometerText" Text="0.0" Foreground="#F5F7FA" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>

            <StackPanel x:Name="RoutePanel" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="26,0">
                <TextBlock x:Name="RouteText" Text="Aguardando viagem" Foreground="#F5F7FA" FontSize="13" FontWeight="SemiBold" TextAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="CompaniesText" Text="" Foreground="#8E9AA8" FontSize="10" TextAlignment="Center" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                <Grid x:Name="ProgressTrack" Margin="0,4,0,0" Height="3">
                    <Border Background="#202A33" CornerRadius="4"/>
                    <Border x:Name="ProgressFill" HorizontalAlignment="Left" Background="#E2B84A" CornerRadius="3" Width="0"/>
                </Grid>
            </StackPanel>

            <Border x:Name="TelemetryClusterShell" Grid.Column="2" VerticalAlignment="Center" Background="#B30E1217" BorderBrush="#27313B" BorderThickness="1" CornerRadius="9" Padding="12,4">
            <Grid x:Name="TelemetryPanel">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="165"/>
                    <ColumnDefinition Width="165"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="VELOCIDADE" Foreground="#8E9AA8" FontSize="10" FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                        <TextBlock x:Name="SpeedText" Text="0" Foreground="#F5F7FA" FontSize="16" FontWeight="Bold"/>
                        <TextBlock x:Name="SpeedUnitText" Text=" KM/H" Foreground="#8E9AA8" FontSize="9" FontWeight="Bold" Margin="3,0,0,4"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="RPM" Foreground="#8E9AA8" FontSize="11"/>
                    <TextBlock x:Name="GearClusterText" Text="N" Foreground="#FFD45A" FontSize="24" FontWeight="Bold"/>
                    <TextBlock x:Name="RpmText" Text="0" Foreground="#F5F7FA" FontSize="17" FontWeight="SemiBold"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="AUTONOMIA" Foreground="#8E9AA8" FontSize="11"/>
                    <TextBlock x:Name="FuelClusterText" Text="0 L" Foreground="#F5F7FA" FontSize="20" FontWeight="Bold"/>
                    <TextBlock x:Name="RangeText" Text="0 km" Foreground="#F5F7FA" FontSize="26" FontWeight="SemiBold"/>
                </StackPanel>
            </Grid>
            </Border>
            <StackPanel x:Name="OperationPanel" Grid.Row="1" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,0">
                <TextBlock x:Name="OperationalText" Text="AGUARDANDO OPERAÇÃO" Foreground="#FFE19A" FontSize="10" FontWeight="Bold" Margin="0,0,18,0"/>
                <TextBlock x:Name="EtaText" Text="ETA —" Foreground="#C8D0D9" FontSize="10" Margin="0,0,18,0"/>
                <TextBlock x:Name="FuelText" Text="COMBUSTÍVEL —" Foreground="#C8D0D9" FontSize="13" Margin="0,0,28,0"/>
                <TextBlock x:Name="GearText" Text="MARCHA —" Foreground="#C8D0D9" FontSize="11"/>
            </StackPanel>
            <StackPanel x:Name="FooterPanel" Grid.Row="2" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,3,0,0">
                <TextBlock x:Name="ConnectionText" Text="● ETS2 CONECTADO" Foreground="#54D99B" FontSize="11" FontWeight="Bold" Margin="0,0,14,0"/>
                <TextBlock x:Name="FinanceText" Text="RECEITA R$ 0,00  •  DESPESAS R$ 0,00  •  LÍQUIDO R$ 0,00" Foreground="#C8D0D9" FontSize="11"/>
            </StackPanel>
            <Border x:Name="EventPopup" Grid.Row="0" Grid.RowSpan="3" Grid.ColumnSpan="3" Panel.ZIndex="20" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" Background="#F20B1117" BorderBrush="#FFD8A92E" BorderThickness="1" CornerRadius="10" Padding="16,8">
                <TextBlock x:Name="EventText" Text="" Foreground="#FFFFFF" FontSize="12" FontWeight="Bold"/>
            </Border>
        </Grid>
    </Border>
</Window>