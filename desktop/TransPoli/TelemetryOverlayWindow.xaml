<Window x:Class="TransPoli.TelemetryOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="1880" Height="72"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
        ShowActivated="False">
    <Border x:Name="HudShell" Margin="5,3" CornerRadius="9"
            Background="#E9080D13" BorderBrush="#34414D" BorderThickness="1">
        <Grid x:Name="HudRoot" Margin="12,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="760"/>
            </Grid.ColumnDefinitions>

            <!-- IDENTIFICAÇÃO DO CONJUNTO -->
            <Grid x:Name="IdentityPanel" Grid.Column="0" VerticalAlignment="Center" Margin="2,0,12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="34"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Width="28" Height="28" CornerRadius="6" Background="#D6A52A"
                        VerticalAlignment="Center" HorizontalAlignment="Left">
                    <TextBlock Text="TP" Foreground="#071018" FontSize="12" FontWeight="Black"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="TRANSPOLI" Foreground="#D6A52A" FontSize="8" FontWeight="Bold"/>
                    <TextBlock x:Name="TruckText" Text="AGUARDANDO CAMINHÃO" Foreground="#F4F7FA"
                               FontSize="11" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <TextBlock x:Name="StateText" Text="● AGUARDANDO" Foreground="#9AA6B2" FontSize="8" FontWeight="Bold"/>
                        <TextBlock Text="  •  KM" Foreground="#788592" FontSize="8"/>
                        <TextBlock x:Name="TripKmText" Text="0.0" Foreground="#F4F7FA" FontSize="9" FontWeight="Bold"/>
                        <TextBlock Text="  ODO" Foreground="#788592" FontSize="8"/>
                        <TextBlock x:Name="OdometerText" Text="0.0" Foreground="#F4F7FA" FontSize="9" FontWeight="Bold"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- CARGA E ROTA -->
            <Grid x:Name="RoutePanel" Grid.Column="1" VerticalAlignment="Center" Margin="10,0,14,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="RouteText" Text="Aguardando rota do jogo" Foreground="#F4F7FA"
                           FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,2,0,0">
                    <TextBlock Text="CARGA " Foreground="#E7B84A" FontSize="8" FontWeight="Bold"/>
                    <TextBlock x:Name="CargoText" Text="SEM CONTRATO" Foreground="#C8D1DA"
                               FontSize="9" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="CompaniesText" Text="" Foreground="#8E9AA8"
                               FontSize="8" Visibility="Collapsed"/>
                </StackPanel>
                <Grid x:Name="ProgressTrack" Grid.Row="2" Height="2" Margin="0,4,0,0">
                    <Border Background="#27323D" CornerRadius="2"/>
                    <Border x:Name="ProgressFill" HorizontalAlignment="Left" Background="#D6A52A"
                            CornerRadius="2" Width="0"/>
                </Grid>
                <TextBlock x:Name="RestText" Grid.Row="2" Text="DESCANSO —"
                           Foreground="#9AA6B2" FontSize="8" HorizontalAlignment="Right"
                           VerticalAlignment="Bottom" Margin="0,0,0,3"/>
            </Grid>

            <!-- INSTRUMENTOS: VELOCIDADE, MOTOR, COMBUSTÍVEL E DANOS -->
            <Border x:Name="TelemetryClusterShell" Grid.Column="2" VerticalAlignment="Stretch"
                    Background="#A90E151D" BorderBrush="#2A3743" BorderThickness="1"
                    CornerRadius="7" Padding="8,3">
                <Grid x:Name="TelemetryPanel">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="145"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="190"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="VELOCIDADE" Foreground="#8997A5" FontSize="7.5" FontWeight="Bold"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="SpeedText" Text="—" Foreground="#35C7F4" FontSize="23" FontWeight="Bold"/>
                            <StackPanel VerticalAlignment="Center" Margin="5,0,0,0">
                                <TextBlock x:Name="SpeedUnitText" Text="MPH" Foreground="#B7C2CD" FontSize="8" FontWeight="Bold"/>
                                <TextBlock x:Name="SpeedLimitText" Text="VIA —" Foreground="#E7B84A" FontSize="8" FontWeight="SemiBold"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="MARCHA / MOTOR" Foreground="#8997A5" FontSize="7.5" FontWeight="Bold"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="GearClusterText" Text="N" Foreground="#E7B84A" FontSize="19" FontWeight="Bold" Margin="0,0,9,0"/>
                            <TextBlock x:Name="RpmText" Text="— RPM" Foreground="#F4F7FA" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="CruiseText" Text="CRUISE —" Foreground="#8E9AA8" FontSize="8" FontWeight="Bold"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="COMBUSTÍVEL" Foreground="#8997A5" FontSize="7.5" FontWeight="Bold"/>
                        <TextBlock x:Name="FuelClusterText" Text="— L" Foreground="#F4F7FA" FontSize="15" FontWeight="Bold"/>
                        <TextBlock x:Name="RangeText" Text="AUTONOMIA —" Foreground="#8E9AA8" FontSize="8.5" FontWeight="SemiBold"/>
                    </StackPanel>

                    <StackPanel x:Name="MechanicalPanel" Grid.Column="3" VerticalAlignment="Center">
                        <TextBlock Text="TEMPERATURA / PRESSÃO" Foreground="#8997A5" FontSize="7.5" FontWeight="Bold"/>
                        <TextBlock x:Name="TemperatureText" Text="ÁGUA — °C" Foreground="#F4F7FA" FontSize="9" FontWeight="SemiBold"/>
                        <StackPanel x:Name="ExtendedMechanicalPanel" Orientation="Horizontal" Margin="0,3,0,0">
                            <TextBlock x:Name="OilText" Text="ÓLEO —" Foreground="#AAB5C0" FontSize="8" Margin="0,0,7,0"/>
                            <TextBlock x:Name="AirPressureText" Text="AR —" Foreground="#AAB5C0" FontSize="8"/>
                        </StackPanel>
                        <TextBlock x:Name="BatteryText" Text="BAT — V" Foreground="#8997A5" FontSize="7.5"/>
                        <TextBlock x:Name="AdBlueText" Text="ADBLUE — L" Foreground="#8997A5" FontSize="7.5"/>
                    </StackPanel>

                    <StackPanel Grid.Column="4" VerticalAlignment="Center" Margin="10,0,0,0">
                        <TextBlock Text="DANOS / CONJUNTO" Foreground="#8997A5" FontSize="7.5" FontWeight="Bold"/>
                        <TextBlock x:Name="DamageText" Text="MOTOR — • CABINE — • CHASSI —"
                                   Foreground="#C8D1DA" FontSize="8.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="TrailerText" Text="REBOQUE —" Foreground="#8E9AA8" FontSize="8"/>
                        <TextBlock x:Name="ConnectionText" Text="● SEM JOGO" Foreground="#8E9AA8" FontSize="8" FontWeight="Bold"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- CONTROLES/INFORMAÇÕES LEGADAS MANTIDOS PARA COMPATIBILIDADE COM AS CONFIGURAÇÕES -->
            <StackPanel x:Name="OperationPanel" Grid.Column="1" Visibility="Collapsed">
                <TextBlock x:Name="OperationalText" Text="DISPONÍVEL"/>
                <TextBlock x:Name="EtaText" Text="ETA —"/>
                <TextBlock x:Name="FinanceText" Text=""/>
                <TextBlock x:Name="FuelText" Text=""/>
                <TextBlock x:Name="GearText" Text=""/>
            </StackPanel>

            <Border x:Name="EventPopup" Grid.ColumnSpan="3" Panel.ZIndex="20"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="Collapsed" Background="#F20B1117"
                    BorderBrush="#FFD8A92E" BorderThickness="1" CornerRadius="8" Padding="16,7">
                <TextBlock x:Name="EventText" Text="" Foreground="#FFFFFF" FontSize="12" FontWeight="Bold"/>
            </Border>
        </Grid>
    </Border>
</Window>