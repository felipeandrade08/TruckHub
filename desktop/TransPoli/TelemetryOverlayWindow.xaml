<Window x:Class="TransPoli.TelemetryOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="1120" Height="128"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
        ShowActivated="False">
    <Border Margin="8" CornerRadius="20" Background="#F2080C11" BorderBrush="#9A7824" BorderThickness="1.4">
        <Grid Margin="18,11">
            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="290"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="270"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="20" Height="20" CornerRadius="6" Background="#FFD8A92E" Margin="0,0,7,0">
                        <TextBlock Text="TP" Foreground="#081016" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="TRANSPOLI" Foreground="#FFE19A" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock x:Name="StateText" Text=" • EM VIAGEM" Foreground="#54D99B" FontSize="11" FontWeight="Bold" Margin="6,1,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                    <TextBlock Text="KM " Foreground="#8E9AA8" FontSize="11" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TripKmText" Text="0.0" Foreground="#F5F7FA" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Text="  •  ODO " Foreground="#8E9AA8" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="OdometerText" Text="0.0" Foreground="#F5F7FA" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Width="500">
                <TextBlock x:Name="RouteText" Text="Aguardando viagem" Foreground="#F5F7FA" FontSize="13" FontWeight="Bold" TextAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="CompaniesText" Text="" Foreground="#8E9AA8" FontSize="11" TextAlignment="Center" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                <Grid Margin="0,7,0,0" Height="7">
                    <Border Background="#26313D" CornerRadius="4"/>
                    <Border x:Name="ProgressFill" HorizontalAlignment="Left" Background="#D8A92E" CornerRadius="3" Width="0"/>
                </Grid>
            </StackPanel>

            <Grid Grid.Column="2" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="86"/>
                    <ColumnDefinition Width="86"/>
                    <ColumnDefinition Width="98"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="VELOCIDADE" Foreground="#8E9AA8" FontSize="11"/>
                    <TextBlock x:Name="SpeedText" Text="0 km/h" Foreground="#F5F7FA" FontSize="15" FontWeight="Bold"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="RPM" Foreground="#8E9AA8" FontSize="11"/>
                    <TextBlock x:Name="RpmText" Text="0" Foreground="#F5F7FA" FontSize="15" FontWeight="Bold"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="AUTONOMIA" Foreground="#8E9AA8" FontSize="11"/>
                    <TextBlock x:Name="RangeText" Text="0 km" Foreground="#F5F7FA" FontSize="15" FontWeight="Bold"/>
                </StackPanel>
            </Grid>
            <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,1">
                <TextBlock x:Name="OperationalText" Text="AGUARDANDO OPERAÇÃO" Foreground="#FFE19A" FontSize="11" FontWeight="Bold" Margin="0,0,14,0"/>
                <TextBlock x:Name="EtaText" Text="ETA —" Foreground="#C8D0D9" FontSize="11" Margin="0,0,14,0"/>
                <TextBlock x:Name="FuelText" Text="COMBUSTÍVEL —" Foreground="#C8D0D9" FontSize="11" Margin="0,0,14,0"/>
                <TextBlock x:Name="GearText" Text="MARCHA —" Foreground="#C8D0D9" FontSize="11"/>
            </StackPanel>
            <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5,0,0">
                <TextBlock x:Name="ConnectionText" Text="● ETS2 CONECTADO" Foreground="#54D99B" FontSize="11" FontWeight="Bold" Margin="0,0,14,0"/>
                <TextBlock x:Name="FinanceText" Text="RECEITA R$ 0,00  •  DESPESAS R$ 0,00  •  LÍQUIDO R$ 0,00" Foreground="#C8D0D9" FontSize="11"/>
            </StackPanel>
            <Border x:Name="EventPopup" Grid.Row="0" Grid.RowSpan="3" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" Background="#F20B1117" BorderBrush="#FFD8A92E" BorderThickness="1" CornerRadius="14" Padding="18,9">
                <TextBlock x:Name="EventText" Text="" Foreground="#FFFFFF" FontSize="12" FontWeight="Bold"/>
            </Border>
        </Grid>
    </Border>
</Window>