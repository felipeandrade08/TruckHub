<Window x:Class="TransPoli.TelemetryOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="2040" Height="154"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
        ShowActivated="False">
    <Border x:Name="HudShell" Margin="8" CornerRadius="18" Background="#F807090C" BorderBrush="#D6A52A" BorderThickness="1.2">
        <Grid x:Name="HudRoot" Margin="52,18,48,16">
            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="430"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="650"/>
            </Grid.ColumnDefinitions>

            <StackPanel x:Name="IdentityPanel" Grid.Column="0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="38" Height="38" CornerRadius="10" Background="#FFD8A92E" BorderBrush="#FFE19A" BorderThickness="1" Margin="0,0,7,0">
                        <TextBlock Text="TP" Foreground="#081016" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="TRANSPOLI" Foreground="#D6A52A" FontSize="24" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock x:Name="StateText" Text="  •  EM VIAGEM" Foreground="#54D99B" FontSize="11" FontWeight="Bold" Margin="12,1,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBlock Text="KM " Foreground="#8E9AA8" FontSize="11" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TripKmText" Text="0.0" Foreground="#F5F7FA" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Text="  •  ODO " Foreground="#8E9AA8" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="OdometerText" Text="0.0" Foreground="#F5F7FA" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>

            <StackPanel x:Name="RoutePanel" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Width="720">
                <TextBlock x:Name="RouteText" Text="Aguardando viagem" Foreground="#F5F7FA" FontSize="20" FontWeight="SemiBold" TextAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="CompaniesText" Text="" Foreground="#8E9AA8" FontSize="13" TextAlignment="Center" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
                <Grid Margin="0,10,0,0" Height="6">
                    <Border Background="#202A33" CornerRadius="4"/>
                    <Border x:Name="ProgressFill" HorizontalAlignment="Left" Background="#E2B84A" CornerRadius="3" Width="0"/>
                </Grid>
            </StackPanel>

            <Grid x:Name="TelemetryPanel" Grid.Column="2" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="210"/>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="220"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="VELOCIDADE" Foreground="#8E9AA8" FontSize="13"/>
                    <TextBlock x:Name="SpeedText" Text="0 km/h" Foreground="#F5F7FA" FontSize="26" FontWeight="SemiBold"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="RPM" Foreground="#8E9AA8" FontSize="11"/>
                    <TextBlock x:Name="RpmText" Text="0" Foreground="#F5F7FA" FontSize="26" FontWeight="SemiBold"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="AUTONOMIA" Foreground="#8E9AA8" FontSize="11"/>
                    <TextBlock x:Name="RangeText" Text="0 km" Foreground="#F5F7FA" FontSize="26" FontWeight="SemiBold"/>
                </StackPanel>
            </Grid>
            <StackPanel x:Name="OperationPanel" Grid.Row="1" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                <TextBlock x:Name="OperationalText" Text="AGUARDANDO OPERAÇÃO" Foreground="#FFE19A" FontSize="13" FontWeight="Bold" Margin="0,0,28,0"/>
                <TextBlock x:Name="EtaText" Text="ETA —" Foreground="#C8D0D9" FontSize="13" Margin="0,0,28,0"/>
                <TextBlock x:Name="FuelText" Text="COMBUSTÍVEL —" Foreground="#C8D0D9" FontSize="13" Margin="0,0,28,0"/>
                <TextBlock x:Name="GearText" Text="MARCHA —" Foreground="#C8D0D9" FontSize="11"/>
            </StackPanel>
            <StackPanel x:Name="FooterPanel" Grid.Row="2" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5,0,0">
                <TextBlock x:Name="ConnectionText" Text="● ETS2 CONECTADO" Foreground="#54D99B" FontSize="11" FontWeight="Bold" Margin="0,0,14,0"/>
                <TextBlock x:Name="FinanceText" Text="RECEITA R$ 0,00  •  DESPESAS R$ 0,00  •  LÍQUIDO R$ 0,00" Foreground="#C8D0D9" FontSize="11"/>
            </StackPanel>
            <Border x:Name="EventPopup" Grid.Row="0" Grid.RowSpan="3" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" Background="#F20B1117" BorderBrush="#FFD8A92E" BorderThickness="1" CornerRadius="14" Padding="18,9">
                <TextBlock x:Name="EventText" Text="" Foreground="#FFFFFF" FontSize="12" FontWeight="Bold"/>
            </Border>
        </Grid>
    </Border>
</Window>