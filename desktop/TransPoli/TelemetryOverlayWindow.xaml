<Window x:Class="TransPoli.TelemetryOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="1880" Height="78"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
        ShowActivated="False" FontFamily="Segoe UI">

    <Window.Resources>
        <!-- Painel escuro com borda fina: base dos 4 blocos da HUD -->
        <Style x:Key="PanelStyle" TargetType="Border">
            <Setter Property="Background" Value="#E9080D13"/>
            <Setter Property="BorderBrush" Value="#2E3B48"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
        <Style x:Key="Ico" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Emoji"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
        </Style>
        <Style x:Key="Lbl" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8997A5"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
        </Style>
        <Style x:Key="Val" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F4F7FA"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="Sep" TargetType="TextBlock">
            <Setter Property="Text" Value="|"/>
            <Setter Property="Foreground" Value="#3A4652"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="8,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Group" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Margin" Value="0,0,18,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid x:Name="HudShell" Margin="5,3">
        <Grid x:Name="HudRoot">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="5*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- ESQUERDA: caminhão, carga, descanso, distância e ETA -->
            <Border x:Name="LeftPanel" Grid.Column="0" Style="{StaticResource PanelStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="1"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="ConnectionText" Text="●" Foreground="#6B7785" FontSize="9"
                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <StackPanel Style="{StaticResource Group}">
                            <TextBlock Style="{StaticResource Ico}" Text="🚚"/>
                            <TextBlock Style="{StaticResource Lbl}" Text="Caminhão:"/>
                            <TextBlock x:Name="TruckText" Style="{StaticResource Val}" MaxWidth="220" Text="Aguardando caminhão"/>
                        </StackPanel>
                        <StackPanel x:Name="CargoGroup" Style="{StaticResource Group}">
                            <TextBlock Style="{StaticResource Ico}" Text="📦"/>
                            <TextBlock Style="{StaticResource Lbl}" Text="Carga:"/>
                            <TextBlock x:Name="CargoText" Style="{StaticResource Val}" MaxWidth="240" Text="Sem contrato"/>
                        </StackPanel>
                    </StackPanel>

                    <Border Grid.Row="1" Background="#1E2833"/>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel x:Name="RestGroup" Style="{StaticResource Group}">
                            <TextBlock Style="{StaticResource Ico}" Text="🛏"/>
                            <TextBlock Style="{StaticResource Lbl}" Text="Descanso:"/>
                            <TextBlock x:Name="RestText" Style="{StaticResource Val}" Foreground="#E7B84A" Text="—"/>
                        </StackPanel>
                        <StackPanel x:Name="RemainGroup" Style="{StaticResource Group}">
                            <TextBlock Style="{StaticResource Ico}" Text="📏"/>
                            <TextBlock Style="{StaticResource Lbl}" Text="Faltam:"/>
                            <TextBlock x:Name="RemainingText" Style="{StaticResource Val}" Foreground="#4DA8FF" Text="—"/>
                        </StackPanel>
                        <StackPanel x:Name="EtaGroup" Style="{StaticResource Group}">
                            <TextBlock Style="{StaticResource Ico}" Text="🕒"/>
                            <TextBlock Style="{StaticResource Lbl}" Text="Real ETA:"/>
                            <TextBlock x:Name="EtaText" Style="{StaticResource Val}" Foreground="#B58CFF" Text="—"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- CENTRO: velocidade em destaque, marcha e temperaturas -->
            <Border x:Name="CenterPanel" Grid.Column="1" Style="{StaticResource PanelStyle}"
                    Background="#F00B1118" BorderBrush="#3F5C70" Padding="18,2">
                <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="⚡" Foreground="#F5A524" FontFamily="Segoe UI Emoji" FontSize="17"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock x:Name="SpeedText" Text="—" Foreground="#35C7F4" FontSize="26"
                                   FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock x:Name="SpeedUnitText" Text="km/h" Foreground="#B7C2CD" FontSize="11"
                                   FontWeight="SemiBold" VerticalAlignment="Center" Margin="5,5,0,0"/>
                        <TextBlock x:Name="SpeedLimitText" Text="" Foreground="#E7B84A" FontSize="10.5"
                                   VerticalAlignment="Center" Margin="8,5,0,0"/>
                        <Border x:Name="GearBadge" Margin="12,0,0,0" Background="#151D26" BorderBrush="#3A4652"
                                BorderThickness="1" CornerRadius="5" Padding="8,1" VerticalAlignment="Center">
                            <TextBlock x:Name="GearClusterText" Text="N" Foreground="#E7B84A" FontSize="13" FontWeight="Bold"/>
                        </Border>
                        <TextBlock x:Name="RpmText" Text="" Foreground="#AAB5C0" FontSize="10.5"
                                   VerticalAlignment="Center" Margin="10,5,0,0"/>
                        <TextBlock x:Name="CruiseText" Text="" Foreground="#4EE59B" FontSize="10.5" FontWeight="Bold"
                                   VerticalAlignment="Center" Margin="10,5,0,0" Visibility="Collapsed"/>
                    </StackPanel>

                    <StackPanel x:Name="TempRow" Grid.Row="1" Orientation="Horizontal"
                                HorizontalAlignment="Center" Margin="0,3,0,0">
                        <StackPanel x:Name="WaterItem" Margin="0,0,18,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Ico}" Text="🌡"/>
                                <TextBlock Style="{StaticResource Lbl}" Text="Água:"/>
                                <TextBlock x:Name="WaterText" Style="{StaticResource Val}" FontSize="10.5" Text="—"/>
                            </StackPanel>
                            <Grid Width="104" Height="3" Margin="0,2,0,0" HorizontalAlignment="Left">
                                <Border Background="#243040" CornerRadius="2"/>
                                <Border x:Name="WaterBar" HorizontalAlignment="Left" Width="0" CornerRadius="2" Background="#4EE59B"/>
                            </Grid>
                        </StackPanel>
                        <StackPanel x:Name="BrakeItem" Margin="0,0,18,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Ico}" Text="🛑"/>
                                <TextBlock Style="{StaticResource Lbl}" Text="Freios:"/>
                                <TextBlock x:Name="BrakeText" Style="{StaticResource Val}" FontSize="10.5" Text="—"/>
                            </StackPanel>
                            <Grid Width="104" Height="3" Margin="0,2,0,0" HorizontalAlignment="Left">
                                <Border Background="#243040" CornerRadius="2"/>
                                <Border x:Name="BrakeBar" HorizontalAlignment="Left" Width="0" CornerRadius="2" Background="#4EE59B"/>
                            </Grid>
                        </StackPanel>
                        <StackPanel x:Name="FuelItem" Orientation="Horizontal" VerticalAlignment="Top">
                            <TextBlock Style="{StaticResource Ico}" Text="⛽"/>
                            <TextBlock x:Name="FuelClusterText" Style="{StaticResource Val}" FontSize="10.5" Text="— L"/>
                            <TextBlock x:Name="RangeText" Style="{StaticResource Lbl}" Margin="6,0,0,0" Text=""/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- DIREITA: rota, frete, prazo, mercado e danos -->
            <Border x:Name="RightPanel" Grid.Column="2" Style="{StaticResource PanelStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="2"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel x:Name="RouteGroup" Style="{StaticResource Group}">
                            <TextBlock Style="{StaticResource Ico}" Text="📍"/>
                            <TextBlock x:Name="RouteText" Style="{StaticResource Val}" FontWeight="Bold" MaxWidth="380"
                                       Text="Aguardando rota do jogo"/>
                        </StackPanel>
                        <StackPanel x:Name="ValueGroup" Style="{StaticResource Group}">
                            <TextBlock Style="{StaticResource Ico}" Text="💰"/>
                            <TextBlock x:Name="ValueText" Style="{StaticResource Val}" Foreground="#E7B84A" Text="—"/>
                        </StackPanel>
                        <StackPanel x:Name="DeadlineGroup" Style="{StaticResource Group}">
                            <TextBlock Style="{StaticResource Ico}" Text="⌛"/>
                            <TextBlock x:Name="DeadlineText" Style="{StaticResource Val}" Text="—"/>
                        </StackPanel>
                        <Border x:Name="MarketBadge" Background="#22D6A52A" BorderBrush="#D6A52A" BorderThickness="1"
                                CornerRadius="4" Padding="8,1" VerticalAlignment="Center" Visibility="Collapsed">
                            <TextBlock x:Name="MarketText" Foreground="#E7B84A" FontSize="9.5" FontWeight="Bold" Text=""/>
                        </Border>
                    </StackPanel>

                    <!-- Separador que também funciona como barra de progresso da viagem -->
                    <Grid x:Name="ProgressTrack" Grid.Row="1" Height="2">
                        <Border Background="#1E2833"/>
                        <Border x:Name="ProgressFill" HorizontalAlignment="Left" Background="#D6A52A" Width="0"/>
                    </Grid>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Ico}" Text="🛡"/>
                        <TextBlock Style="{StaticResource Lbl}" Foreground="#4DA8FF" FontWeight="SemiBold" Text="Danos —"/>
                        <TextBlock Style="{StaticResource Lbl}" Text="Caminhão:"/>
                        <TextBlock x:Name="DmgTruckText" Style="{StaticResource Val}" Text="—"/>
                        <TextBlock Style="{StaticResource Sep}"/>
                        <TextBlock Style="{StaticResource Lbl}" Text="Reboque:"/>
                        <TextBlock x:Name="DmgTrailerText" Style="{StaticResource Val}" Text="—"/>
                        <TextBlock Style="{StaticResource Sep}"/>
                        <TextBlock Style="{StaticResource Lbl}" Text="Carga:"/>
                        <TextBlock x:Name="DmgCargoText" Style="{StaticResource Val}" Text="—"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- EXTREMO DIREITO: eixos e quilometragem -->
            <Border x:Name="AxlesPanel" Grid.Column="3" Style="{StaticResource PanelStyle}" Margin="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="1"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Ico}" Text="⚙"/>
                        <TextBlock Style="{StaticResource Lbl}" Foreground="#4DA8FF" FontWeight="SemiBold" Text="Eixos —"/>
                        <TextBlock Style="{StaticResource Lbl}" Text="Caminhão:"/>
                        <TextBlock x:Name="AxleTruckText" Style="{StaticResource Val}" Foreground="#4DA8FF" Text="—"/>
                        <TextBlock Style="{StaticResource Sep}"/>
                        <TextBlock Style="{StaticResource Lbl}" Text="Reboque:"/>
                        <TextBlock x:Name="AxleTrailerText" Style="{StaticResource Val}" Foreground="#4DA8FF" Text="—"/>
                    </StackPanel>

                    <Border Grid.Row="1" Background="#1E2833"/>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel x:Name="TripGroup" Style="{StaticResource Group}" Margin="0,0,14,0">
                            <TextBlock Style="{StaticResource Lbl}" Text="Viagem:"/>
                            <TextBlock x:Name="TripKmText" Style="{StaticResource Val}" FontSize="10.5" Text="0.0"/>
                            <TextBlock Style="{StaticResource Lbl}" Margin="3,0,0,0" Text="km"/>
                        </StackPanel>
                        <StackPanel x:Name="OdoGroup" Style="{StaticResource Group}" Margin="0">
                            <TextBlock Style="{StaticResource Lbl}" Text="ODO:"/>
                            <TextBlock x:Name="OdometerText" Style="{StaticResource Val}" FontSize="10.5" Text="0.0"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Border x:Name="EventPopup" Panel.ZIndex="20"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Visibility="Collapsed" Background="#F20B1117"
                BorderBrush="#FFD8A92E" BorderThickness="1" CornerRadius="8" Padding="16,7">
            <TextBlock x:Name="EventText" Text="" Foreground="#FFFFFF" FontSize="12" FontWeight="Bold"/>
        </Border>
    </Grid>
</Window>