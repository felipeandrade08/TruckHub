<Window x:Class="TransPoli.TelemetryOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="1880" Height="112"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
        ShowActivated="False"
        SnapsToDevicePixels="True" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
    <Window.Resources>
        <SolidColorBrush x:Key="HudText" Color="#F4F8FC"/>
        <SolidColorBrush x:Key="HudMuted" Color="#94A5B6"/>
        <SolidColorBrush x:Key="HudCyan" Color="#35C7F4"/>
        <SolidColorBrush x:Key="HudGold" Color="#F0B94B"/>
        <SolidColorBrush x:Key="HudGreen" Color="#55D6A0"/>
        <SolidColorBrush x:Key="HudStroke" Color="#344555"/>
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8FA2B4"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>
        <Style x:Key="ValueText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F4F8FC"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="MicroText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#9BAABA"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>
        <Style x:Key="HudCard" TargetType="Border">
            <Setter Property="Background" Value="#B5111B25"/>
            <Setter Property="BorderBrush" Value="#344555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Margin" Value="3,1"/>
        </Style>
    </Window.Resources>

    <Border x:Name="HudShell" Margin="5,4" CornerRadius="13"
            Background="#F0081018" BorderBrush="#3C5366" BorderThickness="1">
        <Grid x:Name="HudRoot" Margin="10,7">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="900"/>
            </Grid.ColumnDefinitions>

            <!-- IDENTIDADE: marca, caminhão, simulador e estado da viagem -->
            <Border x:Name="IdentityPanel" Grid.Column="0" Style="{StaticResource HudCard}"
                    Background="#D20C1721" BorderBrush="#40596D" Margin="0,0,7,0" Padding="10,7">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="42"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="34" Height="34" CornerRadius="9" Background="#1D3342"
                            BorderBrush="#35C7F4" BorderThickness="1" VerticalAlignment="Center">
                        <TextBlock Text="🚛" FontSize="19" HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="TRANSPOLI" Foreground="#35C7F4" FontSize="9"
                                       FontWeight="ExtraBold" />
                            <TextBlock Text="  •  COMPUTADOR DE BORDO" Foreground="#8497A8"
                                       FontSize="7.5" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="TruckText" Text="AGUARDANDO CAMINHÃO"
                                   Foreground="#F4F8FC" FontSize="12" FontWeight="Bold"
                                   TextTrimming="CharacterEllipsis" Margin="0,3,0,2"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="StateText" Text="● AGUARDANDO" Foreground="#F0B94B"
                                       FontSize="8.5" FontWeight="Bold"/>
                            <TextBlock Text="   🛣 " FontSize="8"/>
                            <TextBlock x:Name="TripUnitText" Text="KM" Foreground="#91A3B4" FontSize="8"/>
                            <TextBlock x:Name="TripKmText" Text="0.0" Foreground="#F4F8FC"
                                       FontSize="9" FontWeight="Bold" Margin="3,0,0,0"/>
                            <TextBlock Text="   ODO " Foreground="#91A3B4" FontSize="8"/>
                            <TextBlock x:Name="OdometerText" Text="0.0" Foreground="#F4F8FC"
                                       FontSize="9" FontWeight="Bold"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- VIAGEM: rota em destaque, carga e progresso -->
            <Border x:Name="RoutePanel" Grid.Column="1" Style="{StaticResource HudCard}"
                    Background="#B50D1720" Margin="0,0,7,0" Padding="13,7">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="📍" FontSize="12" Margin="0,0,7,0"/>
                        <TextBlock x:Name="RouteText" Text="Aguardando rota do jogo"
                                   Foreground="#F4F8FC" FontSize="12" FontWeight="Bold"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="📦 " FontSize="10"/>
                            <TextBlock Text="CARGA  " Foreground="#F0B94B" FontSize="8"
                                       FontWeight="Bold" VerticalAlignment="Center"/>
                            <TextBlock x:Name="CargoText" Text="SEM CONTRATO ATIVO"
                                       Foreground="#D8E1E9" FontSize="9" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            <TextBlock x:Name="CompaniesText" Text="" Foreground="#8FA2B4"
                                       FontSize="8" Visibility="Collapsed"/>
                        </StackPanel>
                        <TextBlock x:Name="EtaText" Grid.Column="1" Text="⏱ ETA —"
                                   Foreground="#9FB0BF" FontSize="8.5" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Margin="8,0,0,0"/>
                        <TextBlock x:Name="RestText" Grid.Column="2" Text="☕ DESCANSO —"
                                   Foreground="#9FB0BF" FontSize="8.5" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </Grid>
                    <Grid x:Name="ProgressTrack" Grid.Row="2" Height="4"
                          VerticalAlignment="Bottom" Margin="0,7,0,0">
                        <Border Background="#273746" CornerRadius="3"/>
                        <Border x:Name="ProgressFill" HorizontalAlignment="Left"
                                Background="#35C7F4" CornerRadius="3" Width="0"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- INSTRUMENTOS: cards independentes, leitura rápida e sem textos amontoados -->
            <Grid Grid.Column="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="178"/>
                    <ColumnDefinition Width="164"/>
                    <ColumnDefinition Width="174"/>
                    <ColumnDefinition Width="205"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource HudCard}" BorderBrush="#28617A"
                        Background="#C10B1D2A" Padding="12,7">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="⚡ VELOCIDADE" Style="{StaticResource SectionLabel}"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,1,0,0">
                            <TextBlock x:Name="SpeedText" Text="—" Foreground="#35C7F4"
                                       FontSize="29" FontWeight="ExtraBold"/>
                            <StackPanel VerticalAlignment="Center" Margin="7,0,0,0">
                                <TextBlock x:Name="SpeedUnitText" Text="KM/H" Foreground="#D7E5EF"
                                           FontSize="9" FontWeight="Bold"/>
                                <TextBlock x:Name="SpeedLimitText" Text="VIA —" Foreground="#F0B94B"
                                           FontSize="8.5" FontWeight="Bold" Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource HudCard}">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="⚙️ MOTOR / MARCHA" Style="{StaticResource SectionLabel}"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,0,1">
                            <TextBlock x:Name="GearClusterText" Text="N" Foreground="#F0B94B"
                                       FontSize="24" FontWeight="ExtraBold" Margin="0,0,10,0"/>
                            <TextBlock x:Name="RpmText" Text="— RPM" Style="{StaticResource ValueText}"/>
                        </StackPanel>
                        <TextBlock x:Name="CruiseText" Text="CRUISE —" Style="{StaticResource MicroText}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource HudCard}">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="⛽ COMBUSTÍVEL" Style="{StaticResource SectionLabel}"/>
                        <TextBlock x:Name="FuelClusterText" Text="— L" Foreground="#F4F8FC"
                                   FontSize="19" FontWeight="Bold" Margin="0,3,0,1"/>
                        <TextBlock x:Name="RangeText" Text="AUTONOMIA —" Style="{StaticResource MicroText}"/>
                    </StackPanel>
                </Border>

                <Border x:Name="MechanicalPanel" Grid.Column="3" Style="{StaticResource HudCard}">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="🌡️ TEMPERATURA / PRESSÃO" Style="{StaticResource SectionLabel}"/>
                        <TextBlock x:Name="TemperatureText" Text="ÁGUA — °C" Style="{StaticResource ValueText}" FontSize="10"/>
                        <StackPanel x:Name="ExtendedMechanicalPanel" Orientation="Horizontal" Margin="0,3,0,0">
                            <TextBlock x:Name="OilText" Text="ÓLEO —" Style="{StaticResource MicroText}" Margin="0,0,9,0"/>
                            <TextBlock x:Name="AirPressureText" Text="AR —" Style="{StaticResource MicroText}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                            <TextBlock x:Name="BatteryText" Text="BAT — V" Style="{StaticResource MicroText}" Margin="0,0,9,0"/>
                            <TextBlock x:Name="AdBlueText" Text="ADBLUE — L" Style="{StaticResource MicroText}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border x:Name="ConditionPanel" Grid.Column="4" Style="{StaticResource HudCard}" Margin="3,1,0,1">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="🛠️ CONDIÇÃO DO CONJUNTO" Style="{StaticResource SectionLabel}"/>
                        <TextBlock x:Name="DamageText" Text="MOTOR — • CABINE — • CHASSI —"
                                   Foreground="#D8E1E9" FontSize="8.5" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" Margin="0,3,0,2"/>
                        <TextBlock x:Name="TrailerText" Text="🔗 REBOQUE —"
                                   Foreground="#9FB0BF" FontSize="8" FontWeight="SemiBold"/>
                        <TextBlock x:Name="ConnectionText" Text="● SEM JOGO"
                                   Foreground="#F0B94B" FontSize="8" FontWeight="Bold" Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Elementos legados mantidos para compatibilidade com o controlador/configurações -->
            <StackPanel x:Name="OperationPanel" Grid.Column="1" Visibility="Collapsed">
                <TextBlock x:Name="OperationalText" Text="DISPONÍVEL"/>
                <TextBlock x:Name="OperationalText" Text="DISPONÍVEL"/>
                <TextBlock x:Name="FinanceText" Text=""/>
                <TextBlock x:Name="FuelText" Text=""/>
                <TextBlock x:Name="GearText" Text=""/>
            </StackPanel>

            <Border x:Name="EventPopup" Grid.ColumnSpan="3" Panel.ZIndex="20"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="Collapsed" Background="#F20B1117"
                    BorderBrush="#35C7F4" BorderThickness="1" CornerRadius="10" Padding="16,8">
                <TextBlock x:Name="EventText" Text="" Foreground="#FFFFFF"
                           FontSize="12" FontWeight="Bold"/>
            </Border>
        </Grid>
    </Border>
</Window>