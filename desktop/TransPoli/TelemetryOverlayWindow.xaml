<Window x:Class="TransPoli.TelemetryOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="1880" Height="86"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
        ShowActivated="False">
    <Border x:Name="HudShell" Margin="6" CornerRadius="16" Background="#F807090C" BorderBrush="#D6A52A" BorderThickness="1.2">
        <Grid x:Name="HudRoot" Margin="18,5,18,5">
            <Grid.RowDefinitions><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="560"/>
            </Grid.ColumnDefinitions>

            <StackPanel x:Name="IdentityPanel" Grid.Column="0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="30" Height="30" CornerRadius="8" Background="#FFD8A92E" BorderBrush="#FFE19A" BorderThickness="1" Margin="0,0,7,0">
                        <TextBlock Text="TP" Foreground="#081016" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="TRANSPOLI" Foreground="#D6A52A" FontSize="9.5" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock x:Name="StateText" Text="  •  EM VIAGEM" Foreground="#54D99B" FontSize="11" FontWeight="Bold" Margin="12,1,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock Text="KM " Foreground="#8E9AA8" FontSize="9" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TripKmText" Text="0.0" Foreground="#F5F7FA" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Text="  •  ODO " Foreground="#8E9AA8" FontSize="9" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="OdometerText" Text="0.0" Foreground="#F5F7FA" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>

            <StackPanel x:Name="RoutePanel" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="18,0,24,0">
                <TextBlock x:Name="RouteText" Text="Aguardando viagem" Foreground="#F5F7FA" FontSize="12.5" FontWeight="SemiBold" TextAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="CompaniesText" Text="" Foreground="#8E9AA8" FontSize="10" TextAlignment="Center" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"/>
                <Grid x:Name="ProgressTrack" Margin="0,5,0,0" Height="2">
                    <Border Background="#202A33" CornerRadius="4"/>
                    <Border x:Name="ProgressFill" HorizontalAlignment="Left" Background="#E2B84A" CornerRadius="3" Width="0"/>
                </Grid>
            </StackPanel>

            <Border x:Name="TelemetryClusterShell" Grid.Column="2" VerticalAlignment="Center" Background="#B30E1217" BorderBrush="#27313B" BorderThickness="1" CornerRadius="9" Padding="12,4">
            <Grid x:Name="TelemetryPanel">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="250"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="VELOCIDADE" Foreground="#8E9AA8" FontSize="8" FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                        <TextBlock x:Name="SpeedText" Text="0" Foreground="#F5F7FA" FontSize="16" FontWeight="Bold"/>
                        <TextBlock x:Name="SpeedUnitText" Text=" KM/H" Foreground="#8E9AA8" FontSize="9" FontWeight="Bold" Margin="3,0,0,4"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="MARCHA / RPM" Foreground="#8E9AA8" FontSize="8" FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="GearClusterText" Text="N" Foreground="#FFD45A" FontSize="19" FontWeight="Bold" Margin="0,0,12,0"/>
                        <TextBlock x:Name="RpmText" Text="0 RPM" Foreground="#F5F7FA" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="COMBUSTÍVEL / AUTONOMIA" Foreground="#8E9AA8" FontSize="8" FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="FuelClusterText" Text="0 L" Foreground="#F5F7FA" FontSize="14" FontWeight="Bold" Margin="0,0,10,0"/>
                        <TextBlock x:Name="RangeText" Text="— KM" Foreground="#F5F7FA" FontSize="13" FontWeight="SemiBold"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel x:Name="MechanicalPanel" Grid.Column="3" VerticalAlignment="Center">
                    <TextBlock Text="MOTOR / SISTEMAS" Foreground="#8E9AA8" FontSize="8" FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="TemperatureText" Text="ÁGUA — °C" Foreground="#F5F7FA" FontSize="9" FontWeight="SemiBold" Margin="0,0,8,0"/>
                        <TextBlock x:Name="AirPressureText" Text="AR —" Foreground="#F5F7FA" FontSize="9" FontWeight="SemiBold" Margin="0,0,8,0"/>
                        <TextBlock x:Name="CruiseText" Text="CC —" Foreground="#8E9AA8" FontSize="9" FontWeight="Bold"/>
                    </StackPanel>
                    <StackPanel x:Name="ExtendedMechanicalPanel" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,0,0">
                        <TextBlock x:Name="OilText" Text="ÓLEO —" Foreground="#8E9AA8" FontSize="8" FontWeight="SemiBold" Margin="0,0,8,0"/>
                        <TextBlock x:Name="BatteryText" Text="BAT — V" Foreground="#8E9AA8" FontSize="8" FontWeight="SemiBold" Margin="0,0,8,0"/>
                        <TextBlock x:Name="AdBlueText" Text="ADBLUE — L" Foreground="#8E9AA8" FontSize="8" FontWeight="SemiBold"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
            </Border>
            <StackPanel x:Name="OperationPanel" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,2">
                <TextBlock x:Name="OperationalText" Text="● DISPONÍVEL" Foreground="#FFE19A" FontSize="9" FontWeight="Bold" Margin="0,0,12,0"/>
                <TextBlock x:Name="EtaText" Text="ETA —" Foreground="#C8D0D9" FontSize="9" Margin="0,0,12,0"/>
                <TextBlock x:Name="FinanceText" Text="" Foreground="#54D99B" FontSize="9.5" FontWeight="SemiBold"/>
                <TextBlock x:Name="FuelText" Text="" Visibility="Collapsed"/>
                <TextBlock x:Name="GearText" Text="" Visibility="Collapsed"/>
                <TextBlock x:Name="ConnectionText" Text="" Visibility="Collapsed"/>
            </StackPanel>
            <Border x:Name="EventPopup" Grid.Row="0" Grid.RowSpan="3" Grid.ColumnSpan="3" Panel.ZIndex="20" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" Background="#F20B1117" BorderBrush="#FFD8A92E" BorderThickness="1" CornerRadius="10" Padding="16,8">
                <TextBlock x:Name="EventText" Text="" Foreground="#FFFFFF" FontSize="12" FontWeight="Bold"/>
            </Border>
        </Grid>
    </Border>
</Window>