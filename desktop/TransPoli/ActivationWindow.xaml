<Window x:Class="TransPoli.ActivationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TransPoli • Acesso" Width="620" Height="760" MinWidth="560" MinHeight="680"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" SnapsToDevicePixels="True" WindowStartupLocation="CenterScreen"
        Icon="/TransPoli;component/Assets/transpoli-logo.png">
  <Window.Resources>
    <Style x:Key="WindowButton" TargetType="Button">
      <Setter Property="Width" Value="34"/><Setter Property="Height" Value="34"/><Setter Property="Margin" Value="4,0,0,0"/>
      <Setter Property="Background" Value="#151A20"/><Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="10"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#242D36"/><Setter Property="Foreground" Value="{StaticResource Text}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Field" TargetType="Control"><Setter Property="Background" Value="#0A0F14"/><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="BorderBrush" Value="{StaticResource Stroke}"/><Setter Property="BorderThickness" Value="1"/></Style>
    <Style x:Key="LinkButton" TargetType="Button"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{StaticResource GoldBright}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="6,3"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontSize" Value="10"/></Style>
  </Window.Resources>
  <Grid Margin="18">
    <Border Background="#080C10" BorderBrush="#2A333D" BorderThickness="1" CornerRadius="30">
      <Border.Effect><DropShadowEffect BlurRadius="46" ShadowDepth="10" Opacity="0.65"/></Border.Effect>
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="62"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Background="#0D1218" CornerRadius="30,30,0,0">
          <Grid MouseLeftButtonDown="TabletDrag">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="22,0,0,0">
              <Border Width="32" Height="32" CornerRadius="10" Background="#181E25" Padding="5"><Image Source="{StaticResource BrandLogo}"/></Border>
              <TextBlock Text="TRANSPOLI" Foreground="{StaticResource Text}" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" Margin="10,0,0,0"/>
              <TextBlock Text=" / COMPUTADOR DE BORDO" Foreground="{StaticResource Muted}" FontSize="9" VerticalAlignment="Center" Margin="5,0,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0">
              <Button Style="{StaticResource WindowButton}" Content="—" Click="TabletMinimize_Click" ToolTip="Minimizar"/>
              <Button Style="{StaticResource WindowButton}" Content="×" Click="TabletClose_Click" ToolTip="Fechar"/>
            </StackPanel>
          </Grid>
        </Border>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
          <Grid Margin="52,28,52,24">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <StackPanel Grid.Row="0" HorizontalAlignment="Center">
              <Border Width="76" Height="76" CornerRadius="22" Background="#141A20" BorderBrush="#333D48" BorderThickness="1" Padding="12"><Image Source="{StaticResource BrandLogo}" Stretch="Uniform"/></Border>
              <TextBlock Text="TRANSPOLI" Foreground="{StaticResource Text}" FontSize="29" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,12,0,0"/>
              <TextBlock Text="COMPUTADOR DE BORDO • ETS2" Foreground="{StaticResource Orange}" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,2,0,0"/>
              <TextBlock Text="Acesso seguro ao seu cockpit digital." Foreground="{StaticResource Muted}" FontSize="11" HorizontalAlignment="Center" Margin="0,5,0,0"/>
            </StackPanel>
            <Border Grid.Row="1" Background="#0E1318" BorderBrush="#29343F" BorderThickness="1" CornerRadius="22" Padding="24" Margin="0,22,0,0">
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <StackPanel Grid.Row="0">
                  <TextBlock x:Name="TitleText" Text="ENTRAR NO TRANSPOLI" Foreground="{StaticResource Text}" FontSize="19" FontWeight="Bold"/>
                  <TextBlock x:Name="SubtitleText" Text="Use seu e-mail e o PIN de 6 dígitos para entrar neste computador." Foreground="{StaticResource Muted}" FontSize="10.5" Margin="0,5,0,18" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel x:Name="LoginPanel" Grid.Row="1">
                  <TextBlock Text="E-MAIL" Style="{StaticResource Label}"/>
                  <TextBox x:Name="EmailBox" Height="44" Margin="0,6,0,13" Padding="12,0" VerticalContentAlignment="Center" FontSize="14" Style="{StaticResource Field}"/>
                  <TextBlock Text="PIN DE 6 DÍGITOS" Style="{StaticResource Label}"/>
                  <PasswordBox x:Name="PinBox" Height="50" Margin="0,6,0,9" Padding="12,0" VerticalContentAlignment="Center" FontSize="21" MaxLength="6" Style="{StaticResource Field}"/>
                  <TextBlock x:Name="StatusText" Text="Pronto para entrar." Foreground="{StaticResource Muted}" FontSize="10" TextWrapping="Wrap" MinHeight="30"/>
                  <Button x:Name="ActivateButton" Height="48" Content="ENTRAR NO COCKPIT  ›" Click="ActivateButton_Click" Background="{StaticResource Orange}" Foreground="#100D06" BorderThickness="0" FontSize="12.5" FontWeight="Bold" Cursor="Hand" Margin="0,6,0,4"/>
                  <Grid Margin="0,4,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="CRIAR CONTA" Style="{StaticResource LinkButton}" Click="CreateAccount_Click" HorizontalAlignment="Left"/>
                    <Button Grid.Column="1" Content="RECUPERAR PIN" Style="{StaticResource LinkButton}" Click="RecoverPin_Click" HorizontalAlignment="Center"/>
                    <Button Grid.Column="2" Content="RECUPERAR COMPUTADOR" Style="{StaticResource LinkButton}" Click="RecoverComputer_Click" HorizontalAlignment="Right"/>
                  </Grid>
                </StackPanel>
                <StackPanel x:Name="FormPanel" Grid.Row="1" Visibility="Collapsed">
                  <TextBlock x:Name="NameLabel" Text="NOME" Style="{StaticResource Label}"/>
                  <TextBox x:Name="NameBox" Height="42" Margin="0,6,0,11" Padding="12,0" VerticalContentAlignment="Center" FontSize="13" Style="{StaticResource Field}"/>
                  <TextBlock Text="E-MAIL" Style="{StaticResource Label}"/>
                  <TextBox x:Name="FormEmailBox" Height="42" Margin="0,6,0,11" Padding="12,0" VerticalContentAlignment="Center" FontSize="13" Style="{StaticResource Field}"/>
                  <TextBlock Text="SENHA" Style="{StaticResource Label}"/>
                  <PasswordBox x:Name="PasswordBox" Height="42" Margin="0,6,0,11" Padding="12,0" VerticalContentAlignment="Center" FontSize="15" Style="{StaticResource Field}"/>
                  <TextBlock x:Name="ConfirmLabel" Text="CONFIRMAR SENHA" Style="{StaticResource Label}"/>
                  <PasswordBox x:Name="ConfirmPasswordBox" Height="42" Margin="0,6,0,9" Padding="12,0" VerticalContentAlignment="Center" FontSize="15" Style="{StaticResource Field}"/>
                  <TextBlock x:Name="FormStatusText" Text="" Foreground="{StaticResource Muted}" FontSize="10" TextWrapping="Wrap" MinHeight="30"/>
                  <Button x:Name="FormActionButton" Height="46" Content="CRIAR MINHA CONTA  ›" Click="FormActionButton_Click" Background="{StaticResource Orange}" Foreground="#100D06" BorderThickness="0" FontSize="12" FontWeight="Bold" Cursor="Hand" Margin="0,5,0,4"/>
                  <Button x:Name="BackButton" Content="← VOLTAR PARA LOGIN" Style="{StaticResource LinkButton}" Click="BackToLogin_Click" HorizontalAlignment="Center"/>
                </StackPanel>
              </Grid>
            </Border>
            <StackPanel Grid.Row="2" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,16,0,0">
              <TextBlock Text="TELEMETRIA • VIAGENS • COMBUSTÍVEL • BANCO • DOCUMENTOS" Foreground="{StaticResource Muted}" FontSize="7.5" HorizontalAlignment="Center"/>
              <TextBlock Text="Sua conta e o vínculo do computador são gerenciados pelo próprio aplicativo." Foreground="{StaticResource Muted}" FontSize="8" HorizontalAlignment="Center" Margin="0,5,0,0" TextAlignment="Center"/>
              <TextBlock Text="v1.0.17  •  TransPoli" Foreground="{StaticResource Muted}" FontSize="8.5" HorizontalAlignment="Center" Margin="0,5,0,0"/>
            </StackPanel>
          </Grid>
        </ScrollViewer>
      </Grid>
    </Border>
  </Grid>
</Window>