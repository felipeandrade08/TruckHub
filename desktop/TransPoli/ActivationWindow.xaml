<Window x:Class="TransPoli.ActivationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TransPoli • Computador de Bordo"
        Width="620" Height="860" MinWidth="360" MinHeight="500"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResize" SnapsToDevicePixels="True"
        WindowStartupLocation="CenterScreen"
        Icon="/TransPoli;component/Assets/transpoli-logo.png">

  <Window.Resources>
    <Style TargetType="Button" x:Key="ChassisButton">
      <Setter Property="Width" Value="30"/>
      <Setter Property="Height" Value="30"/>
      <Setter Property="Margin" Value="6,0,0,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="#8A8F96"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Dot" CornerRadius="15" Background="#1A1C20">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Dot" Property="Background" Value="#34383E"/>
                <Setter Property="Foreground" Value="#FFFFFF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="Button" x:Key="HomeHardButton">
      <Setter Property="Width" Value="78"/>
      <Setter Property="Height" Value="78"/>
      <Setter Property="IsHitTestVisible" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Ellipse Stroke="#3A3D42" StrokeThickness="2">
              <Ellipse.Fill>
                <RadialGradientBrush GradientOrigin="0.4,0.35">
                  <GradientStop Color="#2A2D33" Offset="0"/>
                  <GradientStop Color="#141619" Offset="1"/>
                </RadialGradientBrush>
              </Ellipse.Fill>
            </Ellipse>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <LinearGradientBrush x:Key="ChassisMetal" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#F2F3F5" Offset="0"/>
      <GradientStop Color="#C9CCD1" Offset="0.5"/>
      <GradientStop Color="#9EA3AA" Offset="1"/>
    </LinearGradientBrush>
  </Window.Resources>

  <Viewbox Stretch="Uniform" Margin="10">
    <Grid Width="1000" Height="1400">
      <Border Background="{StaticResource ChassisMetal}" CornerRadius="72" Padding="7"
              MouseLeftButtonDown="TabletDrag">
        <Border.Effect>
          <DropShadowEffect BlurRadius="60" ShadowDepth="16" Direction="270" Opacity="0.55" Color="#000000"/>
        </Border.Effect>

        <Border Background="#070708" CornerRadius="66">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="104"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="150"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="60,0,60,0">
              <Ellipse Width="12" Height="12" Fill="#1C1E22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Style="{StaticResource ChassisButton}" Content="—" Click="TabletMinimize_Click" ToolTip="Minimizar"/>
                <Button Style="{StaticResource ChassisButton}" Content="✕" Click="TabletClose_Click" ToolTip="Fechar"/>
              </StackPanel>
            </Grid>

            <Border Grid.Row="1" Margin="46,0,46,0" CornerRadius="8" Background="{StaticResource Bg}"
                    BorderBrush="#101215" BorderThickness="1" ClipToBounds="True">
              <Grid>
                <Image Source="{StaticResource BrandBackground}" Stretch="UniformToFill" Opacity="0.30"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <Rectangle Fill="{StaticResource BrandOverlay}"/>

                <Grid Margin="34">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                  </Grid.RowDefinitions>

                  <StackPanel Grid.Row="0" Margin="0,10,0,0">
                    <Border Width="92" Height="92" Background="{StaticResource PanelGlass}" CornerRadius="24" Padding="12" HorizontalAlignment="Center">
                      <Image Source="{StaticResource BrandLogo}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <TextBlock Text="TRANSPOLI" FontSize="34" FontWeight="Bold" Foreground="{StaticResource Text}" HorizontalAlignment="Center" Margin="0,16,0,0"/>
                    <TextBlock Text="COMPUTADOR DE BORDO" FontSize="13" FontWeight="Bold" Foreground="{StaticResource Orange}" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                    <TextBlock Text="Central eletrônica do veículo" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                    <TextBlock Text="Criado por Felipe Andrade" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Orange}" HorizontalAlignment="Center" Margin="0,8,0,0" Opacity="0.9"/>
                  </StackPanel>

                  <Border Grid.Row="1" Background="{StaticResource PanelGlass}" CornerRadius="24" BorderBrush="#1B3550"
                          BorderThickness="1" Padding="26" Margin="0,26,0,10" VerticalAlignment="Center">
                    <StackPanel>
                      <TextBlock Text="ACESSO" FontSize="24" FontWeight="Bold" Foreground="{StaticResource Text}"/>
                      <TextBlock Text="Identificação do motorista" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,5,0,18"/>

                      <TextBlock Text="E-MAIL" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Muted}"/>
                      <TextBox x:Name="EmailBox" Height="54" Margin="0,7,0,18" Padding="14,0" VerticalContentAlignment="Center"
                               FontSize="15" Background="#081827" Foreground="{StaticResource Text}" BorderBrush="#25445E" BorderThickness="1"/>

                      <TextBlock Text="PIN DE 6 DÍGITOS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Muted}"/>
                      <PasswordBox x:Name="PinBox" Height="62" Margin="0,7,0,12" Padding="14,0" VerticalContentAlignment="Center"
                                   FontSize="24" Background="#081827" Foreground="{StaticResource Text}" BorderBrush="#25445E" BorderThickness="1" MaxLength="6"/>

                      <TextBlock x:Name="StatusText" Text="Informe seu e-mail e o PIN de 6 dígitos."
                                 Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" MinHeight="34"/>

                      <Button x:Name="ActivateButton" Height="56" Content="ENTRAR  ›" Click="ActivateButton_Click"
                              Background="{StaticResource Orange}" Foreground="#02080F" FontSize="15" FontWeight="Bold"
                              BorderThickness="0" Cursor="Hand" Margin="0,8,0,0"/>
                    </StackPanel>
                  </Border>
                </Grid>
              </Grid>
            </Border>

            <Button Grid.Row="2" Style="{StaticResource HomeHardButton}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Grid>
        </Border>
      </Border>
    </Grid>
  </Viewbox>
</Window>
