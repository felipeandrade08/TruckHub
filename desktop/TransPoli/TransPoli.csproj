<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Product>TransPoli • Computador de Bordo</Product>
    <AssemblyTitle>TransPoli • Computador de Bordo</AssemblyTitle>
    <Company>Felipe Andrade</Company>
    <Authors>Felipe Andrade</Authors>
    <Copyright>© 2026 Felipe Andrade — Todos os direitos reservados</Copyright>
    <Version>1.0.14</Version>
    <FileVersion>1.0.14.0</FileVersion>
    <AssemblyVersion>1.0.14.0</AssemblyVersion>
    <AssemblyName>TransPoli</AssemblyName>
    <RootNamespace>TransPoli</RootNamespace>
    <ApplicationIcon>../../assets/brand/icons/transpoli.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="../../assets/brand/transpoli-badge.png" Link="Assets/transpoli-badge.png" />
    <Resource Include="../../assets/brand/transpoli-logo.png" Link="Assets/transpoli-logo.png" />
    <Resource Include="../../assets/brand/transpoli-bg.jpg" Link="Assets/transpoli-bg.jpg" />
    <Resource Include="../../assets/brand/icons/transpoli.ico" Link="Assets/transpoli.ico" />
  </ItemGroup>

  <!-- FASE M: versão oficial do produto para a release V1.0.14. -->
</Project>
