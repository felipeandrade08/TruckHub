<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Product>TransPoli • Computador de Bordo</Product>
    <AssemblyTitle>TransPoli • Computador de Bordo</AssemblyTitle>
    <Company>Felipe Andrade</Company>
    <Authors>Felipe Andrade</Authors>
    <Copyright>© 2026 Felipe Andrade — Todos os direitos reservados</Copyright>
    <Version>1.0.35</Version>
    <FileVersion>1.0.35.0</FileVersion>
    <AssemblyVersion>1.0.35.0</AssemblyVersion>
    <AssemblyName>TransPoli</AssemblyName>
    <RootNamespace>TransPoli</RootNamespace>
    <ApplicationIcon>../../assets/brand/icons/truckhub.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../TransPoliEconomy/TransPoliEconomy.csproj" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.10" />
    <PackageReference Include="NAudio" Version="2.3.0" />
    <PackageReference Include="TagLibSharp2" Version="0.6.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="../../assets/brand/truckhub-logo.png" Link="Assets/truckhub-logo.png" />
    <Resource Include="../../assets/brand/truckhub-mark.png" Link="Assets/truckhub-mark.png" />
    <Resource Include="../../assets/brand/truckhub-badge.png" Link="Assets/truckhub-badge.png" />
    <Resource Include="../../assets/brand/truckhub-scene.jpg" Link="Assets/truckhub-scene.jpg" />
    <Resource Include="../../assets/brand/icons/truckhub.ico" Link="Assets/truckhub.ico" />
    <Resource Include="../../assets/brand/transpoli-bg.jpg" Link="Assets/transpoli-bg.jpg" />
    <Resource Include="../../assets/brand/hero-truck.jpg" Link="Assets/hero-truck.jpg" />
    <Resource Include="Assets/Phone/*.png" />
  </ItemGroup>

  <!-- V1.0.27: fundo OEM grafite do cockpit TransPoli, sem fotografia atrás dos instrumentos. -->
  <!-- Build é validado pelo GitHub Actions a cada alteração de desktop antes da publicação. -->
</Project>
