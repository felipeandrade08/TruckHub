<Window x:Class="TransPoli.TransPoliMediaWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="TransPoli Cabin Media" Width="1180" Height="800" WindowStartupLocation="CenterOwner"
 Background="#0B1016" Foreground="#F2F4F7">
 <Window.Resources>
  <SolidColorBrush x:Key="Gold" Color="#E0B33B"/>
  <SolidColorBrush x:Key="Panel" Color="#151C24"/>
  <SolidColorBrush x:Key="Panel2" Color="#10171F"/>
  <Style x:Key="DriveButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="MinWidth" Value="92"/><Setter Property="MinHeight" Value="48"/><Setter Property="FontSize" Value="15"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Background" Value="#1D2833"/>
  </Style>
  <Style x:Key="PrimaryDriveButton" TargetType="Button" BasedOn="{StaticResource DriveButton}">
   <Setter Property="Background" Value="#E0B33B"/><Setter Property="Foreground" Value="#101317"/><Setter Property="BorderBrush" Value="#F0CA61"/>
  </Style>
  <Style TargetType="Button"><Setter Property="Background" Value="#222C37"/><Setter Property="Foreground" Value="#F2F4F7"/><Setter Property="BorderBrush" Value="#3A4653"/><Setter Property="Padding" Value="12,7"/><Setter Property="Margin" Value="3"/></Style>
 </Window.Resources>
 <Grid Margin="22">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid>
   <StackPanel>
    <TextBlock Text="TRANSPOLI • CABIN MEDIA" Foreground="{StaticResource Gold}" FontSize="13" FontWeight="Bold"/>
    <TextBlock Text="Som para a estrada." FontSize="31" FontWeight="Bold"/>
    <TextBlock Text="Cabin Audio • fila local • rádio online • sessão do motorista" Foreground="#91A0AF" Margin="0,4,0,0"/>
    <StackPanel>
     <Border Background="#0F151C" BorderBrush="#293542" BorderThickness="1" CornerRadius="12" Padding="5" Margin="0,12,170,0">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="SearchBox" Height="38" Padding="12,8" TextChanged="SearchBox_TextChanged" ToolTip="Buscar na fila e nos favoritos" Background="Transparent" BorderThickness="0"/><TextBlock IsHitTestVisible="False" Text="⌕  BUSCA RÁPIDA • música, artista ou rádio" Foreground="#657382" Margin="13,10,0,0" x:Name="SearchHint"/><Button Grid.Column="1" Content="＋ ADICIONAR" Click="OpenFile_Click" Style="{StaticResource PrimaryDriveButton}" MinHeight="38" Margin="8,0,0,0"/></Grid>
     </Border>
     <WrapPanel Margin="0,10,0,0">
      <Button x:Name="NowPlayingNav" Content="AGORA TOCANDO" Tag="now" Click="MediaNav_Click" Style="{StaticResource PrimaryDriveButton}" MinHeight="34" Padding="14,6"/>
      <Button x:Name="LibraryNav" Content="BIBLIOTECA" Tag="library" Click="MediaNav_Click" MinHeight="34" Padding="14,6"/>
      <Button x:Name="RadioNav" Content="RÁDIOS" Tag="radio" Click="MediaNav_Click" MinHeight="34" Padding="14,6"/>
      <Button x:Name="CabinNav" Content="CABIN AUDIO" Tag="cabin" Click="MediaNav_Click" MinHeight="34" Padding="14,6"/>
     </WrapPanel>
    </StackPanel>
   </StackPanel>
   <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="#17251E" BorderBrush="#315D45" BorderThickness="1" CornerRadius="10" Padding="12,7">
    <TextBlock x:Name="StatusText" Text="PRONTO" Foreground="#70D99A" FontWeight="Bold"/>
   </Border>
  </Grid>
  <Grid Grid.Row="1" Margin="0,22,0,18">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="SoundLabColumn" Width="0"/></Grid.ColumnDefinitions>
   <Border Background="{StaticResource Panel}" BorderBrush="#293542" BorderThickness="1" CornerRadius="16" Padding="20" Margin="0,0,10,0">
    <Grid>
    <StackPanel x:Name="NowPlayingPage">
     <TextBlock Text="NOW PLAYING • DRIVER SESSION" Foreground="{StaticResource Gold}" FontSize="11" FontWeight="Bold"/>
     <Grid Margin="0,8,0,8">
      <Grid.ColumnDefinitions><ColumnDefinition Width="196"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Width="178" Height="178" Background="#0F151C" BorderBrush="#293542" BorderThickness="1" CornerRadius="10">
       <Grid><Image x:Name="CoverImage" Stretch="UniformToFill"/><TextBlock x:Name="CoverPlaceholder" Text="♫" FontSize="52" Foreground="{StaticResource Gold}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
      </Border>
      <StackPanel Grid.Column="1" VerticalAlignment="Center">
       <TextBlock x:Name="NowPlayingText" Text="Nenhuma fonte selecionada" FontSize="32" FontWeight="Bold" TextWrapping="Wrap"/>
       <TextBlock x:Name="ArtistText" Text="Selecione uma música ou rádio" Foreground="#AAB5C0" FontSize="13" Margin="0,4,0,0" TextWrapping="Wrap"/>
      </StackPanel>
     </Grid>
     <TextBlock x:Name="SourceText" Text="LOCAL / RÁDIO" Foreground="{StaticResource Gold}"/>
     <TextBlock x:Name="TrackMetaText" Text="Artista • duração" Foreground="#91A0AF" Margin="0,4,0,0"/>
     <Slider x:Name="TrackProgress" Height="18" Minimum="0" Maximum="1" Value="0" Margin="0,8,0,0" PreviewMouseLeftButtonUp="TrackProgress_Seek" ToolTip="Clique para avançar/voltar na faixa"/>
     <TextBlock x:Name="TrackTimeText" Text="00:00 / 00:00" Foreground="#91A0AF" FontSize="11"/>
     <TextBlock Text="CABIN OUTPUT • ESTÉREO" Foreground="#91A0AF" FontWeight="Bold" FontSize="10" Margin="0,14,0,4"/>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="L"/><ProgressBar x:Name="VuLeft" Grid.Column="1" Height="8" Minimum="0" Maximum="1"/></Grid>
     <Grid Margin="0,4,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="R"/><ProgressBar x:Name="VuRight" Grid.Column="1" Height="8" Minimum="0" Maximum="1"/></Grid>
     <Separator Margin="0,18"/>
     <TextBlock Text="SOUNDDRIVE • PRONTO PARA A ESTRADA" Foreground="#657382" FontSize="10"/>
    </StackPanel>
    <StackPanel x:Name="RadioPage" Visibility="Collapsed">
     <TextBlock Text="RÁDIOS" Foreground="{StaticResource Gold}" FontSize="11" FontWeight="Bold"/>
     <TextBlock Text="Estações da estrada" FontSize="28" FontWeight="Bold" Margin="0,4,0,2"/>
     <TextBlock Text="RÁDIO ONLINE" FontWeight="Bold" Margin="0,18,0,0"/>
     <TextBlock Text="Cole o endereço direto do stream HTTP/HTTPS. Favoritos ficam somente neste computador." Foreground="#91A0AF" TextWrapping="Wrap" Margin="0,4,0,8"/>
     <TextBox x:Name="StreamUrlBox" Height="34" Padding="8" Text=""/>
     <WrapPanel Margin="0,8,0,0">
      <Button Content="▶ TOCAR RÁDIO" Click="PlayStream_Click"/>
      <Button Content="♫ ADICIONAR MÚSICAS" Click="OpenFile_Click"/>
      <Button Content="★ FAVORITAR RÁDIO" Click="FavoriteRadio_Click"/>
     </WrapPanel>
    </StackPanel>
    <StackPanel x:Name="LibraryPage" Visibility="Collapsed">
     <TextBlock Text="BIBLIOTECA" Foreground="{StaticResource Gold}" FontSize="11" FontWeight="Bold"/>
     <TextBlock Text="Sua música. Sua viagem." FontSize="28" FontWeight="Bold" Margin="0,4,0,8"/>
     <Grid Margin="0,20,0,6"><TextBlock Text="DRIVE CONTROLS" Foreground="#91A0AF" FontWeight="Bold"/><Button Content="⚙ AJUSTAR SOM" Click="ToggleSoundLab_Click" HorizontalAlignment="Right" Padding="12,5"/></Grid>
     <WrapPanel>
      <Button Content="|◀" ToolTip="Faixa anterior" Click="Previous_Click" Style="{StaticResource DriveButton}"/>
      <Button Content="▶ PLAY" Click="Play_Click" Style="{StaticResource PrimaryDriveButton}" MinWidth="124"/>
      <Button Content="Ⅱ" ToolTip="Pausar" Click="Pause_Click" Style="{StaticResource DriveButton}"/>
      <Button Content="▶|" ToolTip="Próxima faixa" Click="Next_Click" Style="{StaticResource DriveButton}"/>
     </WrapPanel>
     <WrapPanel>
      <ToggleButton x:Name="ShuffleToggle" Content="⤨ SHUFFLE" Checked="PlaybackModeChanged" Unchecked="PlaybackModeChanged" Margin="3" Padding="12,7"/>
      <ToggleButton x:Name="RepeatToggle" Content="↻ REPETIR" Checked="PlaybackModeChanged" Unchecked="PlaybackModeChanged" Margin="3" Padding="12,7"/>
      <Button Content="■ STOP" Click="Stop_Click"/>
     </WrapPanel>
     <Grid Margin="0,14,0,4"><TextBlock Text="FILA LOCAL" Foreground="#91A0AF" FontWeight="Bold"/><TextBlock x:Name="QueueCountText" Text="0 FAIXAS" HorizontalAlignment="Right" Foreground="#657382" FontSize="10"/></Grid>
     <Grid>
      <ListBox x:Name="PlaylistBox" Height="125" MouseDoubleClick="PlaylistBox_DoubleClick" Background="#10171F" BorderBrush="#293542"/>
      <StackPanel x:Name="PlaylistEmptyState" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center">
       <TextBlock Text="♫" Foreground="#657382" FontSize="24" HorizontalAlignment="Center"/>
       <TextBlock Text="Sua fila está vazia" Foreground="#AAB5C0" FontWeight="SemiBold" HorizontalAlignment="Center"/>
       <TextBlock Text="Adicione músicas para começar a viagem." Foreground="#657382" FontSize="10" HorizontalAlignment="Center"/>
      </StackPanel>
     </Grid>
     <WrapPanel><Button Content="REMOVER DA FILA" Click="RemoveTrack_Click"/><Button Content="LIMPAR FILA" Click="ClearPlaylist_Click"/></WrapPanel>
     <TextBlock Text="RÁDIOS FAVORITAS" Foreground="#91A0AF" FontWeight="Bold" Margin="0,12,0,4"/>
     <Grid>
      <ListBox x:Name="RadioFavoritesBox" Height="82" MouseDoubleClick="RadioFavoritesBox_DoubleClick" Background="#10171F" BorderBrush="#293542"/>
      <TextBlock x:Name="RadioEmptyState" Text="Nenhuma rádio favorita salva" Foreground="#657382" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
     </Grid>
     <Button Content="REMOVER FAVORITO" Click="RemoveRadioFavorite_Click" HorizontalAlignment="Left"/>
    </StackPanel>
   </Grid>
   </Border>
   <Border x:Name="SoundLabPanel" Grid.Column="1" Background="{StaticResource Panel}" BorderBrush="#293542" BorderThickness="1" CornerRadius="16" Padding="20" Margin="10,0,0,0">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,6,0">
     <Grid><TextBlock Text="SOUND LAB" Foreground="{StaticResource Gold}" FontSize="13" FontWeight="Bold"/><Button Content="×" Click="ToggleSoundLab_Click" HorizontalAlignment="Right" Width="34" Height="28" Padding="0"/></Grid>
     <TextBlock Text="Ajuste fino da cabine" FontSize="22" FontWeight="Bold" Margin="0,4,0,2"/>
     <TextBlock Text="Arquivos locais usam DSP real com equalização por canal. Rádio online mantém a saída nativa nesta primeira versão." Foreground="#91A0AF" TextWrapping="Wrap"/>
     <WrapPanel Margin="0,8,0,0"><Border Background="#17251E" CornerRadius="8" Padding="8,4" Margin="0,0,6,0"><TextBlock x:Name="DspStateText" Text="DSP • PRONTO" Foreground="#70D99A" FontSize="10" FontWeight="Bold"/></Border><Border Background="#11171E" CornerRadius="8" Padding="8,4" Margin="0,0,6,0"><TextBlock x:Name="TelemetryAudioText" Text="TELEMETRIA • AGUARDANDO" Foreground="#91A0AF" FontSize="10" FontWeight="Bold"/></Border><Border Background="#11171E" CornerRadius="8" Padding="8,4"><TextBlock x:Name="CameraAudioText" Text="PERSPECTIVA • CABINE" Foreground="{StaticResource Gold}" FontSize="10" FontWeight="Bold"/></Border></WrapPanel>
     <TextBlock Text="PRESET" Foreground="#91A0AF" FontWeight="Bold" Margin="0,20,0,5"/>
     <ComboBox x:Name="PresetBox" SelectionChanged="PresetBox_SelectionChanged" Height="32">
      <ComboBoxItem Content="ORIGINAL" Tag="NORMAL" IsSelected="True"/>
      <ComboBoxItem Content="CABINE" Tag="CABINE"/>
      <ComboBoxItem Content="GRAVE+" Tag="SUBWOOFER"/>
      <ComboBoxItem Content="NOTURNO" Tag="NOTURNO"/>
     </ComboBox>
     <TextBlock Text="EQUALIZADOR MANUAL" Foreground="#91A0AF" FontWeight="Bold" Margin="0,14,0,5"/>
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock Text="65" HorizontalAlignment="Center"/><Slider x:Name="Eq65" Minimum="-12" Maximum="12" Value="0" ValueChanged="Eq_ValueChanged"/><TextBlock x:Name="Eq65Text" Text="0 dB" HorizontalAlignment="Center" FontSize="10"/></StackPanel>
      <StackPanel Grid.Column="1"><TextBlock Text="145" HorizontalAlignment="Center"/><Slider x:Name="Eq145" Minimum="-12" Maximum="12" Value="0" ValueChanged="Eq_ValueChanged"/><TextBlock x:Name="Eq145Text" Text="0 dB" HorizontalAlignment="Center" FontSize="10"/></StackPanel>
      <StackPanel Grid.Column="2"><TextBlock Text="850" HorizontalAlignment="Center"/><Slider x:Name="Eq850" Minimum="-12" Maximum="12" Value="0" ValueChanged="Eq_ValueChanged"/><TextBlock x:Name="Eq850Text" Text="0 dB" HorizontalAlignment="Center" FontSize="10"/></StackPanel>
      <StackPanel Grid.Column="3"><TextBlock Text="3.8k" HorizontalAlignment="Center"/><Slider x:Name="Eq3800" Minimum="-12" Maximum="12" Value="0" ValueChanged="Eq_ValueChanged"/><TextBlock x:Name="Eq3800Text" Text="0 dB" HorizontalAlignment="Center" FontSize="10"/></StackPanel>
      <StackPanel Grid.Column="4"><TextBlock Text="10.5k" HorizontalAlignment="Center"/><Slider x:Name="Eq10500" Minimum="-12" Maximum="12" Value="0" ValueChanged="Eq_ValueChanged"/><TextBlock x:Name="Eq10500Text" Text="0 dB" HorizontalAlignment="Center" FontSize="10"/></StackPanel>
     </Grid>
     <TextBlock Text="INTENSIDADE" Foreground="#91A0AF" FontWeight="Bold" Margin="0,12,0,4"/>
     <TextBlock Text="Cabine"/><Slider x:Name="CabinIntensity" Minimum="0" Maximum="150" Value="100" ValueChanged="Intensity_ValueChanged"/>
     <TextBlock Text="Subwoofer"/><Slider x:Name="SubIntensity" Minimum="0" Maximum="150" Value="100" ValueChanged="Intensity_ValueChanged"/>
     <TextBlock Text="Ambiência"/><Slider x:Name="AmbienceIntensity" Minimum="0" Maximum="150" Value="100" ValueChanged="Intensity_ValueChanged"/>
     <Button Content="↺ RESETAR ÁUDIO" Click="ResetEq_Click" HorizontalAlignment="Left" Margin="0,8,0,4" ToolTip="Zerar equalizador e restaurar intensidades em 100%"/>
     <TextBlock Text="VOLUME" Foreground="#91A0AF" FontWeight="Bold" Margin="0,20,0,5"/>
     <Slider x:Name="VolumeSlider" Minimum="0" Maximum="100" Value="70" ValueChanged="VolumeSlider_ValueChanged"/>
     <TextBlock x:Name="VolumeText" Text="70%" FontSize="18" FontWeight="Bold" Margin="0,5,0,0"/>
     <Border Background="#11171E" CornerRadius="10" Padding="12" Margin="0,22,0,0">
      <TextBlock x:Name="CabinInfoText" Text="NORMAL • áudio sem processamento adicional" Foreground="#AAB5C0" TextWrapping="Wrap"/>
     </Border>
     <TextBlock Text="ATALHO GLOBAL" Foreground="#91A0AF" FontWeight="Bold" Margin="0,18,0,5"/>
     <TextBlock Text="Abre/fecha a central mesmo com o ETS2 em foco. F9, F10 e F11 são reservadas." Foreground="#91A0AF" FontSize="11" TextWrapping="Wrap"/>
     <WrapPanel Margin="0,7,0,0">
      <ComboBox x:Name="HotkeyBox" Width="80" Height="30"/>
      <CheckBox x:Name="HotkeyCtrl" Content="Ctrl" Margin="8,5,0,0"/>
      <CheckBox x:Name="HotkeyAlt" Content="Alt" Margin="8,5,0,0"/>
      <CheckBox x:Name="HotkeyShift" Content="Shift" Margin="8,5,0,0"/>
     </WrapPanel>
     <Button Content="SALVAR ATALHO" Click="SaveHotkey_Click" Margin="0,7,0,0" HorizontalAlignment="Left"/>
     <TextBlock x:Name="HotkeyStatusText" Foreground="{StaticResource Gold}" FontSize="11" Margin="0,4,0,0"/>
    </StackPanel></ScrollViewer>
   </Border>
  </Grid>
  <Grid Grid.Row="2">
   <TextBlock Text="TRANSPOLI OS • CABIN MEDIA • LOCAL-FIRST" Foreground="#657382" VerticalAlignment="Center"/>
   <Button Content="FECHAR" HorizontalAlignment="Right" Width="100" Click="Close_Click"/>
  </Grid>
  <MediaElement x:Name="Player" Visibility="Collapsed" LoadedBehavior="Manual" UnloadedBehavior="Stop" MediaOpened="Player_MediaOpened" MediaFailed="Player_MediaFailed"/>
 </Grid>
</Window>