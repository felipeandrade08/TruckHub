<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- TransPoli OS • visual tokens. Keep lightweight: no permanent animation/blur. -->
  <Color x:Key="TpColorCanvas">#05080B</Color>
  <Color x:Key="TpColorSurface">#0B1015</Color>
  <Color x:Key="TpColorSurfaceRaised">#111820</Color>
  <Color x:Key="TpColorSurfaceSoft">#161E27</Color>
  <Color x:Key="TpColorStroke">#28333E</Color>
  <Color x:Key="TpColorStrokeStrong">#3A4652</Color>
  <Color x:Key="TpColorGold">#D6A52A</Color>
  <Color x:Key="TpColorGoldBright">#FFD86A</Color>
  <Color x:Key="TpColorText">#F5F7FA</Color>
  <Color x:Key="TpColorMuted">#98A3AE</Color>
  <Color x:Key="TpColorGreen">#54D99B</Color>
  <Color x:Key="TpColorYellow">#F4C95D</Color>
  <Color x:Key="TpColorRed">#F06A6A</Color>
  <Color x:Key="TpColorBlue">#67B7FF</Color>

  <SolidColorBrush x:Key="TpCanvas" Color="{StaticResource TpColorCanvas}"/>
  <SolidColorBrush x:Key="TpSurface" Color="{StaticResource TpColorSurface}"/>
  <SolidColorBrush x:Key="TpSurfaceRaised" Color="{StaticResource TpColorSurfaceRaised}"/>
  <SolidColorBrush x:Key="TpSurfaceSoft" Color="{StaticResource TpColorSurfaceSoft}"/>
  <SolidColorBrush x:Key="TpStroke" Color="{StaticResource TpColorStroke}"/>
  <SolidColorBrush x:Key="TpStrokeStrong" Color="{StaticResource TpColorStrokeStrong}"/>
  <SolidColorBrush x:Key="TpGold" Color="{StaticResource TpColorGold}"/>
  <SolidColorBrush x:Key="TpGoldBright" Color="{StaticResource TpColorGoldBright}"/>
  <SolidColorBrush x:Key="TpText" Color="{StaticResource TpColorText}"/>
  <SolidColorBrush x:Key="TpMuted" Color="{StaticResource TpColorMuted}"/>
  <SolidColorBrush x:Key="TpGreen" Color="{StaticResource TpColorGreen}"/>
  <SolidColorBrush x:Key="TpYellow" Color="{StaticResource TpColorYellow}"/>
  <SolidColorBrush x:Key="TpRed" Color="{StaticResource TpColorRed}"/>
  <SolidColorBrush x:Key="TpBlue" Color="{StaticResource TpColorBlue}"/>

  <Thickness x:Key="TpSpaceXS">4</Thickness>
  <Thickness x:Key="TpSpaceS">8</Thickness>
  <Thickness x:Key="TpSpaceM">12</Thickness>
  <Thickness x:Key="TpSpaceL">18</Thickness>
  <Thickness x:Key="TpSpaceXL">24</Thickness>
  <CornerRadius x:Key="TpRadiusS">8</CornerRadius>
  <CornerRadius x:Key="TpRadiusM">12</CornerRadius>
  <CornerRadius x:Key="TpRadiusL">18</CornerRadius>
  <CornerRadius x:Key="TpRadiusXL">28</CornerRadius>

  <Style x:Key="TpCard" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource TpSurfaceRaised}"/>
    <Setter Property="BorderBrush" Value="{StaticResource TpStroke}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{StaticResource TpRadiusL}"/>
    <Setter Property="Padding" Value="18"/>
  </Style>

  <Style x:Key="TpSectionLabel" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource TpMuted}"/>
    <Setter Property="FontSize" Value="10"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>

  <Style x:Key="TpPrimaryButton" TargetType="Button">
    <Setter Property="Height" Value="44"/>
    <Setter Property="Padding" Value="16,8"/>
    <Setter Property="Background" Value="{StaticResource TpGold}"/>
    <Setter Property="Foreground" Value="#080A0D"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{StaticResource TpGoldBright}"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value=".78"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value=".38"/></Trigger>
        </ControlTemplate.Triggers>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="TpSecondaryButton" TargetType="Button" BasedOn="{StaticResource TpPrimaryButton}">
    <Setter Property="Background" Value="{StaticResource TpSurfaceSoft}"/>
    <Setter Property="Foreground" Value="{StaticResource TpText}"/>
    <Setter Property="BorderBrush" Value="{StaticResource TpStrokeStrong}"/>
    <Setter Property="BorderThickness" Value="1"/>
  </Style>

  <Style x:Key="TpTextBox" TargetType="TextBox">
    <Setter Property="Height" Value="44"/>
    <Setter Property="Padding" Value="12,0"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Background" Value="#090D12"/>
    <Setter Property="Foreground" Value="{StaticResource TpText}"/>
    <Setter Property="CaretBrush" Value="{StaticResource TpGoldBright}"/>
    <Setter Property="BorderBrush" Value="{StaticResource TpStroke}"/>
    <Setter Property="BorderThickness" Value="1"/>
  </Style>
  <Style x:Key="TpPasswordBox" TargetType="PasswordBox">
    <Setter Property="Height" Value="44"/>
    <Setter Property="Padding" Value="12,0"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Background" Value="#090D12"/>
    <Setter Property="Foreground" Value="{StaticResource TpText}"/>
    <Setter Property="CaretBrush" Value="{StaticResource TpGoldBright}"/>
    <Setter Property="BorderBrush" Value="{StaticResource TpStroke}"/>
    <Setter Property="BorderThickness" Value="1"/>
  </Style>
</ResourceDictionary>