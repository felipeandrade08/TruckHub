<Window x:Class="TransPoli.HudSettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="TransPoli • HUD ETS2" Width="680" Height="790" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#070A0E" Foreground="#F5F7FA">
<Border Margin="10" BorderBrush="#604A0B" BorderThickness="1" CornerRadius="22" Background="#0C1117" Padding="24"><Grid>
<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel><TextBlock Text="CENTRAL DE HUD • TRANSPOLI" Foreground="#FFE19A" FontSize="22" FontWeight="Bold"/><TextBlock Text="Configure layout, informações, escala e posição da sobreposição profissional sem interferir na telemetria." Foreground="#8E9AA8" FontSize="13" Margin="0,4,0,18"/></StackPanel>
<ScrollViewer Grid.Row="1"><StackPanel>
<CheckBox x:Name="EnabledCheck" Content="Ativar sobreposição" FontWeight="Bold" FontSize="13" Margin="0,0,0,14" Checked="SettingChanged" Unchecked="SettingChanged"/>
<TextBlock Text="LAYOUT DA HUD" Foreground="#FFE19A" FontSize="12" FontWeight="Bold" Margin="0,0,0,8"/>
<ComboBox x:Name="LayoutCombo" Height="40" FontSize="14" SelectionChanged="SettingChanged" Margin="0,0,0,16"><ComboBoxItem Content="Completa"/><ComboBoxItem Content="Compacta"/><ComboBoxItem Content="Minimalista"/></ComboBox>
<Border Background="#090E13" BorderBrush="#8A6A1D" BorderThickness="1" CornerRadius="16" Padding="14" Margin="0,0,0,18"><StackPanel><Grid><TextBlock Text="PRÉVIA AO VIVO" Foreground="#FFE19A" FontSize="12" FontWeight="Bold"/><TextBlock x:Name="PreviewModeText" Text="COMPLETA • 1120 × 128" HorizontalAlignment="Right" Foreground="#8E9AA8" FontSize="12" FontWeight="SemiBold"/></Grid><Border x:Name="PreviewHudShell" Background="#F2080C11" BorderBrush="#9A7824" BorderThickness="1" CornerRadius="14" Padding="14,10" Margin="0,10,0,0"><StackPanel><TextBlock x:Name="PreviewText" Text="TRANSPOLI  •  VIAGEM ATIVA  •  82 KM/H  •  1.350 RPM  •  420 L  •  ETA 1H 24M" Foreground="#F5F7FA" FontSize="14" FontWeight="Bold" TextWrapping="Wrap"/><TextBlock x:Name="PreviewDetailText" Text="São Paulo → Curitiba  •  Carga em trânsito  •  progresso 64%" Foreground="#8E9AA8" FontSize="12" Margin="0,5,0,0"/></StackPanel></Border><TextBlock Text="A prévia acompanha o preset selecionado; posição, escala e opacidade são aplicadas diretamente à HUD real." Foreground="#8E9AA8" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></Border>
<TextBlock Text="INFORMAÇÕES" Foreground="#FFE19A" FontSize="12" FontWeight="Bold" Margin="0,0,0,8"/>
<WrapPanel>
<CheckBox x:Name="SpeedCheck" Content="Mostrar velocidade" Margin="0,0,20,10" Checked="SettingChanged" Unchecked="SettingChanged"/>
<CheckBox x:Name="RpmCheck" Content="Mostrar RPM" Margin="0,0,20,10" Checked="SettingChanged" Unchecked="SettingChanged"/>
<CheckBox x:Name="RangeCheck" Content="Mostrar autonomia" Margin="0,0,20,10" Checked="SettingChanged" Unchecked="SettingChanged"/>
<CheckBox x:Name="OdometerCheck" Content="Mostrar odômetro" Margin="0,0,20,10" Checked="SettingChanged" Unchecked="SettingChanged"/>
<CheckBox x:Name="TripKmCheck" Content="Mostrar KM da viagem" Margin="0,0,20,10" Checked="SettingChanged" Unchecked="SettingChanged"/>
<CheckBox x:Name="RouteCheck" Content="Mostrar origem/destino" Margin="0,0,20,10" Checked="SettingChanged" Unchecked="SettingChanged"/>
<CheckBox x:Name="CompaniesCheck" Content="Mostrar empresas" Margin="0,0,20,10" Checked="SettingChanged" Unchecked="SettingChanged"/>
<CheckBox x:Name="ProgressCheck" Content="Mostrar progresso" Margin="0,0,20,10" Checked="SettingChanged" Unchecked="SettingChanged"/>
<CheckBox x:Name="CargoCheck" Content="Mostrar carga" Margin="0,0,20,10" Checked="SettingChanged" Unchecked="SettingChanged"/>
<CheckBox x:Name="ProfitCheck" Content="Mostrar lucro" Margin="0,0,20,10" Checked="SettingChanged" Unchecked="SettingChanged"/>
<CheckBox x:Name="ExpensesCheck" Content="Mostrar despesas" Margin="0,0,20,10" Checked="SettingChanged" Unchecked="SettingChanged"/>
<CheckBox x:Name="TripStateCheck" Content="Status da viagem" Margin="0,0,20,10" Checked="SettingChanged" Unchecked="SettingChanged"/>
<CheckBox x:Name="EtaCheck" Content="ETA e distância restante" Margin="0,0,20,10" Checked="SettingChanged" Unchecked="SettingChanged"/>
<CheckBox x:Name="FuelCheck" Content="Combustível" Margin="0,0,20,10" Checked="SettingChanged" Unchecked="SettingChanged"/>
<CheckBox x:Name="GearCheck" Content="Marcha" Margin="0,0,20,10" Checked="SettingChanged" Unchecked="SettingChanged"/>
<CheckBox x:Name="ConnectionCheck" Content="Status da conexão ETS2" Margin="0,0,20,10" Checked="SettingChanged" Unchecked="SettingChanged"/>
<CheckBox x:Name="AlertsCheck" Content="Alertas e eventos na HUD" Margin="0,0,20,10" Checked="SettingChanged" Unchecked="SettingChanged"/>
</WrapPanel>
<TextBlock Text="POSIÇÃO" Foreground="#FFE19A" FontSize="12" FontWeight="Bold" Margin="0,12,0,6"/>
<ComboBox x:Name="PositionCombo" Height="38" FontSize="13" SelectionChanged="SettingChanged"><ComboBoxItem Content="Superior esquerdo"/><ComboBoxItem Content="Topo"/><ComboBoxItem Content="Superior direito"/><ComboBoxItem Content="Centro esquerdo"/><ComboBoxItem Content="Centro"/><ComboBoxItem Content="Centro direito"/><ComboBoxItem Content="Inferior esquerdo"/><ComboBoxItem Content="Inferior"/><ComboBoxItem Content="Inferior direito"/><ComboBoxItem Content="Personalizado"/></ComboBox>
<TextBlock Text="POSIÇÃO LIVRE • X" Foreground="#FFE19A" FontSize="12" FontWeight="Bold" Margin="0,14,0,3"/>
<Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions><Slider x:Name="XSlider" Minimum="0" Maximum="1" ValueChanged="SettingChanged"/><TextBlock x:Name="XText" Grid.Column="1" TextAlignment="Right" VerticalAlignment="Center"/></Grid>
<TextBlock Text="POSIÇÃO LIVRE • Y" Foreground="#FFE19A" FontSize="12" FontWeight="Bold" Margin="0,10,0,3"/>
<Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions><Slider x:Name="YSlider" Minimum="0" Maximum="1" ValueChanged="SettingChanged"/><TextBlock x:Name="YText" Grid.Column="1" TextAlignment="Right" VerticalAlignment="Center"/></Grid>
<TextBlock Text="TRANSPARÊNCIA" Foreground="#FFE19A" FontSize="12" FontWeight="Bold" Margin="0,16,0,3"/>
<Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions><Slider x:Name="OpacitySlider" Minimum="0.35" Maximum="1" ValueChanged="SettingChanged"/><TextBlock x:Name="OpacityText" Grid.Column="1" TextAlignment="Right" VerticalAlignment="Center"/></Grid>
<TextBlock Text="ESCALA" Foreground="#FFE19A" FontSize="12" FontWeight="Bold" Margin="0,14,0,3"/>
<Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions><Slider x:Name="ScaleSlider" Minimum="0.40" Maximum="2.00" ValueChanged="SettingChanged"/><TextBlock x:Name="ScaleText" Grid.Column="1" TextAlignment="Right" VerticalAlignment="Center"/></Grid>
</StackPanel></ScrollViewer>
<StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0"><Button Content="CANCELAR" Width="100" Height="36" Margin="0,0,8,0" Click="Cancel_Click"/><Button Content="SALVAR" Width="100" Height="36" Background="#D8A92E" Foreground="#080B0E" FontWeight="Bold" Click="Save_Click"/></StackPanel>
</Grid></Border></Window>