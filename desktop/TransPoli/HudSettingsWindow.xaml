<Window x:Class="TransPoli.HudSettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="TransPoli • HUD ETS2" Width="780" Height="820" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#070A0E" Foreground="#F5F7FA">
<Border Margin="10" BorderBrush="#27313B" BorderThickness="1" CornerRadius="22" Background="#0E1217" Padding="26"><Grid>
<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="HUD ETS2" Foreground="#F7F8FA" FontSize="25" FontWeight="Bold"/><TextBlock Text="PAINEL DE INSTRUMENTOS • TRANSPOLI" Foreground="#FFD45A" FontSize="11" FontWeight="Bold" Margin="0,3,0,0"/><TextBlock Text="Configure instrumentos de condução sem duplicar o computador de bordo." Foreground="#929BA7" FontSize="12" Margin="0,5,0,0"/></StackPanel><Border Grid.Column="1" Background="#141A20" BorderBrush="#3A4652" BorderThickness="1" CornerRadius="12" Padding="12,7" VerticalAlignment="Center"><StackPanel><TextBlock Text="F11" Foreground="#FFD45A" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock Text="HUD" Foreground="#929BA7" FontSize="9" HorizontalAlignment="Center"/></StackPanel></Border></Grid>
<ScrollViewer Grid.Row="1"><StackPanel>
<Border Background="#141A20" BorderBrush="#27313B" BorderThickness="1" CornerRadius="14" Padding="14,11" Margin="0,0,0,18"><CheckBox x:Name="EnabledCheck" Content="HUD ATIVA NO ETS2" Foreground="#F7F8FA" FontWeight="Bold" FontSize="13" Checked="SettingChanged" Unchecked="SettingChanged"/></Border>
<TextBlock Text="MODO DE EXIBIÇÃO" Foreground="#FFE19A" FontSize="12" FontWeight="Bold" Margin="0,0,0,8"/>
<ComboBox x:Name="LayoutCombo" Height="40" FontSize="14" SelectionChanged="SettingChanged" Margin="0,0,0,16"><ComboBoxItem Content="Completa"/><ComboBoxItem Content="Compacta"/><ComboBoxItem Content="Minimalista"/></ComboBox>
<Border Background="#07090C" BorderBrush="#27313B" BorderThickness="1" CornerRadius="14" Padding="14" Margin="0,0,0,18"><StackPanel><Grid><TextBlock Text="PRÉVIA DA HUD" Foreground="#FFE19A" FontSize="12" FontWeight="Bold"/><TextBlock x:Name="PreviewModeText" Text="COMPLETA • 1880 × 132" HorizontalAlignment="Right" Foreground="#8E9AA8" FontSize="12" FontWeight="SemiBold"/></Grid><Border x:Name="PreviewHudShell" Background="#F2070B0F" BorderBrush="#56616B" BorderThickness="1" CornerRadius="12" Padding="14,10" Margin="0,10,0,0"><StackPanel><TextBlock x:Name="PreviewText" Text="-- KM/H    |    MARCHA --    |    -- L" Foreground="#F5F7FA" FontSize="14" FontWeight="Bold" TextWrapping="Wrap"/><TextBlock x:Name="PreviewDetailText" Text="ORIGEM → DESTINO   •   VIAGEM ATIVA   •   --%" Foreground="#8E9AA8" FontSize="12" Margin="0,5,0,0"/></StackPanel></Border><TextBlock Text="A prévia acompanha o preset selecionado; posição, escala e opacidade são aplicadas diretamente à HUD real." Foreground="#8E9AA8" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></Border>
<TextBlock Text="INSTRUMENTOS E SUPORTE" Foreground="#FFE19A" FontSize="12" FontWeight="Bold" Margin="0,0,0,8"/>
<Grid Margin="0,0,0,4"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
<Border Grid.Column="0" Background="#141A20" BorderBrush="#27313B" BorderThickness="1" CornerRadius="12" Padding="12"><StackPanel><TextBlock Text="CONDUÇÃO" Foreground="#FFD45A" FontSize="10" FontWeight="Bold" Margin="0,0,0,8"/><CheckBox x:Name="SpeedCheck" Content="Velocidade" Margin="0,0,0,7" Checked="SettingChanged" Unchecked="SettingChanged"/><CheckBox x:Name="RpmCheck" Content="RPM" Margin="0,0,0,7" Checked="SettingChanged" Unchecked="SettingChanged"/><CheckBox x:Name="FuelCheck" Content="Combustível" Margin="0,0,0,7" Checked="SettingChanged" Unchecked="SettingChanged"/><CheckBox x:Name="RangeCheck" Content="Autonomia" Margin="0,0,0,7" Checked="SettingChanged" Unchecked="SettingChanged"/><CheckBox x:Name="GearCheck" Content="Marcha" Checked="SettingChanged" Unchecked="SettingChanged"/></StackPanel></Border>
<Border Grid.Column="2" Background="#141A20" BorderBrush="#27313B" BorderThickness="1" CornerRadius="12" Padding="12"><StackPanel><TextBlock Text="SUPORTE À CONDUÇÃO" Foreground="#FFD45A" FontSize="10" FontWeight="Bold" Margin="0,0,0,8"/><CheckBox x:Name="TripKmCheck" Content="Distância percorrida" Margin="0,0,0,7" Checked="SettingChanged" Unchecked="SettingChanged"/><TextBlock Text="Rota, progresso, ETA e estado operacional ficam no computador de bordo." Foreground="#929BA7" FontSize="10" TextWrapping="Wrap"/></StackPanel></Border>
</Grid>
<Grid Margin="0,8,0,8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
<Border Grid.Column="0" Background="#141A20" BorderBrush="#27313B" BorderThickness="1" CornerRadius="12" Padding="12"><StackPanel><TextBlock Text="SEPARAÇÃO DE FUNÇÕES" Foreground="#FFD45A" FontSize="10" FontWeight="Bold" Margin="0,0,0,8"/><TextBlock Text="Carga, empresas, financeiro e despesas pertencem ao computador de bordo e ao celular. A HUD permanece dedicada à condução." Foreground="#929BA7" FontSize="10" TextWrapping="Wrap"/></StackPanel></Border>
<Border Grid.Column="2" Background="#141A20" BorderBrush="#27313B" BorderThickness="1" CornerRadius="12" Padding="12"><StackPanel><TextBlock Text="SISTEMA" Foreground="#FFD45A" FontSize="10" FontWeight="Bold" Margin="0,0,0,8"/><CheckBox x:Name="OdometerCheck" Content="Odômetro" Margin="0,0,0,7" Checked="SettingChanged" Unchecked="SettingChanged"/><CheckBox x:Name="ConnectionCheck" Content="Conexão ETS2" Margin="0,0,0,7" Checked="SettingChanged" Unchecked="SettingChanged"/><CheckBox x:Name="AlertsCheck" Content="Alertas e eventos" Checked="SettingChanged" Unchecked="SettingChanged"/></StackPanel></Border>
</Grid>
<TextBlock Text="POSIÇÃO NA TELA" Foreground="#FFE19A" FontSize="12" FontWeight="Bold" Margin="0,12,0,6"/>
<ComboBox x:Name="PositionCombo" Height="38" FontSize="13" SelectionChanged="SettingChanged"><ComboBoxItem Content="Superior esquerdo"/><ComboBoxItem Content="Topo"/><ComboBoxItem Content="Superior direito"/><ComboBoxItem Content="Centro esquerdo"/><ComboBoxItem Content="Centro"/><ComboBoxItem Content="Centro direito"/><ComboBoxItem Content="Inferior esquerdo"/><ComboBoxItem Content="Inferior"/><ComboBoxItem Content="Inferior direito"/><ComboBoxItem Content="Personalizado"/></ComboBox>
<TextBlock Text="POSIÇÃO LIVRE • X" Foreground="#FFE19A" FontSize="12" FontWeight="Bold" Margin="0,14,0,3"/>
<Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions><Slider x:Name="XSlider" Minimum="0" Maximum="1" ValueChanged="SettingChanged"/><TextBlock x:Name="XText" Grid.Column="1" TextAlignment="Right" VerticalAlignment="Center"/></Grid>
<TextBlock Text="POSIÇÃO LIVRE • Y" Foreground="#FFE19A" FontSize="12" FontWeight="Bold" Margin="0,10,0,3"/>
<Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions><Slider x:Name="YSlider" Minimum="0" Maximum="1" ValueChanged="SettingChanged"/><TextBlock x:Name="YText" Grid.Column="1" TextAlignment="Right" VerticalAlignment="Center"/></Grid>
<TextBlock Text="TRANSPARÊNCIA" Foreground="#FFE19A" FontSize="12" FontWeight="Bold" Margin="0,16,0,3"/>
<Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions><Slider x:Name="OpacitySlider" Minimum="0.35" Maximum="1" ValueChanged="SettingChanged"/><TextBlock x:Name="OpacityText" Grid.Column="1" TextAlignment="Right" VerticalAlignment="Center"/></Grid>
<TextBlock Text="ESCALA" Foreground="#FFE19A" FontSize="12" FontWeight="Bold" Margin="0,14,0,3"/>
<Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions><Slider x:Name="ScaleSlider" Minimum="0.55" Maximum="1.00" ValueChanged="SettingChanged"/><TextBlock x:Name="ScaleText" Grid.Column="1" TextAlignment="Right" VerticalAlignment="Center"/></Grid>
</StackPanel></ScrollViewer>
<StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0"><Button Content="CANCELAR" Width="110" Height="40" Margin="0,0,8,0" Click="Cancel_Click"/><Button Content="SALVAR HUD" Width="130" Height="40" Background="#D8A92E" Foreground="#080B0E" FontWeight="Bold" Click="Save_Click"/></StackPanel>
</Grid></Border></Window>