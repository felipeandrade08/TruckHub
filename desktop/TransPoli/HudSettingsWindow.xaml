<Window x:Class="TransPoli.HudSettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="TransPoli • HUD ETS2" Width="520" Height="650" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#070A0E" Foreground="#F5F7FA">
<Border Margin="10" BorderBrush="#604A0B" BorderThickness="1" CornerRadius="22" Background="#0C1117" Padding="24"><Grid>
<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel><TextBlock Text="HUD ETS2" Foreground="#FFE19A" FontSize="22" FontWeight="Bold"/><TextBlock Text="Configure a sobreposição do TransPoli sem interferir na telemetria." Foreground="#8E9AA8" FontSize="11" Margin="0,4,0,18"/></StackPanel>
<ScrollViewer Grid.Row="1"><StackPanel>
<CheckBox x:Name="EnabledCheck" Content="Ativar sobreposição" FontWeight="Bold" FontSize="13" Margin="0,0,0,14" Checked="SettingChanged" Unchecked="SettingChanged"/>
<TextBlock Text="INFORMAÇÕES" Foreground="#FFE19A" FontSize="9" FontWeight="Bold" Margin="0,0,0,8"/>
<WrapPanel>
<CheckBox x:Name="SpeedCheck" Content="Mostrar velocidade" Margin="0,0,20,10" Checked="SettingChanged" Unchecked="SettingChanged"/>
<CheckBox x:Name="RpmCheck" Content="Mostrar RPM" Margin="0,0,20,10" Checked="SettingChanged" Unchecked="SettingChanged"/>
<CheckBox x:Name="RangeCheck" Content="Mostrar autonomia" Margin="0,0,20,10" Checked="SettingChanged" Unchecked="SettingChanged"/>
<CheckBox x:Name="OdometerCheck" Content="Mostrar odômetro" Margin="0,0,20,10" Checked="SettingChanged" Unchecked="SettingChanged"/>
<CheckBox x:Name="TripKmCheck" Content="Mostrar KM da viagem" Margin="0,0,20,10" Checked="SettingChanged" Unchecked="SettingChanged"/>
<CheckBox x:Name="RouteCheck" Content="Mostrar origem/destino" Margin="0,0,20,10" Checked="SettingChanged" Unchecked="SettingChanged"/>
<CheckBox x:Name="CompaniesCheck" Content="Mostrar empresas" Margin="0,0,20,10" Checked="SettingChanged" Unchecked="SettingChanged"/>
<CheckBox x:Name="ProgressCheck" Content="Mostrar progresso" Margin="0,0,20,10" Checked="SettingChanged" Unchecked="SettingChanged"/>
<CheckBox x:Name="CargoCheck" Content="Mostrar carga" Margin="0,0,20,10" Checked="SettingChanged" Unchecked="SettingChanged"/>
<CheckBox x:Name="ProfitCheck" Content="Mostrar lucro" Margin="0,0,20,10" Checked="SettingChanged" Unchecked="SettingChanged"/>
<CheckBox x:Name="ExpensesCheck" Content="Mostrar despesas" Margin="0,0,20,10" Checked="SettingChanged" Unchecked="SettingChanged"/>
</WrapPanel>
<TextBlock Text="POSIÇÃO" Foreground="#FFE19A" FontSize="9" FontWeight="Bold" Margin="0,12,0,6"/>
<ComboBox x:Name="PositionCombo" Height="34" SelectionChanged="SettingChanged"><ComboBoxItem Content="Topo"/><ComboBoxItem Content="Centro superior"/><ComboBoxItem Content="Inferior"/></ComboBox>
<TextBlock Text="TRANSPARÊNCIA" Foreground="#FFE19A" FontSize="9" FontWeight="Bold" Margin="0,16,0,3"/>
<Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions><Slider x:Name="OpacitySlider" Minimum="0.35" Maximum="1" ValueChanged="SettingChanged"/><TextBlock x:Name="OpacityText" Grid.Column="1" TextAlignment="Right" VerticalAlignment="Center"/></Grid>
<TextBlock Text="ESCALA" Foreground="#FFE19A" FontSize="9" FontWeight="Bold" Margin="0,14,0,3"/>
<Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions><Slider x:Name="ScaleSlider" Minimum="0.55" Maximum="1.35" ValueChanged="SettingChanged"/><TextBlock x:Name="ScaleText" Grid.Column="1" TextAlignment="Right" VerticalAlignment="Center"/></Grid>
</StackPanel></ScrollViewer>
<StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0"><Button Content="CANCELAR" Width="100" Height="36" Margin="0,0,8,0" Click="Cancel_Click"/><Button Content="SALVAR" Width="100" Height="36" Background="#D8A92E" Foreground="#080B0E" FontWeight="Bold" Click="Save_Click"/></StackPanel>
</Grid></Border></Window>