<Window x:Class="TransPoli.HudSettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="TruckHub • HUD ETS2 + ATS" Width="780" Height="820" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" WindowStyle="None" AllowsTransparency="True" Background="Transparent" Foreground="#F4F7FA" FontFamily="Segoe UI">
<Window.Resources>
<Style TargetType="CheckBox"><Setter Property="Foreground" Value="#F4F7FA"/><Setter Property="FontSize" Value="13"/><Setter Property="Margin" Value="0,4"/><Setter Property="Cursor" Value="Hand"/>
<Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><StackPanel Orientation="Horizontal" Background="Transparent">
<Border x:Name="Box" Width="20" Height="20" CornerRadius="6" Background="#18222D" BorderBrush="#3A4652" BorderThickness="1.5" VerticalAlignment="Center"><Path x:Name="Tick" Data="M4,10 L8,14 L16,5" Stroke="#0B1118" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed"/></Border>
<ContentPresenter Margin="11,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/></StackPanel>
<ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Box" Property="Background" Value="#4298EF"/><Setter TargetName="Box" Property="BorderBrush" Value="#4298EF"/><Setter TargetName="Tick" Property="Visibility" Value="Visible"/></Trigger>
<Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="#6DB3FA"/></Trigger>
<Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
<Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="#F4F7FA"/><Setter Property="FontSize" Value="13"/><Setter Property="Cursor" Value="Hand"/>
<Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="Bd" CornerRadius="8" Padding="12,9" Background="Transparent"><ContentPresenter/></Border>
<ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Bd" Property="Background" Value="#1F2B38"/></Trigger>
<Trigger Property="IsSelected" Value="True"><Setter TargetName="Bd" Property="Background" Value="#061B30"/><Setter Property="Foreground" Value="#6DB3FA"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
<Style TargetType="ComboBox"><Setter Property="Foreground" Value="#F4F7FA"/><Setter Property="Background" Value="#18222D"/><Setter Property="BorderBrush" Value="#3A4652"/><Setter Property="Cursor" Value="Hand"/>
<Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid>
<ToggleButton Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}" BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}" BorderThickness="1" CornerRadius="12"><Path Data="M0,0 L5,5 L10,0" Stroke="#6DB3FA" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0"/></Border></ControlTemplate></ToggleButton.Template></ToggleButton>
<ContentPresenter IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" Margin="14,0,38,0" VerticalAlignment="Center" HorizontalAlignment="Left"/>
<Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade"><Border MinWidth="{TemplateBinding ActualWidth}" MaxHeight="320" Background="#111A23" BorderBrush="#3A4652" BorderThickness="1" CornerRadius="14" Margin="0,6,0,10" Padding="5"><Border.Effect><DropShadowEffect BlurRadius="16" ShadowDepth="0" Opacity=".5"/></Border.Effect><ScrollViewer><StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer></Border></Popup>
</Grid></ControlTemplate></Setter.Value></Setter></Style>
<Style TargetType="Slider"><Setter Property="Height" Value="28"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider"><Grid><Border Height="6" CornerRadius="3" Background="#243140" VerticalAlignment="Center"/>
<Track x:Name="PART_Track"><Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" Background="#4298EF" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Height="6" CornerRadius="3" Background="{TemplateBinding Background}"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
<Track.Thumb><Thumb Width="22" Height="22" Focusable="False" Cursor="Hand"><Thumb.Template><ControlTemplate TargetType="Thumb"><Ellipse Fill="#F4F7FA" Stroke="#4298EF" StrokeThickness="4"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
<Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Background="Transparent" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Height="6" Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton></Track>
</Grid></ControlTemplate></Setter.Value></Setter></Style>
<Style TargetType="Button"><Setter Property="Foreground" Value="#F4F7FA"/><Setter Property="Background" Value="#18222D"/><Setter Property="BorderBrush" Value="#3A4652"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontWeight" Value="Bold"/>
<Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
<ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.86"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.7"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
</Window.Resources>

<Border Margin="14" BorderBrush="#2E3B48" BorderThickness="1" CornerRadius="28" Background="#111A23" Padding="28" MouseLeftButtonDown="Drag_MouseDown"><Border.Effect><DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity=".6"/></Border.Effect><Grid>
<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="HUD ETS2 + ATS" Foreground="#F4F7FA" FontSize="27" FontFamily="Bahnschrift, Segoe UI" FontWeight="Bold"/><TextBlock Text="PAINEL DE INSTRUMENTOS • TRUCKHUB" Foreground="#6DB3FA" FontSize="11" FontWeight="Bold" Margin="0,3,0,0"/><TextBlock Text="Configure instrumentos de condução sem duplicar o computador de bordo." Foreground="#8997A5" FontSize="12" Margin="0,5,0,0"/><ComboBox x:Name="ProfileCombo" Width="260" Height="32" HorizontalAlignment="Left" Margin="0,10,0,0" SelectionChanged="ProfileCombo_SelectionChanged"><ComboBoxItem Content="American Truck Simulator (ATS)" Tag="ATS"/><ComboBoxItem Content="Euro Truck Simulator 2 (ETS2)" Tag="ETS2"/></ComboBox><TextBlock Text="O perfil muda automaticamente quando outro simulador é detectado." Foreground="#8997A5" FontSize="10" Margin="0,5,0,0"/></StackPanel><Border Grid.Column="1" Background="#151D26" BorderBrush="#3A4652" BorderThickness="1" CornerRadius="12" Padding="12,7" VerticalAlignment="Center"><StackPanel><TextBlock Text="F11" Foreground="#6DB3FA" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock Text="HUD" Foreground="#8997A5" FontSize="9" HorizontalAlignment="Center"/></StackPanel></Border></Grid>
<ScrollViewer Grid.Row="1"><StackPanel>
<Border Background="#151D26" BorderBrush="#2E3B48" BorderThickness="1" CornerRadius="14" Padding="14,11" Margin="0,0,0,18"><CheckBox x:Name="EnabledCheck" Content="HUD ATIVA NOS SIMULADORES" Foreground="#F4F7FA" FontWeight="Bold" FontSize="13" Checked="SettingChanged" Unchecked="SettingChanged"/></Border>
<TextBlock Text="MODO DE EXIBIÇÃO" Foreground="#6DB3FA" FontSize="12" FontWeight="Bold" Margin="0,0,0,8"/>
<ComboBox x:Name="LayoutCombo" Height="40" FontSize="14" SelectionChanged="SettingChanged" Margin="0,0,0,16"><ComboBoxItem Content="Completa"/><ComboBoxItem Content="Compacta"/><ComboBoxItem Content="Minimalista"/></ComboBox>
<Border Background="#0B1118" BorderBrush="#2E3B48" BorderThickness="1" CornerRadius="14" Padding="14" Margin="0,0,0,18"><StackPanel><Grid><TextBlock Text="PRÉVIA DA HUD" Foreground="#6DB3FA" FontSize="12" FontWeight="Bold"/><TextBlock x:Name="PreviewModeText" Text="COMPLETA • 1880 × 132" HorizontalAlignment="Right" Foreground="#8E9AA8" FontSize="12" FontWeight="SemiBold"/></Grid><Border x:Name="PreviewHudShell" Background="#F2070B0F" BorderBrush="#56616B" BorderThickness="1" CornerRadius="12" Padding="14,10" Margin="0,10,0,0"><StackPanel><TextBlock x:Name="PreviewText" Text="-- KM/H    |    MARCHA --    |    -- L" Foreground="#F4F7FA" FontSize="14" FontWeight="Bold" TextWrapping="Wrap"/><TextBlock x:Name="PreviewDetailText" Text="ORIGEM → DESTINO   •   VIAGEM ATIVA   •   --%" Foreground="#8E9AA8" FontSize="12" Margin="0,5,0,0"/></StackPanel></Border><TextBlock Text="A prévia acompanha o preset selecionado; posição, escala e opacidade são aplicadas diretamente à HUD real." Foreground="#8E9AA8" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></Border>
<TextBlock Text="INSTRUMENTOS E SUPORTE" Foreground="#6DB3FA" FontSize="12" FontWeight="Bold" Margin="0,0,0,8"/>
<Grid Margin="0,0,0,4"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
<Border Grid.Column="0" Background="#151D26" BorderBrush="#2E3B48" BorderThickness="1" CornerRadius="12" Padding="12"><StackPanel><TextBlock Text="CONDUÇÃO" Foreground="#6DB3FA" FontSize="10" FontWeight="Bold" Margin="0,0,0,8"/><CheckBox x:Name="SpeedCheck" Content="Velocidade" Margin="0,0,0,7" Checked="SettingChanged" Unchecked="SettingChanged"/><CheckBox x:Name="RpmCheck" Content="RPM" Margin="0,0,0,7" Checked="SettingChanged" Unchecked="SettingChanged"/><CheckBox x:Name="FuelCheck" Content="Combustível" Margin="0,0,0,7" Checked="SettingChanged" Unchecked="SettingChanged"/><CheckBox x:Name="RangeCheck" Content="Autonomia" Margin="0,0,0,7" Checked="SettingChanged" Unchecked="SettingChanged"/><CheckBox x:Name="GearCheck" Content="Marcha" Checked="SettingChanged" Unchecked="SettingChanged"/></StackPanel></Border>
<Border Grid.Column="2" Background="#151D26" BorderBrush="#2E3B48" BorderThickness="1" CornerRadius="12" Padding="12"><StackPanel><TextBlock Text="SUPORTE À CONDUÇÃO" Foreground="#6DB3FA" FontSize="10" FontWeight="Bold" Margin="0,0,0,8"/><CheckBox x:Name="TripKmCheck" Content="Distância percorrida" Margin="0,0,0,7" Checked="SettingChanged" Unchecked="SettingChanged"/><CheckBox x:Name="TempsCheck" Content="Temperaturas (água e freios)" Margin="0,0,0,7" Checked="SettingChanged" Unchecked="SettingChanged"/><CheckBox x:Name="DamageCheck" Content="Danos do caminhão, reboque e carga" Margin="0,0,0,7" Checked="SettingChanged" Unchecked="SettingChanged"/><CheckBox x:Name="AxlesCheck" Content="Eixos levantados/baixados" Margin="0,0,0,7" Checked="SettingChanged" Unchecked="SettingChanged"/><CheckBox x:Name="RouteCheck" Content="Rota e destino" Margin="0,0,0,7" Checked="SettingChanged" Unchecked="SettingChanged"/><CheckBox x:Name="CompaniesCheck" Content="Detalhes das empresas (dica da rota)" Margin="0,0,0,7" Checked="SettingChanged" Unchecked="SettingChanged"/><CheckBox x:Name="EtaCheck" Content="Previsão de chegada (ETA)" Margin="0,0,0,7" Checked="SettingChanged" Unchecked="SettingChanged"/><CheckBox x:Name="ProgressCheck" Content="Progresso da viagem" Margin="0,0,0,7" Checked="SettingChanged" Unchecked="SettingChanged"/><CheckBox x:Name="CargoCheck" Content="Informações da carga" Margin="0,0,0,7" Checked="SettingChanged" Unchecked="SettingChanged"/><CheckBox x:Name="ScaleCheck" Content="Balança / peso da carga (ATS)" Margin="0,0,0,7" Checked="SettingChanged" Unchecked="SettingChanged"/><CheckBox x:Name="ProfitCheck" Content="Valor do frete" Margin="0,0,0,7" Checked="SettingChanged" Unchecked="SettingChanged"/><CheckBox x:Name="TripStateCheck" Content="Prazo e mercado do frete" Margin="0,0,0,7" Checked="SettingChanged" Unchecked="SettingChanged"/><TextBlock Text="O painel ATS mostra a massa de carga recebida do jogo; não representa o peso bruto medido no PrePass." Foreground="#8997A5" FontSize="10" TextWrapping="Wrap"/></StackPanel></Border>
</Grid>
<Grid Margin="0,8,0,8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
<Border Grid.Column="0" Background="#151D26" BorderBrush="#2E3B48" BorderThickness="1" CornerRadius="12" Padding="12"><StackPanel><TextBlock Text="SEPARAÇÃO DE FUNÇÕES" Foreground="#6DB3FA" FontSize="10" FontWeight="Bold" Margin="0,0,0,8"/><TextBlock Text="Carga, empresas, financeiro e despesas pertencem ao computador de bordo e ao celular. A HUD permanece dedicada à condução." Foreground="#8997A5" FontSize="10" TextWrapping="Wrap"/></StackPanel></Border>
<Border Grid.Column="2" Background="#151D26" BorderBrush="#2E3B48" BorderThickness="1" CornerRadius="12" Padding="12"><StackPanel><TextBlock Text="SISTEMA" Foreground="#6DB3FA" FontSize="10" FontWeight="Bold" Margin="0,0,0,8"/><CheckBox x:Name="OdometerCheck" Content="Odômetro" Margin="0,0,0,7" Checked="SettingChanged" Unchecked="SettingChanged"/><CheckBox x:Name="ConnectionCheck" Content="Conexão do simulador" Margin="0,0,0,7" Checked="SettingChanged" Unchecked="SettingChanged"/><CheckBox x:Name="AlertsCheck" Content="Alertas e eventos" Checked="SettingChanged" Unchecked="SettingChanged"/></StackPanel></Border>
</Grid>
<Border Background="#151D26" BorderBrush="#2E3B48" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,0,8"><StackPanel><TextBlock Text="BALANÇA • ATS (PESO BRUTO ESTIMADO)" Foreground="#6DB3FA" FontSize="10" FontWeight="Bold" Margin="0,0,0,8"/><StackPanel Orientation="Horizontal" Margin="0,0,0,6"><TextBlock Text="Tara do caminhão (t)" Foreground="#C8D1DA" FontSize="11" VerticalAlignment="Center" Width="150"/><TextBox x:Name="TruckTareBox" Width="64" Height="28" Padding="6,3" Background="#0B1015" Foreground="#F4F7FA" BorderBrush="#2E3B48" CaretBrush="#F4F7FA" VerticalContentAlignment="Center" TextChanged="SettingChanged"/></StackPanel><StackPanel Orientation="Horizontal" Margin="0,0,0,8"><TextBlock Text="Tara por reboque (t)" Foreground="#C8D1DA" FontSize="11" VerticalAlignment="Center" Width="150"/><TextBox x:Name="TrailerTareBox" Width="64" Height="28" Padding="6,3" Background="#0B1015" Foreground="#F4F7FA" BorderBrush="#2E3B48" CaretBrush="#F4F7FA" VerticalContentAlignment="Center" TextChanged="SettingChanged"/></StackPanel><TextBlock Text="A telemetria da SCS informa o peso da carga, mas não a tara. O peso bruto da HUD é a carga real somada a estas taras (estimativa) e comparado ao limite federal de 80.000 lb. Multas por ignorar balança ou inspeção vêm direto do jogo e são registradas automaticamente." Foreground="#8997A5" FontSize="10" TextWrapping="Wrap"/></StackPanel></Border>
<TextBlock Text="POSIÇÃO NA TELA" Foreground="#6DB3FA" FontSize="12" FontWeight="Bold" Margin="0,12,0,6"/>
<ComboBox x:Name="PositionCombo" Height="38" FontSize="13" SelectionChanged="SettingChanged"><ComboBoxItem Content="Superior esquerdo"/><ComboBoxItem Content="Topo"/><ComboBoxItem Content="Superior direito"/><ComboBoxItem Content="Centro esquerdo"/><ComboBoxItem Content="Centro"/><ComboBoxItem Content="Centro direito"/><ComboBoxItem Content="Inferior esquerdo"/><ComboBoxItem Content="Inferior"/><ComboBoxItem Content="Inferior direito"/><ComboBoxItem Content="Personalizado"/></ComboBox>
<TextBlock Text="POSIÇÃO LIVRE • X" Foreground="#6DB3FA" FontSize="12" FontWeight="Bold" Margin="0,14,0,3"/>
<Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions><Slider x:Name="XSlider" Minimum="0" Maximum="1" ValueChanged="SettingChanged"/><TextBlock x:Name="XText" Grid.Column="1" TextAlignment="Right" VerticalAlignment="Center"/></Grid>
<TextBlock Text="POSIÇÃO LIVRE • Y" Foreground="#6DB3FA" FontSize="12" FontWeight="Bold" Margin="0,10,0,3"/>
<Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions><Slider x:Name="YSlider" Minimum="0" Maximum="1" ValueChanged="SettingChanged"/><TextBlock x:Name="YText" Grid.Column="1" TextAlignment="Right" VerticalAlignment="Center"/></Grid>
<TextBlock Text="TRANSPARÊNCIA" Foreground="#6DB3FA" FontSize="12" FontWeight="Bold" Margin="0,16,0,3"/>
<Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions><Slider x:Name="OpacitySlider" Minimum="0.35" Maximum="1" ValueChanged="SettingChanged"/><TextBlock x:Name="OpacityText" Grid.Column="1" TextAlignment="Right" VerticalAlignment="Center"/></Grid>
<TextBlock Text="ESCALA" Foreground="#6DB3FA" FontSize="12" FontWeight="Bold" Margin="0,14,0,3"/>
<Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions><Slider x:Name="ScaleSlider" Minimum="0.55" Maximum="1.00" ValueChanged="SettingChanged"/><TextBlock x:Name="ScaleText" Grid.Column="1" TextAlignment="Right" VerticalAlignment="Center"/></Grid>
</StackPanel></ScrollViewer>
<StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0"><Button Content="CANCELAR" Width="120" Height="44" Margin="0,0,8,0" Click="Cancel_Click"/><Button Content="SALVAR HUD" Width="140" Height="44" Background="#4298EF" Foreground="#080B0E" FontWeight="Bold" Click="Save_Click"/></StackPanel>
</Grid></Border></Window>