<UserControl x:Class="TransPoli.DashboardBackdrop"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsHitTestVisible="False" ClipToBounds="True" Focusable="False">
  <!-- Fundo TruckHub: cena noturna da estrada, malha de carbono, linhas de néon azuis e vinheta -->
  <Grid>
    <Border Background="#04070D"/>
    <Border>
      <Border.Background>
        <ImageBrush x:Name="SceneBrush" ImageSource="{StaticResource BrandScene}" Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Center"/>
      </Border.Background>
    </Border>
    <Border>
      <Border.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
          <GradientStop Color="#B004070D" Offset="0"/>
          <GradientStop Color="#70050810" Offset="0.5"/>
          <GradientStop Color="#C804070D" Offset="1"/>
        </LinearGradientBrush>
      </Border.Background>
    </Border>
    <Border Opacity="0.22">
      <Border.Background>
        <DrawingBrush TileMode="Tile" Viewport="0,0,10,10" ViewportUnits="Absolute">
          <DrawingBrush.Drawing>
            <DrawingGroup>
              <GeometryDrawing Brush="#0A1018"><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,10,10"/></GeometryDrawing.Geometry></GeometryDrawing>
              <GeometryDrawing Brush="#142130"><GeometryDrawing.Geometry><GeometryGroup><RectangleGeometry Rect="0,0,5,5"/><RectangleGeometry Rect="5,5,5,5"/></GeometryGroup></GeometryDrawing.Geometry></GeometryDrawing>
            </DrawingGroup>
          </DrawingBrush.Drawing>
        </DrawingBrush>
      </Border.Background>
    </Border>
    <Border>
      <Border.Background>
        <RadialGradientBrush Center="0.5,0.45" RadiusX="0.9" RadiusY="0.9">
          <GradientStop Color="#00030609" Offset="0.5"/>
          <GradientStop Color="#D8030609" Offset="1"/>
        </RadialGradientBrush>
      </Border.Background>
    </Border>
    <!-- Linhas de néon nas bordas, como no painel de referência -->
    <Border Height="2" VerticalAlignment="Top" Margin="70,0,70,0">
      <Border.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
          <GradientStop Color="#001E9BFF" Offset="0"/><GradientStop Color="#CC1E9BFF" Offset="0.5"/><GradientStop Color="#001E9BFF" Offset="1"/>
        </LinearGradientBrush>
      </Border.Background>
    </Border>
    <Border Height="2" VerticalAlignment="Bottom" Margin="70,0,70,0">
      <Border.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
          <GradientStop Color="#001E9BFF" Offset="0"/><GradientStop Color="#CC1E9BFF" Offset="0.5"/><GradientStop Color="#001E9BFF" Offset="1"/>
        </LinearGradientBrush>
      </Border.Background>
    </Border>
    <Path Data="M0,64 L64,0" Stroke="#CC1E9BFF" StrokeThickness="2.5" HorizontalAlignment="Left" VerticalAlignment="Top" Width="64" Height="64"/>
    <Path Data="M0,64 L64,0" Stroke="#CC1E9BFF" StrokeThickness="2.5" HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="64" Height="64"/>
    <Path Data="M0,0 L64,64" Stroke="#661E9BFF" StrokeThickness="2" HorizontalAlignment="Right" VerticalAlignment="Top" Width="64" Height="64"/>
    <Path Data="M0,0 L64,64" Stroke="#661E9BFF" StrokeThickness="2" HorizontalAlignment="Left" VerticalAlignment="Bottom" Width="64" Height="64"/>
  </Grid>
</UserControl>
