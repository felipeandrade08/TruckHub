<UserControl x:Class="TransPoli.DashboardBackdrop"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsHitTestVisible="False" ClipToBounds="True" Focusable="False">
  <!-- Fundo de painel de caminhão: fibra de carbono, brilho diagonal do vidro, vinheta e anéis de instrumento -->
  <Grid>
    <Border Background="#0B1118"/>
    <Border>
      <Border.Background>
        <DrawingBrush TileMode="Tile" Viewport="0,0,10,10" ViewportUnits="Absolute">
          <DrawingBrush.Drawing>
            <DrawingGroup>
              <GeometryDrawing Brush="#0C131B"><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,10,10"/></GeometryDrawing.Geometry></GeometryDrawing>
              <GeometryDrawing Brush="#101923"><GeometryDrawing.Geometry><GeometryGroup><RectangleGeometry Rect="0,0,5,5"/><RectangleGeometry Rect="5,5,5,5"/></GeometryGroup></GeometryDrawing.Geometry></GeometryDrawing>
              <GeometryDrawing Brush="#0A1017"><GeometryDrawing.Geometry><GeometryGroup><RectangleGeometry Rect="5,0,5,5"/><RectangleGeometry Rect="0,5,5,5"/></GeometryGroup></GeometryDrawing.Geometry></GeometryDrawing>
            </DrawingGroup>
          </DrawingBrush.Drawing>
        </DrawingBrush>
      </Border.Background>
    </Border>
    <Border>
      <Border.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
          <GradientStop Color="#1FFFFFFF" Offset="0"/>
          <GradientStop Color="#00FFFFFF" Offset="0.32"/>
          <GradientStop Color="#00FFFFFF" Offset="0.68"/>
          <GradientStop Color="#12E7B84A" Offset="1"/>
        </LinearGradientBrush>
      </Border.Background>
    </Border>
    <Ellipse Width="1100" Height="1100" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,-700"
             Stroke="#30E7B84A" StrokeThickness="3" StrokeDashArray="0.5 6"/>
    <Ellipse Width="1000" Height="1000" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,-650"
             Stroke="#14FFFFFF" StrokeThickness="1.5"/>
    <Ellipse Width="700" Height="700" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-380,-380,0,0"
             Stroke="#22E7B84A" StrokeThickness="2" StrokeDashArray="0.5 7"/>
    <Border>
      <Border.Background>
        <RadialGradientBrush Center="0.5,0.45" RadiusX="0.85" RadiusY="0.85">
          <GradientStop Color="#00070B10" Offset="0.45"/>
          <GradientStop Color="#E0070B10" Offset="1"/>
        </RadialGradientBrush>
      </Border.Background>
    </Border>
    <Border Height="2" VerticalAlignment="Bottom" Margin="40,0,40,0">
      <Border.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
          <GradientStop Color="#00E7B84A" Offset="0"/><GradientStop Color="#66E7B84A" Offset="0.5"/><GradientStop Color="#00E7B84A" Offset="1"/>
        </LinearGradientBrush>
      </Border.Background>
    </Border>
  </Grid>
</UserControl>
