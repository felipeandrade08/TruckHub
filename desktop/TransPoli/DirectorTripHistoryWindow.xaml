<Window x:Class="TransPoli.DirectorTripHistoryWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Width="1050" Height="700" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" WindowStyle="None" AllowsTransparency="True" Background="Transparent">
<Border Background="#0A0F14" BorderBrush="#34404C" BorderThickness="1" CornerRadius="20" Padding="22"><Grid>
<Grid.RowDefinitions><RowDefinition Height="66"/><RowDefinition Height="*"/><RowDefinition Height="48"/></Grid.RowDefinitions>
<StackPanel><TextBlock Text="OPERAÇÃO DA TRANSPOLI" Foreground="#D7B34A" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="TitleText" Text="Detalhes da viagem" Foreground="#F2F4F6" FontSize="24" FontWeight="Bold" Margin="0,4,0,0"/></StackPanel>
<TabControl Grid.Row="1" Background="#0A0F14" BorderThickness="0">
<TabItem Header="RESUMO"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="8">
<UniformGrid Columns="4" Margin="0,0,0,12">
<Border Background="#0D141B" CornerRadius="12" Padding="14" Margin="0,0,6,0"><StackPanel><TextBlock Text="MOTORISTA" Foreground="#7F8B98" FontSize="8"/><TextBlock x:Name="DriverText" Foreground="#F2F4F6" FontSize="14" FontWeight="Bold"/></StackPanel></Border>
<Border Background="#0D141B" CornerRadius="12" Padding="14" Margin="2,0,4,0"><StackPanel><TextBlock Text="ROTA" Foreground="#7F8B98" FontSize="8"/><TextBlock x:Name="RouteText" Foreground="#F2F4F6" FontSize="13" FontWeight="Bold"/></StackPanel></Border>
<Border Background="#0D141B" CornerRadius="12" Padding="14" Margin="4,0,2,0"><StackPanel><TextBlock Text="DISTÂNCIA" Foreground="#7F8B98" FontSize="8"/><TextBlock x:Name="DistanceText" Foreground="#F2F4F6" FontSize="14" FontWeight="Bold"/></StackPanel></Border>
<Border Background="#141109" CornerRadius="12" Padding="14" Margin="6,0,0,0"><StackPanel><TextBlock Text="RESULTADO" Foreground="#7F8B98" FontSize="8"/><TextBlock x:Name="ResultText" Foreground="#D7B34A" FontSize="14" FontWeight="Bold"/></StackPanel></Border></UniformGrid>
<Border Background="#0C1319" BorderBrush="#26313D" BorderThickness="1" CornerRadius="14" Padding="16"><TextBlock x:Name="SummaryText" Foreground="#A5AFBA" FontSize="11" TextWrapping="Wrap"/></Border>
</StackPanel></ScrollViewer></TabItem>
<TabItem Header="DESPESAS"><DataGrid x:Name="ExpensesGrid" AutoGenerateColumns="True" IsReadOnly="True" CanUserAddRows="False" Margin="8" Background="#0C1319" Foreground="#F2F4F6" BorderThickness="0"/></TabItem>
<TabItem Header="TELEMETRIA"><DataGrid x:Name="TelemetryGrid" AutoGenerateColumns="True" IsReadOnly="True" CanUserAddRows="False" Margin="8" Background="#0C1319" Foreground="#F2F4F6" BorderThickness="0"/></TabItem>
<TabItem Header="EVENTOS"><DataGrid x:Name="EventsGrid" AutoGenerateColumns="True" IsReadOnly="True" CanUserAddRows="False" Margin="8" Background="#0C1319" Foreground="#F2F4F6" BorderThickness="0"/></TabItem>
</TabControl>
<StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="FECHAR" Click="Close_Click" Width="110" Height="36" Background="#111820" Foreground="#D7B34A" BorderBrush="#26313D"/></StackPanel>
</Grid></Border></Window>