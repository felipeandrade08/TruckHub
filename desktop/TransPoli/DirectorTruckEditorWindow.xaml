<Window x:Class="TransPoli.DirectorTruckEditorWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Width="430" Height="500" Background="#0A0F14" WindowStyle="None" AllowsTransparency="True">
 <Window.Resources>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#111922"/><Setter Property="Foreground" Value="#F4F6F8"/><Setter Property="BorderBrush" Value="#34404C"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="10,7"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style TargetType="PasswordBox"><Setter Property="Background" Value="#111922"/><Setter Property="Foreground" Value="#F4F6F8"/><Setter Property="BorderBrush" Value="#34404C"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="10,7"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Background" Value="#111922"/><Setter Property="Foreground" Value="#F4F6F8"/><Setter Property="BorderBrush" Value="#34404C"/><Setter Property="Padding" Value="8,5"/></Style>
  <Style TargetType="Button"><Setter Property="Background" Value="#111820"/><Setter Property="Foreground" Value="#FFE19A"/><Setter Property="BorderBrush" Value="#34404C"/><Setter Property="BorderThickness" Value="1"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
 </Window.Resources>
 <Border Background="#0D141B" BorderBrush="#34404C" BorderThickness="1" CornerRadius="18" Padding="24">
  <StackPanel>
   <TextBlock Text="CAMINHÃO DA TRANSPOLI" Foreground="#FFE19A" FontSize="11" FontWeight="Bold"/>
   <TextBlock x:Name="TitleText" Text="Cadastrar caminhão" Foreground="#F4F6F8" FontSize="23" FontWeight="Bold" Margin="0,5,0,18"/>
   <TextBlock Text="MOTORISTA" Foreground="#8E9AA8" FontSize="12"/><ComboBox x:Name="DriverBox" Height="38" Margin="0,5,0,12" Background="#111922" Foreground="#F4F6F8"/>
   <TextBlock Text="NOME DO CAMINHÃO" Foreground="#8E9AA8" FontSize="12"/><TextBox x:Name="TruckNameBox" Height="38" Margin="0,5,0,12"/>
   <TextBlock Text="MARCA" Foreground="#8E9AA8" FontSize="12"/><TextBox x:Name="BrandBox" Height="38" Margin="0,5,0,12"/>
   <TextBlock Text="MODELO" Foreground="#8E9AA8" FontSize="12"/><TextBox x:Name="ModelBox" Height="38" Margin="0,5,0,12"/>
   <TextBlock Text="PLACA" Foreground="#8E9AA8" FontSize="12"/><TextBox x:Name="PlateBox" Height="38" Margin="0,5,0,18"/>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="CANCELAR" Click="Cancel_Click" Width="100" Height="36" Margin="0,0,8,0"/><Button Content="SALVAR" Click="Save_Click" Width="100" Height="36"/></StackPanel>
  </StackPanel>
 </Border>
</Window>
