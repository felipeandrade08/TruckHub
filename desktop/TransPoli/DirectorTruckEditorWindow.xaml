<Window x:Class="TransPoli.DirectorTruckEditorWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Width="430" Height="500" Background="#0A0F14" WindowStyle="None" AllowsTransparency="True">
 <Border Background="#0D141B" BorderBrush="#34404C" BorderThickness="1" CornerRadius="18" Padding="24">
  <StackPanel>
   <TextBlock Text="CAMINHÃO DA TRANSPOLI" Foreground="#D7B34A" FontSize="11" FontWeight="Bold"/>
   <TextBlock x:Name="TitleText" Text="Cadastrar caminhão" Foreground="#F2F4F6" FontSize="23" FontWeight="Bold" Margin="0,5,0,18"/>
   <TextBlock Text="MOTORISTA" Foreground="#7F8B98" FontSize="12"/><ComboBox x:Name="DriverBox" Height="38" Margin="0,5,0,12" Background="#111922" Foreground="#F2F4F6"/>
   <TextBlock Text="NOME DO CAMINHÃO" Foreground="#7F8B98" FontSize="12"/><TextBox x:Name="TruckNameBox" Height="38" Margin="0,5,0,12"/>
   <TextBlock Text="MARCA" Foreground="#7F8B98" FontSize="12"/><TextBox x:Name="BrandBox" Height="38" Margin="0,5,0,12"/>
   <TextBlock Text="MODELO" Foreground="#7F8B98" FontSize="12"/><TextBox x:Name="ModelBox" Height="38" Margin="0,5,0,12"/>
   <TextBlock Text="PLACA" Foreground="#7F8B98" FontSize="12"/><TextBox x:Name="PlateBox" Height="38" Margin="0,5,0,18"/>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="CANCELAR" Click="Cancel_Click" Width="100" Height="36" Margin="0,0,8,0"/><Button Content="SALVAR" Click="Save_Click" Width="100" Height="36"/></StackPanel>
  </StackPanel>
 </Border>
</Window>
