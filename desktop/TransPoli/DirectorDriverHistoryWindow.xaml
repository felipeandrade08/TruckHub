<Window x:Class="TransPoli.DirectorDriverHistoryWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" WindowStartupLocation="CenterOwner" ResizeMode="CanResize" Width="820" Height="620" Background="Transparent" WindowStyle="None" AllowsTransparency="True">
 <Border Background="#0D141B" BorderBrush="#34404C" BorderThickness="1" CornerRadius="20" Padding="22">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="55"/><RowDefinition Height="*"/><RowDefinition Height="45"/></Grid.RowDefinitions>
   <StackPanel><TextBlock Text="HISTÓRICO OPERACIONAL" Foreground="#FFE19A" FontSize="12" FontWeight="Bold"/><TextBlock x:Name="TitleText" Text="Motorista" Foreground="#F4F6F8" FontSize="22" FontWeight="Bold" Margin="0,3,0,0"/></StackPanel>
   <TabControl Grid.Row="1" Background="#0B1117" Foreground="#F4F6F8">
    <TabItem Header="VIAGENS"><DataGrid x:Name="TripsGrid" AutoGenerateColumns="True" IsReadOnly="True" CanUserAddRows="False" Background="#0B1117" Foreground="#F4F6F8" BorderThickness="0"/></TabItem>
    <TabItem Header="EVENTOS"><DataGrid x:Name="EventsGrid" AutoGenerateColumns="True" IsReadOnly="True" CanUserAddRows="False" Background="#0B1117" Foreground="#F4F6F8" BorderThickness="0"/></TabItem>
   </TabControl>
   <TextBlock Grid.Row="2" x:Name="StatusText" Foreground="#8E9AA8" VerticalAlignment="Center"/>
  </Grid>
 </Border>
</Window>