<Window x:Class="TransPoli.DirectorDriverHistoryWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" WindowStartupLocation="CenterOwner" ResizeMode="CanResize" Width="820" Height="620" Background="Transparent" WindowStyle="None" AllowsTransparency="True">
 <Border Background="#0D141B" BorderBrush="#34404C" BorderThickness="1" CornerRadius="20" Padding="22">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="*"/><RowDefinition Height="48"/></Grid.RowDefinitions>
   <Grid MouseLeftButtonDown="DragWindow"><StackPanel><TextBlock Text="HISTÓRICO OPERACIONAL" Foreground="#FFE19A" FontSize="12" FontWeight="Bold"/><TextBlock x:Name="TitleText" Text="Motorista" Foreground="#F4F6F8" FontSize="22" FontWeight="Bold" Margin="0,3,0,0"/></StackPanel><Button Content="✕" Click="Close_Click" Width="36" Height="32" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#111820" Foreground="#FFE19A" BorderBrush="#303A44"/></Grid>
   <TabControl Grid.Row="1" Background="#0B1117" Foreground="#F4F6F8">
    <TabItem Header="VIAGENS"><DataGrid x:Name="TripsGrid" AutoGenerateColumns="True" IsReadOnly="True" CanUserAddRows="False" RowHeight="42" ColumnHeaderHeight="40" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#1D2731" AlternatingRowBackground="#101820" Background="#0B1117" Foreground="#F4F6F8" BorderThickness="0"/></TabItem>
    <TabItem Header="EVENTOS"><DataGrid x:Name="EventsGrid" AutoGenerateColumns="True" IsReadOnly="True" CanUserAddRows="False" RowHeight="42" ColumnHeaderHeight="40" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#1D2731" AlternatingRowBackground="#101820" Background="#0B1117" Foreground="#F4F6F8" BorderThickness="0"/></TabItem>
   </TabControl>
   <Grid Grid.Row="2"><TextBlock x:Name="StatusText" Foreground="#8E9AA8" VerticalAlignment="Center"/><Button Content="FECHAR" Click="Close_Click" Width="110" Height="36" HorizontalAlignment="Right" VerticalAlignment="Center" Background="#111820" Foreground="#FFE19A" BorderBrush="#303A44"/></Grid>
  </Grid>
 </Border>
</Window>