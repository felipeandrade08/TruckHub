<Window x:Class="TransPoli.DirectorCenterWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="TransPoli • Central da Diretoria" Width="1280" Height="820"
 WindowStyle="None" AllowsTransparency="True" Background="Transparent"
 ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
 Icon="/TransPoli;component/Assets/transpoli-logo.png">
 <Window.Resources>
  <SolidColorBrush x:Key="Bg" Color="#070A0E"/>
  <SolidColorBrush x:Key="Panel" Color="#0D1319"/>
  <SolidColorBrush x:Key="Stroke" Color="#26313D"/>
  <SolidColorBrush x:Key="Text" Color="#F4F6F8"/>
  <SolidColorBrush x:Key="Muted" Color="#8E9AA8"/>
  <SolidColorBrush x:Key="Gold" Color="#D8A92E"/>
  <SolidColorBrush x:Key="GoldBright" Color="#FFE19A"/>
  <SolidColorBrush x:Key="Green" Color="#54D99B"/>
  <Style x:Key="Field" TargetType="Control">
   <Setter Property="Background" Value="#080D12"/><Setter Property="Foreground" Value="{StaticResource Text}"/>
   <Setter Property="BorderBrush" Value="{StaticResource Stroke}"/><Setter Property="BorderThickness" Value="1"/>
  </Style>
  <Style x:Key="Action" TargetType="Button">
   <Setter Property="Background" Value="{StaticResource Gold}"/><Setter Property="Foreground" Value="#120F07"/>
   <Setter Property="BorderThickness" Value="0"/><Setter Property="Height" Value="44"/>
   <Setter Property="FontWeight" Value="Bold"/><Setter Property="Cursor" Value="Hand"/>
  </Style>
  <Style x:Key="Ghost" TargetType="Button">
   <Setter Property="Background" Value="#111820"/><Setter Property="Foreground" Value="{StaticResource GoldBright}"/>
   <Setter Property="BorderBrush" Value="{StaticResource Stroke}"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Height" Value="40"/><Setter Property="Cursor" Value="Hand"/>
  </Style>
 </Window.Resources>
 <Grid Margin="14">
  <Border Margin="1" Background="#020305" BorderBrush="#11161C" BorderThickness="2" CornerRadius="34">
   <Border.Effect><DropShadowEffect BlurRadius="42" ShadowDepth="0" Opacity=".72"/></Border.Effect>
  </Border>
  <Border Margin="8" Background="#080C10" BorderBrush="#3F4953" BorderThickness="1" CornerRadius="28">
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="66"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border Grid.Row="0" Background="#0C1218" CornerRadius="28,28,0,0" BorderBrush="#222C36" BorderThickness="0,0,0,1">
     <Grid MouseLeftButtonDown="DragWindow">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0,0,0">
       <Border Width="38" Height="38" CornerRadius="11" Background="#171D24" Padding="6"><Image Source="{StaticResource BrandLogo}"/></Border>
       <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
        <TextBlock Text="TRANSPOLI • CENTRAL DA DIRETORIA" Foreground="{StaticResource Text}" FontSize="15" FontWeight="Bold"/>
        <TextBlock x:Name="HeaderCompanyText" Text="Gestão empresarial e de frota" Foreground="{StaticResource Muted}" FontSize="9"/>
       </StackPanel>
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,18,0">
       <Button Width="34" Height="34" Content="—" Click="Minimize_Click" Background="#151A20" Foreground="{StaticResource Muted}" BorderThickness="0"/>
       <Button Width="34" Height="34" Content="×" Click="Close_Click" Background="#151A20" Foreground="{StaticResource Muted}" BorderThickness="0" Margin="5,0,0,0"/>
      </StackPanel>
     </Grid>
    </Border>

    <Grid Grid.Row="1" x:Name="LoginView" Margin="72,44,72,44">
     <Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="420"/></Grid.ColumnDefinitions>
     <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="20,0,80,0">
      <TextBlock Text="CENTRAL TRANSPOLI" Foreground="{StaticResource GoldBright}" FontSize="12" FontWeight="Bold"/>
      <TextBlock Text="A gestão da empresa começa aqui." Foreground="{StaticResource Text}" FontSize="38" FontWeight="Bold" Margin="0,8,0,0"/>
      <TextBlock Text="Acesso separado do computador de bordo. Motoristas continuam no ambiente do cockpit; a diretoria trabalha com frota, operações e financeiro." Foreground="{StaticResource Muted}" FontSize="14" TextWrapping="Wrap" MaxWidth="650" Margin="0,14,0,0"/>
      <Border Background="#0C1319" BorderBrush="#26313D" BorderThickness="1" CornerRadius="16" Padding="18" Margin="0,30,0,0">
       <StackPanel>
        <TextBlock Text="DADOS REAIS" Foreground="{StaticResource GoldBright}" FontSize="9" FontWeight="Bold"/>
        <TextBlock Text="Os indicadores só aparecem depois que existirem registros reais de motoristas, caminhões, viagens e despesas vinculados à empresa." Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/>
       </StackPanel>
      </Border>
     </StackPanel>
     <Border Grid.Column="1" Background="#0D141B" BorderBrush="#34404C" BorderThickness="1" CornerRadius="22" Padding="28">
      <StackPanel>
       <TextBlock Text="ACESSO DA DIRETORIA" Foreground="{StaticResource Text}" FontSize="21" FontWeight="Bold"/>
       <TextBlock Text="E-mail cadastrado + PIN exclusivo da diretoria." Foreground="{StaticResource Muted}" FontSize="10.5" Margin="0,5,0,22"/>
       <TextBlock Text="E-MAIL DA DIRETORIA" Foreground="{StaticResource Muted}" FontSize="9" FontWeight="Bold"/>
       <TextBox x:Name="DirectorEmailBox" Height="44" Margin="0,6,0,14" Padding="12,0" VerticalContentAlignment="Center" Style="{StaticResource Field}"/>
       <TextBlock Text="PIN ÚNICO" Foreground="{StaticResource Muted}" FontSize="9" FontWeight="Bold"/>
       <PasswordBox x:Name="DirectorPinBox" Height="48" Margin="0,6,0,8" Padding="12,0" VerticalContentAlignment="Center" FontSize="20" MaxLength="6" Style="{StaticResource Field}"/>
       <TextBlock x:Name="StatusText" Text="Pronto para entrar." Foreground="{StaticResource Muted}" FontSize="10" TextWrapping="Wrap" MinHeight="34"/>
       <Button x:Name="LoginButton" Content="ENTRAR NA CENTRAL  ›" Click="Login_Click" Style="{StaticResource Action}" Margin="0,4,0,9"/>
       <Button Content="ESQUECI MEU PIN" Click="ForgotPin_Click" Background="Transparent" Foreground="{StaticResource GoldBright}" BorderThickness="0" Height="32" Cursor="Hand"/>
       <Button Content="PRIMEIRO ACESSO / CRIAR EMPRESA" Click="ShowSetup_Click" Style="{StaticResource Ghost}"/>
       <Button Content="← VOLTAR PARA MOTORISTA" Click="BackToDriver_Click" Background="Transparent" Foreground="{StaticResource Muted}" BorderThickness="0" Height="36" Cursor="Hand"/>
      </StackPanel>
     </Border>
    </Grid>

    <Grid Grid.Row="1" x:Name="SetupView" Visibility="Collapsed" Margin="72,30,72,30">
     <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="440"/></Grid.ColumnDefinitions>
     <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="20,0,80,0">
      <TextBlock Text="CONFIGURAÇÃO INICIAL" Foreground="{StaticResource GoldBright}" FontSize="12" FontWeight="Bold"/>
      <TextBlock Text="Crie o ambiente da sua empresa." Foreground="{StaticResource Text}" FontSize="34" FontWeight="Bold" Margin="0,8,0,0"/>
      <TextBlock Text="A conta atual será a responsável pela criação da empresa. Depois disso, o acesso da diretoria será separado por e-mail e PIN próprio." Foreground="{StaticResource Muted}" FontSize="13" TextWrapping="Wrap" MaxWidth="650" Margin="0,14,0,0"/>
     </StackPanel>
     <Border Grid.Column="1" Background="#0D141B" BorderBrush="#34404C" BorderThickness="1" CornerRadius="22" Padding="26">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
       <StackPanel>
        <TextBlock Text="CRIAR CENTRAL" Foreground="{StaticResource Text}" FontSize="20" FontWeight="Bold"/>
        <TextBlock Text="Primeiro, confirme a conta proprietária." Foreground="{StaticResource Muted}" FontSize="10" Margin="0,5,0,17"/>
        <TextBlock Text="E-MAIL DA CONTA ATUAL" Foreground="{StaticResource Muted}" FontSize="9" FontWeight="Bold"/>
        <TextBox x:Name="OwnerEmailBox" Height="40" Margin="0,5,0,10" Padding="11,0" VerticalContentAlignment="Center" Style="{StaticResource Field}"/>
        <TextBlock Text="PIN DA CONTA ATUAL" Foreground="{StaticResource Muted}" FontSize="9" FontWeight="Bold"/>
        <PasswordBox x:Name="OwnerPinBox" Height="42" Margin="0,5,0,13" Padding="11,0" VerticalContentAlignment="Center" FontSize="17" MaxLength="6" Style="{StaticResource Field}"/>
        <TextBlock Text="NOME DA EMPRESA" Foreground="{StaticResource Muted}" FontSize="9" FontWeight="Bold"/>
        <TextBox x:Name="CompanyNameBox" Height="40" Margin="0,5,0,10" Padding="11,0" VerticalContentAlignment="Center" Style="{StaticResource Field}"/>
        <TextBlock Text="E-MAIL DA DIRETORIA" Foreground="{StaticResource Muted}" FontSize="9" FontWeight="Bold"/>
        <TextBox x:Name="SetupDirectorEmailBox" Height="40" Margin="0,5,0,10" Padding="11,0" VerticalContentAlignment="Center" Style="{StaticResource Field}"/>
        <TextBlock Text="PIN DA DIRETORIA" Foreground="{StaticResource Muted}" FontSize="9" FontWeight="Bold"/>
        <PasswordBox x:Name="SetupDirectorPinBox" Height="42" Margin="0,5,0,15" Padding="11,0" VerticalContentAlignment="Center" FontSize="18" MaxLength="6" Style="{StaticResource Field}"/>
        <TextBlock x:Name="SetupStatusText" Text="" Foreground="{StaticResource Muted}" FontSize="9.5" TextWrapping="Wrap" MinHeight="34"/>
        <Button x:Name="SetupButton" Content="CRIAR CENTRAL  ›" Click="Setup_Click" Style="{StaticResource Action}" Margin="0,4,0,7"/>
        <Button Content="← VOLTAR AO LOGIN DA DIRETORIA" Click="BackToLogin_Click" Background="Transparent" Foreground="{StaticResource Muted}" BorderThickness="0" Height="34" Cursor="Hand"/>
       </StackPanel>
      </ScrollViewer>
     </Border>
    </Grid>

    <Grid Grid.Row="1" x:Name="DashboardView" Visibility="Collapsed" Margin="28,22,28,24">
     <Grid.RowDefinitions><RowDefinition Height="88"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Grid Grid.Row="0">
      <StackPanel>
       <TextBlock Text="VISÃO GERAL" Foreground="{StaticResource GoldBright}" FontSize="10" FontWeight="Bold"/>
       <TextBlock Text="Central da Diretoria" Foreground="{StaticResource Text}" FontSize="28" FontWeight="Bold" Margin="0,4,0,0"/>
      </StackPanel>
      <Button Content="SAIR" Click="Logout_Click" Width="82" Height="36" HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource Ghost}"/>
     </Grid>
     <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel>
       <UniformGrid Columns="4" Margin="0,0,0,16">
        <Border Background="#0E1715" BorderBrush="#285440" BorderThickness="1" CornerRadius="14" Padding="16" Margin="0,0,6,0"><StackPanel><TextBlock Text="MOTORISTAS ATIVOS" Foreground="{StaticResource Muted}" FontSize="8"/><TextBlock x:Name="KpiDrivers" Text="—" Foreground="{StaticResource Text}" FontSize="25" FontWeight="Bold" Margin="0,4,0,0"/></StackPanel></Border>
        <Border Background="#0D141B" BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="14" Padding="16" Margin="2,0,4,0"><StackPanel><TextBlock Text="CAMINHÕES" Foreground="{StaticResource Muted}" FontSize="8"/><TextBlock x:Name="KpiTrucks" Text="—" Foreground="{StaticResource Text}" FontSize="25" FontWeight="Bold" Margin="0,4,0,0"/></StackPanel></Border>
        <Border Background="#0D141B" BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="14" Padding="16" Margin="4,0,2,0"><StackPanel><TextBlock Text="VIAGENS HOJE" Foreground="{StaticResource Muted}" FontSize="8"/><TextBlock x:Name="KpiTrips" Text="—" Foreground="{StaticResource Text}" FontSize="25" FontWeight="Bold" Margin="0,4,0,0"/></StackPanel></Border>
        <Border Background="#141109" BorderBrush="#604A0B" BorderThickness="1" CornerRadius="14" Padding="16" Margin="6,0,0,0"><StackPanel><TextBlock Text="RESULTADO" Foreground="{StaticResource Muted}" FontSize="8"/><TextBlock x:Name="KpiResult" Text="—" Foreground="{StaticResource GoldBright}" FontSize="22" FontWeight="Bold" Margin="0,4,0,0"/></StackPanel></Border>
       </UniformGrid>
       <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#0C1319" BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="16" Padding="16" Margin="0,0,5,0">
         <StackPanel><TextBlock Text="FROTA" Foreground="{StaticResource GoldBright}" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="FleetText" Text="Nenhum caminhão cadastrado." Foreground="{StaticResource Muted}" FontSize="10" Margin="0,10,0,0" TextWrapping="Wrap"/></StackPanel>
        </Border>
        <Border Grid.Column="1" Background="#0C1319" BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="16" Padding="16" Margin="5,0">
         <StackPanel><TextBlock Text="MOTORISTAS" Foreground="{StaticResource GoldBright}" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="DriversText" Text="Nenhum motorista vinculado." Foreground="{StaticResource Muted}" FontSize="10" Margin="0,10,0,0" TextWrapping="Wrap"/></StackPanel>
        </Border>
        <Border Grid.Column="2" Background="#0C1319" BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="16" Padding="16" Margin="5,0,0,0">
         <StackPanel><TextBlock Text="OPERAÇÕES RECENTES" Foreground="{StaticResource GoldBright}" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="OperationsText" Text="Nenhuma viagem registrada." Foreground="{StaticResource Muted}" FontSize="10" Margin="0,10,0,0" TextWrapping="Wrap"/></StackPanel>
        </Border>
       </Grid>
       <Border Background="#0C1319" BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="16" Padding="16" Margin="0,10,0,0">
        <TextBlock x:Name="FinancialText" Text="Receitas e despesas serão exibidas somente quando houver dados reais." Foreground="{StaticResource Muted}" FontSize="10" TextWrapping="Wrap"/>
       </Border>
      </StackPanel>
     </ScrollViewer>
    </Grid>
   </Grid>
  </Border>
 </Grid>
</Window>