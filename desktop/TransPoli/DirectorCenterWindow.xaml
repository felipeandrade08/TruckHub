<Window x:Class="TransPoli.DirectorCenterWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="TransPoli • Central da Diretoria" Width="1280" Height="820"
 WindowStyle="None" AllowsTransparency="True" Background="Transparent"
 ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
 <Window.Resources>
  <SolidColorBrush x:Key="Bg" Color="#070A0E"/>
  <SolidColorBrush x:Key="Panel" Color="#0D1319"/>
  <SolidColorBrush x:Key="Stroke" Color="#26313D"/>
  <SolidColorBrush x:Key="Text" Color="#F4F6F8"/>
  <SolidColorBrush x:Key="Muted" Color="#8E9AA8"/>
  <SolidColorBrush x:Key="Gold" Color="#D8A92E"/>
  <SolidColorBrush x:Key="GoldBright" Color="#FFE19A"/>
  <SolidColorBrush x:Key="Green" Color="#54D99B"/>
  <Style x:Key="Field" TargetType="Control">
   <Setter Property="Background" Value="#080D12"/><Setter Property="Foreground" Value="{StaticResource Text}"/>
   <Setter Property="BorderBrush" Value="{StaticResource Stroke}"/><Setter Property="BorderThickness" Value="1"/>
  </Style>
  <Style x:Key="Action" TargetType="Button">
   <Setter Property="Background" Value="{StaticResource Gold}"/><Setter Property="Foreground" Value="#120F07"/>
   <Setter Property="BorderThickness" Value="0"/><Setter Property="Height" Value="44"/>
   <Setter Property="FontWeight" Value="Bold"/><Setter Property="Cursor" Value="Hand"/>
  </Style>
  <Style x:Key="Ghost" TargetType="Button">
   <Setter Property="Background" Value="#111820"/><Setter Property="Foreground" Value="{StaticResource GoldBright}"/>
   <Setter Property="BorderBrush" Value="{StaticResource Stroke}"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Height" Value="40"/><Setter Property="Cursor" Value="Hand"/>
  </Style>
  <Style x:Key="DirectorGrid" TargetType="DataGrid">
   <Setter Property="Background" Value="#0B1117"/>
   <Setter Property="Foreground" Value="{StaticResource Text}"/>
   <Setter Property="BorderThickness" Value="0"/>
   <Setter Property="RowBackground" Value="#0B1117"/>
   <Setter Property="AlternatingRowBackground" Value="#101820"/>
   <Setter Property="GridLinesVisibility" Value="Horizontal"/>
   <Setter Property="HorizontalGridLinesBrush" Value="#1D2731"/>
   <Setter Property="VerticalGridLinesBrush" Value="#1D2731"/>
   <Setter Property="SelectionMode" Value="Single"/>
   <Setter Property="SelectionUnit" Value="FullRow"/>
   <Setter Property="CanUserResizeRows" Value="False"/>
   <Setter Property="ColumnHeaderHeight" Value="34"/>
   <Setter Property="RowHeight" Value="32"/>
   <Setter Property="ColumnWidth" Value="*"/>
  </Style>
  <Style TargetType="DataGridColumnHeader">
   <Setter Property="Background" Value="#151D26"/>
   <Setter Property="Foreground" Value="{StaticResource GoldBright}"/>
   <Setter Property="BorderBrush" Value="#26313D"/>
   <Setter Property="BorderThickness" Value="0,0,0,1"/>
   <Setter Property="FontSize" Value="9"/>
   <Setter Property="FontWeight" Value="Bold"/>
   <Setter Property="Padding" Value="10,0"/>
  </Style>
  <Style TargetType="DataGridRow">
   <Setter Property="Foreground" Value="{StaticResource Text}"/>
   <Setter Property="Background" Value="#0B1117"/>
   <Setter Property="BorderBrush" Value="#1D2731"/>
  </Style>
  <Style TargetType="DataGridCell">
   <Setter Property="Foreground" Value="{StaticResource Text}"/>
   <Setter Property="Background" Value="Transparent"/>
   <Setter Property="BorderThickness" Value="0"/>
   <Setter Property="Padding" Value="10,0"/>
  </Style>
  <Style x:Key="StatusFilter" TargetType="ComboBox">
   <Setter Property="Background" Value="#080D12"/>
   <Setter Property="Foreground" Value="{StaticResource Text}"/>
   <Setter Property="BorderBrush" Value="{StaticResource Stroke}"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Height" Value="36"/>
   <Setter Property="Padding" Value="10,0"/>
  </Style>
 </Window.Resources>
 <Grid Margin="14">
  <Border Margin="1" Background="#020305" BorderBrush="#11161C" BorderThickness="2" CornerRadius="34">
   <Border.Effect><DropShadowEffect BlurRadius="42" ShadowDepth="0" Opacity=".72"/></Border.Effect>
  </Border>
  <Border Margin="8" Background="#080C10" BorderBrush="#3F4953" BorderThickness="1" CornerRadius="28">
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="66"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border Grid.Row="0" Background="#0C1218" CornerRadius="28,28,0,0" BorderBrush="#222C36" BorderThickness="0,0,0,1">
     <Grid MouseLeftButtonDown="DragWindow">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0,0,0">
       <Border Width="38" Height="38" CornerRadius="11" Background="#171D24"><TextBlock Text="TP" Foreground="{StaticResource GoldBright}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
       <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
        <TextBlock Text="TRANSPOLI • CENTRAL DA DIRETORIA" Foreground="{StaticResource Text}" FontSize="15" FontWeight="Bold"/>
        <TextBlock x:Name="HeaderCompanyText" Text="Gestão empresarial e de frota" Foreground="{StaticResource Muted}" FontSize="12"/>
       </StackPanel>
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,18,0">
       <Button Width="34" Height="34" Content="—" Click="Minimize_Click" Background="#151A20" Foreground="{StaticResource Muted}" BorderThickness="0"/>
       <Button Width="34" Height="34" Content="×" Click="Close_Click" Background="#151A20" Foreground="{StaticResource Muted}" BorderThickness="0" Margin="5,0,0,0"/>
      </StackPanel>
     </Grid>
    </Border>

    <Grid Grid.Row="1" x:Name="LoginView" Margin="72,44,72,44">
     <Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="420"/></Grid.ColumnDefinitions>
     <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="20,0,80,0">
      <TextBlock Text="CENTRAL TRANSPOLI" Foreground="{StaticResource GoldBright}" FontSize="12" FontWeight="Bold"/>
      <TextBlock Text="A gestão da empresa começa aqui." Foreground="{StaticResource Text}" FontSize="38" FontWeight="Bold" Margin="0,8,0,0"/>
      <TextBlock Text="Acesso separado do computador de bordo. Motoristas continuam no ambiente do cockpit; a diretoria trabalha com frota, operações e financeiro." Foreground="{StaticResource Muted}" FontSize="14" TextWrapping="Wrap" MaxWidth="650" Margin="0,14,0,0"/>
      <Border Background="#0C1319" BorderBrush="#26313D" BorderThickness="1" CornerRadius="16" Padding="18" Margin="0,30,0,0">
       <StackPanel>
        <TextBlock Text="DADOS REAIS" Foreground="{StaticResource GoldBright}" FontSize="12" FontWeight="Bold"/>
        <TextBlock Text="Os indicadores só aparecem depois que existirem registros reais de motoristas, caminhões, viagens e despesas vinculados à empresa." Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/>
       </StackPanel>
      </Border>
     </StackPanel>
     <Border Grid.Column="1" Background="#0D141B" BorderBrush="#34404C" BorderThickness="1" CornerRadius="22" Padding="28">
      <StackPanel>
       <TextBlock Text="ACESSO DA DIRETORIA" Foreground="{StaticResource Text}" FontSize="21" FontWeight="Bold"/>
       <TextBlock Text="E-mail cadastrado + PIN exclusivo da diretoria." Foreground="{StaticResource Muted}" FontSize="13" Margin="0,5,0,22"/>
       <TextBlock Text="E-MAIL DA DIRETORIA" Foreground="{StaticResource Muted}" FontSize="12" FontWeight="Bold"/>
       <TextBox x:Name="DirectorEmailBox" Height="44" Margin="0,6,0,14" Padding="12,0" VerticalContentAlignment="Center" Style="{StaticResource Field}"/>
       <TextBlock Text="PIN ÚNICO" Foreground="{StaticResource Muted}" FontSize="12" FontWeight="Bold"/>
       <PasswordBox x:Name="DirectorPinBox" Height="48" Margin="0,6,0,8" Padding="12,0" VerticalContentAlignment="Center" FontSize="20" MaxLength="6" Style="{StaticResource Field}"/>
       <TextBlock x:Name="StatusText" Text="Pronto para entrar." Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" MinHeight="34"/>
       <Button x:Name="LoginButton" Content="ENTRAR NA CENTRAL  ›" Click="Login_Click" Style="{StaticResource Action}" Margin="0,4,0,9"/>
       <Button x:Name="FirstAccessButton" Content="PRIMEIRO ACESSO / CONFIGURAR TRANSPOLI" Click="ShowSetup_Click" Style="{StaticResource Ghost}"/>
       <Button Content="← VOLTAR PARA MOTORISTA" Click="BackToDriver_Click" Background="Transparent" Foreground="{StaticResource Muted}" BorderThickness="0" Height="36" Cursor="Hand"/>
      </StackPanel>
     </Border>
    </Grid>

    <Grid Grid.Row="1" x:Name="SetupView" Visibility="Collapsed" Margin="72,30,72,30">
     <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="440"/></Grid.ColumnDefinitions>
     <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="20,0,80,0">
      <TextBlock Text="CONFIGURAÇÃO INICIAL" Foreground="{StaticResource GoldBright}" FontSize="12" FontWeight="Bold"/>
      <TextBlock Text="Crie o ambiente da sua empresa." Foreground="{StaticResource Text}" FontSize="34" FontWeight="Bold" Margin="0,8,0,0"/>
      <TextBlock Text="A conta atual será a responsável pela criação da empresa. Depois disso, o acesso da diretoria será separado por e-mail e PIN próprio." Foreground="{StaticResource Muted}" FontSize="13" TextWrapping="Wrap" MaxWidth="650" Margin="0,14,0,0"/>
     </StackPanel>
     <Border Grid.Column="1" Background="#0D141B" BorderBrush="#34404C" BorderThickness="1" CornerRadius="22" Padding="26">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
       <StackPanel>
        <TextBlock Text="CONFIGURAR TRANSPOLI" Foreground="{StaticResource Text}" FontSize="20" FontWeight="Bold"/>
        <TextBlock Text="Apenas o primeiro acesso pode realizar esta configuração." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,5,0,17"/>
        <TextBlock Text="E-MAIL DA CONTA ATUAL" Foreground="{StaticResource Muted}" FontSize="12" FontWeight="Bold"/>
        <TextBox x:Name="OwnerEmailBox" Height="40" Margin="0,5,0,10" Padding="11,0" VerticalContentAlignment="Center" Style="{StaticResource Field}"/>
        <TextBlock Text="PIN DA CONTA ATUAL" Foreground="{StaticResource Muted}" FontSize="12" FontWeight="Bold"/>
        <PasswordBox x:Name="OwnerPinBox" Height="42" Margin="0,5,0,13" Padding="11,0" VerticalContentAlignment="Center" FontSize="17" MaxLength="6" Style="{StaticResource Field}"/>
        <Border Background="#17130A" BorderBrush="#604A0B" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,0,0,12">
         <TextBlock Text="EMPRESA OFICIAL: TRANSPOLI" Foreground="{StaticResource GoldBright}" FontSize="12" FontWeight="Bold"/>
        </Border>
        <TextBlock Text="E-MAIL DA DIRETORIA" Foreground="{StaticResource Muted}" FontSize="12" FontWeight="Bold"/>
        <TextBox x:Name="SetupDirectorEmailBox" Height="40" Margin="0,5,0,10" Padding="11,0" VerticalContentAlignment="Center" Style="{StaticResource Field}"/>
        <TextBlock Text="PIN DA DIRETORIA" Foreground="{StaticResource Muted}" FontSize="12" FontWeight="Bold"/>
        <PasswordBox x:Name="SetupDirectorPinBox" Height="42" Margin="0,5,0,15" Padding="11,0" VerticalContentAlignment="Center" FontSize="18" MaxLength="6" Style="{StaticResource Field}"/>
        <TextBlock x:Name="SetupStatusText" Text="" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" MinHeight="34"/>
        <Button x:Name="SetupButton" Content="CRIAR CENTRAL  ›" Click="Setup_Click" Style="{StaticResource Action}" Margin="0,4,0,7"/>
        <Button Content="← VOLTAR AO LOGIN DA DIRETORIA" Click="BackToLogin_Click" Background="Transparent" Foreground="{StaticResource Muted}" BorderThickness="0" Height="34" Cursor="Hand"/>
       </StackPanel>
      </ScrollViewer>
     </Border>
    </Grid>

    <Grid Grid.Row="1" x:Name="DashboardView" Visibility="Collapsed" Margin="24,18,24,20">
     <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

     <Border Grid.Column="0" Background="#0A0F14" BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="18" Margin="0,0,12,0">
      <StackPanel Margin="10">
       <TextBlock Text="TRANSPOLI" Foreground="{StaticResource GoldBright}" FontSize="11" FontWeight="Bold" Margin="10,10,10,2"/>
       <TextBlock Text="CENTRAL DA DIRETORIA" Foreground="{StaticResource Muted}" FontSize="11" Margin="10,0,10,18"/>
       <Button Content="⌂  VISÃO GERAL" Click="NavOverview_Click" Style="{StaticResource Ghost}" Margin="0,0,0,7"/>
       <Button Content="♙  MOTORISTAS" Click="NavDrivers_Click" Style="{StaticResource Ghost}" Margin="0,0,0,7"/>
       <Button Content="▣  CAMINHÕES" Click="NavTrucks_Click" Style="{StaticResource Ghost}" Margin="0,0,0,7"/>
       <Button Content="↗  VIAGENS" Click="NavTrips_Click" Style="{StaticResource Ghost}" Margin="0,0,0,7"/>
       <Button Content="R$  FINANCEIRO" Click="NavFinancial_Click" Style="{StaticResource Ghost}" Margin="0,0,0,7"/>
       <Button Content="⚙  CONFIGURAÇÕES" Click="NavSettings_Click" Style="{StaticResource Ghost}" Margin="0,0,0,7"/>
       <Border Height="1" Background="{StaticResource Stroke}" Margin="8,12,8,12"/>
       <Button Content="↻  ATUALIZAR DADOS" Click="Refresh_Click" Style="{StaticResource Ghost}" Margin="0,0,0,7"/>
       <Button Content="SAIR" Click="Logout_Click" Style="{StaticResource Ghost}"/>
      </StackPanel>
     </Border>

     <Grid Grid.Column="1">
      <Grid.RowDefinitions><RowDefinition Height="66"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid Grid.Row="0">
       <StackPanel>
        <TextBlock x:Name="SectionEyebrow" Text="VISÃO GERAL" Foreground="{StaticResource GoldBright}" FontSize="12" FontWeight="Bold"/>
        <TextBlock x:Name="SectionTitle" Text="Central da Diretoria" Foreground="{StaticResource Text}" FontSize="27" FontWeight="Bold" Margin="0,3,0,0"/>
       </StackPanel>
       <TextBlock x:Name="LastUpdateText" Text="Dados reais • TransPoli" Foreground="{StaticResource Muted}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0"/>
      </Grid>

      <Grid Grid.Row="1">
       <ScrollViewer x:Name="OverviewPanel" VerticalScrollBarVisibility="Auto">
        <StackPanel>
         <UniformGrid Columns="4" Margin="0,0,0,8">
          <Border Background="#0E1715" BorderBrush="#285440" BorderThickness="1" CornerRadius="14" Padding="14" Margin="0,0,5,5"><StackPanel><TextBlock Text="MOTORISTAS ATIVOS" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock x:Name="KpiDrivers" Text="—" Foreground="{StaticResource Text}" FontSize="24" FontWeight="Bold" Margin="0,3,0,0"/></StackPanel></Border>
          <Border Background="#0D141B" BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="14" Padding="14" Margin="2,0,3,5"><StackPanel><TextBlock Text="CAMINHÕES ATIVOS" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock x:Name="KpiTrucks" Text="—" Foreground="{StaticResource Text}" FontSize="24" FontWeight="Bold" Margin="0,3,0,0"/></StackPanel></Border>
          <Border Background="#0D141B" BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="14" Padding="14" Margin="3,0,2,5"><StackPanel><TextBlock Text="EM VIAGEM AGORA" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock x:Name="KpiActiveTrips" Text="—" Foreground="{StaticResource Text}" FontSize="24" FontWeight="Bold" Margin="0,3,0,0"/></StackPanel></Border>
          <Border Background="#0D141B" BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="14" Padding="14" Margin="4,0,0,5"><StackPanel><TextBlock Text="CONCLUÍDAS HOJE" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock x:Name="KpiCompleted" Text="—" Foreground="{StaticResource Text}" FontSize="24" FontWeight="Bold" Margin="0,3,0,0"/></StackPanel></Border>
         </UniformGrid>
         <UniformGrid Columns="4" Margin="0,0,0,12">
          <Border Background="#0D141B" BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="14" Padding="14" Margin="0,0,5,0"><StackPanel><TextBlock Text="KM RODADOS HOJE" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock x:Name="KpiKmToday" Text="—" Foreground="{StaticResource Text}" FontSize="21" FontWeight="Bold" Margin="0,3,0,0"/></StackPanel></Border>
          <Border Background="#0D141B" BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="14" Padding="14" Margin="2,0,3,0"><StackPanel><TextBlock Text="RECEITA HOJE" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock x:Name="KpiRevenueToday" Text="—" Foreground="{StaticResource Text}" FontSize="21" FontWeight="Bold" Margin="0,3,0,0"/></StackPanel></Border>
          <Border Background="#0D141B" BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="14" Padding="14" Margin="3,0,2,0"><StackPanel><TextBlock Text="DESPESAS HOJE" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock x:Name="KpiExpensesToday" Text="—" Foreground="{StaticResource Text}" FontSize="21" FontWeight="Bold" Margin="0,3,0,0"/></StackPanel></Border>
          <Border Background="#141109" BorderBrush="#604A0B" BorderThickness="1" CornerRadius="14" Padding="14" Margin="4,0,0,0"><StackPanel><TextBlock Text="RESULTADO HOJE" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock x:Name="KpiResult" Text="—" Foreground="{StaticResource GoldBright}" FontSize="21" FontWeight="Bold" Margin="0,3,0,0"/></StackPanel></Border>
         </UniformGrid>
         <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
          <Border Grid.Column="0" Background="#0C1319" BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="16" Padding="16" Margin="0,0,5,0"><StackPanel><TextBlock Text="FROTA" Foreground="{StaticResource GoldBright}" FontSize="12" FontWeight="Bold"/><TextBlock x:Name="FleetText" Text="Nenhum caminhão cadastrado." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap"/></StackPanel></Border>
          <Border Grid.Column="1" Background="#0C1319" BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="16" Padding="16" Margin="5,0"><StackPanel><TextBlock Text="MOTORISTAS" Foreground="{StaticResource GoldBright}" FontSize="12" FontWeight="Bold"/><TextBlock x:Name="DriversText" Text="Nenhum motorista vinculado." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap"/></StackPanel></Border>
          <Border Grid.Column="2" Background="#0C1319" BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="16" Padding="16" Margin="5,0,0,0"><StackPanel><TextBlock Text="OPERAÇÕES RECENTES" Foreground="{StaticResource GoldBright}" FontSize="12" FontWeight="Bold"/><TextBlock x:Name="OperationsText" Text="Nenhuma viagem registrada." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap"/></StackPanel></Border>
         </Grid>
         <Grid Margin="0,10,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
          <Border Grid.Column="0" Background="#0C1319" BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="16" Padding="16" Margin="0,0,5,0">
           <StackPanel><TextBlock Text="RESUMO FINANCEIRO" Foreground="{StaticResource GoldBright}" FontSize="12" FontWeight="Bold"/><TextBlock x:Name="FinancialText" Text="Receitas e despesas serão exibidas somente quando houver dados reais." Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,9,0,0"/></StackPanel>
          </Border>
          <Border Grid.Column="1" Background="#0C1319" BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="16" Padding="16" Margin="5,0,0,0">
           <StackPanel><TextBlock Text="MANUTENÇÃO RECENTE" Foreground="{StaticResource GoldBright}" FontSize="12" FontWeight="Bold"/><TextBlock x:Name="MaintenanceText" Text="Nenhuma manutenção registrada." Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,9,0,0"/></StackPanel>
          </Border>
         </Grid>
        </StackPanel>
       </ScrollViewer>

              <Grid x:Name="DriversPanel" Visibility="Collapsed">
        <StackPanel>
         <Grid Margin="0,0,0,10">
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal">
           <TextBlock Text="MOTORISTAS" Foreground="{StaticResource GoldBright}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
           <Border Background="#101820" BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="8" Padding="9,5" Margin="12,0,0,0"><TextBlock Text="GESTÃO DA EQUIPE" Foreground="{StaticResource Muted}" FontSize="11" FontWeight="Bold"/></Border>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal">
          <ComboBox x:Name="DriverStatusFilter" Width="150" Style="{StaticResource StatusFilter}" SelectionChanged="DriverStatusFilter_SelectionChanged" Margin="0,0,7,0">
           <ComboBoxItem Content="TODOS OS STATUS" Tag="all" IsSelected="True"/>
           <ComboBoxItem Content="ATIVOS" Tag="active"/>
           <ComboBoxItem Content="BLOQUEADOS" Tag="blocked"/>
           <ComboBoxItem Content="DESVINCULADOS" Tag="unlinked"/>
          </ComboBox>
          <TextBox x:Name="DriverSearchBox" Width="220" Height="36" TextChanged="DriverSearch_TextChanged" Style="{StaticResource Field}" Padding="11,0" VerticalContentAlignment="Center" ToolTip="Pesquisar por nome, e-mail, status ou licença"/>
         </StackPanel>
         </Grid>
         <UniformGrid Columns="4" Margin="0,0,0,10">
          <Border Background="#0E1715" BorderBrush="#285440" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,4,0"><StackPanel><TextBlock Text="ATIVOS" Foreground="{StaticResource Muted}" FontSize="7"/><TextBlock x:Name="DriverSummaryActive" Text="0" Foreground="{StaticResource Green}" FontSize="18" FontWeight="Bold"/></StackPanel></Border>
          <Border Background="#0D141B" BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="12" Padding="12" Margin="4,0"><StackPanel><TextBlock Text="VIAGENS" Foreground="{StaticResource Muted}" FontSize="7"/><TextBlock x:Name="DriverSummaryTrips" Text="0" Foreground="{StaticResource Text}" FontSize="18" FontWeight="Bold"/></StackPanel></Border>
          <Border Background="#0D141B" BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="12" Padding="12" Margin="4,0"><StackPanel><TextBlock Text="KM ACUMULADOS" Foreground="{StaticResource Muted}" FontSize="7"/><TextBlock x:Name="DriverSummaryKm" Text="0 km" Foreground="{StaticResource Text}" FontSize="18" FontWeight="Bold"/></StackPanel></Border>
          <Border Background="#141109" BorderBrush="#604A0B" BorderThickness="1" CornerRadius="12" Padding="12" Margin="4,0,0,0"><StackPanel><TextBlock Text="LICENÇAS" Foreground="{StaticResource Muted}" FontSize="7"/><TextBlock x:Name="DriverSummaryLicenses" Text="0" Foreground="{StaticResource GoldBright}" FontSize="18" FontWeight="Bold"/></StackPanel></Border>
         </UniformGrid>
         <WrapPanel Margin="0,0,0,10">
          <Button Content="+ NOVO MOTORISTA" Click="NewDriver_Click" Style="{StaticResource Action}" Width="145" Margin="0,0,7,7"/>
          <Button Content="EDITAR" Click="EditDriver_Click" Style="{StaticResource Ghost}" Width="90" Margin="0,0,7,7"/>
          <Button Content="BLOQUEAR / ATIVAR" Click="ToggleDriver_Click" Style="{StaticResource Ghost}" Width="145" Margin="0,0,7,7"/>
          <Button Content="VINCULAR" Click="LinkDriver_Click" Style="{StaticResource Ghost}" Width="95" Margin="0,0,7,7"/>
          <Button Content="DESVINCULAR" Click="UnlinkDriver_Click" Style="{StaticResource Ghost}" Width="110" Margin="0,0,7,7"/>
          <Button Content="HISTÓRICO" Click="DriverHistory_Click" Style="{StaticResource Ghost}" Width="105" Margin="0,0,7,7"/>
          <Button Content="ATUALIZAR" Click="Refresh_Click" Style="{StaticResource Ghost}" Width="95" Margin="0,0,7,7"/>
         </WrapPanel>
         <Border Background="#0C1319" BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="16" Padding="8">
          <DataGrid x:Name="DriversGrid" AutoGenerateColumns="True" IsReadOnly="True" HeadersVisibility="Column" Style="{StaticResource DirectorGrid}" Background="#0B1117" Foreground="{StaticResource Text}" BorderThickness="0" CanUserAddRows="False"/>
         </Border>
        </StackPanel>
       </Grid>
<Grid x:Name="TrucksPanel" Visibility="Collapsed">
        <StackPanel>
         <Grid Margin="0,0,0,10">
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal"><TextBlock Text="FROTA" Foreground="{StaticResource GoldBright}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/><Border Background="#101820" BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="8" Padding="9,5" Margin="12,0,0,0"><TextBlock Text="MONITORAMENTO OPERACIONAL" Foreground="{StaticResource Muted}" FontSize="11" FontWeight="Bold"/></Border></StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal">
          <ComboBox x:Name="TruckStatusFilter" Width="160" Style="{StaticResource StatusFilter}" SelectionChanged="TruckStatusFilter_SelectionChanged" Margin="0,0,7,0">
           <ComboBoxItem Content="TODOS OS ESTADOS" Tag="all" IsSelected="True"/>
           <ComboBoxItem Content="NORMAL" Tag="normal"/>
           <ComboBoxItem Content="PAUSADO" Tag="paused"/>
           <ComboBoxItem Content="MANUTENÇÃO" Tag="maintenance"/>
           <ComboBoxItem Content="OFFLINE" Tag="offline"/>
          </ComboBox>
          <TextBox x:Name="TruckSearchBox" Width="220" Height="36" TextChanged="TruckSearch_TextChanged" Style="{StaticResource Field}" Padding="11,0" VerticalContentAlignment="Center" ToolTip="Pesquisar caminhão, placa, marca, modelo ou motorista"/>
         </StackPanel>
         </Grid>
         <UniformGrid Columns="4" Margin="0,0,0,10">
          <Border Background="#0E1715" BorderBrush="#285440" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,4,0"><StackPanel><TextBlock Text="NORMAL" Foreground="{StaticResource Muted}" FontSize="7"/><TextBlock x:Name="TruckSummaryNormal" Text="0" Foreground="{StaticResource Green}" FontSize="18" FontWeight="Bold"/></StackPanel></Border>
          <Border Background="#0D141B" BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="12" Padding="12" Margin="4,0"><StackPanel><TextBlock Text="EM VIAGEM" Foreground="{StaticResource Muted}" FontSize="7"/><TextBlock x:Name="TruckSummaryTrips" Text="0" Foreground="{StaticResource Text}" FontSize="18" FontWeight="Bold"/></StackPanel></Border>
          <Border Background="#0D141B" BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="12" Padding="12" Margin="4,0"><StackPanel><TextBlock Text="TELEMETRIA" Foreground="{StaticResource Muted}" FontSize="7"/><TextBlock x:Name="TruckSummaryTelemetry" Text="0" Foreground="{StaticResource Text}" FontSize="18" FontWeight="Bold"/></StackPanel></Border>
          <Border Background="#141109" BorderBrush="#604A0B" BorderThickness="1" CornerRadius="12" Padding="12" Margin="4,0,0,0"><StackPanel><TextBlock Text="DESGASTE" Foreground="{StaticResource Muted}" FontSize="7"/><TextBlock x:Name="TruckSummaryWear" Text="0%" Foreground="{StaticResource GoldBright}" FontSize="18" FontWeight="Bold"/></StackPanel></Border>
         </UniformGrid>
         <WrapPanel Margin="0,0,0,10"><Button Content="+ NOVO CAMINHÃO" Click="NewTruck_Click" Style="{StaticResource Action}" Width="160" Margin="0,0,8,7"/><Button Content="EDITAR / VINCULAR" Click="EditTruck_Click" Style="{StaticResource Ghost}" Width="150" Margin="0,0,8,7"/><Button Content="HISTÓRICO" Click="TruckHistory_Click" Style="{StaticResource Ghost}" Width="105" Margin="0,0,8,7"/><Button Content="REMOVER" Click="DeleteTruck_Click" Style="{StaticResource Ghost}" Width="105" Margin="0,0,8,7"/><Button Content="ATUALIZAR" Click="Refresh_Click" Style="{StaticResource Ghost}" Width="95" Margin="0,0,8,7"/></WrapPanel>
         <Border Background="#0C1319" BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="16" Padding="8">
          <DataGrid x:Name="TrucksGrid" AutoGenerateColumns="True" IsReadOnly="True" HeadersVisibility="Column" Style="{StaticResource DirectorGrid}" Background="#0B1117" Foreground="{StaticResource Text}" BorderThickness="0" CanUserAddRows="False"/>
         </Border>
        </StackPanel>
       </Grid>
<Grid x:Name="TripsPanel" Visibility="Collapsed">
        <StackPanel>
         <Grid Margin="0,0,0,10">
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal"><TextBlock Text="OPERAÇÕES" Foreground="{StaticResource GoldBright}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/><Border Background="#101820" BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="8" Padding="9,5" Margin="12,0,0,0"><TextBlock Text="VIAGENS E TELEMETRIA" Foreground="{StaticResource Muted}" FontSize="11" FontWeight="Bold"/></Border></StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal">
          <ComboBox x:Name="TripStatusFilter" Width="150" Style="{StaticResource StatusFilter}" SelectionChanged="TripStatusFilter_SelectionChanged" Margin="0,0,7,0">
           <ComboBoxItem Content="TODOS OS STATUS" Tag="all" IsSelected="True"/>
           <ComboBoxItem Content="EM ANDAMENTO" Tag="active"/>
           <ComboBoxItem Content="CONCLUÍDAS" Tag="finished"/>
           <ComboBoxItem Content="CANCELADAS" Tag="cancelled"/>
          </ComboBox>
          <TextBox x:Name="TripSearchBox" Width="250" Height="36" TextChanged="TripSearch_TextChanged" Style="{StaticResource Field}" Padding="11,0" VerticalContentAlignment="Center" ToolTip="Pesquisar carga, rota, motorista, caminhão ou status"/>
         </StackPanel>
         </Grid>
         <UniformGrid Columns="4" Margin="0,0,0,10">
          <Border Background="#0E1715" BorderBrush="#285440" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,4,0"><StackPanel><TextBlock Text="EM ANDAMENTO" Foreground="{StaticResource Muted}" FontSize="7"/><TextBlock x:Name="TripSummaryActive" Text="0" Foreground="{StaticResource Green}" FontSize="18" FontWeight="Bold"/></StackPanel></Border>
          <Border Background="#0D141B" BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="12" Padding="12" Margin="4,0"><StackPanel><TextBlock Text="CONCLUÍDAS" Foreground="{StaticResource Muted}" FontSize="7"/><TextBlock x:Name="TripSummaryFinished" Text="0" Foreground="{StaticResource Text}" FontSize="18" FontWeight="Bold"/></StackPanel></Border>
          <Border Background="#0D141B" BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="12" Padding="12" Margin="4,0"><StackPanel><TextBlock Text="KM" Foreground="{StaticResource Muted}" FontSize="7"/><TextBlock x:Name="TripSummaryKm" Text="0 km" Foreground="{StaticResource Text}" FontSize="18" FontWeight="Bold"/></StackPanel></Border>
          <Border Background="#141109" BorderBrush="#604A0B" BorderThickness="1" CornerRadius="12" Padding="12" Margin="4,0,0,0"><StackPanel><TextBlock Text="RESULTADO" Foreground="{StaticResource Muted}" FontSize="7"/><TextBlock x:Name="TripSummaryResult" Text="R$ 0,00" Foreground="{StaticResource GoldBright}" FontSize="18" FontWeight="Bold"/></StackPanel></Border>
         </UniformGrid>
         <WrapPanel Margin="0,0,0,10"><Button Content="DETALHES DA VIAGEM" Click="TripDetails_Click" Style="{StaticResource Action}" Width="155" Margin="0,0,8,7"/><Button Content="ATUALIZAR" Click="Refresh_Click" Style="{StaticResource Ghost}" Width="100" Margin="0,0,8,7"/></WrapPanel>
         <Border Background="#0C1319" BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="16" Padding="8">
          <DataGrid x:Name="TripsGrid" AutoGenerateColumns="True" IsReadOnly="True" HeadersVisibility="Column" Style="{StaticResource DirectorGrid}" Background="#0B1117" Foreground="{StaticResource Text}" BorderThickness="0" CanUserAddRows="False"/>
         </Border>
        </StackPanel>
       </Grid>
<Grid x:Name="FinancialPanel" Visibility="Collapsed">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
         <StackPanel>
          <UniformGrid Columns="4" Margin="0,0,0,12">
           <Border Background="#11170F" BorderBrush="#40582B" BorderThickness="1" CornerRadius="14" Padding="16" Margin="0,0,5,0"><StackPanel><TextBlock Text="BANCO DA EMPRESA" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock x:Name="CompanyBankBalance" Text="R$ 0,00" Foreground="{StaticResource GoldBright}" FontSize="22" FontWeight="Bold"/></StackPanel></Border>
           <Border Background="#0D141B" BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="14" Padding="16" Margin="5,0"><StackPanel><TextBlock Text="RECEITA" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock x:Name="FinancialRevenue" Text="R$ 0,00" Foreground="{StaticResource Text}" FontSize="22" FontWeight="Bold"/></StackPanel></Border>
           <Border Background="#0D141B" BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="14" Padding="16" Margin="5,0"><StackPanel><TextBlock Text="DESPESAS" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock x:Name="FinancialExpenses" Text="R$ 0,00" Foreground="{StaticResource Text}" FontSize="22" FontWeight="Bold"/></StackPanel></Border>
           <Border Background="#141109" BorderBrush="#604A0B" BorderThickness="1" CornerRadius="14" Padding="16" Margin="5,0,0,0"><StackPanel><TextBlock Text="RESULTADO" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock x:Name="FinancialResult" Text="R$ 0,00" Foreground="{StaticResource GoldBright}" FontSize="22" FontWeight="Bold"/></StackPanel></Border>
          </UniformGrid>
          <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
           <Border Grid.Column="0" Background="#0C1319" BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="16" Padding="16" Margin="0,0,6,0"><StackPanel><TextBlock Text="MOVIMENTAÇÕES DO BANCO TRANSPOLI" Foreground="{StaticResource GoldBright}" FontSize="12" FontWeight="Bold" Margin="0,0,0,10"/><DataGrid x:Name="CompanyLedgerGrid" AutoGenerateColumns="True" IsReadOnly="True" Style="{StaticResource DirectorGrid}" CanUserAddRows="False" MaxHeight="210"/></StackPanel></Border>
           <Border Grid.Column="1" Background="#0C1319" BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="16" Padding="16" Margin="6,0,0,0"><StackPanel><TextBlock Text="CRÉDITO EMPRESARIAL" Foreground="{StaticResource GoldBright}" FontSize="12" FontWeight="Bold"/><TextBlock x:Name="CompanyLoanSummary" Text="Nenhuma solicitação." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,7,0,10"/><DataGrid x:Name="CompanyLoansGrid" AutoGenerateColumns="True" IsReadOnly="True" Style="{StaticResource DirectorGrid}" CanUserAddRows="False" MaxHeight="150"/><StackPanel Orientation="Horizontal" Margin="0,10,0,0"><Button Content="APROVAR" Click="ApproveCompanyLoan_Click" Style="{StaticResource Action}" Width="110" Margin="0,0,8,0"/><Button Content="REJEITAR" Click="RejectCompanyLoan_Click" Style="{StaticResource Ghost}" Width="110"/></StackPanel></StackPanel></Border>
          </Grid>
          <Border Background="#0C1319" BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="16" Padding="14"><DataGrid x:Name="ExpensesGrid" AutoGenerateColumns="True" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" Style="{StaticResource DirectorGrid}" Background="#0B1117" Foreground="{StaticResource Text}" BorderThickness="0" CanUserAddRows="False"/></Border>
         </StackPanel>
        </ScrollViewer>
       </Grid>
       <Grid x:Name="SettingsPanel" Visibility="Collapsed">
        <Border Background="#0C1319" BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="16" Padding="24">
         <StackPanel>
          <TextBlock Text="CONFIGURAÇÕES DA INSTALAÇÃO" Foreground="{StaticResource GoldBright}" FontSize="11" FontWeight="Bold"/>
          <TextBlock Text="A TransPoli é uma instalação centralizada: existe uma única empresa e uma única Central da Diretoria." Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,22"/>
          <TextBlock Text="EMPRESA" Foreground="{StaticResource Muted}" FontSize="11"/>
          <TextBlock Text="TRANSPOLI" Foreground="{StaticResource Text}" FontSize="20" FontWeight="Bold" Margin="0,4,0,16"/>
          <TextBlock Text="E-MAIL DA DIRETORIA" Foreground="{StaticResource Muted}" FontSize="11"/>
          <TextBlock x:Name="SettingsDirectorEmail" Text="—" Foreground="{StaticResource Text}" FontSize="14" Margin="0,4,0,18"/>
          <TextBlock Text="STATUS DA CENTRAL" Foreground="{StaticResource Muted}" FontSize="11"/>
          <TextBlock Text="ATIVA • EMPRESA ÚNICA" Foreground="{StaticResource Green}" FontSize="13" FontWeight="Bold" Margin="0,4,0,18"/>
          <Button Content="↻  RECARREGAR STATUS" Click="RefreshSettings_Click" Style="{StaticResource Ghost}" Width="190" HorizontalAlignment="Left"/>
         </StackPanel>
        </Border>
       </Grid>
      </Grid>
     </Grid>
    </Grid>
   </Grid>
  </Border>
 </Grid>
</Window>