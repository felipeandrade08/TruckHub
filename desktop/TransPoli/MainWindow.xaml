<Window x:Class="TransPoli.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TransPoli • Computador de Bordo"
        Width="1180" Height="820" MinWidth="900" MinHeight="650"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResize" SnapsToDevicePixels="True"
        WindowStartupLocation="CenterScreen" KeyDown="Window_KeyDown"
        Icon="/TransPoli;component/Assets/transpoli-logo.png">
  <Window.Resources>
    <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="{StaticResource Panel}"/><Setter Property="BorderBrush" Value="{StaticResource Stroke}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="18"/><Setter Property="Padding" Value="18"/></Style>
    <Style x:Key="Label" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="FontSize" Value="10"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style x:Key="TabletButton" TargetType="Button"><Setter Property="Background" Value="{StaticResource Panel2}"/><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="BorderBrush" Value="{StaticResource Stroke}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="14,11"/><Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="4"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextBlock.TextAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#202B39"/><Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Orange}"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{StaticResource Orange}"/><Setter Property="Foreground" Value="#070A0F"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style x:Key="WindowButton" TargetType="Button"><Setter Property="Width" Value="34"/><Setter Property="Height" Value="34"/><Setter Property="Margin" Value="4,0,0,0"/><Setter Property="Background" Value="#151B23"/><Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="10"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#293442"/><Setter Property="Foreground" Value="{StaticResource Text}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  </Window.Resources>
  <Grid Margin="12">
    <Image Source="{StaticResource BrandBackground}" Stretch="UniformToFill" Opacity="0.20" IsHitTestVisible="False"/>
    <Border Background="#D9070A0F" CornerRadius="28" IsHitTestVisible="False"/>
    <Border Background="#B8070A0F" CornerRadius="28" BorderBrush="#263241" BorderThickness="1"><Border.Effect><DropShadowEffect BlurRadius="35" ShadowDepth="8" Opacity="0.55"/></Border.Effect><Grid>
      <Grid.RowDefinitions><RowDefinition Height="70"/><RowDefinition Height="*"/><RowDefinition Height="64"/></Grid.RowDefinitions>
      <Border Grid.Row="0" Background="#0B1017" CornerRadius="28,28,0,0" Padding="24,0"><Grid MouseLeftButtonDown="TabletDrag">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Width="42" Height="42" CornerRadius="12" Background="#151C25" Padding="7"><Image Source="{StaticResource BrandLogo}" Stretch="Uniform"/></Border><StackPanel Margin="13,0,0,0" VerticalAlignment="Center"><TextBlock Text="TRANSPOLI" Foreground="{StaticResource Text}" FontSize="20" FontWeight="Bold"/><TextBlock Text="COMPUTADOR DE BORDO • TRANSPOLI" Foreground="{StaticResource Muted}" FontSize="9" FontWeight="SemiBold" Margin="0,2,0,0"/></StackPanel><Border Background="#101D17" BorderBrush="#28503A" BorderThickness="1" CornerRadius="9" Padding="9,5" Margin="18,0,0,0"><StackPanel Orientation="Horizontal"><Ellipse x:Name="ConnectionDot" Width="7" Height="7" Fill="{StaticResource Muted}" Margin="0,0,6,0"/><TextBlock x:Name="ConnectionText" Text="ETS2 OFFLINE" Foreground="{StaticResource Muted}" FontSize="9" FontWeight="Bold"/></StackPanel></Border></StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Border Background="#16130B" BorderBrush="#443813" BorderThickness="1" CornerRadius="9" Padding="10,5" Margin="0,0,12,0"><TextBlock x:Name="VehicleLockText" Text="🔒 CAMINHÃO BLOQUEADO" Foreground="{StaticResource Yellow}" FontSize="9" FontWeight="Bold"/></Border><Button Style="{StaticResource WindowButton}" Content="—" Click="TabletMinimize_Click" ToolTip="Minimizar"/><Button Style="{StaticResource WindowButton}" Content="□" Click="TabletMaximize_Click" ToolTip="Maximizar"/><Button Style="{StaticResource WindowButton}" Content="×" Click="TabletClose_Click" ToolTip="Fechar"/></StackPanel>
      </Grid></Border>
      <Grid Grid.Row="1" Margin="18,16"><Grid.ColumnDefinitions><ColumnDefinition Width="1.18*"/><ColumnDefinition Width="1.82*"/></Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Margin="0,0,8,0">
          <Border Style="{StaticResource Card}" Height="305"><Grid><Image Source="{StaticResource BrandBackground}" Stretch="UniformToFill" Opacity="0.08"/><StackPanel><TextBlock Text="VEÍCULO" Style="{StaticResource Label}"/><TextBlock x:Name="TruckName" Text="Aguardando ETS2" Foreground="{StaticResource Text}" FontSize="22" FontWeight="Bold" Margin="0,5,0,0" TextWrapping="Wrap"/><TextBlock x:Name="RouteText" Text="Conecte o ETS2 para receber a telemetria." Foreground="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/><Grid Margin="0,20,0,0"><StackPanel HorizontalAlignment="Center"><TextBlock x:Name="SpeedText" Text="0" Foreground="{StaticResource Text}" FontSize="72" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock Text="KM/H" Foreground="{StaticResource Orange}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,-10,0,0"/></StackPanel><StackPanel HorizontalAlignment="Right" VerticalAlignment="Top"><TextBlock Text="MOTOR" Style="{StaticResource Label}" HorizontalAlignment="Right"/><TextBlock x:Name="EngineStateText" Text="DESLIGADO" Foreground="{StaticResource Yellow}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Right"/></StackPanel></Grid><Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="1.05*"/></Grid.ColumnDefinitions><Border Grid.Column="0" Background="{StaticResource Panel2}" CornerRadius="11" Padding="7"><StackPanel><TextBlock Text="RPM" Style="{StaticResource Label}"/><TextBlock x:Name="RpmText" Text="0" Foreground="{StaticResource Text}" FontSize="14" FontWeight="Bold"/></StackPanel></Border><Border Grid.Column="1" Background="{StaticResource Panel2}" CornerRadius="11" Padding="7" Margin="5,0"><StackPanel><TextBlock Text="MARCHA" Style="{StaticResource Label}"/><TextBlock x:Name="GearText" Text="N" Foreground="{StaticResource Yellow}" FontSize="14" FontWeight="Bold"/></StackPanel></Border><Border Grid.Column="2" Background="{StaticResource Panel2}" CornerRadius="11" Padding="7"><StackPanel><TextBlock Text="CRUISE" Style="{StaticResource Label}"/><TextBlock x:Name="CruiseText" Text="OFF" Foreground="{StaticResource Muted}" FontSize="14" FontWeight="Bold"/></StackPanel></Border></Grid></StackPanel></Grid></Border>
          <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Grid.Column="0" Style="{StaticResource Card}" Padding="14" Margin="0,0,5,0"><StackPanel><TextBlock Text="ODÔMETRO" Style="{StaticResource Label}"/><TextBlock x:Name="OdometerText" Text="0 km" Foreground="{StaticResource Text}" FontSize="17" FontWeight="Bold" Margin="0,4,0,0"/><TextBlock Text="COMBUSTÍVEL" Style="{StaticResource Label}" Margin="0,12,0,0"/><TextBlock x:Name="FuelText" Text="0 L" Foreground="{StaticResource Text}" FontSize="17" FontWeight="Bold" Margin="0,4,0,0"/></StackPanel></Border><Border Grid.Column="1" Style="{StaticResource Card}" Padding="14" Margin="5,0,0,0"><StackPanel><TextBlock Text="AUTONOMIA" Style="{StaticResource Label}"/><TextBlock x:Name="RangeText" Text="0 km" Foreground="{StaticResource Text}" FontSize="17" FontWeight="Bold" Margin="0,4,0,0"/><TextBlock Text="CARGA" Style="{StaticResource Label}" Margin="0,12,0,0"/><TextBlock x:Name="CargoText" Text="Nenhuma carga" Foreground="{StaticResource Text}" FontSize="13" FontWeight="Bold" Margin="0,4,0,0" TextWrapping="Wrap"/><TextBlock x:Name="CargoMassText" Text="0 kg" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,2,0,0"/></StackPanel></Border></Grid>
          <Border Style="{StaticResource Card}" Padding="14" Margin="0,10,0,0"><StackPanel><TextBlock Text="MERCADO DE CARGAS" Style="{StaticResource Label}"/><TextBlock x:Name="AlertText" Text="📦 Carregando tarifas do mercado..." Foreground="{StaticResource Green}" FontSize="12" FontWeight="Bold" Margin="0,6,0,0" TextWrapping="Wrap"/><TextBlock x:Name="TelemetryInfoText" Text="Tarifas por KM • carga identificada automaticamente pelo ETS2/ATS" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,5,0,0" TextWrapping="Wrap"/><TextBlock x:Name="FuelAutoText" Text="Clique no mercado para consultar todas as cargas" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,5,0,0" TextWrapping="Wrap"/></StackPanel></Border>
        </StackPanel>
        <StackPanel Grid.Column="1" Margin="8,0,0,0">
          <Border Style="{StaticResource Card}" Padding="20" Height="310"><StackPanel><Grid><StackPanel><TextBlock Text="VIAGEM ATUAL" Style="{StaticResource Label}"/><TextBlock x:Name="TripStatusText" Text="Aguardando trabalho do ETS2" Foreground="{StaticResource Text}" FontSize="20" FontWeight="Bold" Margin="0,5,0,0"/><TextBlock x:Name="TripRouteText" Text="Nenhuma viagem ativa" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap"/><TextBlock x:Name="TripCargoText" Text="" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap"/></StackPanel><Border Background="{StaticResource Panel2}" CornerRadius="9" Padding="9,5" HorizontalAlignment="Right" VerticalAlignment="Top"><TextBlock x:Name="TripLiveText" Text="OFFLINE" Foreground="{StaticResource Muted}" FontSize="9" FontWeight="Bold"/></Border></Grid><Grid Margin="0,22,0,0"><TextBlock Text="PROGRESSO" Style="{StaticResource Label}"/><TextBlock x:Name="TripProgressText" Text="0%" Foreground="{StaticResource Text}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Right"/></Grid><Grid Height="24" Margin="0,8,0,0"><Border Height="8" VerticalAlignment="Center" Background="#1D2733" CornerRadius="4"/><Border x:Name="TripProgressFill" Height="8" Width="0" HorizontalAlignment="Left" VerticalAlignment="Center" Background="{StaticResource Orange}" CornerRadius="4"/><TextBlock x:Name="TripTruckText" Text="🚚" FontSize="20" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="-9,0,0,0"/></Grid><Grid Margin="0,5,0,0"><TextBlock Text="SAÍDA" Style="{StaticResource Label}"/><TextBlock x:Name="TripRemainingText" Text="— km restantes" Style="{StaticResource Label}" HorizontalAlignment="Center"/><TextBlock Text="DESTINO" Style="{StaticResource Label}" HorizontalAlignment="Right"/></Grid><Grid Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Grid.Column="0" Background="{StaticResource Panel2}" CornerRadius="11" Padding="12" Margin="0,0,5,0"><StackPanel><TextBlock Text="DISTÂNCIA" Style="{StaticResource Label}"/><TextBlock x:Name="TripDistanceText" Text="0 km" Foreground="{StaticResource Text}" FontSize="18" FontWeight="Bold" Margin="0,4,0,0"/></StackPanel></Border><Border Grid.Column="1" Background="{StaticResource Panel2}" CornerRadius="11" Padding="12" Margin="5,0,0,0"><StackPanel><TextBlock Text="TEMPO DECORRIDO" Style="{StaticResource Label}"/><TextBlock x:Name="TripDurationText" Text="00:00:00" Foreground="{StaticResource Text}" FontSize="16" FontWeight="Bold" Margin="0,4,0,0"/></StackPanel></Border></Grid></StackPanel></Border>
          <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Grid.Column="0" Style="{StaticResource Card}" Padding="12" Margin="0,0,5,0"><StackPanel><TextBlock Text="SAÍDA" Style="{StaticResource Label}"/><TextBlock x:Name="TripStartText" Text="—" Foreground="{StaticResource Text}" FontSize="11" FontWeight="Bold" Margin="0,4,0,0"/></StackPanel></Border><Border Grid.Column="1" Style="{StaticResource Card}" Padding="12" Margin="5,0"><StackPanel><TextBlock Text="CHEGADA ESTIMADA" Style="{StaticResource Label}"/><TextBlock x:Name="TripArrivalText" Text="Calculando…" Foreground="{StaticResource Green}" FontSize="11" FontWeight="Bold" Margin="0,4,0,0" TextWrapping="Wrap"/></StackPanel></Border><Border Grid.Column="2" Style="{StaticResource Card}" Padding="12" Margin="5,0,0,0"><StackPanel><TextBlock Text="TEMPO RESTANTE" Style="{StaticResource Label}"/><TextBlock x:Name="TripEtaText" Text="Calculando…" Foreground="{StaticResource Text}" FontSize="11" FontWeight="Bold" Margin="0,4,0,0" TextWrapping="Wrap"/></StackPanel></Border></Grid>
          <Border Style="{StaticResource Card}" Padding="14" Margin="0,10,0,0"><StackPanel><Grid><TextBlock Text="CENTRAL DE OPERAÇÃO" Style="{StaticResource Label}"/><TextBlock x:Name="OpsCounterText" Text="" Foreground="{StaticResource Text}" FontSize="10" HorizontalAlignment="Right" TextWrapping="Wrap"/></Grid><TextBlock x:Name="TripEstimateNoteText" Text="Estimativa baseada na telemetria real da viagem." Foreground="{StaticResource Muted}" FontSize="9" Margin="0,6,0,0"/></StackPanel></Border>
          <UniformGrid Columns="4" Margin="-4,8,-4,0"><Button Content="💰 BANCO" Tag="feature-bank" Click="BankButtonV15_Click" Style="{StaticResource TabletButton}"/><Button Content="🚛 GARAGEM" Tag="feature-garage" Click="GarageButtonV15_Click" Style="{StaticResource TabletButton}"/><Button Content="📦 MERCADO" Tag="feature-cargo-market" Click="CargoMarketButtonV15_Click" Style="{StaticResource TabletButton}"/><Button Content="🧾 NOTA FISCAL" Tag="feature-invoice" Click="InvoiceButtonV15_Click" Style="{StaticResource TabletButton}"/></UniformGrid>
          <Button x:Name="UnlockButton" Content="🔓 DESBLOQUEAR CAMINHÃO" Click="UnlockButton_Click" Style="{StaticResource TabletButton}" Height="42" Margin="4,4,4,0" Background="#1B1710" BorderBrush="#594A16" Foreground="{StaticResource Yellow}"/>
        </StackPanel>
      </Grid>
      <Border Grid.Row="2" Background="#0B1017" CornerRadius="0,0,28,28" Padding="16,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><UniformGrid Grid.Column="0" Columns="6"><Button Content="⌂  INÍCIO" Click="HomeButton_Click" Style="{StaticResource TabletButton}"/><Button Content="▣  VIAGEM" Click="SummaryButton_Click" Style="{StaticResource TabletButton}"/><Button Content="💰  BANCO" Tag="feature-bank" Click="BankButtonV15_Click" Style="{StaticResource TabletButton}"/><Button Content="🚛  GARAGEM" Tag="feature-garage" Click="GarageButtonV15_Click" Style="{StaticResource TabletButton}"/><Button Content="📦  MERCADO" Tag="feature-cargo-market" Click="CargoMarketButtonV15_Click" Style="{StaticResource TabletButton}"/><Button Content="🧾  NOTA" Tag="feature-invoice" Click="InvoiceButtonV15_Click" Style="{StaticResource TabletButton}"/></UniformGrid><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0"><Button Content="⭳ Atualizar" Click="UpdateButton_Click" Style="{StaticResource TabletButton}" FontSize="9" Padding="9,7"/><Button Content="ℹ Sobre" Click="AboutButton_Click" Style="{StaticResource TabletButton}" FontSize="9" Padding="9,7"/><TextBlock x:Name="StatusText" Text="TransPoli pronto. Inicie o Connector junto com o ETS2." Foreground="{StaticResource Muted}" FontSize="9" VerticalAlignment="Center" Margin="5,0,0,0" MaxWidth="250" TextWrapping="Wrap"/><TextBlock Text="v1.0.15" Foreground="{StaticResource Orange}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" Margin="10,0,0,0"/></StackPanel></Grid></Border>
    </Grid></Border>
  </Grid>
</Window>
