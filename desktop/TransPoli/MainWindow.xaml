        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
         <StackPanel Orientation="Horizontal"><Border Width="34" Height="34" CornerRadius="10" Background="#191409" BorderBrush="{StaticResource StrokeGold}" BorderThickness="1"><TextBlock Text="$" Foreground="{StaticResource GoldBright}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="9,0,0,0"><TextBlock Text="MEU BANCO" Foreground="{StaticResource TextMain}" FontSize="15" FontWeight="Bold"/><TextBlock Text="Saldo, entradas, saídas e resultado da operação" Foreground="{StaticResource TextMuted}" FontSize="7"/></StackPanel></StackPanel>
         <Grid Grid.Row="1" Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="1.45*"/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="SALDO DISPONÍVEL" Style="{StaticResource Label}"/><TextBlock x:Name="DashboardBankBalanceText" Text="R$ —" Foreground="{StaticResource Green}" FontSize="25" FontWeight="Bold"/></StackPanel><StackPanel Grid.Column="1" Margin="10,0"><TextBlock Text="ENTRADAS" Style="{StaticResource Label}"/><TextBlock x:Name="DashboardBankCreditsText" Text="R$ —" Foreground="{StaticResource TextMain}" FontSize="12" FontWeight="Bold"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="SAÍDAS" Style="{StaticResource Label}"/><TextBlock x:Name="DashboardBankDebitsText" Text="R$ —" Foreground="{StaticResource GoldBright}" FontSize="12" FontWeight="Bold"/></StackPanel></Grid>
         <Border Grid.Row="2" Background="#9A060A0F" BorderBrush="#202B36" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,12,0,0"><Grid><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions><TextBlock Text="RESUMO FINANCEIRO" Foreground="{StaticResource GoldBright}" FontSize="7" FontWeight="Bold"/><TextBlock Grid.Row="1" x:Name="DashboardBankTripsText" Text="— viagens pagas" Foreground="{StaticResource TextMain}" FontSize="12" FontWeight="Bold" Margin="0,4,0,0"/><TextBlock Grid.Row="2" x:Name="DashboardBankStatusText" Text="Sincronizando com o banco..." Foreground="{StaticResource TextMuted}" FontSize="7" TextWrapping="Wrap" Margin="0,3,0,0"/></Grid></Border>
         <Button Grid.Row="2" Content="ABRIR BANCO COMPLETO" Click="BankButtonV15_Click" Style="{StaticResource ActionButton}" Width="150" Height="30" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
        </Grid>
       </Border>
       <Border Grid.Column="1" Background="#B8080E15" BorderBrush="{StaticResource StrokeGold}" BorderThickness="1" CornerRadius="17" Padding="16" Margin="5,0,0,0">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
         <StackPanel Orientation="Horizontal"><Border Width="34" Height="34" CornerRadius="10" Background="#191409" BorderBrush="{StaticResource StrokeGold}" BorderThickness="1"><TextBlock Text="⏱" FontFamily="Segoe UI Symbol" Foreground="{StaticResource GoldBright}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="9,0,0,0"><TextBlock Text="TACÓGRAFO DIGITAL" Foreground="{StaticResource TextMain}" FontSize="15" FontWeight="Bold"/><TextBlock Text="Jornada, roteiro da viagem e impressão" Foreground="{StaticResource TextMuted}" FontSize="7"/></StackPanel></StackPanel>
         <Grid Grid.Row="1" Margin="0,10,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions><Border Background="#9A10161C" BorderBrush="#26313D" BorderThickness="1" CornerRadius="12" Padding="11" Margin="0,0,5,0"><StackPanel VerticalAlignment="Center"><TextBlock Text="JORNADA" Style="{StaticResource Label}"/><TextBlock Text="DIREÇÃO • DESCANSO • REFEIÇÃO" Foreground="{StaticResource TextMain}" FontSize="9" FontWeight="Bold" TextWrapping="Wrap" Margin="0,4,0,0"/><TextBlock Text="Registros sincronizados com a telemetria." Foreground="{StaticResource TextMuted}" FontSize="7" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel></Border><Border Grid.Column="1" Background="#F5F1E8" BorderBrush="#C8BFA9" BorderThickness="1" CornerRadius="4" Padding="9" Margin="5,0,0,0"><StackPanel><TextBlock Text="ROTEIRO / NOTA" FontFamily="Consolas" Foreground="#2B2B2B" FontSize="7" FontWeight="Bold"/><TextBlock Text="━━━━━━━━━━━━" Foreground="#77716A" FontSize="7" Margin="0,2"/><TextBlock x:Name="DashboardTachRouteText" Text="Nenhuma viagem ativa" Foreground="#222222" FontSize="8" FontWeight="Bold" TextWrapping="Wrap"/><TextBlock x:Name="DashboardTachCargoText" Text="Carga: —" Foreground="#55504A" FontSize="7" TextWrapping="Wrap" Margin="0,3,0,0"/><TextBlock Text="Documento disponível no tacógrafo" Foreground="#77716A" FontSize="6.5" Margin="0,5,0,0"/></StackPanel></Border></Grid>
         <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="VER DOCUMENTOS" Click="DocumentsButton_Click" Style="{StaticResource ActionButton}" Width="110" Height="30" Margin="0,0,6,0"/><Button Content="ABRIR TACÓGRAFO" Click="TachographButton_Click" Style="{StaticResource ActionButton}" Width="122" Height="30"/></StackPanel>
        </Grid>
       </Border>
      </Grid>
     </Grid>

