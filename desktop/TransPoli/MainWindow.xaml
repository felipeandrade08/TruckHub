<Window x:Class="TransPoli.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TransPoli • Computador de Bordo"
        Width="720" Height="960" MinWidth="380" MinHeight="520"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResize" SnapsToDevicePixels="True"
        WindowStartupLocation="CenterScreen" KeyDown="Window_KeyDown"
        Icon="/TransPoli;component/Assets/transpoli-logo.png">
  <Window.Resources>
    <Style TargetType="Border" x:Key="Card"><Setter Property="Background" Value="{StaticResource PanelGlass}"/><Setter Property="CornerRadius" Value="20"/><Setter Property="BorderBrush" Value="{StaticResource Panel2}"/><Setter Property="BorderThickness" Value="1"/></Style>
    <Style TargetType="TextBlock" x:Key="Label"><Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style TargetType="Button" x:Key="TabletButton">
      <Setter Property="Background" Value="{StaticResource Panel2}"/><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="BorderBrush" Value="#1D3B57"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="12,11"/><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="3"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Chrome" CornerRadius="16" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextBlock.TextAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#17395A"/><Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Orange}"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{StaticResource Orange}"/><Setter Property="Foreground" Value="#02080F"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="Button" x:Key="ChassisButton"><Setter Property="Width" Value="30"/><Setter Property="Height" Value="30"/><Setter Property="Margin" Value="6,0,0,0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Foreground" Value="#8A8F96"/><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Dot" CornerRadius="15" Background="#1A1C20"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Dot" Property="Background" Value="#34383E"/><Setter Property="Foreground" Value="#FFFFFF"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="Button" x:Key="HomeHardButton"><Setter Property="Width" Value="78"/><Setter Property="Height" Value="78"/><Setter Property="Cursor" Value="Hand"/><Setter Property="ToolTip" Value="Início"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Grid><Ellipse x:Name="Ring" Stroke="#3A3D42" StrokeThickness="2"><Ellipse.Fill><RadialGradientBrush GradientOrigin="0.4,0.35"><GradientStop Color="#2A2D33" Offset="0"/><GradientStop Color="#141619" Offset="1"/></RadialGradientBrush></Ellipse.Fill></Ellipse><Ellipse x:Name="Glow" Margin="16" Stroke="#4A4E55" StrokeThickness="0" Fill="Transparent"/></Grid><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Ring" Property="Stroke" Value="{StaticResource Orange}"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Glow" Property="Fill" Value="#33FFC41F"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <LinearGradientBrush x:Key="ChassisMetal" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#F2F3F5" Offset="0"/><GradientStop Color="#C9CCD1" Offset="0.5"/><GradientStop Color="#9EA3AA" Offset="1"/></LinearGradientBrush>
  </Window.Resources>
  <Viewbox Stretch="Uniform" Margin="10"><Grid Width="1000" Height="1400">
    <Border Background="{StaticResource ChassisMetal}" CornerRadius="72" Padding="7" MouseLeftButtonDown="TabletDrag"><Border.Effect><DropShadowEffect BlurRadius="60" ShadowDepth="16" Direction="270" Opacity="0.55" Color="#000000"/></Border.Effect>
      <Border Background="#070708" CornerRadius="66"><Grid><Grid.RowDefinitions><RowDefinition Height="104"/><RowDefinition Height="*"/><RowDefinition Height="150"/></Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="60,0,60,0"><Ellipse Width="12" Height="12" Fill="#1C1E22" HorizontalAlignment="Center" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Button Style="{StaticResource ChassisButton}" Content="—" Click="TabletMinimize_Click" ToolTip="Minimizar"/><Button Style="{StaticResource ChassisButton}" Content="▢" Click="TabletMaximize_Click" ToolTip="Maximizar"/><Button Style="{StaticResource ChassisButton}" Content="✕" Click="TabletClose_Click" ToolTip="Fechar"/></StackPanel></Grid>
        <Border Grid.Row="1" Margin="46,0,46,0" CornerRadius="8" Background="{StaticResource Bg}" BorderBrush="#101215" BorderThickness="1" ClipToBounds="True"><Grid><Image Source="{StaticResource BrandBackground}" Stretch="UniformToFill" Opacity="0.30" RenderOptions.BitmapScalingMode="HighQuality"/><Rectangle Fill="{StaticResource BrandOverlay}"/>
          <Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel Grid.Row="0"><StackPanel Orientation="Horizontal"><Image Source="{StaticResource BrandLogo}" Width="58" Height="58" RenderOptions.BitmapScalingMode="HighQuality"/><StackPanel Margin="14,0,0,0" VerticalAlignment="Center"><TextBlock Text="TRANSPOLI" Foreground="{StaticResource Text}" FontSize="26" FontWeight="Bold"/><TextBlock Text="COMPUTADOR DE BORDO" Foreground="{StaticResource Muted}" FontSize="11" FontWeight="SemiBold"/></StackPanel></StackPanel><Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Grid.Column="0" Background="{StaticResource PanelGlass}" CornerRadius="14" Padding="12,9" Margin="0,0,5,0"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Ellipse x:Name="ConnectionDot" Width="10" Height="10" Fill="{StaticResource Muted}" Margin="0,0,8,0" VerticalAlignment="Center"/><TextBlock x:Name="ConnectionText" Text="ETS2 DESCONECTADO" Foreground="{StaticResource Muted}" FontSize="12" FontWeight="SemiBold"/></StackPanel></Border><Border Grid.Column="1" Background="{StaticResource PanelGlass}" CornerRadius="14" Padding="12,9" Margin="5,0,0,0"><TextBlock x:Name="VehicleLockText" Text="🔒 CAMINHÃO BLOQUEADO" Foreground="{StaticResource Yellow}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center"/></Border></Grid></StackPanel>
          <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly"><StackPanel>
            <Border Style="{StaticResource Card}" Padding="20"><StackPanel><Grid><StackPanel><TextBlock Text="STATUS DO VEÍCULO" Foreground="{StaticResource Orange}" FontSize="11" FontWeight="Bold"/><TextBlock x:Name="TruckName" Text="Aguardando ETS2" Foreground="{StaticResource Text}" FontSize="24" FontWeight="Bold" Margin="0,5,0,0" TextWrapping="Wrap"/><TextBlock x:Name="RouteText" Text="Conecte o ETS2 para receber a telemetria." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap"/></StackPanel><StackPanel HorizontalAlignment="Right" VerticalAlignment="Top"><TextBlock Text="MOTOR" Style="{StaticResource Label}" HorizontalAlignment="Right"/><TextBlock x:Name="EngineStateText" Text="DESLIGADO" Foreground="{StaticResource Yellow}" FontSize="14" FontWeight="Bold" HorizontalAlignment="Right"/></StackPanel></Grid><TextBlock x:Name="SpeedText" Text="0" Foreground="{StaticResource Text}" FontSize="118" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,10,0,0"/><TextBlock Text="KM/H" Foreground="{StaticResource Orange}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,-14,0,0"/><Grid Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Grid.Column="0" Background="{StaticResource Panel2}" CornerRadius="14" Padding="12,10" Margin="0,0,4,0"><StackPanel><TextBlock Text="RPM" Style="{StaticResource Label}"/><TextBlock x:Name="RpmText" Text="0" Foreground="{StaticResource Text}" FontSize="22" FontWeight="Bold"/></StackPanel></Border><Border Grid.Column="1" Background="{StaticResource Panel2}" CornerRadius="14" Padding="12,10" Margin="4,0"><StackPanel><TextBlock Text="MARCHA" Style="{StaticResource Label}"/><TextBlock x:Name="GearText" Text="N" Foreground="{StaticResource Yellow}" FontSize="22" FontWeight="Bold"/></StackPanel></Border><Border Grid.Column="2" Background="{StaticResource Panel2}" CornerRadius="14" Padding="12,10" Margin="4,0,0,0"><StackPanel><TextBlock Text="CRUISE" Style="{StaticResource Label}"/><TextBlock x:Name="CruiseText" Text="OFF" Foreground="{StaticResource Muted}" FontSize="22" FontWeight="Bold"/></StackPanel></Border></Grid><Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Grid.Column="0"><TextBlock Text="ODÔMETRO" Style="{StaticResource Label}"/><TextBlock x:Name="OdometerText" Text="0 km" Foreground="{StaticResource Text}" FontSize="18" FontWeight="Bold"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="COMBUSTÍVEL" Style="{StaticResource Label}"/><TextBlock x:Name="FuelText" Text="0 L" Foreground="{StaticResource Text}" FontSize="18" FontWeight="Bold"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="AUTONOMIA" Style="{StaticResource Label}"/><TextBlock x:Name="RangeText" Text="0 km" Foreground="{StaticResource Text}" FontSize="18" FontWeight="Bold"/></StackPanel></Grid></StackPanel></Border>
            <Border Style="{StaticResource Card}" Padding="18" Margin="0,12,0,0"><StackPanel><TextBlock Text="CENTRAL DE OPERAÇÃO" Foreground="{StaticResource Orange}" FontSize="11" FontWeight="Bold"/><Grid Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="TripStatusText" Text="Aguardando trabalho do ETS2" Foreground="{StaticResource Text}" FontSize="19" FontWeight="Bold" TextWrapping="Wrap"/><TextBlock x:Name="TripRouteText" Text="Nenhuma viagem ativa" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/><TextBlock x:Name="TripCargoText" Text="" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/></StackPanel><Border Background="{StaticResource Panel2}" CornerRadius="10" Padding="8,5" Margin="8,0,0,0" VerticalAlignment="Top"><TextBlock x:Name="TripLiveText" Text="OFFLINE" Foreground="{StaticResource Muted}" FontSize="9" FontWeight="Bold"/></Border></Grid>
              <Border Background="#0A1828" BorderBrush="#1D3B57" BorderThickness="1" CornerRadius="14" Padding="14" Margin="0,12,0,0"><StackPanel><Grid><TextBlock Text="PROGRESSO DA VIAGEM" Style="{StaticResource Label}"/><TextBlock x:Name="TripProgressText" Text="0%" Foreground="{StaticResource Text}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Right"/></Grid><Grid Height="22" Margin="4,8,4,0"><Border Height="8" VerticalAlignment="Center" Background="#17283A" CornerRadius="4"/><Border x:Name="TripProgressFill" Height="8" Width="0" HorizontalAlignment="Left" VerticalAlignment="Center" Background="{StaticResource Orange}" CornerRadius="4"/><TextBlock x:Name="TripTruckText" Text="🚚" FontSize="22" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="-10,0,0,0"/></Grid><Grid Margin="4,3,4,0"><TextBlock Text="SAÍDA" Style="{StaticResource Label}"/><TextBlock x:Name="TripRemainingText" Text="— km restantes" Style="{StaticResource Label}" HorizontalAlignment="Center"/><TextBlock Text="DESTINO" Style="{StaticResource Label}" HorizontalAlignment="Right"/></Grid></StackPanel></Border>
              <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Grid.Column="0" Background="{StaticResource Panel2}" CornerRadius="14" Padding="12" Margin="0,0,4,0"><StackPanel><TextBlock Text="DISTÂNCIA" Style="{StaticResource Label}"/><TextBlock x:Name="TripDistanceText" Text="0 km" Foreground="{StaticResource Text}" FontSize="22" FontWeight="Bold"/></StackPanel></Border><Border Grid.Column="1" Background="{StaticResource Panel2}" CornerRadius="14" Padding="12" Margin="4,0,0,0"><StackPanel><TextBlock Text="TEMPO DECORRIDO" Style="{StaticResource Label}"/><TextBlock x:Name="TripDurationText" Text="00:00:00" Foreground="{StaticResource Text}" FontSize="18" FontWeight="Bold"/></StackPanel></Border></Grid>
              <Grid Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Grid.Column="0" Style="{StaticResource Card}" Padding="9" Margin="0,0,3,0"><StackPanel><TextBlock Text="SAÍDA" Style="{StaticResource Label}"/><TextBlock x:Name="TripStartText" Text="—" Foreground="{StaticResource Text}" FontSize="12" FontWeight="Bold"/></StackPanel></Border><Border Grid.Column="1" Style="{StaticResource Card}" Padding="9" Margin="3,0"><StackPanel><TextBlock Text="CHEGADA ESTIMADA" Style="{StaticResource Label}"/><TextBlock x:Name="TripArrivalText" Text="Calculando…" Foreground="{StaticResource Green}" FontSize="12" FontWeight="Bold" TextWrapping="Wrap"/></StackPanel></Border><Border Grid.Column="2" Style="{StaticResource Card}" Padding="9" Margin="3,0,0,0"><StackPanel><TextBlock Text="TEMPO RESTANTE" Style="{StaticResource Label}"/><TextBlock x:Name="TripEtaText" Text="Calculando…" Foreground="{StaticResource Text}" FontSize="12" FontWeight="Bold" TextWrapping="Wrap"/></StackPanel></Border></Grid>
              <TextBlock x:Name="TripEstimateNoteText" Text="Estimativa baseada na telemetria real da viagem." Foreground="{StaticResource Muted}" FontSize="10" Margin="2,7,2,0" TextWrapping="Wrap"/>
              <Button x:Name="UnlockButton" Content="🔓 DESBLOQUEAR CAMINHÃO" Click="UnlockButton_Click" Style="{StaticResource TabletButton}" FontSize="14" Padding="14" Margin="0,12,0,0"/></StackPanel></Border>
            <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Grid.Column="0" Style="{StaticResource Card}" Padding="16" Margin="0,0,6,0"><StackPanel><TextBlock Text="CARGA" Style="{StaticResource Label}"/><TextBlock x:Name="CargoText" Text="Nenhuma carga" Foreground="{StaticResource Text}" FontSize="16" FontWeight="Bold" Margin="0,4,0,0" TextWrapping="Wrap"/><TextBlock x:Name="CargoMassText" Text="0 kg" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,3,0,0"/></StackPanel></Border><Border Grid.Column="1" Style="{StaticResource Card}" Padding="16" Margin="6,0,0,0"><StackPanel><TextBlock Text="CONTADORES TRANS POLI" Style="{StaticResource Label}"/><TextBlock x:Name="OpsCounterText" Text="⛽ 0 abastecimentos  •  🛑 0 paradas  •  ⚠ 0 ocorrências  •  📄 0 documentos" Foreground="{StaticResource Text}" FontSize="12" Margin="0,7,0,0" TextWrapping="Wrap"/></StackPanel></Border></Grid>
            <Border Style="{StaticResource Card}" Padding="16" Margin="0,12,0,0"><StackPanel><TextBlock Text="CENTRAL DE ALERTAS" Style="{StaticResource Label}"/><TextBlock x:Name="AlertText" Text="Nenhum alerta ativo" Foreground="{StaticResource Green}" FontSize="14" FontWeight="Bold" Margin="0,6,0,0" TextWrapping="Wrap"/><TextBlock x:Name="TelemetryInfoText" Text="Telemetria aguardando conexão" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/><TextBlock x:Name="FuelAutoText" Text="Abastecimento automático: aguardando telemetria" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/></StackPanel></Border>
            <Border Style="{StaticResource Card}" Padding="12" Margin="0,12,0,0"><StackPanel><Grid><TextBlock Text="PAINEL RÁPIDO" Style="{StaticResource Label}" Margin="4,2,0,0"/><TextBlock Text="COMPUTADOR DE BORDO" Foreground="{StaticResource Muted}" FontSize="9" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid><UniformGrid Columns="2" Margin="0,6,0,0"><Button Content="⛽ ABASTECIMENTO" Click="FuelButton_Click" Style="{StaticResource TabletButton}"/><Button Content="🛑 PARADAS" Click="StopsButton_Click" Style="{StaticResource TabletButton}"/><Button Content="⚠ OCORRÊNCIAS" Click="OccurrenceButton_Click" Style="{StaticResource TabletButton}"/><Button Content="📄 DOCUMENTOS" Click="DocumentsButton_Click" Style="{StaticResource TabletButton}"/></UniformGrid></StackPanel></Border>
            <TextBlock Height="6"/>
          </StackPanel></ScrollViewer>
          <StackPanel Grid.Row="4"><Border Style="{StaticResource Card}" Padding="6"><UniformGrid Columns="6"><Button Content="⌂&#x0a;INÍCIO" Click="HomeButton_Click" Style="{StaticResource TabletButton}" FontSize="11" Padding="4,8"/><Button Content="▣&#x0a;VIAGEM" Click="SummaryButton_Click" Style="{StaticResource TabletButton}" FontSize="11" Padding="4,8"/><Button Content="⛽&#x0a;ABAST." Click="FuelButton_Click" Style="{StaticResource TabletButton}" FontSize="11" Padding="4,8"/><Button Content="🛑&#x0a;PARADAS" Click="StopsButton_Click" Style="{StaticResource TabletButton}" FontSize="11" Padding="4,8"/><Button Content="⚠&#x0a;OCORR." Click="OccurrenceButton_Click" Style="{StaticResource TabletButton}" FontSize="11" Padding="4,8"/><Button Content="📄&#x0a;DOCS" Click="DocumentsButton_Click" Style="{StaticResource TabletButton}" FontSize="11" Padding="4,8"/></UniformGrid></Border><Grid Margin="6,6,2,0"><TextBlock x:Name="StatusText" Text="TransPoli pronto. Inicie o Connector junto com o ETS2." Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,0,260,0"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="⭳ Atualizar" Click="UpdateButton_Click" Style="{StaticResource TabletButton}" FontSize="9" Padding="7,5" ToolTip="Verificar atualização"/><Button Content="ℹ Sobre" Click="AboutButton_Click" Style="{StaticResource TabletButton}" FontSize="9" Padding="7,5" ToolTip="Sobre o TransPoli"/><TextBlock Text="v1.0.12 • por Felipe Andrade" Foreground="{StaticResource Muted}" FontSize="10" Opacity="0.75" VerticalAlignment="Center" Margin="4,0,0,0"/></StackPanel></Grid></StackPanel>
        </Grid></Border>
        <Button Grid.Row="2" Style="{StaticResource HomeHardButton}" Click="HomeButton_Click" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Grid></Border>
  </Grid></Viewbox>
</Window>
