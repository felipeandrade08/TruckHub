<Window x:Class="TransPoli.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="TransPoli • Computador de Bordo" Width="1520" Height="940"
 WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
 SnapsToDevicePixels="True" WindowStartupLocation="CenterScreen" KeyDown="Window_KeyDown"
 Icon="/TransPoli;component/Assets/transpoli-logo.png">

 <Window.Resources>
  <FontFamily x:Key="TransPoliFont">Segoe UI</FontFamily>
  <Style TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource TransPoliFont}"/></Style>
  <SolidColorBrush x:Key="Gold" Color="#D8A92E"/>
  <SolidColorBrush x:Key="GoldBright" Color="#FFE19A"/>
  <SolidColorBrush x:Key="GoldSoft" Color="#9D7620"/>
  <SolidColorBrush x:Key="Bg" Color="#05070A"/>
  <SolidColorBrush x:Key="Surface" Color="#0A0F14"/>
  <SolidColorBrush x:Key="Surface2" Color="#0E151C"/>
  <SolidColorBrush x:Key="Surface3" Color="#131B23"/>
  <SolidColorBrush x:Key="Stroke" Color="#26313D"/>
  <SolidColorBrush x:Key="StrokeGold" Color="#604A0B"/>
  <SolidColorBrush x:Key="TextMain" Color="#F5F7FA"/>
  <SolidColorBrush x:Key="TextMuted" Color="#8E9AA8"/>
  <SolidColorBrush x:Key="Green" Color="#54D99B"/>
  <SolidColorBrush x:Key="Red" Color="#F06A6A"/>
  <Style x:Key="Card" TargetType="Border">
   <Setter Property="Background">
    <Setter.Value><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#F20C1219" Offset="0"/><GradientStop Color="#E6070B11" Offset="1"/></LinearGradientBrush></Setter.Value>
   </Setter>
   <Setter Property="BorderBrush" Value="{StaticResource Stroke}"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="CornerRadius" Value="14"/>
   <Setter Property="Padding" Value="14"/>
   <Setter Property="Effect"><Setter.Value><DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity=".24"/></Setter.Value></Setter>
  </Style>
  <Style x:Key="GoldCard" TargetType="Border">
   <Setter Property="Background">
    <Setter.Value><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#E61A1307" Offset="0"/><GradientStop Color="#D9080D12" Offset="1"/></LinearGradientBrush></Setter.Value>
   </Setter>
   <Setter Property="BorderBrush" Value="{StaticResource StrokeGold}"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="CornerRadius" Value="14"/>
   <Setter Property="Padding" Value="14"/>
   <Setter Property="Effect"><Setter.Value><DropShadowEffect BlurRadius="26" ShadowDepth="0" Opacity=".28"/></Setter.Value></Setter>
  </Style>
  <Style x:Key="Label" TargetType="TextBlock">
   <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
   <Setter Property="FontSize" Value="8.8"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style x:Key="Metric" TargetType="TextBlock">
   <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
   <Setter Property="FontSize" Value="20"/>
   <Setter Property="FontWeight" Value="Bold"/>
  </Style>
  <Style x:Key="NavButton" TargetType="Button">
   <Setter Property="Height" Value="60"/>
   <Setter Property="MinWidth" Value="88"/>
   <Setter Property="Margin" Value="3,2"/>
   <Setter Property="Background" Value="Transparent"/>
   <Setter Property="Padding" Value="6,5"/>
   <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
   <Setter Property="BorderThickness" Value="0"/>
   <Setter Property="FontSize" Value="8.5"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Border x:Name="N" Background="{TemplateBinding Background}" BorderBrush="#17212B" BorderThickness="1" CornerRadius="13" Padding="{TemplateBinding Padding}">
       <Grid>
        <Border x:Name="NavGlow" Width="3" Height="28" HorizontalAlignment="Left" VerticalAlignment="Center" Background="{StaticResource Gold}" CornerRadius="2" Opacity="0"/>
        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
       </Grid>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="N" Property="Background" Value="#241B07"/>
        <Setter TargetName="N" Property="BorderBrush" Value="#5C4610"/>
        <Setter TargetName="NavGlow" Property="Opacity" Value="1"/>
        <Setter Property="Foreground" Value="{StaticResource GoldBright}"/>
       </Trigger>
       <Trigger Property="IsPressed" Value="True">
        <Setter TargetName="N" Property="Opacity" Value="0.78"/>
       </Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style x:Key="ActionButton" TargetType="Button">
   <Setter Property="Height" Value="36"/>
   <Setter Property="Padding" Value="12,5"/>
   <Setter Property="Background" Value="#101821"/>
   <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
   <Setter Property="BorderBrush" Value="{StaticResource StrokeGold}"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="FontSize" Value="8.5"/>
   <Setter Property="FontWeight" Value="Bold"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}">
       <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="B" Property="Background" Value="{StaticResource Gold}"/>
        <Setter Property="Foreground" Value="#090B0E"/>
       </Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <!-- SCROLLBARS TRANSPOLI: padrão visual único para todas as áreas roláveis do tablet. -->
  <Style TargetType="{x:Type ScrollBar}">
   <Setter Property="Width" Value="7"/>
   <Setter Property="Background" Value="Transparent"/>
   <Setter Property="Foreground" Value="#8F6E13"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="{x:Type ScrollBar}">
      <Grid Background="Transparent">
       <Track x:Name="PART_Track"
              Orientation="{TemplateBinding Orientation}"
              IsDirectionReversed="True"
              Minimum="{TemplateBinding Minimum}"
              Maximum="{TemplateBinding Maximum}"
              Value="{TemplateBinding Value}"
              ViewportSize="{TemplateBinding ViewportSize}">
        <Track.Thumb>
         <Thumb MinHeight="28" MinWidth="7">
          <Thumb.Template>
           <ControlTemplate TargetType="{x:Type Thumb}">
            <Border x:Name="ThumbBorder"
                    Margin="1,2"
                    Background="#8F6E13"
                    CornerRadius="3.5"
                    Opacity="0.72"/>
            <ControlTemplate.Triggers>
             <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="ThumbBorder" Property="Background" Value="#FFD45A"/>
              <Setter TargetName="ThumbBorder" Property="Opacity" Value="0.95"/>
             </Trigger>
             <Trigger Property="IsDragging" Value="True">
              <Setter TargetName="ThumbBorder" Property="Background" Value="#FFD45A"/>
              <Setter TargetName="ThumbBorder" Property="Opacity" Value="1"/>
             </Trigger>
            </ControlTemplate.Triggers>
           </ControlTemplate>
          </Thumb.Template>
         </Thumb>
        </Track.Thumb>
       </Track>
      </Grid>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>

  <Style x:Key="WindowButton" TargetType="Button">
   <Setter Property="Width" Value="34"/>
   <Setter Property="Height" Value="30"/>
   <Setter Property="Background" Value="#0C1218"/>
   <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
   <Setter Property="BorderThickness" Value="0"/>
   <Setter Property="FontSize" Value="17"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Border x:Name="W" Background="{TemplateBinding Background}" CornerRadius="15" Padding="0">
       <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="W" Property="Background" Value="#27323D"/><Setter Property="Foreground" Value="{StaticResource GoldBright}"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
 </Window.Resources>

 <Grid ClipToBounds="False">
  <!-- CHASSI FIXO DO TABLET — Etapa 1. A moldura permanece montada; apenas o conteúdo interno evolui nas próximas etapas. -->
  <Border Margin="1" Background="#010203" BorderBrush="#0D1116" BorderThickness="2" CornerRadius="58">
   <Border.Effect><DropShadowEffect BlurRadius="34" ShadowDepth="0" Opacity=".55"/></Border.Effect>
  </Border>
  <Border Margin="7" Background="#06090D" BorderBrush="#3F4953" BorderThickness="2" CornerRadius="54"/>
  <Border Margin="12" Background="#020407" BorderBrush="#A77C18" BorderThickness="1" CornerRadius="50" Opacity="0.96"/>
  <Border x:Name="TabletScreen" Margin="32" Background="#04070A" BorderBrush="#303B46" BorderThickness="1" CornerRadius="38" ClipToBounds="True">
   <Border.Effect><DropShadowEffect BlurRadius="22" ShadowDepth="0" Opacity=".30"/></Border.Effect>
   <Grid>
    <Grid.RowDefinitions>
     <RowDefinition Height="80"/>
     <RowDefinition Height="*"/>
     <RowDefinition Height="40"/>
    </Grid.RowDefinitions>

    <!-- FUNDO OEM DO TABLET: grafite profundo, vidro fosco e textura sutil. Sem fotografia atrás dos instrumentos. -->
    <Border Grid.Row="0" Grid.RowSpan="3" Background="#05080C" IsHitTestVisible="False"/>
    <Border Grid.Row="0" Grid.RowSpan="3" IsHitTestVisible="False">
     <Border.Background>
      <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
       <GradientStop Color="#10161D" Offset="0"/>
       <GradientStop Color="#070B10" Offset="0.42"/>
       <GradientStop Color="#030508" Offset="1"/>
      </LinearGradientBrush>
     </Border.Background>
    </Border>
    <Border Grid.Row="0" Grid.RowSpan="3" IsHitTestVisible="False" Opacity="0.16">
     <Border.Background>
      <DrawingBrush TileMode="Tile" Viewport="0,0,28,28" ViewportUnits="Absolute">
       <DrawingBrush.Drawing>
        <GeometryDrawing Brush="#17202A">
         <GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,1,1"/></GeometryDrawing.Geometry>
        </GeometryDrawing>
       </DrawingBrush.Drawing>
      </DrawingBrush>
     </Border.Background>
    </Border>
    <Border Grid.Row="0" Grid.RowSpan="3" IsHitTestVisible="False" Opacity="0.18">
     <Border.Background>
      <RadialGradientBrush Center="0.12,0.08" RadiusX="0.85" RadiusY="0.85">
       <GradientStop Color="#3A424C" Offset="0"/>
       <GradientStop Color="#10151B" Offset="0.45"/>
       <GradientStop Color="Transparent" Offset="1"/>
      </RadialGradientBrush>
     </Border.Background>
    </Border>
    <Border Grid.Row="0" Grid.RowSpan="3" Background="#0A0F14" Opacity="0.22" IsHitTestVisible="False"/>

    <!-- HEADER -->
    <Border Grid.Row="0" Background="#E0060B11" BorderBrush="#382D12" BorderThickness="0,0,0,1" CornerRadius="32,32,0,0">
     <Grid MouseLeftButtonDown="TabletDrag">
      <Grid.ColumnDefinitions>
       <ColumnDefinition Width="350"/>
       <ColumnDefinition Width="*"/>
       <ColumnDefinition Width="435"/>
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
       <Border Width="48" Height="48" CornerRadius="12" Background="#101720" BorderBrush="{StaticResource GoldSoft}" BorderThickness="1" Padding="5">
        <Image Source="{StaticResource BrandLogo}" Stretch="Uniform"/>
       </Border>
       <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
        <TextBlock Text="TRANSPOLI" Foreground="{StaticResource TextMain}" FontSize="21" FontWeight="Bold"/>
        <TextBlock Text="COMPUTADOR DE BORDO • ETS2" Foreground="{StaticResource GoldBright}" FontSize="7.5" FontWeight="Bold"/>
       </StackPanel>
      </StackPanel>

      <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
       <Border Background="#0E1715" BorderBrush="#285440" BorderThickness="1" CornerRadius="9" Padding="11,7" Margin="0,0,7,0">
        <StackPanel Orientation="Horizontal">
         <Ellipse x:Name="ConnectionDot" Width="9" Height="9" Fill="#758596" Margin="0,0,7,0"/>
         <StackPanel>
          <TextBlock x:Name="ConnectionText" Text="ETS2 DESCONECTADO" Foreground="{StaticResource TextMain}" FontSize="8.5" FontWeight="Bold"/>
          <TextBlock x:Name="StatusText" Text="Telemetria aguardando" Foreground="{StaticResource TextMuted}" FontSize="7"/>
         </StackPanel>
        </StackPanel>
       </Border>
       <Border Background="#B8151109" BorderBrush="{StaticResource StrokeGold}" BorderThickness="1" CornerRadius="9" Padding="11,7">
        <StackPanel Orientation="Horizontal">
         <TextBlock Text="▰" FontSize="15" FontFamily="Segoe UI Symbol" Margin="0,0,7,0"/>
         <StackPanel>
          <TextBlock x:Name="VehicleLockText" Text="CAMINHÃO BLOQUEADO" Foreground="{StaticResource GoldBright}" FontSize="8.5" FontWeight="Bold"/>
          <TextBlock Text="Liberação segura" Foreground="{StaticResource TextMuted}" FontSize="7"/>
         </StackPanel>
        </StackPanel>
       </Border>
      </StackPanel>

      <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0">
       <!-- CONTROLES DO TABLET: atualização da telemetria + atualização do aplicativo -->
       <!-- STATUS BAR REALISTA DE TABLET -->
       <Border Background="#A8080D12" BorderBrush="#26313D" BorderThickness="1" CornerRadius="12" Padding="10,5" Margin="0,0,8,0">
        <Grid>
         <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
         </Grid.ColumnDefinitions>
         <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
          <TextBlock x:Name="NetworkSignalText" Text="▂▄▆█" Foreground="{StaticResource Green}" FontSize="9" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,5,0"/>
          <StackPanel>
           <TextBlock x:Name="WifiStatusText" Text="Wi-Fi" Foreground="{StaticResource TextMain}" FontSize="7.5" FontWeight="Bold"/>
           <TextBlock x:Name="NetworkTypeText" Text="CONECTADO" Foreground="{StaticResource Green}" FontSize="5.5" FontWeight="Bold"/>
          </StackPanel>
         </StackPanel>
         <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
          <TextBlock x:Name="GpsStatusText" Text="●" Foreground="{StaticResource Green}" FontSize="10" FontWeight="Bold" Margin="0,0,4,0"/>
          <StackPanel>
           <TextBlock Text="GPS" Foreground="{StaticResource TextMain}" FontSize="7.5" FontWeight="Bold"/>
           <TextBlock Text="ROTA ETS2" Foreground="{StaticResource TextMuted}" FontSize="5.5"/>
          </StackPanel>
         </StackPanel>
         <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
          <TextBlock x:Name="BluetoothStatusText" Text="N/D" Foreground="{StaticResource TextMuted}" FontSize="11" FontWeight="Bold" Margin="0,0,4,0"/>
          <StackPanel>
           <TextBlock Text="BT" Foreground="{StaticResource TextMain}" FontSize="7.5" FontWeight="Bold"/>
           <TextBlock Text="N/D" Foreground="{StaticResource TextMuted}" FontSize="5.5"/>
          </StackPanel>
         </StackPanel>
         <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="0,0,12,0">
          <TextBlock x:Name="ClockText" FontFamily="Segoe UI" Text="--:--" Foreground="{StaticResource TextMain}" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center"/>
          <TextBlock x:Name="DateText" Text="--/--/----" Foreground="{StaticResource TextMuted}" FontSize="5.5" HorizontalAlignment="Center"/>
         </StackPanel>
         <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock x:Name="NotificationStatusText" Text="◇" FontFamily="Segoe UI Symbol" Foreground="{StaticResource TextMuted}" FontSize="11" FontWeight="Bold" Margin="0,0,7,0"/>
          <TextBlock x:Name="BatteryStatusText" Text="▮▮▮▮" Foreground="{StaticResource Green}" FontSize="9" FontWeight="Bold" FontFamily="Segoe UI Symbol" VerticalAlignment="Center"/>
          <TextBlock x:Name="BatteryPercentText" Text="100%" Foreground="{StaticResource TextMain}" FontSize="7.5" FontWeight="Bold" Margin="4,0,0,0" VerticalAlignment="Center"/>
         </StackPanel>
        </Grid>
       </Border>
       <Button Content="−" Click="TabletMinimize_Click" Style="{StaticResource WindowButton}" ToolTip="Colocar em segundo plano" Margin="0,0,5,0"/>
       <Button Content="×" Click="TabletClose_Click" Style="{StaticResource WindowButton}" ToolTip="Fechar TransPoli"/>
      </StackPanel>
     </Grid>
    </Border>

    <!-- DIVISOR DE VIDRO DO COCKPIT -->
    <Border Grid.Row="0" Grid.RowSpan="3" Margin="0,80,0,40" BorderBrush="#FFFFFF" BorderThickness="0,0,0,1" Opacity="0.035" IsHitTestVisible="False"/>

    <!-- MAIN BODY — ETAPA 2: cockpit/tablet profissional -->
    <Grid Grid.Row="1" Margin="16,14,16,10">
     <Grid.ColumnDefinitions>
      <ColumnDefinition Width="196"/>
      <ColumnDefinition Width="*"/>
     </Grid.ColumnDefinitions>

     <!-- DOCK LATERAL DO TABLET -->
     <Border Grid.Column="0" Background="#D8070D13" BorderBrush="#2A3540" BorderThickness="1" CornerRadius="22" Padding="9">
      <Border.Effect><DropShadowEffect BlurRadius="16" ShadowDepth="0" Opacity=".22"/></Border.Effect>
      <Grid>
       <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="138"/></Grid.RowDefinitions>
       <ScrollViewer Grid.Row="0"
                     Margin="0,0,0,6"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Disabled"
                     CanContentScroll="True"
                     Focusable="False">
        <StackPanel>
        <Border Background="#151109" BorderBrush="{StaticResource StrokeGold}" BorderThickness="1" CornerRadius="12" Padding="9" Margin="1,1,1,9">
         <StackPanel>
          <TextBlock Text="TABLET DE BORDO" Foreground="{StaticResource GoldBright}" FontSize="7" FontWeight="Bold"/>
          <TextBlock Text="CENTRAL DO MOTORISTA" Foreground="{StaticResource TextMain}" FontSize="11" FontWeight="Bold" Margin="0,2,0,0"/>
          <TextBlock x:Name="TelemetryInfoText" Text="ETS2 conectado • telemetria ativa" Foreground="{StaticResource TextMuted}" FontSize="6.5" TextWrapping="Wrap" Margin="0,4,0,0"/>
         </StackPanel>
        </Border>
        <Button Style="{StaticResource NavButton}" Background="#332706" Foreground="{StaticResource GoldBright}" Click="HomeButton_Click">
         <StackPanel><TextBlock Text="⌂" FontSize="23" HorizontalAlignment="Center"/><TextBlock Text="PAINEL" HorizontalAlignment="Center" FontWeight="Bold"/></StackPanel>
        </Button>
        <Button Style="{StaticResource NavButton}" Click="SummaryButton_Click">
         <StackPanel><TextBlock Text="🧭" FontSize="20" HorizontalAlignment="Center"/><TextBlock Text="VIAGEM" HorizontalAlignment="Center" FontWeight="Bold"/></StackPanel>
        </Button>
        <Button Style="{StaticResource NavButton}" Click="GpsButton_Click">
         <StackPanel><TextBlock Text="⌖" FontSize="22" HorizontalAlignment="Center"/><TextBlock Text="GPS / MAPA" HorizontalAlignment="Center" FontWeight="Bold"/></StackPanel>
        </Button>
        <Button Style="{StaticResource NavButton}" Click="TachographButton_Click">
         <StackPanel><TextBlock Text="⏱" FontSize="21" HorizontalAlignment="Center"/><TextBlock Text="TACÓGRAFO" HorizontalAlignment="Center" FontWeight="Bold"/></StackPanel>
        </Button>
        <Button Style="{StaticResource NavButton}" Click="CargoMarketButtonV15_Click">
         <StackPanel><TextBlock Text="▦" FontSize="21" HorizontalAlignment="Center"/><TextBlock Text="MERCADO" HorizontalAlignment="Center"/><TextBlock Text="CARGAS" HorizontalAlignment="Center"/></StackPanel>
        </Button>
        <Button Style="{StaticResource NavButton}" Click="GarageButtonV15_Click">
         <StackPanel><TextBlock Text="🏠" FontSize="19" HorizontalAlignment="Center"/><TextBlock Text="GARAGEM" HorizontalAlignment="Center"/></StackPanel>
        </Button>
        <Button Style="{StaticResource NavButton}" Click="BankButtonV15_Click">
         <StackPanel><TextBlock Text="🏦" FontSize="19" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock Text="MEU BANCO" HorizontalAlignment="Center"/></StackPanel>
        </Button>
        <Button Style="{StaticResource NavButton}" Click="HudSettingsButton_Click">
         <StackPanel><TextBlock Text="⚙" FontSize="20" HorizontalAlignment="Center"/><TextBlock Text="HUD ETS2" HorizontalAlignment="Center" FontWeight="Bold"/></StackPanel>
        </Button>
        <Button Style="{StaticResource NavButton}" Click="FuelButton_Click">
         <StackPanel><TextBlock Text="⛽" FontSize="19" HorizontalAlignment="Center"/><TextBlock Text="COMBUSTÍVEL" HorizontalAlignment="Center"/></StackPanel>
        </Button>
        </StackPanel>
       </ScrollViewer>
       <Border Grid.Row="1" Background="#A90B1218" BorderBrush="#26313D" BorderThickness="1" CornerRadius="12" Padding="7">
        <StackPanel VerticalAlignment="Center">
         <Button Content="↻  ATUALIZAR TELEMETRIA" Click="RefreshDashboard_Click" Style="{StaticResource ActionButton}" Height="30" Width="184" ToolTip="Atualizar a leitura do ETS2 agora" HorizontalAlignment="Center"/>
         <Button Content="⬇  ATUALIZAR APP" Click="UpdateButton_Click" Style="{StaticResource ActionButton}" Height="28" Width="184" Margin="0,5,0,0" ToolTip="Verificar e instalar atualização do TransPoli" HorizontalAlignment="Center"/>
         <Button Content="↪  SAIR DA CONTA" Click="LogoutAccount_Click" Style="{StaticResource ActionButton}" Height="28" Width="184" Margin="0,5,0,0" ToolTip="Encerrar a sessão e voltar para a tela de login" HorizontalAlignment="Center"/>
         <TextBlock Text="SISTEMA" Foreground="{StaticResource TextMuted}" FontSize="6" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,6,0,0"/>
         <TextBlock Text="TRANSPOLI" Foreground="{StaticResource GoldBright}" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,1"/>
         <TextBlock Text="COMPUTADOR DE BORDO  •  v1.0.25" Foreground="{StaticResource TextMuted}" FontSize="5.5" HorizontalAlignment="Center"/>
        </StackPanel>
       </Border>
      </Grid>
     </Border>

     <!-- COCKPIT PRINCIPAL -->
     <Grid Grid.Column="1" Margin="11,0,0,0">
      <Grid.RowDefinitions>
       <RowDefinition Height="224"/>
       <RowDefinition Height="92"/>
       <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- HERO: VEÍCULO + VIAGEM -->
      <Grid Grid.Row="0">
       <Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="1.55*"/></Grid.ColumnDefinitions>

       <Border Grid.Column="0" Background="#D9080E15" BorderBrush="#35414E" BorderThickness="1" CornerRadius="20" Padding="16" Margin="0,0,5,5">
        <Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity=".22"/></Border.Effect>
        <Grid>
         <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
         <Grid>
          <StackPanel>
           <TextBlock Text="VEÍCULO CONECTADO" Foreground="{StaticResource GoldBright}" FontSize="7" FontWeight="Bold"/>
           <TextBlock x:Name="TruckName" Text="Aguardando ETS2" Foreground="{StaticResource TextMain}" FontSize="20" FontWeight="Bold" Margin="0,3,0,0"/>
           <TextBlock x:Name="EngineStateText" Text="MOTOR DESLIGADO" Foreground="{StaticResource TextMuted}" FontSize="7" FontWeight="Bold"/>
          </StackPanel>
          <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="#0D1714" BorderBrush="#285440" BorderThickness="1" CornerRadius="9" Padding="8,5">
           <StackPanel Orientation="Horizontal"><Ellipse Width="6" Height="6" Fill="{StaticResource Green}" Margin="0,0,5,0"/><TextBlock Text="TELEMETRIA" Foreground="{StaticResource Green}" FontSize="6.5" FontWeight="Bold"/></StackPanel>
          </Border>
         </Grid>
         <Grid Grid.Row="1" Margin="0,0,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="156"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Grid Width="164" Height="138" HorizontalAlignment="Left" VerticalAlignment="Center">
           <Ellipse Width="134" Height="134" Stroke="#18222C" StrokeThickness="10"/>
           <Ellipse Width="120" Height="120" Stroke="#303D4A" StrokeThickness="2"/>
           <Ellipse Width="108" Height="108" Stroke="#6A5011" StrokeThickness="1.5"/>
           <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock x:Name="SpeedText" Text="0" Foreground="{StaticResource TextMain}" FontSize="48" FontWeight="Bold" HorizontalAlignment="Center"/>
            <TextBlock Text="KM/H" Foreground="{StaticResource GoldBright}" FontSize="8" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,-2,0,0"/>
           </StackPanel>
           <TextBlock Text="0" Foreground="{StaticResource TextMuted}" FontSize="5.5" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,5,0,0"/>
