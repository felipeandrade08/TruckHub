           </Grid>
          </Grid>
         </Border>
         <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Content="DOCUMENTOS" Click="DocumentsButton_Click" Style="{StaticResource ActionButton}" Width="94" Height="28" Margin="0,0,5,0"/>
          <Button Content="TACÓGRAFO" Click="TachographButton_Click" Style="{StaticResource ActionButton}" Width="90" Height="28"/>
         </StackPanel>
        </Grid>
       </Border>
      </Grid>
