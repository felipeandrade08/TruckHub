<Window x:Class="TransPoli.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="TransPoli • TruckHub" Width="1180" Height="820" MinWidth="980" MinHeight="680"
 WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="CanResize"
 SnapsToDevicePixels="True" WindowStartupLocation="CenterScreen" KeyDown="Window_KeyDown"
 Icon="/TransPoli;component/Assets/transpoli-logo.png">
 <Window.Resources>
  <SolidColorBrush x:Key="Gold" Color="#FFC400"/><SolidColorBrush x:Key="Panel" Color="#091019"/>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="#091019"/><Setter Property="BorderBrush" Value="#735600"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="14"/><Setter Property="Padding" Value="11"/></Style>
  <Style x:Key="Label" TargetType="TextBlock"><Setter Property="Foreground" Value="#AFC0D2"/><Setter Property="FontSize" Value="8"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style x:Key="Value" TargetType="TextBlock"><Setter Property="Foreground" Value="White"/><Setter Property="FontSize" Value="18"/><Setter Property="FontWeight" Value="Bold"/></Style>
  <Style x:Key="NavButton" TargetType="Button"><Setter Property="Height" Value="62"/><Setter Property="Margin" Value="1,2"/><Setter Property="Padding" Value="3"/><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontSize" Value="8"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="N" Background="{TemplateBinding Background}" CornerRadius="11" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="N" Property="Background" Value="#352900"/><Setter Property="Foreground" Value="#FFC400"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="GoldButton" TargetType="Button"><Setter Property="Height" Value="34"/><Setter Property="Padding" Value="10,5"/><Setter Property="Background" Value="#0C141C"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#A77C00"/><Setter Property="BorderThickness" Value="1"/><Setter Property="FontSize" Value="9"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="G" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="G" Property="Background" Value="#FFC400"/><Setter Property="Foreground" Value="#070A0D"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="HeaderButton" TargetType="Button"><Setter Property="Height" Value="48"/><Setter Property="Padding" Value="11,5"/><Setter Property="Background" Value="#0A1118"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#806000"/><Setter Property="BorderThickness" Value="1"/><Setter Property="FontSize" Value="9"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Cursor" Value="Hand"/></Style>
  <Style x:Key="WindowButton" TargetType="Button"><Setter Property="Width" Value="30"/><Setter Property="Height" Value="30"/><Setter Property="Background" Value="#0A1118"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#35404C"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Cursor" Value="Hand"/></Style>
 </Window.Resources>

 <Grid>
  <!-- ARMADURA DO TABLET -->
  <Border Margin="7" Background="#030609" BorderBrush="#56616C" BorderThickness="2" CornerRadius="34"><Border.Effect><DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity=".8"/></Border.Effect></Border>
  <Border Margin="14" Background="#05080C" BorderBrush="#171E26" BorderThickness="2" CornerRadius="30"/>
  <Border Margin="27,29,27,29" Background="#05090E" BorderBrush="#7C8995" BorderThickness="1" CornerRadius="24"/>
  <Border Width="14" Height="14" CornerRadius="7" Background="#020406" BorderBrush="#3A4652" BorderThickness="2" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,15,0,0"/>
  <Border Width="5" Height="58" CornerRadius="3" Background="#1B222A" BorderBrush="#56616C" BorderThickness="1" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="5,0,0,0"/>
  <Border Width="5" Height="58" CornerRadius="3" Background="#1B222A" BorderBrush="#56616C" BorderThickness="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,5,0"/>
  <Border Width="76" Height="5" CornerRadius="3" Background="#242C35" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,12"/>

  <Border Margin="41,47,41,41" Background="#050B11" BorderBrush="#B28A00" BorderThickness="1" CornerRadius="20" ClipToBounds="True">
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="78"/><RowDefinition Height="*"/><RowDefinition Height="48"/></Grid.RowDefinitions>

    <!-- CABEÇALHO -->
    <Border Grid.Row="0" Background="#070C12" BorderBrush="#725700" BorderThickness="0,0,0,1" Padding="12,7">
     <Grid MouseLeftButtonDown="TabletDrag">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
       <Border Width="52" Height="52" CornerRadius="13" Background="#0A1118" BorderBrush="#A77C00" BorderThickness="1" Padding="5"><Image Source="{StaticResource BrandLogo}" Stretch="Uniform"/></Border>
       <StackPanel Margin="10,0,0,0" VerticalAlignment="Center"><TextBlock Text="TRANSPOLI" Foreground="White" FontSize="22" FontWeight="Bold" FontStyle="Italic"/><TextBlock Text="COMPUTADOR DE BORDO • ETS2" Foreground="{StaticResource Gold}" FontSize="8" FontWeight="Bold"/></StackPanel>
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
       <Border Width="170" Height="48" Style="{StaticResource Card}" Padding="8" Margin="0,0,5,0"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Ellipse x:Name="ConnectionDot" Width="17" Height="17" Fill="#758596" Margin="0,0,8,0"/><StackPanel><TextBlock x:Name="ConnectionText" Text="ETS2 DESCONECTADO" Foreground="White" FontSize="9" FontWeight="Bold"/><TextBlock x:Name="StatusText" Text="Telemetria aguardando" Foreground="#94A8BA" FontSize="7"/></StackPanel></StackPanel></Border>
       <Border Width="178" Height="48" Style="{StaticResource Card}" Padding="8" Margin="0,0,5,0"><StackPanel Orientation="Horizontal"><TextBlock Text="🔒" FontSize="19" Margin="0,0,7,0"/><StackPanel><TextBlock x:Name="VehicleLockText" Text="CAMINHÃO BLOQUEADO" Foreground="{StaticResource Gold}" FontSize="9" FontWeight="Bold"/><TextBlock Text="Liberar com segurança" Foreground="#94A8BA" FontSize="7"/></StackPanel></StackPanel></Border>
       <Button Content="↻  ATUALIZAR" Click="RefreshDashboard_Click" Style="{StaticResource HeaderButton}" Width="112" Margin="0,0,5,0"/>
       <Border Width="70" Height="48" Style="{StaticResource Card}" Padding="5" Margin="0,0,5,0"><StackPanel VerticalAlignment="Center"><TextBlock x:Name="ClockText" Text="--:--" Foreground="White" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock x:Name="DateText" Text="--/--/----" Foreground="#94A8BA" FontSize="7" HorizontalAlignment="Center"/></StackPanel></Border>
       <Button Content="⚙" Click="AboutButton_Click" Style="{StaticResource WindowButton}"/>
       <StackPanel Visibility="Collapsed"><Button Content="—" Click="TabletMinimize_Click"/><Button Content="□" Click="TabletMaximize_Click"/><Button Content="×" Click="TabletClose_Click"/></StackPanel>
      </StackPanel>
     </Grid>
    </Border>

    <!-- PAINEL -->
    <Grid Grid.Row="1" Margin="7,7,7,5">
     <Grid.ColumnDefinitions><ColumnDefinition Width="86"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

     <!-- MENU LATERAL -->
     <Border Grid.Column="0" Background="#050A10" BorderBrush="#1A2735" BorderThickness="0,0,1,0" Padding="3,5">
      <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="45"/></Grid.RowDefinitions>
       <StackPanel>
        <Button Style="{StaticResource NavButton}" Background="#4A3700" Foreground="{StaticResource Gold}" Click="HomeButton_Click"><StackPanel><TextBlock Text="⌂" FontSize="24" HorizontalAlignment="Center"/><TextBlock Text="Início" HorizontalAlignment="Center"/></StackPanel></Button>
        <Button Style="{StaticResource NavButton}" Click="SummaryButton_Click"><StackPanel><TextBlock Text="◉" FontSize="22" HorizontalAlignment="Center"/><TextBlock Text="Viagem" HorizontalAlignment="Center"/></StackPanel></Button>
        <Button Style="{StaticResource NavButton}" Click="TachographButton_Click"><StackPanel><TextBlock Text="◴" FontSize="22" HorizontalAlignment="Center"/><TextBlock Text="Tacógrafo" HorizontalAlignment="Center"/></StackPanel></Button>
        <Button Style="{StaticResource NavButton}" Click="CargoMarketButtonV15_Click"><StackPanel><TextBlock Text="▣" FontSize="22" HorizontalAlignment="Center"/><TextBlock Text="Mercado de" HorizontalAlignment="Center"/><TextBlock Text="Cargas" HorizontalAlignment="Center"/></StackPanel></Button>
        <Button Style="{StaticResource NavButton}" Click="GarageButtonV15_Click"><StackPanel><TextBlock Text="⌂" FontSize="22" HorizontalAlignment="Center"/><TextBlock Text="Garagem" HorizontalAlignment="Center"/></StackPanel></Button>
        <Button Style="{StaticResource NavButton}" Click="FuelButton_Click"><StackPanel><TextBlock Text="⛽" FontSize="21" HorizontalAlignment="Center"/><TextBlock Text="Combustível" HorizontalAlignment="Center"/></StackPanel></Button>
        <Button Style="{StaticResource NavButton}" Click="GarageButtonV15_Click"><StackPanel><TextBlock Text="⚒" FontSize="22" HorizontalAlignment="Center"/><TextBlock Text="Mecânico" HorizontalAlignment="Center"/></StackPanel></Button>
        <Button Style="{StaticResource NavButton}" Click="SummaryButton_Click"><StackPanel><TextBlock Text="⚙" FontSize="21" HorizontalAlignment="Center"/><TextBlock Text="Config." HorizontalAlignment="Center"/></StackPanel></Button>
       </StackPanel>
       <StackPanel Grid.Row="1" VerticalAlignment="Bottom"><TextBlock Text="v1.0.16" Foreground="#AFC0D2" FontSize="7" HorizontalAlignment="Center"/><TextBlock Text="TRANSPOLI" Foreground="{StaticResource Gold}" FontSize="7" FontWeight="Bold" HorizontalAlignment="Center"/></StackPanel>
      </Grid>
     </Border>

     <!-- CONTEÚDO PRINCIPAL -->
     <Grid Grid.Column="1" Margin="8,0,0,0">
      <Grid.RowDefinitions><RowDefinition Height="260"/><RowDefinition Height="150"/><RowDefinition Height="*"/><RowDefinition Height="63"/></Grid.RowDefinitions>
      <Grid.ColumnDefinitions><ColumnDefinition Width="1.03*"/><ColumnDefinition Width="1.15*"/></Grid.ColumnDefinitions>

      <!-- VEÍCULO -->
      <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,4,4" ClipToBounds="True">
       <Grid><Image Source="{StaticResource BrandBackground}" Stretch="UniformToFill" Opacity=".5"/><Border Background="#A9060A0F"/>
        <Grid Margin="10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
         <Border HorizontalAlignment="Left" Background="{StaticResource Gold}" CornerRadius="7" Padding="11,3"><TextBlock Text="VEÍCULO" Foreground="#080B0F" FontSize="8" FontWeight="Bold"/></Border>
         <StackPanel Grid.Row="1" Margin="0,5,0,0"><TextBlock x:Name="TruckName" Text="Aguardando ETS2" Foreground="White" FontSize="21" FontWeight="Bold"/><TextBlock Text="Conecte o ETS2 para receber a telemetria." Foreground="#D7E3EE" FontSize="9"/></StackPanel>
         <Grid Grid.Row="2"><Border Width="136" Height="136" CornerRadius="68" Background="#080D13" BorderBrush="#B18400" BorderThickness="7" HorizontalAlignment="Center" VerticalAlignment="Center"><StackPanel VerticalAlignment="Center"><TextBlock x:Name="SpeedText" Text="0" Foreground="White" FontSize="45" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock Text="KM/H" Foreground="White" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center"/></StackPanel></Border><Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="#B5070B0F" BorderBrush="#9B7200" BorderThickness="1" CornerRadius="8" Padding="9,5"><StackPanel><TextBlock Text="⚙  MOTOR" Foreground="{StaticResource Gold}" FontSize="7" FontWeight="Bold"/><TextBlock x:Name="EngineStateText" Text="DESLIGADO" Foreground="White" FontSize="9" FontWeight="Bold" HorizontalAlignment="Right"/></StackPanel></Border></Grid>
         <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,2,0"><StackPanel><TextBlock Text="◒  RPM" Style="{StaticResource Label}"/><TextBlock x:Name="RpmText" Text="0" Style="{StaticResource Value}"/></StackPanel></Border><Border Grid.Column="1" Style="{StaticResource Card}" Margin="2,0"><StackPanel><TextBlock Text="⚙  MARCHA" Style="{StaticResource Label}"/><TextBlock x:Name="GearText" Text="N" Style="{StaticResource Value}"/></StackPanel></Border><Border Grid.Column="2" Style="{StaticResource Card}" Margin="2,0,0,0"><StackPanel><TextBlock Text="♧  CRUISE" Style="{StaticResource Label}"/><TextBlock x:Name="CruiseText" Text="OFF" Style="{StaticResource Value}"/></StackPanel></Border></Grid>
        </Grid>
       </Grid>
      </Border>

      <!-- TACÓGRAFO -->
      <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource Card}" Margin="4,0,0,4">
       <Grid><Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="113"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="130"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal"><TextBlock Text="▣" Foreground="{StaticResource Gold}" FontSize="27"/><StackPanel Margin="9,0,0,0"><TextBlock Text="TACÓGRAFO" Foreground="White" FontSize="20" FontWeight="Bold"/><TextBlock Text="Jornada e registros" Foreground="#9DB0C1" FontSize="8"/></StackPanel></StackPanel>
        <Button Grid.Column="1" Content="▤  IMPRIMIR TICKET" Click="TachographButton_Click" Style="{StaticResource GoldButton}" Margin="4,0"/>
        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="7"><StackPanel Orientation="Horizontal"><TextBlock Text="▤" FontSize="17"/><TextBlock Text="Papel Térmico" Foreground="#C8D5E2" FontSize="7" VerticalAlignment="Center" Margin="6,0,0,0"/></StackPanel></Border>
        <Border Grid.Row="1" Grid.ColumnSpan="3" Background="#03070B" BorderBrush="#293543" BorderThickness="3" CornerRadius="11" Padding="10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="75"/><ColumnDefinition/><ColumnDefinition Width="75"/></Grid.ColumnDefinitions><Border Background="#080D13" BorderBrush="#1F2A35" BorderThickness="1" CornerRadius="6"><TextBlock Text="◷" Foreground="#73869A" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><TextBlock x:Name="ClockText2" Text="--:--" Foreground="White" FontSize="16" Margin="0,0,15,0"/><TextBlock x:Name="DateText2" Text="--/--/----" Foreground="White" FontSize="16"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><TextBlock Text="0 km/h" Foreground="White" FontSize="8" Margin="0,3,22,0"/><TextBlock Text="0 km" Foreground="White" FontSize="8" Margin="0,3,0,0"/></StackPanel></StackPanel><Border Grid.Column="2" Background="#080D13" BorderBrush="#1F2A35" BorderThickness="1" CornerRadius="6"><TextBlock Text="▱" Foreground="#73869A" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></Grid></Border>
        <Grid Grid.Row="2" Grid.ColumnSpan="3" Margin="0,5,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,2,0"><StackPanel><TextBlock Text="◔  Tempo de condução" Style="{StaticResource Label}"/><TextBlock x:Name="TripLiveText" Text="00:00:00" Style="{StaticResource Value}"/></StackPanel></Border><Border Grid.Column="1" Style="{StaticResource Card}" Margin="2,0"><StackPanel><TextBlock Text="▰  Tempo de descanso" Style="{StaticResource Label}"/><TextBlock Text="—:—:—" Style="{StaticResource Value}"/></StackPanel></Border><Border Grid.Column="2" Style="{StaticResource Card}" Margin="2,0,0,0"><StackPanel><TextBlock Text="⌁  Distância" Style="{StaticResource Label}"/><TextBlock x:Name="TripDistanceText" Text="0 km" Style="{StaticResource Value}"/></StackPanel></Border></Grid>
       </Grid>
      </Border>

      <!-- MÉTRICAS -->
      <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,4,0,4"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
       <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,3,0"><StackPanel><TextBlock Text="◉  ODÔMETRO" Style="{StaticResource Label}"/><TextBlock x:Name="OdometerText" Text="0 km" Style="{StaticResource Value}"/><TextBlock Text="⛽  COMBUSTÍVEL" Style="{StaticResource Label}" Margin="0,6,0,0"/><TextBlock x:Name="FuelText" Text="0 L" Style="{StaticResource Value}"/></StackPanel></Border>
       <Border Grid.Column="1" Style="{StaticResource Card}" Margin="3,0"><StackPanel><TextBlock Text="⛽  AUTONOMIA" Style="{StaticResource Label}"/><TextBlock x:Name="RangeText" Text="0 km" Style="{StaticResource Value}"/><TextBlock Text="▣  CARGA" Style="{StaticResource Label}" Margin="0,6,0,0"/><TextBlock x:Name="CargoText" Text="Nenhuma carga" Foreground="White" FontSize="11" FontWeight="Bold" TextWrapping="Wrap"/><TextBlock x:Name="CargoMassText" Text="0 kg" Foreground="#9DB0C1" FontSize="7"/></StackPanel></Border>
       <Border Grid.Column="2" Style="{StaticResource Card}" Margin="3,0"><StackPanel><TextBlock Text="⌖  VIAGEM ATUAL" Style="{StaticResource Label}"/><TextBlock x:Name="TripStatusText" Text="Aguardando trabalho" Foreground="White" FontSize="11" FontWeight="Bold" Margin="0,3,0,0"/><TextBlock x:Name="TripCargoText" Text="Nenhuma carga ativa" Foreground="#9DB0C1" FontSize="8" TextWrapping="Wrap"/><TextBlock Text="PROGRESSO" Style="{StaticResource Label}" Margin="0,4,0,0"/><Grid Height="14"><Border Height="5" Background="#263441" CornerRadius="3" VerticalAlignment="Center"/><Border x:Name="TripProgressFill" Width="0" Height="5" Background="{StaticResource Gold}" CornerRadius="3" HorizontalAlignment="Left" VerticalAlignment="Center"/><TextBlock x:Name="TripProgressText" Text="0%" Foreground="White" FontSize="7" HorizontalAlignment="Right"/></Grid><TextBlock x:Name="TripStartText" Text="—" Foreground="#DCE7F2" FontSize="7"/></StackPanel></Border>
       <Border Grid.Column="3" Style="{StaticResource Card}" Margin="3,0"><StackPanel><TextBlock Text="◷  TEMPO DECORRIDO" Style="{StaticResource Label}"/><TextBlock x:Name="TripDurationText" Text="00:00:00" Style="{StaticResource Value}"/><TextBlock Text="◉  DISTÂNCIA" Style="{StaticResource Label}" Margin="0,6,0,0"/><TextBlock x:Name="TripRemainingText" Text="0 km" Style="{StaticResource Value}"/></StackPanel></Border>
       <Border Grid.Column="4" Style="{StaticResource Card}" Margin="3,0,0,0"><StackPanel><TextBlock Text="▣  CHEGADA ESTIMADA" Style="{StaticResource Label}"/><TextBlock x:Name="TripArrivalText" Text="Calculando..." Foreground="White" FontSize="12" FontWeight="Bold" Margin="0,3,0,0"/><TextBlock Text="⌛  TEMPO RESTANTE" Style="{StaticResource Label}" Margin="0,6,0,0"/><TextBlock x:Name="TripEtaText" Text="Calculando..." Foreground="White" FontSize="12" FontWeight="Bold"/></StackPanel></Border>
      </Grid>

      <!-- CARDS FUNCIONAIS -->
      <Grid Grid.Row="2" Grid.ColumnSpan="2" Margin="0,4,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="1.55*"/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
       <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,3,0"><StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="▣" Foreground="{StaticResource Gold}" FontSize="24"/><StackPanel Margin="8,0,0,0"><TextBlock Text="MERCADO DE CARGAS" Foreground="White" FontSize="15" FontWeight="Bold"/><TextBlock Text="Encontre as melhores cargas para o seu destino." Foreground="#9DB0C1" FontSize="8"/></StackPanel></StackPanel><Grid Margin="0,7,0,0"><TextBlock x:Name="_v15MarketMain" Text="📦 Carregando mercado..." Foreground="White" FontSize="10" FontWeight="Bold" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="_v15MarketMeta" Text="Tarifas por quilômetro" Foreground="{StaticResource Gold}" FontSize="7" HorizontalAlignment="Right"/></Grid><Button Content="ACESSAR MERCADO   ›" Click="CargoMarketButtonV15_Click" Style="{StaticResource GoldButton}" Margin="0,5,0,0"/></StackPanel></Border>
       <Border Grid.Column="1" Style="{StaticResource Card}" Margin="3,0"><StackPanel><TextBlock Text="▣" Foreground="{StaticResource Gold}" FontSize="23"/><TextBlock Text="GARAGEM" Foreground="White" FontSize="13" FontWeight="Bold"/><TextBlock Text="Gerencie seus caminhões e motoristas." Foreground="#9DB0C1" FontSize="8" TextWrapping="Wrap"/><Button Content="IR PARA GARAGEM" Click="GarageButtonV15_Click" Style="{StaticResource GoldButton}" Margin="0,5,0,0"/></StackPanel></Border>
       <Border Grid.Column="2" Style="{StaticResource Card}" Margin="3,0"><StackPanel><TextBlock Text="⚒" Foreground="{StaticResource Gold}" FontSize="23"/><TextBlock Text="MECÂNICO" Foreground="White" FontSize="13" FontWeight="Bold"/><TextBlock Text="Verifique o estado do seu veículo." Foreground="#9DB0C1" FontSize="8" TextWrapping="Wrap"/><Button Content="ACESSAR MECÂNICO" Click="GarageButtonV15_Click" Style="{StaticResource GoldButton}" Margin="0,5,0,0"/></StackPanel></Border>
       <Border Grid.Column="3" Style="{StaticResource Card}" Margin="3,0,0,0"><StackPanel><TextBlock Text="▤" Foreground="{StaticResource Gold}" FontSize="23"/><TextBlock Text="NOTA FISCAL" Foreground="White" FontSize="13" FontWeight="Bold"/><TextBlock Text="Emissão de notas fiscais e documentos." Foreground="#9DB0C1" FontSize="8" TextWrapping="Wrap"/><Button Content="ACESSAR NOTA FISCAL" Click="SummaryButton_Click" Style="{StaticResource GoldButton}" Margin="0,5,0,0"/></StackPanel></Border>
      </Grid>

      <!-- NAVEGAÇÃO INFERIOR -->
      <Grid Grid.Row="3" Grid.ColumnSpan="2" Margin="0,3,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="1.55*"/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="0.85*"/></Grid.ColumnDefinitions>
       <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,3,0" Padding="8"><StackPanel Orientation="Horizontal"><TextBlock Text="⚕" Foreground="{StaticResource Gold}" FontSize="23"/><StackPanel Margin="8,0,0,0"><TextBlock Text="TACÓGRAFO" Foreground="{StaticResource Gold}" FontSize="9" FontWeight="Bold"/><TextBlock Text="Verifique registros e tempos de condução." Foreground="#9DB0C1" FontSize="7"/></StackPanel></StackPanel></Border>
       <Button Grid.Column="1" Content="⌂&#x0a;INÍCIO" Click="HomeButton_Click" Style="{StaticResource NavButton}" Background="#4A3700" Foreground="{StaticResource Gold}" Margin="2,0"/>
       <Button Grid.Column="2" Content="⌖&#x0a;VIAGEM" Click="SummaryButton_Click" Style="{StaticResource NavButton}" Margin="2,0"/>
       <Button Grid.Column="3" Content="▣&#x0a;MERCADO" Click="CargoMarketButtonV15_Click" Style="{StaticResource NavButton}" Margin="2,0"/>
       <Button Grid.Column="4" Content="⌂&#x0a;GARAGEM" Click="GarageButtonV15_Click" Style="{StaticResource NavButton}" Margin="2,0"/>
       <Button Grid.Column="5" Content="⚒&#x0a;MECÂNICO" Click="GarageButtonV15_Click" Style="{StaticResource NavButton}" Margin="2,0"/><Border Grid.Column="6" Style="{StaticResource Card}" Margin="3,0,0,0" Padding="6"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Border Width="34" Height="34" CornerRadius="9" Background="#0C141C" BorderBrush="#9B7200" BorderThickness="1" Padding="4"><Image Source="{StaticResource BrandLogo}" Stretch="Uniform"/></Border><StackPanel Margin="6,0,0,0" VerticalAlignment="Center"><TextBlock Text="TRANSPOLI" Foreground="White" FontSize="8" FontWeight="Bold"/><TextBlock Text="COMPUTADOR DE BORDO" Foreground="{StaticResource Gold}" FontSize="5" FontWeight="Bold"/></StackPanel></StackPanel></Border>
      </Grid>
     </Grid>

     <!-- COMPATIBILIDADE DAS CAMADAS EXISTENTES -->
     <!-- Build validation: layout premium + legacy bindings preserved. -->
     <StackPanel Grid.ColumnSpan="2" Visibility="Collapsed" IsHitTestVisible="False">
      <TextBlock x:Name="TelemetryInfoText" Text=""/>
      <TextBlock x:Name="TripRouteText" Text=""/>
      <TextBlock x:Name="TripTruckText" Text=""/>
      <TextBlock x:Name="TripEstimateNoteText" Text=""/>
      <TextBlock x:Name="RouteText" Text=""/>
      <TextBlock x:Name="AlertText" Text=""/>
      <TextBlock x:Name="FuelAutoText" Text="Mercado"/>
      <TextBlock x:Name="OpsCounterText" Text=""/>
      <Button x:Name="UnlockButton" Content="DESBLOQUEAR" Click="UnlockButton_Click"/>
     </StackPanel>
    </Grid>
    </Grid>
  </Border>
  <ProgressBar x:Name="FuelProgressBar" Visibility="Collapsed" Minimum="0" Maximum="100" Value="0"/>
 </Grid>
</Window>