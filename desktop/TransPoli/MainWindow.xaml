<Window x:Class="TransPoli.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TruckHub • TransPoli"
        Width="1180" Height="820" MinWidth="900" MinHeight="650"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResize" SnapsToDevicePixels="True"
        WindowStartupLocation="CenterScreen" KeyDown="Window_KeyDown"
        Icon="/TransPoli;component/Assets/transpoli-logo.png">
  <Window.Resources>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="#0D1623"/>
      <Setter Property="BorderBrush" Value="#17385F"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="16"/>
      <Setter Property="Padding" Value="16"/>
    </Style>
    <Style x:Key="Label" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="NavButton" TargetType="Button">
      <Setter Property="Height" Value="46"/>
      <Setter Property="Margin" Value="0,3"/>
      <Setter Property="Padding" Value="12,8"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="NavChrome" Background="{TemplateBinding Background}" CornerRadius="11" Padding="{TemplateBinding Padding}">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="NavChrome" Property="Background" Value="#102D59"/>
                <Setter Property="Foreground" Value="#FFFFFF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button">
      <Setter Property="Height" Value="42"/>
      <Setter Property="Padding" Value="18,8"/>
      <Setter Property="Background" Value="#0969FF"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderBrush" Value="#1681FF"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="PrimaryChrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="21" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="PrimaryChrome" Property="Background" Value="#147BFF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="WindowButton" TargetType="Button">
      <Setter Property="Width" Value="34"/>
      <Setter Property="Height" Value="34"/>
      <Setter Property="Margin" Value="4,0,0,0"/>
      <Setter Property="Background" Value="#111C2A"/>
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="10">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="B" Property="Background" Value="#20334B"/>
                <Setter Property="Foreground" Value="{StaticResource Text}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid Margin="0">
    <Border Margin="64,54,64,54" Background="#050B13" CornerRadius="22" BorderBrush="#263D5A" BorderThickness="1" ClipToBounds="True">
      <Grid>
        <Border Background="#050B13" CornerRadius="22"/>
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="76"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="52"/>
          </Grid.RowDefinitions>

          <!-- TOPO -->
          <Border Grid.Row="0" Background="#071426" BorderBrush="#163A63" BorderThickness="0,0,0,1" Padding="20,0">
            <Grid MouseLeftButtonDown="TabletDrag">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="48" Height="48" CornerRadius="14" Background="#0B1F36" Padding="6">
                  <Image Source="{StaticResource BrandLogo}" Stretch="Uniform"/>
                </Border>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                  <TextBlock Text="TRUCKHUB" Foreground="{StaticResource Text}" FontSize="22" FontWeight="Bold"/>
                  <TextBlock Text="SEU CAMINHÃO, SEMPRE CONECTADO" Foreground="#6F8EAE" FontSize="8" FontWeight="SemiBold" Margin="0,1,0,0"/>
                </StackPanel>
              </StackPanel>

              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                  <TextBlock Text="TRANSPOLI" Foreground="{StaticResource Text}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right"/>
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Ellipse x:Name="ConnectionDot" Width="7" Height="7" Fill="{StaticResource Muted}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="ConnectionText" Text="ETS2 OFFLINE" Foreground="{StaticResource Muted}" FontSize="9" FontWeight="Bold"/>
                  </StackPanel>
                </StackPanel>
                <Border Width="1" Height="36" Background="#21405F" Margin="0,0,16,0"/>
                <TextBlock x:Name="VehicleLockText" Text="🔒 BLOQUEADO" Foreground="{StaticResource Yellow}" FontSize="9" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <Button Content="—" Click="TabletMinimize_Click" Style="{StaticResource WindowButton}" ToolTip="Minimizar"/>
                <Button Content="□" Click="TabletMaximize_Click" Style="{StaticResource WindowButton}" ToolTip="Maximizar"/>
                <Button Content="×" Click="TabletClose_Click" Style="{StaticResource WindowButton}" ToolTip="Fechar"/>
              </StackPanel>
            </Grid>
          </Border>

          <!-- CONTEÚDO -->
          <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="206"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <!-- MENU LATERAL -->
            <Border Grid.Column="0" Background="#06101D" BorderBrush="#102D4D" BorderThickness="0,0,1,0" Padding="10,14">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="*"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel>
                  <Button Content="⌂   INÍCIO" Click="HomeButton_Click" Style="{StaticResource NavButton}" Background="#0969FF" Foreground="White"/>
                  <Button Content="▣   MERCADO DE CARGAS" Tag="feature-cargo-market" Click="CargoMarketButtonV15_Click" Style="{StaticResource NavButton}"/>
                  <Button Content="◉   TACÓGRAFO" Tag="feature-tachograph" Click="TachographButton_Click" Style="{StaticResource NavButton}"/>
                  <Button Content="⌖   VIAGEM" Click="SummaryButton_Click" Style="{StaticResource NavButton}"/>
                  <Button Content="⌘   ROTAS" Click="SummaryButton_Click" Style="{StaticResource NavButton}"/>
                  <Button Content="▥   COMBUSTÍVEL" Click="FuelButton_Click" Style="{StaticResource NavButton}"/>
                  <Button Content="🔧   MANUTENÇÃO" Click="GarageButtonV15_Click" Style="{StaticResource NavButton}"/>
                  <Button Content="▥   ESTATÍSTICAS" Click="SummaryButton_Click" Style="{StaticResource NavButton}"/>
                  <Button Content="♙   PERFIL" Click="AboutButton_Click" Style="{StaticResource NavButton}"/>
                </StackPanel>
                <Button Grid.Row="1" Content="⇥   SAIR" Click="TabletClose_Click" Style="{StaticResource NavButton}" BorderBrush="#17385F"/>
              </Grid>
            </Border>

            <!-- CENTRO -->
            <Grid Grid.Column="1" Margin="12,12,8,12">
              <Grid.RowDefinitions>
                <RowDefinition Height="210"/>
                <RowDefinition Height="116"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>

              <!-- HERO -->
              <Border Grid.Row="0" CornerRadius="16" BorderBrush="#174C88" BorderThickness="1" ClipToBounds="True">
                <Grid>
                  <Image Source="{StaticResource BrandBackground}" Stretch="UniformToFill" Opacity="0.78"/>
                  <Border Background="#A607101B"/>
                  <StackPanel VerticalAlignment="Center" Margin="24,0">
                    <TextBlock Text="TRUCKHUB" Foreground="White" FontSize="32" FontWeight="Bold" FontStyle="Italic"/>
                    <TextBlock Text="MAIS CONTROLE, MAIS ESTRADA" Foreground="White" FontSize="18" FontWeight="Bold" FontStyle="Italic" Margin="0,2,0,0"/>
                    <TextBlock Text="Seu painel completo para monitorar viagens, desempenho e muito mais." Foreground="#D4E5F6" FontSize="11" Width="310" TextWrapping="Wrap" Margin="0,10,0,0"/>
                    <TextBlock x:Name="StatusText" Text="TransPoli pronto. Inicie o Connector junto com o ETS2." Foreground="#76B9FF" FontSize="9" Margin="0,7,0,0" TextWrapping="Wrap" Width="310"/>
                  </StackPanel>
                </Grid>
              </Border>

              <!-- INDICADORES -->
              <Grid Grid.Row="1" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="12" Margin="0,0,4,0">
                  <StackPanel>
                    <TextBlock Text="VELOCIDADE ATUAL" Style="{StaticResource Label}"/>
                    <TextBlock x:Name="SpeedText" Text="0" Foreground="{StaticResource Text}" FontSize="27" FontWeight="Bold" Margin="0,4,0,0"/>
                    <TextBlock Text="KM/H" Foreground="#4FA2FF" FontSize="8" FontWeight="Bold"/>
                    <TextBlock x:Name="EngineStateText" Text="MOTOR DESLIGADO" Foreground="{StaticResource Yellow}" FontSize="9" FontWeight="Bold" Margin="0,3,0,0"/>
                  </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Card}" Padding="12" Margin="4,0">
                  <StackPanel>
                    <TextBlock Text="DISTÂNCIA PERCORRIDA" Style="{StaticResource Label}"/>
                    <TextBlock x:Name="TripDistanceText" Text="0 km" Foreground="{StaticResource Text}" FontSize="23" FontWeight="Bold" Margin="0,6,0,0"/>
                    <TextBlock Text="TOTAL DA VIAGEM" Foreground="#4FA2FF" FontSize="8" FontWeight="Bold"/>
                  </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="12" Margin="4,0">
                  <StackPanel>
                    <TextBlock Text="TEMPO DE VIAGEM" Style="{StaticResource Label}"/>
                    <TextBlock x:Name="TripDurationText" Text="00:00" Foreground="{StaticResource Text}" FontSize="23" FontWeight="Bold" Margin="0,6,0,0"/>
                    <TextBlock Text="DESDE O INÍCIO" Foreground="#4FA2FF" FontSize="8" FontWeight="Bold"/>
                  </StackPanel>
                </Border>
                <Border Grid.Column="3" Style="{StaticResource Card}" Padding="12" Margin="4,0,0,0">
                  <StackPanel>
                    <TextBlock Text="PRÓXIMO DESTINO" Style="{StaticResource Label}"/>
                    <TextBlock x:Name="TripRouteText" Text="Aguardando..." Foreground="{StaticResource Text}" FontSize="13" FontWeight="Bold" Margin="0,6,0,0" TextWrapping="Wrap"/>
                    <TextBlock x:Name="TripRemainingText" Text="— km restantes" Foreground="#4FA2FF" FontSize="8" FontWeight="Bold" Margin="0,3,0,0"/>
                  </StackPanel>
                </Border>
              </Grid>

              <!-- PAINEL INFERIOR -->
              <Grid Grid.Row="2" Margin="0,10,0,0">
                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.45*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource Card}" Padding="16" Margin="0,0,5,0">
                  <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Text="VIAGEM ATUAL" Style="{StaticResource Label}"/>
                    <TextBlock Grid.Row="1" x:Name="TripStatusText" Text="Aguardando trabalho do ETS2" Foreground="{StaticResource Text}" FontSize="18" FontWeight="Bold" Margin="0,4,0,0"/>
                    <TextBlock Grid.Row="2" x:Name="TripCargoText" Text="Nenhuma carga ativa" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    <StackPanel Grid.Row="3" VerticalAlignment="Bottom">
                      <Grid Margin="0,10,0,0"><TextBlock Text="PROGRESSO" Style="{StaticResource Label}"/><TextBlock x:Name="TripProgressText" Text="0%" Foreground="{StaticResource Text}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right"/></Grid>
                      <Grid Height="24" Margin="0,6,0,0">
                        <Border Height="7" VerticalAlignment="Center" Background="#182B41" CornerRadius="4"/>
                        <Border x:Name="TripProgressFill" Height="7" Width="0" HorizontalAlignment="Left" VerticalAlignment="Center" Background="#0876FF" CornerRadius="4"/>
                        <TextBlock x:Name="TripTruckText" Text="🚚" FontSize="18" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="-8,0,0,0"/>
                      </Grid>
                      <Grid Margin="0,3,0,0"><TextBlock Text="SAÍDA" Style="{StaticResource Label}"/><TextBlock x:Name="TripStartText" Text="—" Foreground="{StaticResource Muted}" FontSize="9" HorizontalAlignment="Right"/></Grid>
                    </StackPanel>
                  </Grid>
                </Border>

                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource Card}" Padding="16" Margin="5,0,0,0">
                  <StackPanel>
                    <TextBlock Text="TACÓGRAFO" Style="{StaticResource Label}"/>
                    <TextBlock Text="Sua jornada registrada" Foreground="{StaticResource Text}" FontSize="16" FontWeight="Bold" Margin="0,5,0,0"/>
                    <TextBlock x:Name="TelemetryInfoText" Text="Acompanhe direção, descanso, refeição e espera." Foreground="{StaticResource Muted}" FontSize="9" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    <Button Content="VER TACÓGRAFO  ›" Click="TachographButton_Click" Style="{StaticResource PrimaryButton}" Width="165" HorizontalAlignment="Left" Margin="0,14,0,0"/>
                    <TextBlock x:Name="TripArrivalText" Text="Calculando..." Foreground="{StaticResource Green}" FontSize="9" Margin="0,8,0,0"/>
                    <TextBlock x:Name="TripEtaText" Text="Calculando..." Foreground="{StaticResource Muted}" FontSize="9" Margin="0,2,0,0"/>
                  </StackPanel>
                </Border>


                <StackPanel Visibility="Collapsed" IsHitTestVisible="False">
                  <TextBlock x:Name="RangeText" Text="0 km"/>
                  <TextBlock x:Name="CargoText" Text="Nenhuma carga"/>
                  <TextBlock x:Name="CargoMassText" Text="0 kg"/>
                  <TextBlock x:Name="OdometerText" Text="0 km"/>
                  <TextBlock x:Name="RpmText" Text="0"/>
                  <TextBlock x:Name="GearText" Text="N"/>
                  <TextBlock x:Name="CruiseText" Text="OFF"/>
                  <TextBlock x:Name="TripLiveText" Text="OFFLINE"/>
                  <Button x:Name="UnlockButton" Content="DESBLOQUEAR" Click="UnlockButton_Click"/>
                </StackPanel>
                <!-- Elementos de compatibilidade usados pela camada V15. -->
                <Border Grid.Row="1" Grid.ColumnSpan="2" Height="0" Opacity="0" IsHitTestVisible="False">
                  <StackPanel>
                    <TextBlock x:Name="AlertText" Text="📦 Carregando tarifas do mercado..."/>
                    <TextBlock x:Name="FuelAutoText" Text="Mercado"/>
                    <TextBlock x:Name="OpsCounterText" Text=""/>
                  </StackPanel>
                </Border>
              </Grid>
            </Grid>

            <!-- DIREITA -->
            <Grid Grid.Column="2" Margin="4,12,12,12">
              <Grid.RowDefinitions><RowDefinition Height="220"/><RowDefinition Height="*"/></Grid.RowDefinitions>

              <Border Grid.Row="0" Style="{StaticResource Card}" Padding="18">
                <Grid>
                  <StackPanel>
                    <Grid><TextBlock Text="SEU CAMINHÃO" Foreground="{StaticResource Text}" FontSize="18" FontWeight="Bold"/><TextBlock Text="● Online" Foreground="#00E875" FontSize="10" HorizontalAlignment="Right"/></Grid>
                    <TextBlock x:Name="TruckName" Text="Aguardando ETS2" Foreground="{StaticResource Text}" FontSize="18" FontWeight="Bold" Margin="0,18,0,0" TextWrapping="Wrap"/>
                    <TextBlock Text="Placa: —" Foreground="#8EB7DE" FontSize="10" Margin="0,4,0,0"/>
                    <TextBlock Text="Reboque: —" Foreground="#8EB7DE" FontSize="10" Margin="0,2,0,0"/>
                    <TextBlock Text="COMBUSTÍVEL" Style="{StaticResource Label}" Margin="0,18,0,0"/>
                    <ProgressBar x:Name="FuelProgressBar" Height="8" Minimum="0" Maximum="100" Value="0" Margin="0,6,0,0"/>
                    <TextBlock x:Name="FuelText" Text="0 L" Foreground="{StaticResource Text}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right" Margin="0,4,0,0"/>
                  </StackPanel>
                </Grid>
              </Border>

              <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16" Margin="0,10,0,0">
                <Grid>
                  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                  <StackPanel>
                    <TextBlock Text="MERCADO DE CARGAS" Foreground="{StaticResource Text}" FontSize="18" FontWeight="Bold"/>
                    <TextBlock Text="Encontre as melhores cargas" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,3,0,0"/>
                  </StackPanel>
                  <Grid Grid.Row="1" Margin="0,12,0,8" ClipToBounds="True">
                    <Image Source="{StaticResource BrandBackground}" Stretch="UniformToFill" Opacity="0.62"/>
                    <Border Background="#78030A12" CornerRadius="12"/>
                    <StackPanel VerticalAlignment="Center" Margin="14">
                      <TextBlock x:Name="_v15MarketMain" Text="📦 Carregando mercado..." Foreground="White" FontSize="14" FontWeight="Bold" TextWrapping="Wrap"/>
                      <TextBlock x:Name="_v15MarketMeta" Text="Tarifas por quilômetro" Foreground="#A8D1FF" FontSize="10" Margin="0,6,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                  </Grid>
                  <Button Grid.Row="2" Content="VER CARGAS  ›" Click="CargoMarketButtonV15_Click" Style="{StaticResource PrimaryButton}"/>
                </Grid>
              </Border>
            </Grid>
          </Grid>

          <!-- RODAPÉ -->
          <Border Grid.Row="2" Background="#071426" BorderBrush="#163A63" BorderThickness="0,1,0,0" Padding="14,0">
            <Grid>
              <TextBlock Text="🚚  TruckHub" Foreground="{StaticResource Text}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
              <TextBlock Text="JUNTOS NA ESTRADA   |   SEMPRE CONECTADOS" Foreground="#218BFF" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              <TextBlock Text="v1.0.16" Foreground="#4FA2FF" FontSize="9" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
          </Border>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Window>