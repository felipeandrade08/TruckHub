            <StackPanel Grid.Column="1" Margin="10,0,0,0"><TextBlock Text="ÚLTIMO EVENTO" Foreground="{StaticResource TextMuted}" FontSize="8" FontWeight="Bold"/><TextBlock x:Name="DashboardLastEventText" Text="Nenhum evento nesta operação" Foreground="{StaticResource GoldBright}" FontSize="10" FontWeight="Bold" TextTrimming="CharacterEllipsis"/></StackPanel>
           </Grid>
          </Border>
          <UniformGrid Columns="4" Margin="0,8,0,0"><Border Style="{StaticResource TileBox}"><StackPanel><TextBlock Text="VELOCIDADE" Style="{StaticResource Label}" FontSize="9"/><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Text, ElementName=SpeedText}" Style="{StaticResource TileValue}"/><TextBlock Text="km/h" Style="{StaticResource Label}" Margin="4,0,0,1" VerticalAlignment="Bottom"/></StackPanel></StackPanel></Border><Border Style="{StaticResource TileBox}"><StackPanel><TextBlock Text="COMBUSTÍVEL" Style="{StaticResource Label}" FontSize="9"/><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Text, ElementName=FuelText}" Style="{StaticResource TileValue}"/></StackPanel></StackPanel></Border><Border Style="{StaticResource TileBox}"><StackPanel><TextBlock Text="MARCHA" Style="{StaticResource Label}" FontSize="9"/><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Text, ElementName=GearText}" Style="{StaticResource TileValue}"/></StackPanel></StackPanel></Border><Border Style="{StaticResource TileBox}"><StackPanel><TextBlock Text="ODÔMETRO" Style="{StaticResource Label}" FontSize="9"/><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Text, ElementName=OdometerText}" Style="{StaticResource TileValue}"/></StackPanel></StackPanel></Border></UniformGrid>
         </StackPanel>
         <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
          <Button x:Name="DashboardPrimaryActionButton" Content="MERCADO DE CARGAS" Click="CargoMarketButtonV15_Click" Style="{StaticResource ActionButton}" Height="31" Margin="0,0,5,0"/>
          <Button Grid.Column="1" Content="DOCUMENTOS" Click="DocumentsButton_Click" Style="{StaticResource ActionButton}" Height="31" Margin="5,0,0,0"/>
         </Grid>
        </Grid>
       </Border>
       <Border Background="#D9080D12" BorderBrush="#3D493F" BorderThickness="1" CornerRadius="16" Padding="16" Margin="0,0,0,8">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
         <StackPanel><TextBlock Text="JORNADA / TACÓGRAFO" Foreground="{StaticResource TextMain}" FontSize="16" FontWeight="Bold"/><TextBlock Text="Situação operacional da viagem" Foreground="{StaticResource TextMuted}" FontSize="11"/></StackPanel>
         <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,10,0,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="92"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Border Background="#05090D" BorderBrush="#465361" BorderThickness="1" CornerRadius="46" Width="88" Height="88"><StackPanel VerticalAlignment="Center"><TextBlock x:Name="DashboardTachDurationText" Text="00:00" Foreground="{StaticResource TextMain}" FontSize="19" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock Text="JORNADA" Foreground="{StaticResource GoldBright}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center"/></StackPanel></Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0"><TextBlock x:Name="DashboardTachStateText" Text="AGUARDANDO" Foreground="{StaticResource Green}" FontSize="14" FontWeight="Bold"/><TextBlock x:Name="DashboardTachRouteText" Text="Nenhuma viagem ativa" Foreground="{StaticResource TextMain}" FontSize="11" FontWeight="Bold" TextWrapping="Wrap" Margin="0,4,0,0"/><TextBlock x:Name="DashboardTachCargoText" Text="Carga: —" Foreground="{StaticResource TextMuted}" FontSize="10" TextWrapping="Wrap"/><TextBlock x:Name="DashboardTachSpeedText" Text="—" Foreground="{StaticResource GoldBright}" FontSize="11" FontWeight="Bold" Margin="0,5,0,0"/></StackPanel>
         </Grid>
         <UniformGrid Columns="2" Margin="0,10,0,0"><Border Style="{StaticResource TileBox}"><StackPanel><TextBlock Text="TEMPO DE VIAGEM" Style="{StaticResource Label}" FontSize="9"/><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Text, ElementName=TripDurationText}" Style="{StaticResource TileValue}"/></StackPanel></StackPanel></Border><Border Style="{StaticResource TileBox}"><StackPanel><TextBlock Text="DIRIGINDO" Style="{StaticResource Label}" FontSize="9"/><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Text, ElementName=TripDrivingTimeText}" Style="{StaticResource TileValue}"/></StackPanel></StackPanel></Border></UniformGrid></StackPanel>
         <Button Grid.Row="2" Content="ABRIR TACÓGRAFO" Click="TachographButton_Click" Style="{StaticResource ActionButton}" Height="30"/>
        </Grid>
       </Border>
       <Border Background="#D9080D12" BorderBrush="#36414B" BorderThickness="1" CornerRadius="16" Padding="16" Margin="0">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
         <StackPanel><TextBlock Text="SERVIÇOS DO TERMINAL" Foreground="{StaticResource TextMain}" FontSize="16" FontWeight="Bold"/><TextBlock Text="Sincronização, documentos e serviços" Foreground="{StaticResource TextMuted}" FontSize="11"/></StackPanel>
         <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,10,0,8">
          <TextBlock x:Name="SystemNominalText" Text="TERMINAL OPERACIONAL" Foreground="{StaticResource Green}" FontSize="14" FontWeight="Bold" Margin="0,0,0,8"/>
          <Border Background="#0D141B" BorderBrush="#26313D" BorderThickness="1" CornerRadius="9" Padding="9,7" Margin="0,0,0,7">
           <StackPanel><TextBlock Text="DOCUMENTAÇÃO" Foreground="{StaticResource TextMuted}" FontSize="9" FontWeight="Bold"/><TextBlock Text="{Binding Text, ElementName=DashboardDocumentStateText}" Foreground="{StaticResource TextMain}" FontSize="11" FontWeight="Bold" TextWrapping="Wrap" Margin="0,2,0,0"/></StackPanel>
          </Border>
          <Border Background="#0D141B" BorderBrush="#26313D" BorderThickness="1" CornerRadius="9" Padding="9,7">
           <StackPanel><TextBlock Text="SINCRONIZAÇÃO" Foreground="{StaticResource TextMuted}" FontSize="9" FontWeight="Bold"/><TextBlock Text="{Binding Text, ElementName=DashboardSyncStateText}" Foreground="{StaticResource Green}" FontSize="11" FontWeight="Bold" TextWrapping="Wrap" Margin="0,2,0,0"/></StackPanel>
          </Border>
          <UniformGrid Columns="2" Margin="0,7,0,0"><Border Style="{StaticResource TileBox}"><StackPanel><TextBlock Text="RANKING" Style="{StaticResource Label}" FontSize="9"/><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Text, ElementName=DashboardRankingPositionText}" Style="{StaticResource TileValue}"/></StackPanel></StackPanel></Border><Border Style="{StaticResource TileBox}"><StackPanel><TextBlock Text="VIAGENS" Style="{StaticResource Label}" FontSize="9"/><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Text, ElementName=DashboardRankingTripsText}" Style="{StaticResource TileValue}"/></StackPanel></StackPanel></Border></UniformGrid>
          <StackPanel Visibility="Collapsed" IsHitTestVisible="False">
           <TextBlock x:Name="IndicatorEngineText" Text="MOTOR"/><TextBlock x:Name="IndicatorFuelText" Text="COMB"/><TextBlock x:Name="IndicatorBrakeText" Text="FREIO"/><TextBlock x:Name="IndicatorTempText" Text="TEMP"/>
           <TextBlock x:Name="IndicatorAirText" Text="AR"/><TextBlock x:Name="IndicatorOilText" Text="ÓLEO"/><TextBlock x:Name="IndicatorBatteryText" Text="BATERIA"/><TextBlock x:Name="IndicatorAdBlueText" Text="ADBLUE"/>
          </StackPanel>
         </StackPanel>
         <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
          <Button Content="BANCO" Click="BankButtonV15_Click" Style="{StaticResource ActionButton}" Height="30" Margin="0,0,5,0"/>
          <Button Grid.Column="1" Content="ATUALIZAR" Click="RefreshDashboard_Click" Style="{StaticResource ActionButton}" Height="30" Margin="5,0,0,0"/>
         </Grid>
         <StackPanel Visibility="Collapsed"><TextBlock x:Name="DashboardRankingPositionText" Text="#—"/><TextBlock x:Name="DashboardRankingTripsText" Text="—"/><TextBlock x:Name="DashboardRankingKmText" Text="—"/><Border x:Name="DashboardFuelVisualFill"/></StackPanel>
        </Grid>
       </Border>
      </StackPanel>

      <!-- Bindings de instrumentação preservados para o pipeline existente; condução é apresentada pela HUD. -->
      <StackPanel Visibility="Collapsed" IsHitTestVisible="False">
       <TextBlock x:Name="RpmGaugeText" Text="0"/><TextBlock x:Name="GearGaugeText" Text="N"/><TextBlock x:Name="EngineGaugeStatusText" Text="DESLIGADO"/>
       <TextBlock x:Name="FuelText" Text="0.0 L"/><TextBlock x:Name="FuelRangeGaugeText" Text="AUTONOMIA N/D"/><TextBlock x:Name="FuelStatusDot" Text="●"/>
       <TextBlock x:Name="WaterTempText" Text="— °C"/><TextBlock x:Name="WaterTempDot" Text="●"/><TextBlock x:Name="WaterTempStatusText" Text="N/D"/>
       <TextBlock x:Name="AirPressureText" Text="— PSI"/><TextBlock x:Name="AirPressureDot" Text="●"/><TextBlock x:Name="AirPressureStatusText" Text="N/D"/>
      </StackPanel>
     </Grid>
     </Grid>



