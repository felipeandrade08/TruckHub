<Window x:Class="TransPoli.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:tp="clr-namespace:TransPoli"
 Title="TruckHub • Computador de Bordo" Width="1520" Height="940"
 WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
 SnapsToDevicePixels="True" WindowStartupLocation="CenterScreen" KeyDown="Window_KeyDown"
 UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
 RenderOptions.BitmapScalingMode="HighQuality"
 Icon="/TransPoli;component/Assets/truckhub-badge.png">

 <Window.Resources>
  <FontFamily x:Key="TransPoliFont">Segoe UI</FontFamily>
  <Style TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource TransPoliFont}"/></Style>
  <SolidColorBrush x:Key="Gold" Color="#4298EF"/>
  <SolidColorBrush x:Key="GoldBright" Color="#6DB3FA"/>
  <SolidColorBrush x:Key="GoldSoft" Color="#2065AB"/>
  <SolidColorBrush x:Key="Bg" Color="#0B1118"/>
  <SolidColorBrush x:Key="Surface" Color="#111A23"/>
  <SolidColorBrush x:Key="Surface2" Color="#151D26"/>
  <SolidColorBrush x:Key="Surface3" Color="#18222D"/>
  <SolidColorBrush x:Key="Stroke" Color="#2E3B48"/>
  <SolidColorBrush x:Key="StrokeGold" Color="#073564"/>
  <SolidColorBrush x:Key="TextMain" Color="#F4F7FA"/>
  <SolidColorBrush x:Key="TextMuted" Color="#8997A5"/>
  <SolidColorBrush x:Key="Green" Color="#4EE59B"/>
  <SolidColorBrush x:Key="Red" Color="#FF6B6B"/>
  <Style x:Key="Card" TargetType="Border">
   <Setter Property="Background">
    <Setter.Value><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#F20C1219" Offset="0"/><GradientStop Color="#E6070B11" Offset="1"/></LinearGradientBrush></Setter.Value>
   </Setter>
   <Setter Property="BorderBrush" Value="{StaticResource Stroke}"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="CornerRadius" Value="18"/>
   <Setter Property="Padding" Value="16"/>
   <Setter Property="Effect"><Setter.Value><DropShadowEffect BlurRadius="16" ShadowDepth="0" Opacity=".18"/></Setter.Value></Setter>
  </Style>
  <Style x:Key="GoldCard" TargetType="Border">
   <Setter Property="Background">
    <Setter.Value><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#E61A1307" Offset="0"/><GradientStop Color="#D9080D12" Offset="1"/></LinearGradientBrush></Setter.Value>
   </Setter>
   <Setter Property="BorderBrush" Value="{StaticResource StrokeGold}"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="CornerRadius" Value="14"/>
   <Setter Property="Padding" Value="14"/>
   <Setter Property="Effect"><Setter.Value><DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity=".20"/></Setter.Value></Setter>
  </Style>
  <Style x:Key="Label" TargetType="TextBlock">
   <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
   <Setter Property="FontSize" Value="11"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style x:Key="Metric" TargetType="TextBlock">
   <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
   <Setter Property="FontSize" Value="20"/>
   <Setter Property="FontWeight" Value="Bold"/>
  </Style>
  <Style x:Key="NavButton" TargetType="Button">
   <Setter Property="Height" Value="64"/>
   <Setter Property="MinWidth" Value="0"/>
   <Setter Property="Margin" Value="3,2"/>
   <Setter Property="Background" Value="Transparent"/>
   <Setter Property="Padding" Value="7,5"/>
   <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
   <Setter Property="BorderThickness" Value="0"/>
   <Setter Property="FontSize" Value="11"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Border x:Name="N" Background="{TemplateBinding Background}" BorderBrush="#17212B" BorderThickness="1" CornerRadius="15" Padding="{TemplateBinding Padding}">
       <Grid>
        <Border x:Name="NavGlow" Width="3" Height="28" HorizontalAlignment="Left" VerticalAlignment="Center" Background="{StaticResource Gold}" CornerRadius="2" Opacity="0"/>
        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
       </Grid>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="N" Property="Background" Value="#061525"/>
        <Setter TargetName="N" Property="BorderBrush" Value="#0C3660"/>
        <Setter TargetName="NavGlow" Property="Opacity" Value="1"/>
        <Setter Property="Foreground" Value="{StaticResource GoldBright}"/>
       </Trigger>
       <Trigger Property="IsPressed" Value="True">
        <Setter TargetName="N" Property="Opacity" Value="0.78"/>
       </Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <!-- Indicadores compactos (etapa 2): caixa + valor grande -->
  <Style x:Key="TileBox" TargetType="Border">
   <Setter Property="Background" Value="#0D141B"/>
   <Setter Property="BorderBrush" Value="#26313D"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="CornerRadius" Value="9"/>
   <Setter Property="Padding" Value="10,7"/>
   <Setter Property="Margin" Value="0,0,6,0"/>
  </Style>
  <Style x:Key="TileValue" TargetType="TextBlock">
   <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
   <Setter Property="FontSize" Value="17"/>
   <Setter Property="FontWeight" Value="Bold"/>
   <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
   <Setter Property="Margin" Value="0,2,0,0"/>
  </Style>
  <Style x:Key="ActionButton" TargetType="Button">
   <Setter Property="Height" Value="40"/>
   <Setter Property="Padding" Value="12,5"/>
   <Setter Property="Background" Value="#101821"/>
   <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
   <Setter Property="BorderBrush" Value="{StaticResource StrokeGold}"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="FontSize" Value="11"/>
   <Setter Property="FontWeight" Value="Bold"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
       <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="B" Property="Background" Value="{StaticResource Gold}"/>
        <Setter Property="Foreground" Value="#090B0E"/>
       </Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <!-- SCROLLBARS TRANSPOLI: padrão visual único para todas as áreas roláveis do tablet. -->
  <Style TargetType="{x:Type ScrollBar}">
   <Setter Property="Width" Value="7"/>
   <Setter Property="Background" Value="Transparent"/>
   <Setter Property="Foreground" Value="#66727D"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="{x:Type ScrollBar}">
      <Grid Background="Transparent">
       <Track x:Name="PART_Track"
              Orientation="{TemplateBinding Orientation}"
              IsDirectionReversed="True"
              Minimum="{TemplateBinding Minimum}"
              Maximum="{TemplateBinding Maximum}"
              Value="{TemplateBinding Value}"
              ViewportSize="{TemplateBinding ViewportSize}">
        <Track.Thumb>
         <Thumb MinHeight="28" MinWidth="7">
          <Thumb.Template>
           <ControlTemplate TargetType="{x:Type Thumb}">
            <Border x:Name="ThumbBorder"
                    Margin="1,2"
                    Background="#66727D"
                    CornerRadius="3.5"
                    Opacity="0.62"/>
            <ControlTemplate.Triggers>
             <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="ThumbBorder" Property="Background" Value="#6DB3FA"/>
              <Setter TargetName="ThumbBorder" Property="Opacity" Value="0.95"/>
             </Trigger>
             <Trigger Property="IsDragging" Value="True">
              <Setter TargetName="ThumbBorder" Property="Background" Value="#6DB3FA"/>
              <Setter TargetName="ThumbBorder" Property="Opacity" Value="1"/>
             </Trigger>
            </ControlTemplate.Triggers>
           </ControlTemplate>
          </Thumb.Template>
         </Thumb>
        </Track.Thumb>
       </Track>
      </Grid>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>

  <Style x:Key="WindowButton" TargetType="Button">
   <Setter Property="Width" Value="34"/>
   <Setter Property="Height" Value="30"/>
   <Setter Property="Background" Value="#0C1218"/>
   <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
   <Setter Property="BorderThickness" Value="0"/>
   <Setter Property="FontSize" Value="17"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Border x:Name="W" Background="{TemplateBinding Background}" CornerRadius="15" Padding="0">
       <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="W" Property="Background" Value="#27323D"/><Setter Property="Foreground" Value="{StaticResource GoldBright}"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
 </Window.Resources>

 <Grid ClipToBounds="False">
  <!-- CHASSI FIXO DO TABLET — Etapa 1. A moldura permanece montada; apenas o conteúdo interno evolui nas próximas etapas. -->
  <Border Margin="1" BorderBrush="#0B0E12" BorderThickness="2" CornerRadius="58">
   <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#171C22" Offset="0"/><GradientStop Color="#05070A" Offset="0.18"/><GradientStop Color="#020304" Offset="0.82"/><GradientStop Color="#11161B" Offset="1"/></LinearGradientBrush></Border.Background>
   <Border.Effect><DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity=".42"/></Border.Effect>
  </Border>
  <Border Margin="7" BorderBrush="#46515D" BorderThickness="2" CornerRadius="54">
   <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#151B22" Offset="0"/><GradientStop Color="#080C11" Offset="0.48"/><GradientStop Color="#11171E" Offset="1"/></LinearGradientBrush></Border.Background>
  </Border>
  <Border Margin="12" BorderBrush="#145291" BorderThickness="1" CornerRadius="50" Opacity="0.96">
   <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#090B0F" Offset="0"/><GradientStop Color="#020305" Offset="0.5"/><GradientStop Color="#0B0F13" Offset="1"/></LinearGradientBrush></Border.Background>
  </Border>
  <!-- DETALHES FÍSICOS DO TABLET: câmera, sensores, alto-falante e parafusos. Apenas acabamento visual. -->
  <Border Margin="0" IsHitTestVisible="False">
   <Grid>
    <Border Width="82" Height="7" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,10,0,0"
            Background="#0B0F13" BorderBrush="#303943" BorderThickness="1" CornerRadius="4"/>
    <Ellipse Width="7" Height="7" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,10,0,0"
             Fill="#182027" Stroke="#59636E" StrokeThickness="1"/>
    <Ellipse Width="5" Height="5" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="25,25,0,0"
             Fill="#1B2229" Stroke="#4D5863" StrokeThickness="0.7"/>
    <Ellipse Width="5" Height="5" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,25,25,0"
             Fill="#1B2229" Stroke="#4D5863" StrokeThickness="0.7"/>
    <Ellipse Width="5" Height="5" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="25,0,0,25"
             Fill="#1B2229" Stroke="#4D5863" StrokeThickness="0.7"/>
    <Ellipse Width="5" Height="5" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,25,25"
             Fill="#1B2229" Stroke="#4D5863" StrokeThickness="0.7"/>
   </Grid>
  </Border>
  <Border x:Name="TabletScreen" Margin="32" BorderBrush="#4B5662" BorderThickness="1.2" CornerRadius="42" ClipToBounds="True">
   <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#070B10" Offset="0"/><GradientStop Color="#030609" Offset="0.48"/><GradientStop Color="#080C11" Offset="1"/></LinearGradientBrush></Border.Background>
   <Border.Effect><DropShadowEffect BlurRadius="14" ShadowDepth="0" Opacity=".20"/></Border.Effect>
   <Grid>
    <Grid.RowDefinitions>
     <RowDefinition Height="80"/>
     <RowDefinition Height="*"/>
     <RowDefinition Height="14"/>
    </Grid.RowDefinitions>

    <!-- FUNDO DE PAINEL DE CAMINHÃO: fibra de carbono, brilho de vidro e anéis de instrumento -->
    <tp:DashboardBackdrop Grid.Row="0" Grid.RowSpan="3" CornerRadiusValue="41"/>

    <!-- HEADER -->
    <Border Grid.Row="0" Background="#E0060B11" BorderBrush="#10253A" BorderThickness="0,0,0,1" CornerRadius="32,32,0,0">
     <Grid MouseLeftButtonDown="TabletDrag">
      <Grid.ColumnDefinitions>
       <ColumnDefinition Width="Auto" MinWidth="300"/>
       <ColumnDefinition Width="*"/>
       <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
       <Border Width="104" Height="48" CornerRadius="12" Background="#060A10" BorderBrush="{StaticResource GoldSoft}" BorderThickness="1" Padding="4">
        <Image Source="{StaticResource BrandLogo}" Stretch="Uniform"/>
       </Border>
       <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
        <TextBlock Text="TRUCKHUB OS" Foreground="{StaticResource TextMain}" FontSize="21" FontWeight="Bold"/>
        <TextBlock Text="TERMINAL EMBARCADO • OPERAÇÃO" Foreground="{StaticResource GoldBright}" FontSize="11" FontWeight="Bold"/>
       </StackPanel>
      </StackPanel>

      <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
       <Border Background="#0E1715" BorderBrush="#285440" BorderThickness="1" CornerRadius="9" Padding="11,7" Margin="0,0,7,0">
        <StackPanel Orientation="Horizontal">
         <Ellipse x:Name="ConnectionDot" Width="9" Height="9" Fill="#758596" Margin="0,0,7,0"/>
         <StackPanel>
          <TextBlock x:Name="ConnectionText" Text="ETS2 DESCONECTADO" Foreground="{StaticResource TextMain}" FontSize="11" FontWeight="Bold"/>
          <TextBlock x:Name="StatusText" Text="Telemetria aguardando" Foreground="{StaticResource TextMuted}" FontSize="11"/>
         </StackPanel>
        </StackPanel>
       </Border>
       <Border Visibility="Collapsed" Background="#B80C141A" BorderBrush="{StaticResource StrokeGold}" BorderThickness="1" CornerRadius="9" Padding="9,6" Margin="7,0,0,0">
        <StackPanel Orientation="Horizontal">
         <TextBlock x:Name="EnvironmentIconText" Text="◌" Foreground="{StaticResource TextMuted}" FontSize="15" Margin="0,0,6,0" VerticalAlignment="Center"/>
         <StackPanel>
          <TextBlock x:Name="EnvironmentStateText" Text="AMBIENTE N/D" Foreground="{StaticResource TextMuted}" FontSize="11" FontWeight="Bold"/>
          <TextBlock x:Name="EnvironmentDetailText" Text="Aguardando telemetria" Foreground="{StaticResource TextMuted}" FontSize="11"/>
          <TextBlock x:Name="EnvironmentWeatherText" Text="CLIMA N/D" Foreground="{StaticResource TextMuted}" FontSize="11" FontWeight="Bold"/>
         </StackPanel>
        </StackPanel>
       </Border>
       <Border Background="#B8080F16" BorderBrush="{StaticResource StrokeGold}" BorderThickness="1" CornerRadius="9" Padding="11,7">
        <StackPanel Orientation="Horizontal">
         <TextBlock Text="▰" FontSize="15" FontFamily="Segoe UI Symbol" Margin="0,0,7,0"/>
         <StackPanel>
          <TextBlock x:Name="VehicleLockText" Text="CAMINHÃO BLOQUEADO" Foreground="{StaticResource GoldBright}" FontSize="11" FontWeight="Bold"/>
          <TextBlock Text="Liberação segura" Foreground="{StaticResource TextMuted}" FontSize="11"/>
         </StackPanel>
        </StackPanel>
       </Border>
      </StackPanel>

      <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0">
       <!-- CONTROLES DO TABLET: atualização da telemetria + atualização do aplicativo -->
       <!-- STATUS BAR DE TABLET: rota, Wi-Fi, notificações, bateria e relógio -->
       <Border Background="#B0111A23" BorderBrush="#2E3B48" BorderThickness="1" CornerRadius="16" Padding="14,6" Margin="0,0,10,0">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
         <StackPanel Orientation="Horizontal" VerticalAlignment="Center" ToolTip="Rota da telemetria">
          <TextBlock x:Name="GpsStatusText" Text="●" Foreground="{StaticResource Green}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
          <TextBlock Text="ROTA" Foreground="{StaticResource TextMain}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
         </StackPanel>
         <Border Width="1" Height="22" Background="#2E3B48" Margin="12,0"/>
         <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <tp:TpIcon x:Name="WifiIcon" Kind="wifi" Width="19" Height="19" Fill="{StaticResource Green}" Margin="0,0,7,0"/>
          <TextBlock x:Name="WifiStatusText" Text="Wi-Fi" Foreground="{StaticResource TextMain}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
         </StackPanel>
         <Border Width="1" Height="22" Background="#2E3B48" Margin="12,0"/>
         <TextBlock x:Name="NotificationStatusText" Text="◇" FontFamily="Segoe UI Symbol" Foreground="{StaticResource TextMuted}" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
         <Border Width="1" Height="22" Background="#2E3B48" Margin="12,0"/>
         <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Grid Width="32" Height="16" Margin="0,0,7,0" VerticalAlignment="Center">
           <Border Width="29" Height="16" HorizontalAlignment="Left" BorderBrush="#8997A5" BorderThickness="1.5" CornerRadius="5" Padding="2">
            <Border x:Name="BatteryFill" Width="0" HorizontalAlignment="Left" CornerRadius="2.5" Background="{StaticResource Green}"/>
           </Border>
           <Border Width="3" Height="6" HorizontalAlignment="Right" CornerRadius="0,2,2,0" Background="#8997A5"/>
           <tp:TpIcon x:Name="BatteryBoltIcon" Kind="bolt" Width="10" Height="10" Fill="#0B1118" HorizontalAlignment="Left" Margin="9,0,0,0" Visibility="Collapsed"/>
          </Grid>
          <TextBlock x:Name="BatteryPercentText" Text="100%" Foreground="{StaticResource TextMain}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
         </StackPanel>
         <Border Width="1" Height="22" Background="#2E3B48" Margin="12,0"/>
         <StackPanel VerticalAlignment="Center">
          <TextBlock x:Name="ClockText" FontFamily="Bahnschrift, Segoe UI" Text="--:--" Foreground="{StaticResource TextMain}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
          <TextBlock x:Name="DateText" Text="--/--/----" Foreground="{StaticResource TextMuted}" FontSize="10" HorizontalAlignment="Center"/>
         </StackPanel>
         <StackPanel Visibility="Collapsed" IsHitTestVisible="False">
          <TextBlock x:Name="NetworkSignalText" Text=""/><TextBlock x:Name="NetworkTypeText" Text="CONECTADO"/><TextBlock x:Name="BluetoothStatusText" Text="N/D"/>
          <TextBlock x:Name="BatteryStatusText" Text="▮▮▮▮"/><TextBlock x:Name="BatteryModeText" Text="BATERIA"/>
         </StackPanel>
        </StackPanel>
       </Border>
       <Button Content="−" Click="TabletMinimize_Click" Style="{StaticResource WindowButton}" ToolTip="Colocar em segundo plano" Margin="0,0,5,0"/>
       <Button Content="×" Click="TabletClose_Click" Style="{StaticResource WindowButton}" ToolTip="Fechar TransPoli"/>
      </StackPanel>
     </Grid>
    </Border>

    <!-- DIVISOR DE VIDRO DO COCKPIT -->
    <Border Grid.Row="0" Grid.RowSpan="3" Margin="0,80,0,14" BorderBrush="#FFFFFF" BorderThickness="0,0,0,1" Opacity="0.035" IsHitTestVisible="False"/>

    <!-- MAIN BODY — ETAPA 2: cockpit/tablet profissional -->
    <Grid Grid.Row="1" Margin="16,14,16,10">
     <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="86"/>
     </Grid.RowDefinitions>

     <!-- DOCK INFERIOR DO TABLET -->
     <Border Grid.Row="1" Background="#F0111A23" BorderBrush="#2E3B48" BorderThickness="1" CornerRadius="24" Padding="8,6" Margin="0,8,0,0">
      <Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="0" Opacity=".14"/></Border.Effect>
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <StackPanel Visibility="Collapsed" IsHitTestVisible="False"><TextBlock x:Name="TelemetryInfoText" Text="ETS2 conectado • telemetria ativa"/></StackPanel>
       <UniformGrid Grid.Column="0" Rows="1" Columns="7" VerticalAlignment="Center">
        <Button Style="{StaticResource NavButton}" Background="#061B30" Foreground="{StaticResource GoldBright}" Click="HomeButton_Click" Margin="4,0"><StackPanel><tp:TpIcon Kind="home" Width="26" Height="26" HorizontalAlignment="Center" Margin="0,0,0,3" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ButtonBase}}"/><TextBlock Text="INÍCIO" HorizontalAlignment="Center" FontWeight="Bold" FontSize="11"/></StackPanel></Button>
        <Button Style="{StaticResource NavButton}" Click="CargoMarketButtonV15_Click" Margin="4,0"><StackPanel><tp:TpIcon Kind="cargo" Width="26" Height="26" HorizontalAlignment="Center" Margin="0,0,0,3" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ButtonBase}}"/><TextBlock Text="CARGAS" HorizontalAlignment="Center" FontWeight="Bold" FontSize="11"/></StackPanel></Button>
        <Button Style="{StaticResource NavButton}" Click="DockOperation_Click" Margin="4,0"><StackPanel><tp:TpIcon Kind="route" Width="26" Height="26" HorizontalAlignment="Center" Margin="0,0,0,3" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ButtonBase}}"/><TextBlock Text="OPERAÇÃO ▴" HorizontalAlignment="Center" FontWeight="Bold" FontSize="11"/></StackPanel></Button>
        <Button Style="{StaticResource NavButton}" Click="BankButtonV15_Click" Margin="4,0"><StackPanel><tp:TpIcon Kind="bank" Width="26" Height="26" HorizontalAlignment="Center" Margin="0,0,0,3" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ButtonBase}}"/><TextBlock Text="BANCO" HorizontalAlignment="Center" FontWeight="Bold" FontSize="11"/></StackPanel></Button>
        <Button Style="{StaticResource NavButton}" Click="DockFleet_Click" Margin="4,0"><StackPanel><tp:TpIcon Kind="truck" Width="26" Height="26" HorizontalAlignment="Center" Margin="0,0,0,3" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ButtonBase}}"/><TextBlock Text="FROTA ▴" HorizontalAlignment="Center" FontWeight="Bold" FontSize="11"/></StackPanel></Button>
        <Button Style="{StaticResource NavButton}" Click="DockDriver_Click" Margin="4,0"><StackPanel><tp:TpIcon Kind="account" Width="26" Height="26" HorizontalAlignment="Center" Margin="0,0,0,3" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ButtonBase}}"/><TextBlock Text="MOTORISTA ▴" HorizontalAlignment="Center" FontWeight="Bold" FontSize="10"/></StackPanel></Button>
        <Button Style="{StaticResource NavButton}" Click="HudSettingsButton_Click" Margin="4,0"><StackPanel><tp:TpIcon Kind="gauge" Width="26" Height="26" HorizontalAlignment="Center" Margin="0,0,0,3" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ButtonBase}}"/><TextBlock Text="HUD" HorizontalAlignment="Center" FontWeight="Bold" FontSize="11"/></StackPanel></Button>
       </UniformGrid>
       <Border Grid.Column="1" Margin="8,0,0,0" Padding="6,2" Background="#A9151D26" BorderBrush="#2E3B48" BorderThickness="1" CornerRadius="14" VerticalAlignment="Center">
        <UniformGrid Columns="2" Width="330">
         <Button Content="↻  ATUALIZAR DADOS" Click="RefreshDashboard_Click" Style="{StaticResource ActionButton}" Height="29" Margin="3,2" ToolTip="Atualizar a leitura do jogo agora" />
         <Button Content="⬇  ATUALIZAR APP" Click="UpdateButton_Click" Style="{StaticResource ActionButton}" Height="29" Margin="3,2" ToolTip="Verificar e instalar atualização do TransPoli" />
         <Button Content="▦  DIRETORIA" Click="OpenDirectorCenter_Click" Style="{StaticResource ActionButton}" Height="29" Margin="3,2" ToolTip="Abrir a Central da Diretoria usando a sessão atual" />
         <Button Content="↪  SAIR DA CONTA" Click="LogoutAccount_Click" Style="{StaticResource ActionButton}" Height="29" Margin="3,2" ToolTip="Encerrar a sessão e voltar para a tela de login" />
        </UniformGrid>
       </Border>
      </Grid>
     </Border>

     <!-- COCKPIT PRINCIPAL -->
     <Grid Grid.Row="0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="*"/><ColumnDefinition Width="340"/></Grid.ColumnDefinitions>

      <!-- COLUNA ESQUERDA: motorista + saldo -->
      <Grid Grid.Column="0" Margin="0,0,10,0">
       <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
       <Border Background="#E6111A23" BorderBrush="#2E3B48" BorderThickness="1" CornerRadius="22" Padding="20,16" Margin="0,0,0,10">
