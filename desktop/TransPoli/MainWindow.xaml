/Border>
        <Border Grid.Column="1" Background="#B8080E15" BorderBrush="#26313D" BorderThickness="1" CornerRadius="18" Padding="14" Margin="10,0,0,0"><StackPanel><TextBlock Text="POSIÇÃO ATUAL" Foreground="{StaticResource GoldBright}" FontSize="9" FontWeight="Bold"/><TextBlock x:Name="GpsCoordinatesText" Text="GPS aguardando telemetria" Foreground="{StaticResource TextMain}" FontSize="11" FontWeight="Bold" TextWrapping="Wrap" Margin="0,7,0,0"/><TextBlock Text="WORLD X / Z" Foreground="{StaticResource TextMuted}" FontSize="6" FontWeight="Bold" Margin="0,12,0,0"/><TextBlock x:Name="GpsWorldText" Text="— / —" Foreground="{StaticResource TextMain}" FontSize="8" FontWeight="Bold"/><TextBlock Text="RUMO" Foreground="{StaticResource TextMuted}" FontSize="6" FontWeight="Bold" Margin="0,12,0,0"/><TextBlock x:Name="GpsHeadingText" Text="—°" Foreground="{StaticResource TextMain}" FontSize="16" FontWeight="Bold"/><Border Background="#101821" BorderBrush="#2D3A46" BorderThickness="1" CornerRadius="10" Padding="9" Margin="0,14,0,0"><StackPanel><TextBlock Text="CALIBRAÇÃO" Foreground="{StaticResource TextMuted}" FontSize="6" FontWeight="Bold"/><TextBlock x:Name="GpsCalibrationText" Text="climate.sii não carregado" Foreground="{StaticResource GoldBright}" FontSize="8" FontWeight="Bold" TextWrapping="Wrap" Margin="0,3,0,0"/><TextBlock Text="A fonte geográfica só é considerada calibrada após validação contra um ponto conhecido." Foreground="{StaticResource TextMuted}" FontSize="6.5" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel></Border><TextBlock x:Name="GpsRouteText" Text="Rota: —" Foreground="{StaticResource TextMain}" FontSize="7" FontWeight="Bold" TextWrapping="Wrap" Margin="0,14,0,0"/><TextBlock x:Name="GpsDistanceText" Text="Distância restante: —" Foreground="{StaticResource TextMuted}" FontSize="7" Margin="0,3,0,0"/></StackPanel></Border>
       </Grid><Border Grid.Row="2" Background="#0E151C" BorderBrush="#26313D" BorderThickness="1" CornerRadius="10" Padding="8"><TextBlock x:Name="GpsStatusText" Text="GPS visual pronto • aguardando posição do Connector" Foreground="{StaticResource TextMuted}" FontSize="7" FontWeight="Bold"/></Border>
