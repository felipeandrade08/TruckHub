<Window x:Class="TransPoli.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="TransPoli • Computador de Bordo" Width="1520" Height="940"
 WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
 SnapsToDevicePixels="True" WindowStartupLocation="CenterScreen" KeyDown="Window_KeyDown"
 UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
 RenderOptions.BitmapScalingMode="HighQuality"
 Icon="/TransPoli;component/Assets/transpoli-logo.png">

 <Window.Resources>
  <FontFamily x:Key="TransPoliFont">Segoe UI</FontFamily>
  <Style TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource TransPoliFont}"/></Style>
  <SolidColorBrush x:Key="Gold" Color="#D6A52A"/>
  <SolidColorBrush x:Key="GoldBright" Color="#FFD86A"/>
  <SolidColorBrush x:Key="GoldSoft" Color="#9D7620"/>
  <SolidColorBrush x:Key="Bg" Color="#05080B"/>
  <SolidColorBrush x:Key="Surface" Color="#0B1015"/>
  <SolidColorBrush x:Key="Surface2" Color="#10171E"/>
  <SolidColorBrush x:Key="Surface3" Color="#131B23"/>
  <SolidColorBrush x:Key="Stroke" Color="#29343F"/>
  <SolidColorBrush x:Key="StrokeGold" Color="#604A0B"/>
  <SolidColorBrush x:Key="TextMain" Color="#F5F7FA"/>
  <SolidColorBrush x:Key="TextMuted" Color="#A1ABB6"/>
  <SolidColorBrush x:Key="Green" Color="#54D99B"/>
  <SolidColorBrush x:Key="Red" Color="#F06A6A"/>
  <Style x:Key="Card" TargetType="Border">
   <Setter Property="Background">
    <Setter.Value><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#F20C1219" Offset="0"/><GradientStop Color="#E6070B11" Offset="1"/></LinearGradientBrush></Setter.Value>
   </Setter>
   <Setter Property="BorderBrush" Value="{StaticResource Stroke}"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="CornerRadius" Value="18"/>
   <Setter Property="Padding" Value="16"/>
   <Setter Property="Effect"><Setter.Value><DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity=".30"/></Setter.Value></Setter>
  </Style>
  <Style x:Key="GoldCard" TargetType="Border">
   <Setter Property="Background">
    <Setter.Value><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#E61A1307" Offset="0"/><GradientStop Color="#D9080D12" Offset="1"/></LinearGradientBrush></Setter.Value>
   </Setter>
   <Setter Property="BorderBrush" Value="{StaticResource StrokeGold}"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="CornerRadius" Value="14"/>
   <Setter Property="Padding" Value="14"/>
   <Setter Property="Effect"><Setter.Value><DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity=".34"/></Setter.Value></Setter>
  </Style>
  <Style x:Key="Label" TargetType="TextBlock">
   <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
   <Setter Property="FontSize" Value="11"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style x:Key="Metric" TargetType="TextBlock">
   <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
   <Setter Property="FontSize" Value="20"/>
   <Setter Property="FontWeight" Value="Bold"/>
  </Style>
  <Style x:Key="NavButton" TargetType="Button">
   <Setter Property="Height" Value="64"/>
   <Setter Property="MinWidth" Value="0"/>
   <Setter Property="Margin" Value="3,2"/>
   <Setter Property="Background" Value="Transparent"/>
   <Setter Property="Padding" Value="7,5"/>
   <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
   <Setter Property="BorderThickness" Value="0"/>
   <Setter Property="FontSize" Value="11"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Border x:Name="N" Background="{TemplateBinding Background}" BorderBrush="#17212B" BorderThickness="1" CornerRadius="15" Padding="{TemplateBinding Padding}">
       <Grid>
        <Border x:Name="NavGlow" Width="3" Height="28" HorizontalAlignment="Left" VerticalAlignment="Center" Background="{StaticResource Gold}" CornerRadius="2" Opacity="0"/>
        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
       </Grid>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="N" Property="Background" Value="#241B07"/>
        <Setter TargetName="N" Property="BorderBrush" Value="#5C4610"/>
        <Setter TargetName="NavGlow" Property="Opacity" Value="1"/>
        <Setter Property="Foreground" Value="{StaticResource GoldBright}"/>
       </Trigger>
       <Trigger Property="IsPressed" Value="True">
        <Setter TargetName="N" Property="Opacity" Value="0.78"/>
       </Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style x:Key="ActionButton" TargetType="Button">
   <Setter Property="Height" Value="40"/>
   <Setter Property="Padding" Value="12,5"/>
   <Setter Property="Background" Value="#101821"/>
   <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
   <Setter Property="BorderBrush" Value="{StaticResource StrokeGold}"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="FontSize" Value="11"/>
   <Setter Property="FontWeight" Value="Bold"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
       <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="B" Property="Background" Value="{StaticResource Gold}"/>
        <Setter Property="Foreground" Value="#090B0E"/>
       </Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <!-- SCROLLBARS TRANSPOLI: padrão visual único para todas as áreas roláveis do tablet. -->
  <Style TargetType="{x:Type ScrollBar}">
   <Setter Property="Width" Value="7"/>
   <Setter Property="Background" Value="Transparent"/>
   <Setter Property="Foreground" Value="#8F6E13"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="{x:Type ScrollBar}">
      <Grid Background="Transparent">
       <Track x:Name="PART_Track"
              Orientation="{TemplateBinding Orientation}"
              IsDirectionReversed="True"
              Minimum="{TemplateBinding Minimum}"
              Maximum="{TemplateBinding Maximum}"
              Value="{TemplateBinding Value}"
              ViewportSize="{TemplateBinding ViewportSize}">
        <Track.Thumb>
         <Thumb MinHeight="28" MinWidth="7">
          <Thumb.Template>
           <ControlTemplate TargetType="{x:Type Thumb}">
            <Border x:Name="ThumbBorder"
                    Margin="1,2"
                    Background="#8F6E13"
                    CornerRadius="3.5"
                    Opacity="0.72"/>
            <ControlTemplate.Triggers>
             <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="ThumbBorder" Property="Background" Value="#FFD45A"/>
              <Setter TargetName="ThumbBorder" Property="Opacity" Value="0.95"/>
             </Trigger>
             <Trigger Property="IsDragging" Value="True">
              <Setter TargetName="ThumbBorder" Property="Background" Value="#FFD45A"/>
              <Setter TargetName="ThumbBorder" Property="Opacity" Value="1"/>
             </Trigger>
            </ControlTemplate.Triggers>
           </ControlTemplate>
          </Thumb.Template>
         </Thumb>
        </Track.Thumb>
       </Track>
      </Grid>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>

  <Style x:Key="WindowButton" TargetType="Button">
   <Setter Property="Width" Value="34"/>
   <Setter Property="Height" Value="30"/>
   <Setter Property="Background" Value="#0C1218"/>
   <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
   <Setter Property="BorderThickness" Value="0"/>
   <Setter Property="FontSize" Value="17"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Border x:Name="W" Background="{TemplateBinding Background}" CornerRadius="15" Padding="0">
       <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="W" Property="Background" Value="#27323D"/><Setter Property="Foreground" Value="{StaticResource GoldBright}"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
 </Window.Resources>

 <Grid ClipToBounds="False">
  <!-- CHASSI FIXO DO TABLET — Etapa 1. A moldura permanece montada; apenas o conteúdo interno evolui nas próximas etapas. -->
  <Border Margin="1" BorderBrush="#0B0E12" BorderThickness="2" CornerRadius="58">
   <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#171C22" Offset="0"/><GradientStop Color="#05070A" Offset="0.18"/><GradientStop Color="#020304" Offset="0.82"/><GradientStop Color="#11161B" Offset="1"/></LinearGradientBrush></Border.Background>
   <Border.Effect><DropShadowEffect BlurRadius="34" ShadowDepth="0" Opacity=".55"/></Border.Effect>
  </Border>
  <Border Margin="7" BorderBrush="#46515D" BorderThickness="2" CornerRadius="54">
   <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#151B22" Offset="0"/><GradientStop Color="#080C11" Offset="0.48"/><GradientStop Color="#11171E" Offset="1"/></LinearGradientBrush></Border.Background>
  </Border>
  <Border Margin="12" BorderBrush="#8B691A" BorderThickness="1" CornerRadius="50" Opacity="0.96">
   <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#090B0F" Offset="0"/><GradientStop Color="#020305" Offset="0.5"/><GradientStop Color="#0B0F13" Offset="1"/></LinearGradientBrush></Border.Background>
  </Border>
  <!-- DETALHES FÍSICOS DO TABLET: câmera, sensores, alto-falante e parafusos. Apenas acabamento visual. -->
  <Border Margin="0" IsHitTestVisible="False">
   <Grid>
    <Border Width="82" Height="7" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,10,0,0"
            Background="#0B0F13" BorderBrush="#303943" BorderThickness="1" CornerRadius="4"/>
    <Ellipse Width="7" Height="7" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,10,0,0"
             Fill="#182027" Stroke="#59636E" StrokeThickness="1"/>
    <Ellipse Width="5" Height="5" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="25,25,0,0"
             Fill="#1B2229" Stroke="#4D5863" StrokeThickness="0.7"/>
    <Ellipse Width="5" Height="5" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,25,25,0"
             Fill="#1B2229" Stroke="#4D5863" StrokeThickness="0.7"/>
    <Ellipse Width="5" Height="5" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="25,0,0,25"
             Fill="#1B2229" Stroke="#4D5863" StrokeThickness="0.7"/>
    <Ellipse Width="5" Height="5" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,25,25"
             Fill="#1B2229" Stroke="#4D5863" StrokeThickness="0.7"/>
   </Grid>
  </Border>
  <Border x:Name="TabletScreen" Margin="32" BorderBrush="#4B5662" BorderThickness="1.2" CornerRadius="42" ClipToBounds="True">
   <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#070B10" Offset="0"/><GradientStop Color="#030609" Offset="0.48"/><GradientStop Color="#080C11" Offset="1"/></LinearGradientBrush></Border.Background>
   <Border.Effect><DropShadowEffect BlurRadius="22" ShadowDepth="0" Opacity=".30"/></Border.Effect>
   <Grid>
    <Grid.RowDefinitions>
     <RowDefinition Height="80"/>
     <RowDefinition Height="*"/>
     <RowDefinition Height="40"/>
    </Grid.RowDefinitions>

    <!-- FUNDO OEM DO TABLET: grafite profundo, vidro fosco e textura sutil. Sem fotografia atrás dos instrumentos. -->
    <Border Grid.Row="0" Grid.RowSpan="3" Background="#05080C" IsHitTestVisible="False"/>
    <Border Grid.Row="0" Grid.RowSpan="3" IsHitTestVisible="False">
     <Border.Background>
      <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
       <GradientStop Color="#10161D" Offset="0"/>
       <GradientStop Color="#070B10" Offset="0.42"/>
       <GradientStop Color="#030508" Offset="1"/>
      </LinearGradientBrush>
     </Border.Background>
    </Border>
    <Border Grid.Row="0" Grid.RowSpan="3" IsHitTestVisible="False" Opacity="0.16">
     <Border.Background>
      <DrawingBrush TileMode="Tile" Viewport="0,0,28,28" ViewportUnits="Absolute">
       <DrawingBrush.Drawing>
        <GeometryDrawing Brush="#17202A">
         <GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,1,1"/></GeometryDrawing.Geometry>
        </GeometryDrawing>
       </DrawingBrush.Drawing>
      </DrawingBrush>
     </Border.Background>
    </Border>
    <Border Grid.Row="0" Grid.RowSpan="3" IsHitTestVisible="False" Opacity="0.18">
     <Border.Background>
      <RadialGradientBrush Center="0.12,0.08" RadiusX="0.85" RadiusY="0.85">
       <GradientStop Color="#3A424C" Offset="0"/>
       <GradientStop Color="#10151B" Offset="0.45"/>
       <GradientStop Color="Transparent" Offset="1"/>
      </RadialGradientBrush>
     </Border.Background>
    </Border>
    <Border Grid.Row="0" Grid.RowSpan="3" Background="#0A0F14" Opacity="0.22" IsHitTestVisible="False"/>

    <!-- HEADER -->
    <Border Grid.Row="0" Background="#E0060B11" BorderBrush="#382D12" BorderThickness="0,0,0,1" CornerRadius="32,32,0,0">
     <Grid MouseLeftButtonDown="TabletDrag">
      <Grid.ColumnDefinitions>
       <ColumnDefinition Width="350"/>
       <ColumnDefinition Width="*"/>
       <ColumnDefinition Width="435"/>
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
       <Border Width="48" Height="48" CornerRadius="12" Background="#101720" BorderBrush="{StaticResource GoldSoft}" BorderThickness="1" Padding="5">
        <Image Source="{StaticResource BrandLogo}" Stretch="Uniform"/>
       </Border>
       <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
        <TextBlock Text="TRANSPOLI" Foreground="{StaticResource TextMain}" FontSize="21" FontWeight="Bold"/>
        <TextBlock Text="COMPUTADOR DE BORDO • ETS2" Foreground="{StaticResource GoldBright}" FontSize="11" FontWeight="Bold"/>
       </StackPanel>
      </StackPanel>

      <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
       <Border Background="#0E1715" BorderBrush="#285440" BorderThickness="1" CornerRadius="9" Padding="11,7" Margin="0,0,7,0">
        <StackPanel Orientation="Horizontal">
         <Ellipse x:Name="ConnectionDot" Width="9" Height="9" Fill="#758596" Margin="0,0,7,0"/>
         <StackPanel>
          <TextBlock x:Name="ConnectionText" Text="ETS2 DESCONECTADO" Foreground="{StaticResource TextMain}" FontSize="11" FontWeight="Bold"/>
          <TextBlock x:Name="StatusText" Text="Telemetria aguardando" Foreground="{StaticResource TextMuted}" FontSize="11"/>
         </StackPanel>
        </StackPanel>
       </Border>
       <Border Background="#B80C141A" BorderBrush="{StaticResource StrokeGold}" BorderThickness="1" CornerRadius="9" Padding="9,6" Margin="7,0,0,0">
        <StackPanel Orientation="Horizontal">
         <TextBlock x:Name="EnvironmentIconText" Text="◌" Foreground="{StaticResource TextMuted}" FontSize="15" Margin="0,0,6,0" VerticalAlignment="Center"/>
         <StackPanel>
          <TextBlock x:Name="EnvironmentStateText" Text="AMBIENTE N/D" Foreground="{StaticResource TextMuted}" FontSize="11" FontWeight="Bold"/>
          <TextBlock x:Name="EnvironmentDetailText" Text="Aguardando telemetria" Foreground="{StaticResource TextMuted}" FontSize="11"/>
          <TextBlock x:Name="EnvironmentWeatherText" Text="CLIMA N/D" Foreground="{StaticResource TextMuted}" FontSize="11" FontWeight="Bold"/>
         </StackPanel>
        </StackPanel>
       </Border>
       <Border Background="#B8151109" BorderBrush="{StaticResource StrokeGold}" BorderThickness="1" CornerRadius="9" Padding="11,7">
        <StackPanel Orientation="Horizontal">
         <TextBlock Text="▰" FontSize="15" FontFamily="Segoe UI Symbol" Margin="0,0,7,0"/>
         <StackPanel>
          <TextBlock x:Name="VehicleLockText" Text="CAMINHÃO BLOQUEADO" Foreground="{StaticResource GoldBright}" FontSize="11" FontWeight="Bold"/>
          <TextBlock Text="Liberação segura" Foreground="{StaticResource TextMuted}" FontSize="11"/>
         </StackPanel>
        </StackPanel>
       </Border>
      </StackPanel>

      <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0">
       <!-- CONTROLES DO TABLET: atualização da telemetria + atualização do aplicativo -->
       <!-- STATUS BAR REALISTA DE TABLET -->
       <Border Background="#A8080D12" BorderBrush="#26313D" BorderThickness="1" CornerRadius="12" Padding="10,5" Margin="0,0,8,0">
        <Grid>
         <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
         </Grid.ColumnDefinitions>
         <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
          <TextBlock x:Name="NetworkSignalText" Text="▂▄▆█" Foreground="{StaticResource Green}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,5,0"/>
          <StackPanel>
           <TextBlock x:Name="WifiStatusText" Text="Wi-Fi" Foreground="{StaticResource TextMain}" FontSize="11" FontWeight="Bold"/>
           <TextBlock x:Name="NetworkTypeText" Text="CONECTADO" Foreground="{StaticResource Green}" FontSize="11" FontWeight="Bold"/>
          </StackPanel>
         </StackPanel>
         <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
          <TextBlock x:Name="GpsStatusText" Text="●" Foreground="{StaticResource Green}" FontSize="11" FontWeight="Bold" Margin="0,0,4,0"/>
          <StackPanel>
           <TextBlock Text="ROTA" Foreground="{StaticResource TextMain}" FontSize="11" FontWeight="Bold"/>
           <TextBlock Text="TELEMETRIA ETS2" Foreground="{StaticResource TextMuted}" FontSize="11"/>
          </StackPanel>
         </StackPanel>
         <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
          <TextBlock x:Name="BluetoothStatusText" Text="N/D" Foreground="{StaticResource TextMuted}" FontSize="11" FontWeight="Bold" Margin="0,0,4,0"/>
          <StackPanel>
           <TextBlock Text="BT" Foreground="{StaticResource TextMain}" FontSize="11" FontWeight="Bold"/>
           <TextBlock Text="N/D" Foreground="{StaticResource TextMuted}" FontSize="11"/>
          </StackPanel>
         </StackPanel>
         <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="0,0,12,0">
          <TextBlock x:Name="ClockText" FontFamily="Segoe UI" Text="--:--" Foreground="{StaticResource TextMain}" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center"/>
          <TextBlock x:Name="DateText" Text="--/--/----" Foreground="{StaticResource TextMuted}" FontSize="11" HorizontalAlignment="Center"/>
         </StackPanel>
         <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock x:Name="NotificationStatusText" Text="◇" FontFamily="Segoe UI Symbol" Foreground="{StaticResource TextMuted}" FontSize="11" FontWeight="Bold" Margin="0,0,7,0"/>
          <StackPanel VerticalAlignment="Center">
           <StackPanel Orientation="Horizontal">
            <TextBlock x:Name="BatteryStatusText" Text="▮▮▮▮" Foreground="{StaticResource Green}" FontSize="11" FontWeight="Bold" FontFamily="Segoe UI Symbol" VerticalAlignment="Center"/>
            <TextBlock x:Name="BatteryPercentText" Text="100%" Foreground="{StaticResource TextMain}" FontSize="11" FontWeight="Bold" Margin="4,0,0,0" VerticalAlignment="Center"/>
           </StackPanel>
           <TextBlock x:Name="BatteryModeText" Text="BATERIA" Foreground="{StaticResource TextMuted}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right" Margin="0,1,0,0"/>
          </StackPanel>
         </StackPanel>
        </Grid>
       </Border>
       <Button Content="−" Click="TabletMinimize_Click" Style="{StaticResource WindowButton}" ToolTip="Colocar em segundo plano" Margin="0,0,5,0"/>
       <Button Content="×" Click="TabletClose_Click" Style="{StaticResource WindowButton}" ToolTip="Fechar TransPoli"/>
      </StackPanel>
     </Grid>
    </Border>

    <!-- DIVISOR DE VIDRO DO COCKPIT -->
    <Border Grid.Row="0" Grid.RowSpan="3" Margin="0,80,0,40" BorderBrush="#FFFFFF" BorderThickness="0,0,0,1" Opacity="0.035" IsHitTestVisible="False"/>

    <!-- MAIN BODY — ETAPA 2: cockpit/tablet profissional -->
    <Grid Grid.Row="1" Margin="18,16,18,12">
     <Grid.ColumnDefinitions>
      <ColumnDefinition Width="204"/>
      <ColumnDefinition Width="*"/>
     </Grid.ColumnDefinitions>

     <!-- DOCK LATERAL DO TABLET -->
     <Border Grid.Column="0" Background="#D8070D13" BorderBrush="#2A3540" BorderThickness="1" CornerRadius="24" Padding="12">
      <Border.Effect><DropShadowEffect BlurRadius="16" ShadowDepth="0" Opacity=".22"/></Border.Effect>
      <Grid>
       <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="138"/></Grid.RowDefinitions>
       <ScrollViewer Grid.Row="0"
                     Margin="0,0,0,6"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Disabled"
                     CanContentScroll="True"
                     Focusable="False">
        <StackPanel>
        <Border Background="#151109" BorderBrush="{StaticResource StrokeGold}" BorderThickness="1" CornerRadius="12" Padding="9" Margin="1,1,1,9">
         <StackPanel>
          <TextBlock Text="OPERAÇÃO TRANSPOLI" Foreground="{StaticResource GoldBright}" FontSize="11" FontWeight="Bold"/>
          <TextBlock Text="COMPUTADOR DE BORDO" Foreground="{StaticResource TextMain}" FontSize="15" FontWeight="Bold" Margin="0,2,0,0"/>
          <TextBlock x:Name="TelemetryInfoText" Text="ETS2 conectado • telemetria ativa" Foreground="{StaticResource TextMuted}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
         </StackPanel>
        </Border>
        <Button Style="{StaticResource NavButton}" Background="#332706" Foreground="{StaticResource GoldBright}" Click="HomeButton_Click">
         <StackPanel><TextBlock Text="⌂" FontSize="23" HorizontalAlignment="Center"/><TextBlock Text="PAINEL" HorizontalAlignment="Center" FontWeight="Bold"/></StackPanel>
        </Button>
        <Button Style="{StaticResource NavButton}" Background="#261F0C" Foreground="{StaticResource GoldBright}" Click="SummaryButton_Click" ToolTip="Abrir prontuários, viagem ativa e histórico operacional">
         <StackPanel>
          <TextBlock Text="▣" FontSize="21" HorizontalAlignment="Center"/>
          <TextBlock Text="CENTRAL" HorizontalAlignment="Center" FontWeight="Bold"/>
          <TextBlock Text="DE VIAGENS" HorizontalAlignment="Center" FontSize="11" FontWeight="SemiBold"/>
         </StackPanel>
        </Button>
        <TextBlock Text="OPERAÇÃO DA VIAGEM" Foreground="{StaticResource TextMuted}" FontSize="11" FontWeight="Bold" Margin="8,8,0,4"/>
        <Button Style="{StaticResource NavButton}" Click="TachographButton_Click">
         <StackPanel><TextBlock Text="⏱" FontSize="21" HorizontalAlignment="Center"/><TextBlock Text="JORNADA / TACÓGRAFO" HorizontalAlignment="Center" FontWeight="Bold"/></StackPanel>
        </Button>
        <Button Style="{StaticResource NavButton}" Click="FuelButton_Click">
         <StackPanel><TextBlock Text="◉" FontSize="21" HorizontalAlignment="Center"/><TextBlock Text="COMBUSTÍVEL" HorizontalAlignment="Center" FontWeight="Bold"/></StackPanel>
        </Button>
        <TextBlock Text="SERVIÇOS" Foreground="{StaticResource TextMuted}" FontSize="11" FontWeight="Bold" Margin="8,8,0,4"/>
        <Button Style="{StaticResource NavButton}" Click="DocumentsButton_Click">
         <StackPanel><TextBlock Text="▤" FontSize="22" HorizontalAlignment="Center"/><TextBlock Text="DOCUMENTOS" HorizontalAlignment="Center" FontWeight="Bold"/></StackPanel>
        </Button>
        <Button Style="{StaticResource NavButton}" Click="CargoMarketButtonV15_Click">
         <StackPanel><TextBlock Text="▦" FontSize="21" HorizontalAlignment="Center"/><TextBlock Text="MERCADO" HorizontalAlignment="Center" FontSize="11" FontWeight="Bold"/><TextBlock Text="CARGAS" HorizontalAlignment="Center" FontSize="11"/></StackPanel>
        </Button>
        <Button Style="{StaticResource NavButton}" Click="GarageButtonV15_Click">
         <StackPanel><TextBlock Text="⌂" FontSize="21" HorizontalAlignment="Center"/><TextBlock Text="GARAGEM" HorizontalAlignment="Center"/></StackPanel>
        </Button>
        <Button Style="{StaticResource NavButton}" Click="BankButtonV15_Click">
         <StackPanel><TextBlock Text="▤" FontSize="21" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock Text="MEU BANCO" HorizontalAlignment="Center"/></StackPanel>
        </Button>
        <Button Style="{StaticResource NavButton}" Click="RankingButton_Click">
         <StackPanel><TextBlock Text="♛" FontSize="21" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock Text="RANKING" HorizontalAlignment="Center" FontWeight="Bold"/><TextBlock Text="MOTORISTAS" HorizontalAlignment="Center"/></StackPanel>
