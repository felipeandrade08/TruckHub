<Window x:Class="TransPoli.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="TransPoli • TruckHub" Width="1380" Height="860" MinWidth="1180" MinHeight="720"
 WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="CanResize"
 SnapsToDevicePixels="True" WindowStartupLocation="CenterScreen" KeyDown="Window_KeyDown"
 Icon="/TransPoli;component/Assets/transpoli-logo.png">

 <Window.Resources>
  <SolidColorBrush x:Key="Gold" Color="#D9A900"/>
  <SolidColorBrush x:Key="GoldBright" Color="#FFD45A"/>
  <SolidColorBrush x:Key="GoldSoft" Color="#8F6E13"/>
  <SolidColorBrush x:Key="Bg" Color="#070A0E"/>
  <SolidColorBrush x:Key="Surface" Color="#0C1117"/>
  <SolidColorBrush x:Key="Surface2" Color="#101720"/>
  <SolidColorBrush x:Key="Surface3" Color="#151E28"/>
  <SolidColorBrush x:Key="Stroke" Color="#26313D"/>
  <SolidColorBrush x:Key="StrokeGold" Color="#604A0B"/>
  <SolidColorBrush x:Key="TextMain" Color="#F5F7FA"/>
  <SolidColorBrush x:Key="TextMuted" Color="#8E9AA8"/>
  <SolidColorBrush x:Key="Green" Color="#54D99B"/>
  <SolidColorBrush x:Key="Red" Color="#F06A6A"/>
  <Style x:Key="Card" TargetType="Border">
   <Setter Property="Background" Value="{StaticResource Surface}"/>
   <Setter Property="BorderBrush" Value="{StaticResource Stroke}"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="CornerRadius" Value="14"/>
   <Setter Property="Padding" Value="14"/>
  </Style>
  <Style x:Key="GoldCard" TargetType="Border">
   <Setter Property="Background" Value="#110F0A"/>
   <Setter Property="BorderBrush" Value="{StaticResource StrokeGold}"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="CornerRadius" Value="14"/>
   <Setter Property="Padding" Value="14"/>
  </Style>
  <Style x:Key="Label" TargetType="TextBlock">
   <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
   <Setter Property="FontSize" Value="9"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style x:Key="Metric" TargetType="TextBlock">
   <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
   <Setter Property="FontSize" Value="20"/>
   <Setter Property="FontWeight" Value="Bold"/>
  </Style>
  <Style x:Key="NavButton" TargetType="Button">
   <Setter Property="Height" Value="58"/>
   <Setter Property="Margin" Value="2"/>
   <Setter Property="Background" Value="Transparent"/>
   <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
   <Setter Property="BorderThickness" Value="0"/>
   <Setter Property="FontSize" Value="9"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Border x:Name="N" Background="{TemplateBinding Background}" CornerRadius="11" Padding="4">
       <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="N" Property="Background" Value="#231C09"/>
        <Setter Property="Foreground" Value="{StaticResource GoldBright}"/>
       </Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style x:Key="ActionButton" TargetType="Button">
   <Setter Property="Height" Value="36"/>
   <Setter Property="Padding" Value="12,5"/>
   <Setter Property="Background" Value="#101821"/>
   <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
   <Setter Property="BorderBrush" Value="{StaticResource StrokeGold}"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="FontSize" Value="9"/>
   <Setter Property="FontWeight" Value="Bold"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}">
       <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="B" Property="Background" Value="{StaticResource Gold}"/>
        <Setter Property="Foreground" Value="#090B0E"/>
       </Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style x:Key="WindowButton" TargetType="Button">
   <Setter Property="Width" Value="32"/>
   <Setter Property="Height" Value="30"/>
   <Setter Property="Background" Value="#101720"/>
   <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
   <Setter Property="BorderBrush" Value="{StaticResource Stroke}"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Cursor" Value="Hand"/>
  </Style>
 </Window.Resources>

 <Grid ClipToBounds="False">
  <!-- CHASSI FIXO DO TABLET — Etapa 1. A moldura permanece montada; apenas o conteúdo interno evolui nas próximas etapas. -->
  <Border Margin="3" Background="#020304" BorderBrush="#11161C" BorderThickness="2" CornerRadius="46"/>
  <Border Margin="7" Background="#070A0E" BorderBrush="#4B535C" BorderThickness="2" CornerRadius="43"/>
  <Border Margin="11" Background="#05070A" BorderBrush="#B88B08" BorderThickness="1.5" CornerRadius="40" Opacity="0.95"/>
  <Border x:Name="TabletScreen" Margin="22" Background="#05080B" BorderBrush="#1B232C" BorderThickness="1" CornerRadius="28" ClipToBounds="True">
   <Grid>
    <Grid.RowDefinitions>
     <RowDefinition Height="74"/>
     <RowDefinition Height="*"/>
     <RowDefinition Height="46"/>
    </Grid.RowDefinitions>

    <!-- BACKGROUND GERAL DO TABLET -->
    <Image Grid.Row="0" Grid.RowSpan="3" Source="{StaticResource BrandBackground}" Stretch="UniformToFill" Opacity=".34" IsHitTestVisible="False"/>
    <Border Grid.Row="0" Grid.RowSpan="3" Background="#05080B" Opacity=".56" IsHitTestVisible="False"/>

    <!-- HEADER -->
    <Border Grid.Row="0" Background="#080D13" BorderBrush="#382D12" BorderThickness="0,0,0,1" CornerRadius="30,30,0,0">
     <Grid MouseLeftButtonDown="TabletDrag">
      <Grid.ColumnDefinitions>
       <ColumnDefinition Width="330"/>
       <ColumnDefinition Width="*"/>
       <ColumnDefinition Width="420"/>
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
       <Border Width="48" Height="48" CornerRadius="12" Background="#101720" BorderBrush="{StaticResource GoldSoft}" BorderThickness="1" Padding="5">
        <Image Source="{StaticResource BrandLogo}" Stretch="Uniform"/>
       </Border>
       <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
        <TextBlock Text="TRANSPOLI" Foreground="{StaticResource TextMain}" FontSize="21" FontWeight="Bold"/>
        <TextBlock Text="COMPUTADOR DE BORDO  •  TRUCKHUB" Foreground="{StaticResource GoldBright}" FontSize="7.5" FontWeight="Bold"/>
       </StackPanel>
      </StackPanel>

      <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
       <Border Background="#0E1715" BorderBrush="#285440" BorderThickness="1" CornerRadius="9" Padding="11,7" Margin="0,0,7,0">
        <StackPanel Orientation="Horizontal">
         <Ellipse x:Name="ConnectionDot" Width="9" Height="9" Fill="#758596" Margin="0,0,7,0"/>
         <StackPanel>
          <TextBlock x:Name="ConnectionText" Text="ETS2 DESCONECTADO" Foreground="{StaticResource TextMain}" FontSize="8.5" FontWeight="Bold"/>
          <TextBlock x:Name="StatusText" Text="Telemetria aguardando" Foreground="{StaticResource TextMuted}" FontSize="7"/>
         </StackPanel>
        </StackPanel>
       </Border>
       <Border Background="#151109" BorderBrush="{StaticResource StrokeGold}" BorderThickness="1" CornerRadius="9" Padding="11,7">
        <StackPanel Orientation="Horizontal">
         <TextBlock Text="🚛" FontSize="15" FontFamily="Segoe UI Emoji" Margin="0,0,7,0"/>
         <StackPanel>
          <TextBlock x:Name="VehicleLockText" Text="CAMINHÃO BLOQUEADO" Foreground="{StaticResource GoldBright}" FontSize="8.5" FontWeight="Bold"/>
          <TextBlock Text="Liberação segura" Foreground="{StaticResource TextMuted}" FontSize="7"/>
         </StackPanel>
        </StackPanel>
       </Border>
      </StackPanel>

      <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0">
       <Button Content="↻  ATUALIZAR" Click="RefreshDashboard_Click" Style="{StaticResource ActionButton}" Width="112" Margin="0,0,8,0"/>
       <Border Background="#0D141B" BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="9" Padding="10,6" Margin="0,0,8,0">
        <StackPanel>
         <TextBlock x:Name="ClockText" FontFamily="Segoe UI" Text="--:--" Foreground="{StaticResource TextMain}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center"/>
      <TextBlock x:Name="WifiStatusText" Text="◉  ONLINE" Foreground="{StaticResource Green}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="12,0,0,0"/>
      <TextBlock x:Name="BatteryStatusText" Text="▰  100%" Foreground="{StaticResource TextMain}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="10,0,0,0"/>

         <TextBlock x:Name="DateText" Text="--/--/----" Foreground="{StaticResource TextMuted}" FontSize="7" HorizontalAlignment="Center"/>
        </StackPanel>
       </Border>
       <Button Content="—" Click="TabletMinimize_Click" Style="{StaticResource WindowButton}" Margin="0,0,4,0"/>
       <Button Content="□" Click="TabletMaximize_Click" Style="{StaticResource WindowButton}" Margin="0,0,4,0"/>
       <Button Content="×" Click="TabletClose_Click" Style="{StaticResource WindowButton}"/>
      </StackPanel>
     </Grid>
    </Border>

    <!-- MAIN BODY -->
    <Grid Grid.Row="1" Margin="10,9,10,7">
     <Grid.ColumnDefinitions>
      <ColumnDefinition Width="238"/>
      <ColumnDefinition Width="*"/>
     </Grid.ColumnDefinitions>

     <!-- SIDE NAV -->
     <Border Grid.Column="0" Background="#080D13" BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="16" Padding="5">
      <Grid>
       <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="60"/></Grid.RowDefinitions>
       <StackPanel>
        <Button Style="{StaticResource NavButton}" Background="#332706" Foreground="{StaticResource GoldBright}" Click="HomeButton_Click">
         <StackPanel><TextBlock Text="⌂" FontSize="22" HorizontalAlignment="Center"/><TextBlock Text="INÍCIO" HorizontalAlignment="Center"/></StackPanel>
        </Button>
        <Button Style="{StaticResource NavButton}" Click="SummaryButton_Click">
         <StackPanel><TextBlock Text="◉" FontSize="20" HorizontalAlignment="Center"/><TextBlock Text="VIAGEM" HorizontalAlignment="Center"/></StackPanel>
        </Button>
        <Button Style="{StaticResource NavButton}" Click="TachographButton_Click">
         <StackPanel><TextBlock Text="⏱️" FontSize="20" FontFamily="Segoe UI Emoji" HorizontalAlignment="Center"/><TextBlock Text="TACÓGRAFO" HorizontalAlignment="Center"/></StackPanel>
        </Button>
        <Button Style="{StaticResource NavButton}" Click="CargoMarketButtonV15_Click">
         <StackPanel><TextBlock Text="📦" FontSize="20" FontFamily="Segoe UI Emoji" HorizontalAlignment="Center"/><TextBlock Text="MERCADO" HorizontalAlignment="Center"/><TextBlock Text="DE CARGAS" HorizontalAlignment="Center"/></StackPanel>
        </Button>
        <Button Style="{StaticResource NavButton}" Click="GarageButtonV15_Click">
         <StackPanel><TextBlock Text="🚛" FontSize="20" FontFamily="Segoe UI Emoji" HorizontalAlignment="Center"/><TextBlock Text="GARAGEM" HorizontalAlignment="Center"/></StackPanel>
        </Button>
        <Button Style="{StaticResource NavButton}" Click="BankButtonV15_Click">
         <StackPanel><TextBlock Text="🏦" FontSize="20" FontFamily="Segoe UI Emoji" HorizontalAlignment="Center"/><TextBlock Text="MEU BANCO" HorizontalAlignment="Center"/></StackPanel>
        </Button>
        <Button Style="{StaticResource NavButton}" Click="FuelButton_Click">
         <StackPanel><TextBlock Text="⛽" FontSize="19" FontFamily="Segoe UI Emoji" HorizontalAlignment="Center"/><TextBlock Text="COMBUSTÍVEL" HorizontalAlignment="Center"/></StackPanel>
        </Button>
       </StackPanel>
       <Border Grid.Row="1" Background="#0D141B" BorderBrush="{StaticResource StrokeGold}" BorderThickness="1" CornerRadius="10" Padding="6">
        <StackPanel VerticalAlignment="Center">
         <TextBlock Text="SISTEMA" Style="{StaticResource Label}" HorizontalAlignment="Center"/>
         <TextBlock Text="TRANSPOLI" Foreground="{StaticResource GoldBright}" FontSize="8" FontWeight="Bold" HorizontalAlignment="Center"/>
         <TextBlock Text="1.0.17" Foreground="{StaticResource TextMuted}" FontSize="7" HorizontalAlignment="Center"/>
        </StackPanel>
       </Border>
      </Grid>
     </Border>

     <!-- DASHBOARD -->
     <Grid Grid.Column="1" Margin="10,0,0,0">
      <!-- Fundo geral do dashboard: imagem integrada em baixa opacidade, sem cobrir textos. -->
      <Grid.RowDefinitions>
       <RowDefinition Height="250"/>
       <RowDefinition Height="116"/>
       <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <Grid Grid.Row="0">
       <Grid.ColumnDefinitions><ColumnDefinition Width="1.02*"/><ColumnDefinition Width="1.18*"/></Grid.ColumnDefinitions>
       <Image Source="{StaticResource BrandBackground}" Stretch="UniformToFill" Opacity=".30" IsHitTestVisible="False"/>
       <Border Background="#060A0F" Opacity=".34" IsHitTestVisible="False"/>

       <!-- VEHICLE -->
       <Border Grid.Column="0" Style="{StaticResource GoldCard}" Margin="0,0,5,5" ClipToBounds="True">
        <Grid>
         <Image Source="{StaticResource BrandBackground}" Stretch="UniformToFill" Opacity=".28" IsHitTestVisible="False"/>
         <Border Background="#D9080B10" Opacity=".82"/>
         <Grid Margin="6">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="62"/></Grid.RowDefinitions>
          <Grid>
           <StackPanel>
            <TextBlock Text="VEÍCULO" Foreground="{StaticResource GoldBright}" FontSize="9" FontWeight="Bold"/>
            <TextBlock x:Name="TruckName" Text="Aguardando ETS2" Foreground="{StaticResource TextMain}" FontSize="20" FontWeight="Bold" Margin="0,2,0,0"/>
            <TextBlock Text="Conecte o ETS2 para receber a telemetria." Foreground="{StaticResource TextMuted}" FontSize="8"/>
           </StackPanel>
           <Border HorizontalAlignment="Right" Background="#1C170A" BorderBrush="{StaticResource StrokeGold}" BorderThickness="1" CornerRadius="8" Padding="8,5">
            <StackPanel Orientation="Horizontal"><TextBlock Text="MOTOR" Foreground="{StaticResource GoldBright}" FontSize="7" FontWeight="Bold"/><TextBlock x:Name="EngineStateText" Text="DESLIGADO" Foreground="{StaticResource TextMain}" FontSize="7" FontWeight="Bold" Margin="7,0,0,0"/></StackPanel>
           </Border>
          </Grid>
          <Grid Grid.Row="1">
           <Border Width="136" Height="136" CornerRadius="68" Background="#080D12" BorderBrush="{StaticResource Gold}" BorderThickness="5" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel VerticalAlignment="Center">
             <TextBlock x:Name="SpeedText" Text="0" Foreground="{StaticResource TextMain}" FontSize="44" FontWeight="Bold" HorizontalAlignment="Center"/>
             <TextBlock Text="KM/H" Foreground="{StaticResource GoldBright}" FontSize="8" FontWeight="Bold" HorizontalAlignment="Center"/>
            </StackPanel>
           </Border>
          </Grid>
          <Grid Grid.Row="2">
           <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
           <Border Grid.Column="0" Style="{StaticResource Card}" Padding="8" Margin="0,0,2,0"><StackPanel><TextBlock Text="⚙️" FontFamily="Segoe UI Emoji" FontSize="20" HorizontalAlignment="Center" Margin="0,0,0,2"/><TextBlock Text="RPM" Style="{StaticResource Label}" HorizontalAlignment="Center"/><TextBlock x:Name="RpmText" Text="0" Style="{StaticResource Metric}" HorizontalAlignment="Center"/></StackPanel></Border>
           <Border Grid.Column="1" Style="{StaticResource Card}" Padding="8" Margin="2,0"><StackPanel><TextBlock Text="🔧" FontFamily="Segoe UI Emoji" FontSize="20" HorizontalAlignment="Center" Margin="0,0,0,2"/><TextBlock Text="MARCHA" Style="{StaticResource Label}" HorizontalAlignment="Center"/><TextBlock x:Name="GearText" Text="N" Style="{StaticResource Metric}" HorizontalAlignment="Center"/></StackPanel></Border>
           <Border Grid.Column="2" Style="{StaticResource Card}" Padding="8" Margin="2,0,0,0"><StackPanel><TextBlock Text="🛣️" FontFamily="Segoe UI Emoji" FontSize="20" HorizontalAlignment="Center" Margin="0,0,0,2"/><TextBlock Text="CRUISE" Style="{StaticResource Label}" HorizontalAlignment="Center"/><TextBlock x:Name="CruiseText" Text="OFF" Style="{StaticResource Metric}" HorizontalAlignment="Center"/></StackPanel></Border>
          </Grid>
         </Grid>
        </Grid>
       </Border>

       <!-- TRIP + TACHO -->
       <Border Grid.Column="1" Style="{StaticResource Card}" Margin="5,0,0,5">
        <Grid>
         <Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="62"/><RowDefinition Height="*"/></Grid.RowDefinitions>
         <Grid>
          <StackPanel Orientation="Horizontal">
           <Border Width="36" Height="36" CornerRadius="10" Background="#1A150A" BorderBrush="{StaticResource StrokeGold}" BorderThickness="1">
            <TextBlock Text="⏱️" FontSize="20" FontFamily="Segoe UI Emoji" HorizontalAlignment="Center" VerticalAlignment="Center"/>
           </Border>
           <StackPanel Margin="9,0,0,0">
            <TextBlock Text="TACÓGRAFO" Foreground="{StaticResource TextMain}" FontSize="16" FontWeight="Bold"/>
            <TextBlock Text="Jornada • condução • descanso • registros" Foreground="{StaticResource TextMuted}" FontSize="7.5"/>
           </StackPanel>
          </StackPanel>
          <Button Grid.Column="1" Content="▤  IMPRIMIR TICKET" Click="TachographButton_Click" Style="{StaticResource ActionButton}" Width="142" HorizontalAlignment="Right"/>
         </Grid>
         <Border Grid.Row="1" Background="#070B10" BorderBrush="#202B36" BorderThickness="1" CornerRadius="10" Padding="9">
          <Grid>
           <Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="1.2*"/></Grid.ColumnDefinitions>
           <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="HORA" Style="{StaticResource Label}"/>
            <TextBlock x:Name="ClockText2" Text="--:--" Foreground="{StaticResource TextMain}" FontSize="14" FontWeight="Bold" Margin="9,0,0,0"/>
           </StackPanel>
           <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="STATUS DO TACÓGRAFO" Style="{StaticResource Label}" HorizontalAlignment="Center"/>
            <TextBlock Text="REGISTRANDO" Foreground="{StaticResource Green}" FontSize="8" FontWeight="Bold" HorizontalAlignment="Center"/>
           </StackPanel>
           <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <TextBlock Text="DATA" Style="{StaticResource Label}" VerticalAlignment="Center"/>
            <TextBlock x:Name="DateText2" Text="--/--/----" Foreground="{StaticResource TextMain}" FontSize="11" FontWeight="Bold" Margin="7,0,0,0"/>
           </StackPanel>
          </Grid>
         </Border>
         <Grid Grid.Row="2" Margin="0,6,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
          <Border Grid.Column="0" Style="{StaticResource Card}" Padding="9" Margin="0,0,3,0"><StackPanel><TextBlock Text="🛞" FontFamily="Segoe UI Emoji" FontSize="22" HorizontalAlignment="Center"/><TextBlock Text="TEMPO DE CONDUÇÃO" Style="{StaticResource Label}" HorizontalAlignment="Center"/><TextBlock x:Name="TripDrivingTimeText" Text="00:00:00" Style="{StaticResource Metric}" HorizontalAlignment="Center"/></StackPanel></Border>
          <Border Grid.Column="1" Style="{StaticResource Card}" Padding="9" Margin="3,0"><StackPanel><TextBlock Text="😴" FontFamily="Segoe UI Emoji" FontSize="22" HorizontalAlignment="Center"/><TextBlock Text="DESCANSO" Style="{StaticResource Label}" HorizontalAlignment="Center"/><TextBlock Text="—:—:—" Style="{StaticResource Metric}" HorizontalAlignment="Center"/></StackPanel></Border>
          <Border Grid.Column="2" Style="{StaticResource Card}" Padding="9" Margin="3,0,0,0"><StackPanel><TextBlock Text="📍" FontFamily="Segoe UI Emoji" FontSize="22" HorizontalAlignment="Center"/><TextBlock Text="DISTÂNCIA" Style="{StaticResource Label}" HorizontalAlignment="Center"/><TextBlock x:Name="TripDistanceText" Text="0 km" Style="{StaticResource Metric}" HorizontalAlignment="Center"/></StackPanel></Border>
         </Grid>
        </Grid>
       </Border>
      </Grid>

      <!-- TELEMETRY STRIP -->
      <Grid Grid.Row="1" Margin="0,5">
       <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
       <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,3,0"><StackPanel><TextBlock Text="🛣️" FontFamily="Segoe UI Emoji" FontSize="22" HorizontalAlignment="Center"/><TextBlock Text="ODÔMETRO" Style="{StaticResource Label}" HorizontalAlignment="Center"/><TextBlock x:Name="OdometerText" Text="0 km" Style="{StaticResource Metric}"/></StackPanel></Border>
       <Border Grid.Column="1" Style="{StaticResource Card}" Margin="3,0"><StackPanel><TextBlock Text="⛽" FontFamily="Segoe UI Emoji" FontSize="22" HorizontalAlignment="Center"/><TextBlock Text="COMBUSTÍVEL" Style="{StaticResource Label}" HorizontalAlignment="Center"/><TextBlock x:Name="FuelText" Text="0 L" Style="{StaticResource Metric}"/></StackPanel></Border>
       <Border Grid.Column="2" Style="{StaticResource Card}" Margin="3,0"><StackPanel><TextBlock Text="⛽" FontFamily="Segoe UI Emoji" FontSize="22" HorizontalAlignment="Center"/><TextBlock Text="AUTONOMIA" Style="{StaticResource Label}" HorizontalAlignment="Center"/><TextBlock x:Name="RangeText" Text="0 km" Style="{StaticResource Metric}"/></StackPanel></Border>
       <Border Grid.Column="3" Style="{StaticResource Card}" Margin="3,0"><StackPanel><TextBlock Text="📦" FontFamily="Segoe UI Emoji" FontSize="22" HorizontalAlignment="Center"/><TextBlock Text="CARGA ATUAL" Style="{StaticResource Label}" HorizontalAlignment="Center"/><TextBlock x:Name="CargoText" Text="Nenhuma carga" Foreground="{StaticResource TextMain}" FontSize="11" FontWeight="Bold" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="CargoMassText" Text="0 kg" Foreground="{StaticResource TextMuted}" FontSize="7"/></StackPanel></Border>
       <Border Grid.Column="4" Style="{StaticResource GoldCard}" Margin="3,0,0,0"><StackPanel><TextBlock Text="🚚" FontFamily="Segoe UI Emoji" FontSize="22" HorizontalAlignment="Center"/><TextBlock Text="VIAGEM" Style="{StaticResource Label}" HorizontalAlignment="Center"/><TextBlock x:Name="TripStatusText" Text="Aguardando trabalho" Foreground="{StaticResource TextMain}" FontSize="11" FontWeight="Bold" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="TripStartSummaryText" Text="—" Foreground="{StaticResource GoldBright}" FontSize="7"/></StackPanel></Border>
      </Grid>

      <!-- LOWER OPERATION AREA -->
      <Grid Grid.Row="2" Margin="0,5,0,0">
       <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="64"/></Grid.RowDefinitions>
       <Grid.ColumnDefinitions><ColumnDefinition Width="1.55*"/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>

       <Border Grid.Column="0" Style="{StaticResource GoldCard}" Margin="0,0,4,5" ClipToBounds="True">
        <Grid>
         <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

         <Grid>
          <StackPanel Orientation="Horizontal">
           <Border Width="40" Height="40" CornerRadius="11" Background="#1B1609" BorderBrush="{StaticResource StrokeGold}" BorderThickness="1">
            <TextBlock Text="🚚" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
           </Border>
           <StackPanel Margin="10,0,0,0">
            <TextBlock Text="VIAGEM ATUAL" Foreground="{StaticResource TextMain}" FontSize="16" FontWeight="Bold"/>
            <TextBlock Text="Progresso real baseado na telemetria do ETS2" Foreground="{StaticResource TextMuted}" FontSize="8"/>
           </StackPanel>
          </StackPanel>
          <Border HorizontalAlignment="Right" Background="#0E1715" BorderBrush="#285440" BorderThickness="1" CornerRadius="8" Padding="8,4">
           <StackPanel Orientation="Horizontal">
            <Ellipse Width="7" Height="7" Fill="{StaticResource Green}" Margin="0,0,6,0"/>
            <TextBlock x:Name="TripLiveText" Text="AO VIVO" Foreground="{StaticResource Green}" FontSize="7" FontWeight="Bold"/>
           </StackPanel>
          </Border>
         </Grid>

         <Grid Grid.Row="1" Margin="0,10,0,8">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Grid>
           <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
           <StackPanel>
            <TextBlock Text="SAÍDA" Style="{StaticResource Label}"/>
            <TextBlock x:Name="TripOriginText" Text="—" Foreground="{StaticResource TextMain}" FontSize="13" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="TripOriginCompanyText" Text="Empresa de origem —" Foreground="{StaticResource TextMuted}" FontSize="7" TextTrimming="CharacterEllipsis"/>
           </StackPanel>
           <TextBlock Grid.Column="1" Text="→" Foreground="{StaticResource GoldBright}" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" Margin="8,5"/>
           <StackPanel Grid.Column="2" HorizontalAlignment="Right">
            <TextBlock Text="DESTINO" Style="{StaticResource Label}" HorizontalAlignment="Right"/>
            <TextBlock x:Name="TripDestinationText" Text="—" Foreground="{StaticResource TextMain}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="TripDestinationCompanyText" Text="Empresa de destino —" Foreground="{StaticResource TextMuted}" FontSize="7" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis"/>
           </StackPanel>
          </Grid>

          <Grid Grid.Row="1" Margin="0,7,0,0">
           <Border Height="8" Background="#202A34" CornerRadius="4" VerticalAlignment="Center"/>
           <Border x:Name="TripProgressFill" Height="8" Width="0" Background="{StaticResource Gold}" CornerRadius="4" HorizontalAlignment="Left" VerticalAlignment="Center"/>
           <TextBlock x:Name="TripTruckText" Text="🚚" FontSize="17" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="-9,0,0,0"/>
          </Grid>

          <Grid Grid.Row="2" Margin="0,6,0,0">
           <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
           <TextBlock x:Name="TripProgressText" Text="0%" Foreground="{StaticResource GoldBright}" FontSize="11" FontWeight="Bold"/>
           <TextBlock Grid.Column="1" x:Name="TripDistanceLiveText" Text="0 / 0 km" Foreground="{StaticResource TextMuted}" FontSize="8" VerticalAlignment="Center"/>
           <TextBlock Grid.Column="2" x:Name="TripRemainingText" Text="— km restantes" Foreground="{StaticResource TextMuted}" FontSize="8" HorizontalAlignment="Right"/>
          </Grid>

          <Grid Grid.Row="3" Margin="0,8,0,0">
           <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
           <StackPanel>
            <TextBlock Text="SAÍDA" Style="{StaticResource Label}"/>
            <TextBlock x:Name="TripStartText" Text="—" Foreground="{StaticResource TextMain}" FontSize="11" FontWeight="Bold"/>
           </StackPanel>
           <StackPanel Grid.Column="1" HorizontalAlignment="Center">
            <TextBlock Text="CHEGADA PREVISTA" Style="{StaticResource Label}" HorizontalAlignment="Center"/>
            <TextBlock x:Name="TripArrivalText" Text="Calculando…" Foreground="{StaticResource GoldBright}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
           </StackPanel>
           <StackPanel Grid.Column="2" HorizontalAlignment="Right">
            <TextBlock Text="TEMPO RESTANTE" Style="{StaticResource Label}" HorizontalAlignment="Right"/>
            <TextBlock x:Name="TripEtaText" Text="Calculando…" Foreground="{StaticResource TextMain}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right"/>
           </StackPanel>
          </Grid>
         </Grid>

         <Grid Grid.Row="2">
          <Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition/><ColumnDefinition Width="1.3*"/></Grid.ColumnDefinitions>
          <StackPanel>
           <TextBlock Text="CARGA" Style="{StaticResource Label}"/>
           <TextBlock x:Name="TripCargoText" Text="Nenhuma carga ativa" Foreground="{StaticResource TextMain}" FontSize="9" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
          </StackPanel>
          <StackPanel Grid.Column="1" HorizontalAlignment="Center">
           <TextBlock Text="VALOR" Style="{StaticResource Label}" HorizontalAlignment="Center"/>
           <TextBlock x:Name="TripValueText" Text="—" Foreground="{StaticResource Green}" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center"/>
          </StackPanel>
          <TextBlock Grid.Column="2" x:Name="TripEstimateNoteText" Text="Estimativa baseada na telemetria real." Foreground="{StaticResource TextMuted}" FontSize="7" TextWrapping="Wrap" HorizontalAlignment="Right" TextAlignment="Right" VerticalAlignment="Bottom"/>
         </Grid>
        </Grid>
       </Border>

       <Border Grid.Column="1" Style="{StaticResource Card}" Margin="4,0,4,5">
        <StackPanel VerticalAlignment="Center">
         <TextBlock Text="🚛  GARAGEM" FontFamily="Segoe UI Emoji" Foreground="{StaticResource GoldBright}" FontSize="10" FontWeight="Bold"/>
         <TextBlock Text="Sua frota" Foreground="{StaticResource TextMain}" FontSize="15" FontWeight="Bold" Margin="0,2"/>
         <TextBlock Text="Caminhões e motoristas" Foreground="{StaticResource TextMuted}" FontSize="8" TextWrapping="Wrap"/>
         <Button Content="ABRIR" Click="GarageButtonV15_Click" Style="{StaticResource ActionButton}" Margin="0,10,0,0"/>
        </StackPanel>
       </Border>

       <Border Grid.Column="2" Style="{StaticResource GoldCard}" Margin="4,0,4,5">
        <StackPanel VerticalAlignment="Center">
         <TextBlock Text="🏦  MEU BANCO" FontFamily="Segoe UI Emoji" Foreground="{StaticResource GoldBright}" FontSize="10" FontWeight="Bold"/>
         <TextBlock Text="Sua situação financeira" Foreground="{StaticResource TextMain}" FontSize="15" FontWeight="Bold" Margin="0,2"/>
         <TextBlock Text="Saldo, entradas, despesas e extrato" Foreground="{StaticResource TextMuted}" FontSize="8" TextWrapping="Wrap"/>
         <Button Content="ABRIR BANCO" Click="BankButtonV15_Click" Style="{StaticResource ActionButton}" Margin="0,10,0,0"/>
        </StackPanel>
       </Border>

       <Border Grid.Column="3" Style="{StaticResource Card}" Margin="4,0,0,5">
        <StackPanel VerticalAlignment="Center">
         <TextBlock Text="📄  DOCUMENTOS" FontFamily="Segoe UI Emoji" Foreground="{StaticResource GoldBright}" FontSize="10" FontWeight="Bold"/>
         <TextBlock Text="Nota fiscal" Foreground="{StaticResource TextMain}" FontSize="15" FontWeight="Bold" Margin="0,2"/>
         <TextBlock Text="Documentos da viagem" Foreground="{StaticResource TextMuted}" FontSize="8" TextWrapping="Wrap"/>
         <Button Content="ABRIR" Click="SummaryButton_Click" Style="{StaticResource ActionButton}" Margin="0,10,0,0"/>
        </StackPanel>
       </Border>

       <!-- FOOTER STATUS -->
       <Border Grid.Row="1" Grid.ColumnSpan="4" Background="#090F15" BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="11" Padding="8">
        <Grid>
         <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="STATUS" Foreground="{StaticResource GoldBright}" FontSize="7" FontWeight="Bold" Margin="3,0,8,0"/>
          <TextBlock Text="Telemetria local • Tacógrafo ativo • Atualização automática habilitada" Foreground="{StaticResource TextMuted}" FontSize="7.5"/>
         </StackPanel>
         <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="TransPoli" Foreground="{StaticResource TextMain}" FontSize="7" FontWeight="Bold"/>
          <TextBlock Text="  •  v1.0.17" Foreground="{StaticResource GoldBright}" FontSize="7" FontWeight="Bold"/>
         </StackPanel>
        </Grid>
       </Border>
      </Grid>
     </Grid>
    </Grid>

    <!-- HIDDEN COMPATIBILITY BINDINGS -->
    <StackPanel Grid.RowSpan="3" Visibility="Collapsed" IsHitTestVisible="False">
     <TextBlock x:Name="TelemetryInfoText" Text=""/>
     <TextBlock x:Name="TripRouteText" Text=""/>
     <TextBlock x:Name="RouteText" Text=""/>
     <TextBlock x:Name="AlertText" Text=""/>
     <TextBlock x:Name="FuelAutoText" Text="Mercado"/>
     <TextBlock x:Name="OpsCounterText" Text=""/>
     <TextBlock x:Name="TripDurationText" Text="00:00:00"/>
     <Button x:Name="UnlockButton" Content="DESBLOQUEAR" Click="UnlockButton_Click"/>
    </StackPanel>
   </Grid>
  </Border>

  <!-- Detalhes físicos do hardware. São puramente decorativos e não capturam cliques. -->
  <Border Width="170" Height="11" CornerRadius="6" Background="#080A0D" BorderBrush="#343A42" BorderThickness="1"
          HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,5,0,0" IsHitTestVisible="False"/>
  <Ellipse Width="18" Height="18" Fill="#080B0F" Stroke="#4D555E" StrokeThickness="2"
           HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,18,0,0" IsHitTestVisible="False"/>
  <Ellipse Width="6" Height="6" Fill="#28435B" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,24,0,0" IsHitTestVisible="False"/>
  <Border Width="7" Height="86" CornerRadius="4" Background="#20252B" BorderBrush="#4D555E" BorderThickness="1"
          HorizontalAlignment="Left" VerticalAlignment="Center" Margin="7,0,0,0" IsHitTestVisible="False"/>
  <Border Width="7" Height="118" CornerRadius="4" Background="#20252B" BorderBrush="#4D555E" BorderThickness="1"
          HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,7,0" IsHitTestVisible="False"/>
  <Border Width="120" Height="7" CornerRadius="4" Background="#171B20" BorderBrush="#30363D" BorderThickness="1"
          HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,8" IsHitTestVisible="False"/>
  <ProgressBar x:Name="FuelProgressBar" Visibility="Collapsed" Minimum="0" Maximum="100" Value="0"/>
 </Grid>
</Window>