<Application x:Class="TruckHub.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Themes/TruckHubOS.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    <SolidColorBrush x:Key="Bg" Color="#0B1118"/>
    <SolidColorBrush x:Key="Panel" Color="#111A23"/>
    <SolidColorBrush x:Key="Panel2" Color="#151D26"/>
    <SolidColorBrush x:Key="Panel3" Color="#1B232C"/>
    <SolidColorBrush x:Key="Orange" Color="#4298EF"/>
    <SolidColorBrush x:Key="Yellow" Color="#6DB3FA"/>
    <SolidColorBrush x:Key="GoldBright" Color="#6DB3FA"/>
    <SolidColorBrush x:Key="Text" Color="#F4F7FA"/>
    <SolidColorBrush x:Key="Muted" Color="#8997A5"/>
    <!-- Compatibility aliases for legacy code-behind. These keys are still referenced
         by runtime status updates; keeping them at application scope prevents the
         telemetry timer from throwing ResourceReferenceKeyNotFoundException. -->
    <SolidColorBrush x:Key="TextPrimary" Color="#F4F7FA"/>
    <SolidColorBrush x:Key="TextMuted" Color="#8997A5"/>
    <SolidColorBrush x:Key="Green" Color="#4EE59B"/>
    <SolidColorBrush x:Key="Red" Color="#FF6B6B"/>
    <SolidColorBrush x:Key="Blue" Color="#4DA8FF"/>
    <SolidColorBrush x:Key="PanelGlass" Color="#E60E1217"/>
    <SolidColorBrush x:Key="Stroke" Color="#2E3B48"/>
    <SolidColorBrush x:Key="StrokeStrong" Color="#3A4652"/>
    <Style x:Key="TabletButton" TargetType="Button">
      <Setter Property="Background" Value="#0D141B"/>
      <Setter Property="Foreground" Value="{StaticResource GoldBright}"/>
      <Setter Property="BorderBrush" Value="#083C70"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Padding" Value="12,9"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ButtonBorder" Property="Background" Value="#006CD9"/>
                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#6DB3FA"/>
                <Setter Property="Foreground" Value="#0B1118"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="ButtonBorder" Property="Background" Value="#0D5195"/>
                <Setter Property="Foreground" Value="#FFFFFF"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.42"/>
                <Setter Property="Foreground" Value="#7D8792"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Label" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
    </Style>
    <BitmapImage x:Key="BrandBackground" UriSource="/TruckHub;component/Assets/truckhub-bg.jpg"/>
    <BitmapImage x:Key="BrandLogo" UriSource="/TruckHub;component/Assets/truckhub-mark.png"/>
    <BitmapImage x:Key="BrandLogoFull" UriSource="/TruckHub;component/Assets/truckhub-logo.png"/>
    <BitmapImage x:Key="BrandBadge" UriSource="/TruckHub;component/Assets/truckhub-badge.png"/>
    <BitmapImage x:Key="BrandScene" UriSource="/TruckHub;component/Assets/truckhub-scene.jpg"/>
    <SolidColorBrush x:Key="Warn" Color="#FFB84D"/>
    <BitmapImage x:Key="BrandHero" UriSource="/TruckHub;component/Assets/hero-truck.jpg"/>
    <LinearGradientBrush x:Key="BrandOverlay" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#D807090C" Offset="0"/>
      <GradientStop Color="#E607090C" Offset="0.52"/>
      <GradientStop Color="#F907090C" Offset="1"/>
    </LinearGradientBrush>
      </ResourceDictionary>
  </Application.Resources>
</Application>
