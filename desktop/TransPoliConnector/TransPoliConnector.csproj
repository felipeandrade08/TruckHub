    <TargetFramework>net48</TargetFramework>
    <RootNamespace>TransPoliConnector</RootNamespace>
    <AssemblyName>TransPoliConnector</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Product>TransPoli Connector</Product>
    <Company>Felipe Andrade</Company>
    <Authors>Felipe Andrade</Authors>
